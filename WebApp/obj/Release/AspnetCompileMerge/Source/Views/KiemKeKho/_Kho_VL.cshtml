
<div class="main-action pt-3">
    <div class="form-search w-100">
        <input ng-model="search" type="text" placeholder="Tìm kiếm">
        <button>
            <i class="fa fa-search" aria-hidden="true"></i>
        </button>
    </div>
</div>
<div class="content-table fixTableHead" style="height: calc(100vh - 300px);">
    <table class="table-responsive table-hover result-point">
        <tbody class="">
        <tr ng-repeat="item in ListKhoVL|filter:search"
            ng-class="{activerow:$index==selectedRowKhoVL}" ng-click="SelectKhoVL($index,item)">
            <td class="text-left clhd">{{item.TEN_DON_VI}}</td>
        </tr>
        </tbody>
    </table>
</div>