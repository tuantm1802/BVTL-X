

<div class="col-7 col-sm-7 col-md-7 col-lg-7 none-padding" style="float:left">
    <div class="col-12">
        <label style="font-weight: bold;">{{SelectedKho}}</label>
    </div>
    <div class="content-table fixTableHead" style="height: calc(100vh - 184px);">

        <table class="table-hover result-point">
            <thead class="point-table-head">
                <tr>
                    <th style="width:10%;">Mã hàng<i id="or_dv"></i></th>
                    <th style="width:30%;">Tên hàng<i id="or_dv"></i></th>
                    <th style="width:5%;">ĐVT<i id="or_dv"></i></th>
                    <th style="width:10%;">Sl tồn<i id="or_ng"></i></th>
                    <th style="width:10%;">Sl sẵn sàng CP<i id="or_ng"></i></th>
                </tr>
            </thead>
            <tbody style="background-color:white">
                <tr ng-repeat="item in ListHangHoa | filter: searchTK">
                    <td>
                        @*<button style="margin-left: 10px;" type="button" class="btn btn-primary bg-green" ng-click="GetTheKhoVL(item)">Thẻ kho</button>*@
                        @*<div class="btn-group main-action d-flex pull-left ">
            <button class="btn-action-m" ng-click="GetTheKhoVL(item)">
                <span>Thẻ kho</span>
            </button>
        </div>*@
                        <a href="#" title="Thẻ kho" ng-click="GetTheKhoVL(item)"> {{item.CODE}}</a>
                       
                    </td>
                    <td>{{item.NAME}}</td>
                    <td>{{item.DVT}}</td>
                    <td style="text-align: right;">{{item.SO_LUONG_TON}}</td>
                    <td style="text-align: right;">{{item.SL_SAN_SANG_CP}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
    <div class="col-5 col-sm-5 col-md-5 col-lg-5 none-padding" style="float:left">
        <fieldset class="scheduler-border" style="padding: 0 0.25em 0 0.25em !important;">
            <legend class="scheduler-border"><label class="bold-label"><b>Giữ hàng trong kho</b></label></legend>
            <div class="row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                    <div class="btn-group main-action d-flex pull-left ">
                        <button class="btn-action-m" ng-click="ThemGiuHang()">
                            <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                        </button>
                        <button class="btn-action-m bg-red" ng-click="XoaGiuHang()">
                            <i class="fa fa-trash" aria-hidden="true"></i>  <span>Xóa</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="content-table fixTableHead" style="height: calc(100vh/2 - 155px);">
                <table class="table-responsive table-hover result-point">
                    <thead class="point-table-head">
                        <tr>
                            <th style="width:5%;" class="center"><input type="checkbox" class="form-control"  ng-change="toggleAllKH()" ng-model="isAllSelectedKH" /> </th>
                            <th class="text-center">STT</th>
                            <th class="text-center">Số phiếu</th>
                            <th class="text-center">Người lập</th>
                            <th class="text-center">Ngày lập</th>
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody class="">
                        <tr ng-repeat="item in DSDuHang">
                             <td class="text-center">
                                    <input type="checkbox" class="ace" ng-model="item.CHECKEDKH" ng-change="optionToggledKH()">
                                </td>
                            <td class="text-center">{{$index +1}}</td>
                            <td class="text-left">{{item.SO_PHIEU}}</td>
                            <td class="text-left">{{item.NGUOI_TAO_TEXT}}</td>
                            <td class="text-center">{{item.NGAY_TAO_TEXT}}</td>
                            <td class="text-center"> 
                            <i class="fa fa-pencil-square-o" ng-click="ChiTiet(item)" aria-hidden="true"></i>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </fieldset>


        <fieldset class="scheduler-border" style="padding: 0 0.25em 0 0.25em !important;">
            <legend class="scheduler-border"><label class="bold-label"><b>Dừng cấp phát</b></label></legend>
            <div class="row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                    <div class="btn-group main-action d-flex pull-left ">
                        <button class="btn-action-m" ng-click="ThemDCP()">
                            <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                        </button>
                        <button class="btn-action-m bg-red" ng-click="XoaDCP()">
                            <i class="fa fa-trash" aria-hidden="true"></i>  <span>Xóa</span>
                        </button>
                    </div>
                    <div class="btn-group main-action d-flex pull-right ">
                        <div class="form-search w-100" style="margin:0;">
                            <input type="text" placeholder="Tìm kiếm" ng-model="SearchDCP">
                            <button>
                                <img src="~/App_Assets/images/search_icon.svg" ng-click="TimKiemDCP()" alt="">
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-table fixTableHead" style="height: calc(100vh/2 - 152px);">
                <table class="table-responsive table-hover result-point">
                    <thead class="point-table-head">
                        <tr>
                            <th style="width:5%;" class="center"><input type="checkbox" class="form-control" ng-change="toggleAllDCP()" ng-model="isAllSelectedDCP" /> </th>
                            <th style="width:5%;" class="text-center">STT</th>
                            <th style="width:8%;" class="text-center">Mã H55</th>
                            <th style="width:50%;"class="text-center">Tên sản phẩm</th>
                        </tr>
                    </thead>
                    <tbody class="">
                        <tr ng-repeat="item in DSDungCP">
                            <td class="text-center">
                                <input type="checkbox" class="ace" ng-model="item.CHECKEDDCP" ng-change="optionToggledDCP()">
                            </td>
                            <td class="text-center">{{$index +1}}</td>
                            <td class="text-left">{{item.MA_H55}}</td>
                            <td style="padding: 0 !important;">
                                <select class="form-control" ng-change="changeHangDCP($index, item.ID_SP)" style="width:100%" ng-model="item.ID_SP" select2 required ng-options="i.ID_HANG as i.NAME for i in ListHangHoa">
                                    <option value=""> -- Chọn mặt hàng --  </option>
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
            <div class="row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                    <div class="btn-group main-action d-flex pull-right ">
                        <button class="btn-action-m" ng-click="HuyDCP()">
                            <i class="fa fa-ban" aria-hidden="true"></i>
                            <span>Hủy thay đổi</span>
                        </button>
                        <button class="btn-action-m" ng-click="LuuDCP()">
                            <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                            <span> Lưu </span>
                        </button>
                    </div>
                   
                </div>
            </div>
           
        </fieldset>
    </div>
