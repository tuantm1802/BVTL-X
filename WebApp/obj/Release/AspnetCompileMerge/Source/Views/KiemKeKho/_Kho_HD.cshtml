<style>
    .fixTableHead {
         overflow: auto; height: 600px; 
    }

    .fixTableHead thead th {
         position: sticky; top: 0; z-index: 1;
    }
</style>
<div class="main-action pt-3">
    <div class="form-search w-100">
        <input ng-model="search" type="text" placeholder="Tìm kiếm">
        <button>
            <i class="fa fa-search" aria-hidden="true"></i>
        </button>
    </div>
    <div class="content-table fixTableHead" style="height: calc(100vh - 300px);">
        <table class="table-responsive table-hover result-point">
            <thead class="point-table-head">
                <tr>
                    <th class="text-center balance">Số HĐ</th>
                    <th class="text-center balance">Tên HĐ</th>
                </tr>
            </thead>
            <tbody ng-repeat="itemCT in ListKhoHD">
                <tr><td colspan="2" style="background-color:#38a36b; color:white;">{{itemCT.TEN_CONG_TY}}</td></tr>
                <tr ng-repeat="item in itemCT.ListKhoHopDong" ng-class="{activerow:item.ID_HOP_DONG==selectedRowKhoHD}" ng-click="viewDetailKhoHD(item)">
                    <td class="clhd">{{item.SO_HD}}</td>
                    <td class="balance">{{item.TEN_HD}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
