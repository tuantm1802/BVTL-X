@{
    ViewBag.Title = "Cấp bậc";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục cấp bậc
    </h3>
</div>
<div ng-controller="CapBacController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;  padding-right: 2px;">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12" align-self-end>
                                <div class="main-action d-flex pull-left">
                                    <button class="btn-action-m bg-green"
                                            ng-click="addData()" ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green"
                                            ng-click="cancelAction()" ng-show="RoleBtnCancel">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>Hủy thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green"
                                            ng-click="saveAction()" ng-show="RoleBtnSave">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                        <span>Lưu</span>
                                    </button>
                                    <button class="btn-action-m bg-red"
                                            ng-click="deleteData()" ng-show="RoleBtnDelete"
                                            style="margin-right: 10px;background-color:#f55442;">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xoá</span>
                                    </button>
                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right" style="margin-left:5px;">
                                    <div class="main-action">
                                        <div class="d-flex form-group" style="margin-bottom:0px;vertical-align:middle">
                                            <input type="text" ng-model="search" placeholder="Tìm kiếm" class="form-control" style="width:250px;margin-bottom:0px" />
                                            <button class="btn-action-m form-control" ng-click="SearchCapBac()" style="color:white;width:40px;margin-bottom:0px">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="margin-top:10px;">
                        <div>
                            <table class="table-responsive table-hover result-point">
                                <thead class="point-table-head">
                                    <tr>
                                        <th class="text-center ht4-number">
                                            <input type="checkbox" class="ace" ng-disabled="isDisable" ng-model="selectAll" ng-click="checkAll()" />
                                        </th>
                                        <th class="text-left">STT</th>
                                        <th class="text-left">
                                            Tên cấp bậc

                                        </th>
                                        <th class="text-left">
                                            Mô tả
                                        </th>
                                        <th class="text-left">
                                            Số thứ tự

                                        </th>
                                        <th class="text-left">
                                            Nhóm cấp bậc
                                        </th>
                                        <th class="text-center">
                                            Không xét phong hàm
                                        </th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr ng-repeat="row in rows">
                                        <td class="center">
                                            <input type="checkbox" id="check" ng-true-value="{{item.ID}}" ng-false-value="''" ng-model="item.selected" />
                                        </td>
                                        <td>
                                            {{(modelSearch.totalItems+1)+ $index}}
                                        </td>
                                        <td>
                                            <input ng-class="row.TCB? 'error': ''" type="text" class="form-control" ng-model="row.TEN_CB" />
                                            <div ng-show="row.TCB">
                                                <label class="error">Bạn chưa nhập tên cấp bậc</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control" ng-model="row.MO_TA_CB" />
                                        </td>
                                        <td>
                                            <input ng-class="row.ST? 'error': ''" type="text" class="form-control" ng-model="row.SO_THU_TU" />
                                            <div ng-show="row.ST">
                                                <label class="error">Bạn chưa nhập STT</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input ng-class="row.NCB? 'error': ''"
                                                   type="text" class="form-control"
                                                   ng-change="ChangeNhomCapBac()"
                                                   ng-model="row.TEN_NHOM_CB"
                                                   placeholder="Nhóm cấp bậc"
                                                   autocomplete="on"
                                                   ui-combo-tree
                                                   combo-tree-init="NhomCBTreeInit"
                                                   on-callback="NhomCBCallback(data)" />
                                            <div ng-show="row.NCB">
                                                <label class="error">Bạn chưa chọn nhóm cấp bậc</label>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="checkbox" ng-model="row.KXPH" />
                                        </td>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    <tr ng-repeat="item in GetListCapBac" ng-dblclick="tableEdit($index)">
                                        <td class="text-center">
                                            <label class="pos-rel">
                                                <input type="checkbox" ng-disabled="isDisable" class="ace" ng-model="item.select" value="10" />
                                                <span class="lbl"></span>
                                            </label>
                                        </td>
                                        <td class="text-left">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>

                                        <td class="text-left">
                                            <span ng-if="!item.Edit">{{item.TEN_CB}}</span>
                                            <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.TEN_CB">
                                        </td>
                                        <td class="text-left">
                                            <span ng-if="!item.Edit">{{item.MO_TA_CB}}</span>
                                            <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.MO_TA_CB">
                                        </td>
                                        <td class="text-left">
                                            <span ng-if="!item.Edit">{{item.SO_THU_TU}}</span>
                                            <input ng-class="item.ST? 'error': ''" type="text" ng-if="item.Edit" class="form-control" ng-model="item.SO_THU_TU">
                                        </td>
                                        <td class="text-left">
                                            <span ng-if="!item.Edit">{{item.TEN_NHOM_CB}}</span>
                                            <input ng-if="item.Edit"
                                                   type="text" class="form-control"
                                                   ng-change="ChangeNhomCapBac()"
                                                   ng-model="item.TEN_NHOM_CB"
                                                   placeholder="Chọn nhóm cấp bậc"
                                                   autocomplete="on"
                                                   ui-combo-tree
                                                   combo-tree-init="NhomCBTreeInit"
                                                   on-callback="NhomCBCallback(data)" />
                                        </td>
                                        <td class="text-center" ng-if="koXetPhongHam">
                                            <input type="checkbox" ng-disabled="isDisable" ng-model="item.KXPH" />
                                        </td>
                                    </tr>

                                </tbody>
                            </table>

                            <div class="pages-switch">
                                <ul class="pagination pagination-sm m-0 float-right "
                                    uib-pagination total-items="modelSearch.totalItems"
                                    items-per-page="modelSearch.pageSize"
                                    ng-model="modelSearch.currentPage"
                                    ng-change="pageChanged()"
                                    max-size="modelSearch.maxSize"
                                    boundary-links="true"
                                    rotate="false"
                                    previous-text="&lsaquo;"
                                    next-text="&rsaquo;"
                                    first-text="&laquo;"
                                    last-text="&raquo;"></ul>
                            </div><!-- /.span -->

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section scripts{
    <script src="~/app/Controller/CapBacController.js"></script>
}



