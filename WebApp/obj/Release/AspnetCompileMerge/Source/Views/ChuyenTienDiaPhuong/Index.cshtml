
@{
    ViewBag.Title = "Chuyển tiền địa phương";
}
<style>
    .function-box {
        height: auto;
    }
</style>
<main ng-controller="ChuyenTienDiaPhuongController" style="padding-top: 15px;">
    <div class="container-fluid d-flex cons-ac-system" style="height: calc(100vh - 125px);">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>

            <div class="fill-box">
                <h3 class="title-fill">
                    Năm
                </h3>
            </div>

            <div class="container">
                @*<div class="main-action pt-3">
                        <div class="form-search w-100">
                            <select class="form-control" ng-model="NamKH" ng-change="ChangeNamKH()">
                                <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Text}}</option>
                            </select>
                        </div>
                    </div>*@
                <div class="main-action pt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <select class="form-control" ng-model="NamKH" ng-change="ChangeNamKH()">
                                <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Text}}</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="btn-group main-action d-flex pull-right ">
                                <button class="btn-action-m" ng-click="ThemKeHoach()">
                                    <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="function-box" style="overflow: auto;height: calc(100vh - 230px);">
                    <div class="content-table row">
                        <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="center">Số kế hoạch</th>
                                    <th class="center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ListKeHoach" @*ng-class="{activerow:$index==selectedRow}"*@ ng-click="ChonKeHoach(item, $index)" style="cursor: pointer;">
                                    <td>{{item.SO_KH}}</td>
                                    <td>{{item.TRANG_THAI == 'Y' ? 'Đã duyệt' : 'Chưa duyệt'}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            @*<div class="main-action pt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Năm</label>
                            <select class="form-control" ng-model="NamThemMoiKH">
                                <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Text}}</option>
                            </select>
                        </div>
                        <div class="col-md-6" style="text-align: -webkit-right;">
                            <label></label>
                            <button class="btn-action-m bg-green" style="margin-right: 10px;" ng-click="ThemKeHoach()">
                                <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                            </button>
                        </div>
                    </div>

                </div>*@
        </div>

        <div class="content-system no-border pb-0" ng-show="IsShowRight" style="overflow-y: auto; overflow-x: hidden">
            <div class="form-infor has-border p-3 firts-to-h">
                <div class="row no-gutters">
                    <div class="col-12 col-md-2 col-lg-2">
                        <label for="">Số kế hoạch</label>
                        <input type="text" class="form-control" placeholder="{{modelKH.SO_KH}}" disabled>
                    </div>

                    <div class="col-12 col-md-2 col-lg-2">
                        <label for="">Năm</label>
                        <input type="text" class="form-control" placeholder="{{modelKH.NAM}}" disabled>
                    </div>

                    <div class="col-12 col-md-2 col-lg-2">
                        <label for="">Cán bộ P7/H03</label>
                        <input type="text" class="form-control" placeholder="{{modelKH.TEN_CAN_BO}}" disabled>
                    </div>
                    <div class="col-12 col-md-5 col-lg-5">
                        <label for="">Lý do cấp</label>
                        <input type="text" class="form-control" placeholder="" ng-model="modelKH.LY_DO_CAP">
                    </div>
                    <div class="col-12 col-md-1 col-lg-1 main-action">
                        <button class="btn-action-m bg-green" style="margin-top: 22px;" ng-click="LuuKeHoach()">
                            <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                        </button>
                    </div>
                </div>
                @*<div class="row no-gutters">
                        <div class="col-12 col-md-6 col-lg-7">
                            <label for="">Lý do cấp</label>
                            <input type="text" class="form-control" placeholder="" ng-model="modelKH.LY_DO_CAP">
                        </div>
                        <div class="col-12 col-md-6 col-lg-5 main-action">
                            <button class="btn-action-m bg-green" style="margin-top: 25px;" ng-click="LuuKeHoach()">
                                <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                            </button>
                        </div>
                    </div>*@
            </div>
            <div>
                <div class="nav-tabs-box">
                    <ul class="nav nav-tabs tab-main" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#bieu-gia" role="tab">Biểu giá trang phục</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#kinh-phi-ung-no-ton" role="tab">Kinh phí ứng nợ tồn</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#kinh-phi-khac" role="tab">kinh phí khác</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#ke-hoach-chuyen-tien" role="tab">Kế hoạch chuyển tiền</a>
                        </li>
                    </ul>
                </div>

                <div class="container-fluid sl-1-row">
                    <div class="tab-content" id="myTabContent">
                        @Html.Partial("_bieuGiaTrangPhuc")
                        @Html.Partial("_kinhPhiUngNoTon")
                        @Html.Partial("_kinhPhiKhac")
                        @Html.Partial("_keHoachChuyenTien")
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
@section scripts{
    <script src="~/app/Controller/CapPhat/ChuyenTienDiaPhuongController.js"></script>
}