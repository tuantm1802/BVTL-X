            <div class="col-md-12 main-action">
                <div class="row">
                    <button class="btn-action-m" ng-click="ThemDSDV_UngNoTon()">
                        <span>Thêm đơn vị</span>
                    </button>
                    <button class="btn-action-m red" ng-click="xoaDV_UngNoTon()">
                        <span>Xóa</span>
                    </button>
                </div>
            </div>
            <div class="content-table fixTableHead" style="height: calc(100vh - 300px);">
                <table class="table-hover result-point">
                    <thead class="point-table-head" style="width:100%">
                        <tr>
                            <th style="width:5%;" class="text-center">
                                <input ng-model="toggleAllDV_UngNoTon" class="form-control" ng-change="changeToggleDV_UngNoTon()" type="checkbox" />
                            </th>
                            <th style="width:5%;">STT</th>
                            <th style="width:20%;" class="text-left">Tên đơn vị</th>
                            <th style="width:10%;" class="text-left">Kinh phí CBCS tồn</th>
                            <th style="width:10%;" class="text-left">Kinh phí phạm tồn</th>
                            <th style="width:10%;" class="text-left">Tổng cộng tồn</th>
                            <th style="width:10%;" class="text-left">Kinh phí CBCS DN</th>
                            <th style="width:10%;" class="text-left">Kinh phí phạm DN</th>
                            <th style="width:10%;" class="text-left">Tổng cộng DN</th>
                        </tr>

                    </thead>
                    <tbody>
                        <tr ng-repeat="item in dsDV_NoTon">
                            <td class="text-center">
                                <input ng-model="item.CHECKEDDV" class="form-control" ng-change="changeCheckDV_UngNoTon()" type="checkbox" />
                            </td>
                            <td class="text-center">
                                {{$index + 1}}
                            </td>
                            <td>
                                {{item.TEN_DON_VI}}
                            </td>
                            <td>
                                <input type="number" ng-change="changeSua_UngNoTon($index, 'NT')" style="text-align: right" class="form-control" ng-model="item.QT_NT_CBCS">
                            </td>
                            <td>
                                <input type="number" ng-change="changeSua_UngNoTon($index, 'NT')" style="text-align: right" class="form-control" ng-model="item.QT_NT_PHAM">
                            </td>
                            <td class="text-right">
                                {{item.QT_NT_TONG}}
                            </td>
                            <td>
                                <input type="number" ng-change="changeSua_UngNoTon($index, 'DN')" style="text-align: right" class="form-control" ng-model="item.DN_KP_CBCS">
                            </td>
                            <td>
                                <input type="number" ng-change="changeSua_UngNoTon($index, 'DN')" style="text-align: right" class="form-control" ng-model="item.DN_KP_PHAM">
                            </td>
                            <td class="text-right">
                                {{item.DN_KP_TONG}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-12 main-action">
                <div class="row pull-right">
                    <button class="btn-action-m" ng-click="huyDV_UngNoTon()">
                        <i class="fa fa-ban" aria-hidden="true"></i>  <span>Hủy thay đổi</span>
                    </button>
                    <button class="btn-action-m" ng-click="luuDV_UngNoTon()">
                        <i class="fa fa-save" aria-hidden="true"></i> <span>Lưu</span>
                    </button>
                </div>
            </div>
        </div>
