<div class="modal fade" id="LPXK_ChonHopDong">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Lập phiếu xuất</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <!-- Modal body -->
            <div class="modal-body">
                <form class=" col-md-12" id="formSubmit">
                    <div class="content-table" style="height:auto; overflow-y:scroll;">
                        <table class="table-nested table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th class="left" style="width:8%;"></th>
                                    <th class="text-center" style="width: 20% !important;">Số hợp đồng</th>
                                    <th class="text-center">Tên hợp đồng </th>
                                    <th class="text-center" style="width: 200px !important;">Năm kinh phí </th>
                                </tr>
                            </thead>
                            <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_treedhopdong.html&#39;" ng-repeat="item in LPXK_ListHopDong">
                            </tbody>
                        </table>
                        <script id="table_treedhopdong.html" type="text/ng-template">
                            <tr ng-class="{parent: item.children}" ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)">
                                <td class="cell-name" style="width:8%;" ng-click="item.opened = !item.opened">
                                    <div class="indent" ng-if="item.parent" style="padding-left: {{15*level}}px"></div>
                                    <input ng-if="!item.parent" ng-model="item.selected" class="form-control" type="checkbox" />
                                </td>
                                <td class="cell-name" ng-if="item.parent" colspan="3" style="padding: 8px !important;">
                                    <b>{{item.name}}</b>
                                </td>
                                <td class="cell-name" ng-if="!item.parent" style="padding: 8px !important;width: 20% !important;">
                                    <b>{{item.title}}</b>
                                </td>
                                <td class="cell-name" ng-if="!item.parent" style="padding: 8px !important;">
                                    {{item.name}}
                                </td>
                                <td class="cell-members" ng-if="!item.parent" style="padding: 8px !important;width: 200px !important;">
                                    {{item.SO_LUONG_KH}}
                                </td>
                            </tr>
                            <tr class="children" ng-if="item.children &amp;&amp; item.children.length &gt; 0">
                                <td colspan="6">
                                    <table class="table-nested table table-striped table-bordered table-hover">
                                        <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_treedhopdong.html&#39;" ng-init="level = level + 1" ng-repeat="item in item.children"></tbody>
                                    </table>
                                </td>
                            </tr>
                        </script>
                    </div>
                </form>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">
                <h5 class="day-make"></h5>
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="LPXK_XuatGiaoThangTuHD()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Xuất giao thẳng</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

