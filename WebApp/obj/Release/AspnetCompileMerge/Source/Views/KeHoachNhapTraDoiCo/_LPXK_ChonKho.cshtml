<div class="modal fade" id="LPXK_ChonKhoKhac">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Chọn kho xuất ưu tiên 2(Trong trường hợp kho mặc định 1 hết hàng)</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <!-- Modal body -->
            <div class="modal-body">
                <form class=" col-md-12" id="formSubmit">
                    <div class="row">
                        <div class="col-sm-12" style="padding:0px;padding-right:10px;">
                            <div class="form-infor has-border p-3">
                                <div class="row no-gutters">
                                    <div class="col-12 col-md-12">
                                        <label style="color:white;" for="">Tìm kiếm: </label>
                                        <div class="main-action">
                                            <div class="form-search w-100">
                                                <input type="text" placeholder="Tìm kiếm" ng-model="LPXK_SearchKhoText">
                                                <button>
                                                    <img src="~/App_Assets/images/search_icon.svg" ng-click="LPXK_SearchKho()" alt="">
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="content-table" style="height:300px; overflow-y:scroll;">
                                <table class="table-responsive table-hover result-point">
                                    <thead class="point-table-head">
                                        <tr>
                                            <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="LPXK_CheckAllKho" ng-change="LPXK_ChangeCheckAllKho()" /> </th>
                                            <th>STT</th>
                                            <th>Tên kho</th>
                                            <th>Thứ tự ưu tiên</th>
                                        </tr>
                                    </thead>
                                    <tbody class="">
                                        <tr ng-repeat="item in LPXK_ListKho">
                                            <td class="center"><input type="checkbox" ng-change="LPXK_CheckedKho($index)" class="form-control" ng-model="item.SELECTED" /> </td>
                                            <td>{{$index +1}}</td>
                                            <td>{{item.TEN_DON_VI}}</td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">
                <h5 class="day-make"></h5>
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="LPXK_TaoPhieuXuatKhoKhac()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Xuất hàng</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" >
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

