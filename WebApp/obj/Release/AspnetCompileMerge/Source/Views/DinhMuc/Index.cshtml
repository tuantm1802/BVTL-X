@{
    //ViewBag.Title = "Tiêu chuẩn CBCS";
}

<style type="text/css">
    .tccbcsParentcolor {
        background-color: #ffe2e2 !important;
        color: #900 !important;
    }
</style>
<div class="row page-content" ng-controller="DinhMucController" style="padding:5px !important;">
    <div class="main-container ace-save-state" id="main-container">
        <script type="text/javascript">
            try { ace.settings.loadState('main-container') } catch (e) { }
        </script>
        <div class="main-content">
            <div class="main-content-inner">
                <div class="page-content" style="padding:0px !important;">
                    <div class="row" style="height:480px;">
                        <div class="col-xs-3 none-padding" style="padding-left:0px;padding-right:2px;height:100%;">
                            <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                                <legend class="scheduler-border" style="        width: 90px;"><label class="bold-label">Đinh mức</label></legend>
                                <div class="row" style="padding-bottom: 5px;">
                                    <div class="form-group">
                                        <div class="col-sm-3 no-padding text-right">
                                            <label>Tìm kiếm</label>
                                        </div>
                                        <div class="col-sm-9">
                                            <div class="input-group">
                                                <input type="text" ng-model="TC_MaDoiTieuChuan" class="form-control search-query">
                                                <span class="input-group-btn">
                                                    <button type="button" style=" height: 28px;" class="btn btn-inverse btn-white" ng-click="TC_TimKiem()">
                                                        <span class="ace-icon fa fa-search icon-on-right bigger-110"></span>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="height:378px;">
                                    <div class=" form-group">
                                        <div class="col-sm-12">
                                            <table id="dynamic-table" class="table table-striped table-bordered table-hover" style="max-height:378px; overflow-y:scroll;">
                                                <thead>
                                                    <tr>
                                                        <th style="width:10%;" class="center"><input style="width:100%;" type="checkbox" ng-model="SPD_CheckAllSPDoi" ng-change="SPD_ChangeSPDoi()" /> </th>
                                                        <th style="width:25%;" class="center">Ngày QĐ </th>
                                                        <th class="center">Số QĐ </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="item in DSTieuChuan" ng-class="{activerow:$index==selectedRowTieuChuan}" ng-click="TC_SelectTieuChuan(item,$index )">
                                                        <td class="text-center"><input type="checkbox" /></td>
                                                        <td class="text-center">{{item.SP_NAME}}</td>
                                                        <td class="text-left">{{item.NIEN_HAN}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12" style="text-align:right;">
                                        <a class="btn btn-default btn-xs" href="#" @*ng-disabled="disabledRollbackData"*@ ng-click="TC_LamMoi()">
                                            <i class="ace-icon fa fa-refresh bigger-130"></i> Làm mới
                                        </a>
                                        <a class="btn btn-default btn-xs" href="#" @*ng-disabled="disabledSaveChange"*@ ng-click="TC_ThemMoi()">
                                            <i class="ace-icon fa fa-plus bigger-130"></i> Thêm mới
                                        </a>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-xs-9 none-padding" style="margin-top: 10px; padding-right: 2px;">
                            <div class="row">
                                <div class="form-group">
                                    <label class="col-sm-1 control-label">Số QĐ</label>
                                    <div class="col-sm-2">
                                        <input type="text" class="form-control" />
                                    </div>
                                    <label class="col-sm-1 control-label">Ngày QĐ</label>
                                    <div class="col-sm-2">
                                        <input type="date" class="form-control" />
                                    </div>
                                    <label class="col-sm-2 control-label">Hao hụt (%)</label>
                                    <div class="col-sm-2">
                                        <input type="number" maxlength="100" class="form-control" />
                                    </div>
                                    <div class="col-sm-2">
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="margin-top: 5px;">
                                <div class="form-group">
                                    <div class="col-sm-3">
                                        <a class="btn btn-default btn-xs" style="margin-right: 5px;" href="#" ng-click="SPD_ThemMoi()">
                                            <i class="ace-icon fa fa-plus bigger-130"></i>
                                        </a>
                                        <a class="btn btn-default btn-xs" href="#" ng-click="SPD_Xoa()">
                                            <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                        </a>
                                    </div>
                                    <div class="col-sm-2 no-padding text-right">
                                        <label>Tìm kiếm</label>
                                    </div>
                                    <div class="col-sm-7">
                                        <div class="input-group">
                                            <input type="text" ng-model="SPD_TenSanPham" class="form-control search-query">
                                            <span class="input-group-btn">
                                                <button type="button" style=" height: 28px;" class="btn btn-inverse btn-white" ng-click="SPD_TimKiem()">
                                                    <span class="ace-icon fa fa-search icon-on-right bigger-110"></span>
                                                </button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="margin-top: 5px; height: 370px;">
                                <div class=" form-group">
                                    <div class="col-sm-12">
                                        <table id="dynamic-table" class="table table-striped table-bordered table-hover" style="max-height:378px; overflow-y:scroll;">
                                            <thead>
                                                <tr>
                                                    <th style="width:7%;" class="center"><input style="width:100%;" type="checkbox" ng-model="SPD_CheckAllSPDoi" ng-change="SPD_ChangeSPDoi()" /> </th>
                                                    <th style="width:7%;" class="center">STT </th>
                                                    <th class="center">Định mức </th>
                                                    <th class="center">Trang phục </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="item in DSSanPhamDoi" ng-class="{activerow:$index==selectedRowSPD}" ng-click="SPD_ChooseSPD()">
                                                    <td class="text-center"><input type="checkbox" /></td>
                                                    <td class="text-center">{{$index +1}}</td>
                                                    <td class="text-center">{{item.SP_NAME}}</td>
                                                    <td class="text-center">{{item.SP_NAME}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4" style="text-align:left;">
                                    <a class="btn btn-default btn-xs" href="#" @*ng-disabled="disabledRollbackData"*@ ng-click="SPD_HuyThayDoi()">
                                        <i class="ace-icon fa fa-mail-reply bigger-130"></i> Danh sách trang phục
                                    </a>
                                </div>
                                <div class="col-sm-8" style="text-align:right;">
                                    <a class="btn btn-default btn-xs" href="#" @*ng-disabled="disabledRollbackData"*@ ng-click="SPD_HuyThayDoi()">
                                        <i class="ace-icon fa fa-mail-reply bigger-130"></i> Hủy thay đổi
                                    </a>
                                    <a class="btn btn-default btn-xs" href="#" @*ng-disabled="disabledSaveChange"*@ ng-click="SPD_Luu()">
                                        <i class="ace-icon fa fa-save bigger-130"></i> Lưu
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
            <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
        </a>
    </div>
    @Html.Partial("~/Views/DinhMuc/_add.cshtml")
</div>

@section Scripts{
    <script src="~/app/Controller/TieuChuan_DinhMuc/DinhMucController.js"></script>
    <script src="~/Content/js/jquery.ztree.core.js"></script>
    <script src="~/Content/js/jquery.ztree.excheck.js"></script>
}
