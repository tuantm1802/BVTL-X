
<div id="AddTieuChuan" class="modal fade " role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Danh sách sản phẩm đổi tiêu chuẩn</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="min-height:330px;">
                <form class=" col-md-12" id="formSubmit">
                    <div class="row" style="padding-bottom:10px;">
                        <div class="col-sm-2 no-padding text-right">
                            <label>Mô tả:</label>
                        </div>
                        <div class="col-md-10">
                            <input type="text" ng-model="TC_SO_QUYET_DINH" class="form-control">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">

                <button type="button" class="btn btn-default" ng-click="TC_LuuTieuChuan()">Lưu</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Hủy</button>
            </div>
        </div>
    </div>
</div>
