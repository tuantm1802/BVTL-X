<div style="width:600px;">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Tiêu chuẩn khu vực</h4>
                <button type="button" class="close" data-dismiss="modal" ng-click="cancel()">
                    <img src="assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body sl-row-1">
                <div class="content-table" style="margin-top: -10px;">
                    <div style="height:310px; overflow-y:scroll;">
                        <table class="table-hover result-point mt-2">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:10%;"></th>
                                    <th style="width:90%;" class="text-left">Tên khu vực</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in khuvuc">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.SELECT" value="10" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="text-left">{{item.TEN_KHU_VUC}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="submit()">
                        <img src="/App_Assets/images/d_save.svg" alt="" class="exsit">
                        <img src="/App_Assets/images/icon_save.svg" alt="" class="hover_m">
                        <span>Lưu</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="assets/images/d_cancel.svg" alt="" class="exsit">
                        <img src="assets/images/ic_cancel_light.svg" alt="" class="hover_m">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
</div>

