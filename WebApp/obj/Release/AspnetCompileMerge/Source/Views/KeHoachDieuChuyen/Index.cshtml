@{
    ViewBag.Title = "Kế hoạch điều chuyển";
    var userSession = (Simple.Base.UserLogin)HttpContext.Current.Session["USER_SESSION"];
}
<style>
    .row {
        margin-left: 0px;
        margin-right: 0px;
    }

    .form-control {
        padding: 0px 0px;
    }

    .table-responsive {
        display: table
    }

    .modal .btn-container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .centered {
        margin: 0;
        position: absolute;
        left: 50%;
        -ms-transform: translate(-50%, -50%);
        transform: translate(-50%, -50%);
    }

    table {
        border: 1px solid black;
    }

    #resizable {
        height: 87vh
    }

    .sticky-top {
        position: sticky;
        top: 0;
    }
</style>

<div class="container-fluid d-flex cons-ac-system form-infor" ng-controller="KeHoachDieuChuyenController" style=" margin-top: 5px ">
    @Html.Partial("~/Views/KeHoachDieuChuyen/HangDoi.cshtml")
    <div class="content-system no-border pb-0">
        <div class="row">
            <div class="col-9 col-md-8">
                <div class="fill-box-bread-crumb">
                    <h3 class="bread_crumb">
                        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a> / Kế hoạch  /   Kế hoạch điều chuyển
                    </h3>
                </div>
            </div>
            <div class="col-1 col-md-2" style="padding: 0px !important;">
                <span>Ngày cập nhật</span>
            </div>
            <div class="col-2 col-md-2">
                <div class="input-group date" data-date-format="dd/mm/yyyy">
                    <input type="text" name="NGUOI_LAP" customzdatetime class="form-control" ng-model="NgayCapNhat">
                    <span class="input-group-addon"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="main-action d-flex align-items-center justify-content-between flex-wrap">
                    <div class="d-flex align-items-center flex-wrap">
                        @if (userSession.IsKyDuyet != "Y")
                        {
                            <button class="btn-action-m" ng-show="RoleBtnCreate" ng-click="ThemKeHoach('@userSession.Name','@userSession.Appcode')">
                                <img src="~/App_Assets/images/icon_add.svg" alt="">
                                <span>Thêm mới</span>
                            </button>
                            <button class="btn-action-delete" ng-show="RoleBtnDelete" ng-click="XoaKeHoach()" ng-disabled="disabledDelete">
                                <img src="~/App_Assets/images/icon_del.svg" alt="">
                                <span>Xoá</span>
                            </button>

                            <button class="btn-action-m" ng-show="RoleBtnRollback" ng-click="HuyThayDoi()" ng-disabled="disabledRollback">
                                <span>Hủy thay đổi</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnUpdate" ng-click="SuaKeHoach()" ng-disabled="disabledEdit">
                                <img src="~/App_Assets/images/icon_edit.svg" alt="">
                                <span>Sửa</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnSave" ng-click="LuuPhieu()" ng-disabled="disabledSave">
                                <img src="~/App_Assets/images/icon_save.svg" alt="">
                                <span>Lưu</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnSendApprove" ng-click="TrinhDuyet()" ng-disabled="disabledSendApprove">
                                <img src="~/App_Assets/images/icon_save.svg" alt="">
                                <span>Trình duyệt</span>
                            </button>
                        }

                        @*@if (userSession.IsKyDuyet == "Y")
                            {
                                <button class="btn-action-m" ng-show="RoleBtnApprove" ng-click="DuyetPhieu()" ng-disabled="disabledDuyet">
                                    <img src="~/App_Assets/images/icon_edit.svg" alt="">
                                    <span>Duyệt phiếu</span>
                                </button>
                                <button class="btn-action-m" ng-show="RoleBtnNotApprove" ng-click="TuChoiDuyetPhieu()" ng-disabled="disabledTuChoiDuyet">
                                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                                    <span>Từ chối duyệt</span>
                                </button>
                            }*@

                    </div>
                    <button class="btn-action-m" ng-show="RoleBtnPrint" ng-click="InPhieu()" ng-disabled="disabledPrint">
                        <img src="~/App_Assets/images/l7_hover.svg" alt="">
                        <span>In kế hoạch</span>
                    </button>
                </div>
            </div>
        </div>
        <form class="form-infor" id="main-info">
            <div class="row">
                <div class="col-4 col-md-4">
                    <label>Số kế hoạch</label>
                    <input type="text" name="NGUOI_LAP" ng-model="thongTinKh.SO_KH" class="form-control" />
                </div>
                <div class="col-4 col-md-4">
                    <label>Nơi xuất <span>*</span></label>
                    <select class="form-control" ng-disabled="disabledThongTinKH" name="KhoXuat" ng-model="thongTinKh.ID_KHO_XUAT" ng-options="item.ID as item.TEN_DON_VI for item in dmDonVis" required>
                    </select>
                </div>
                <div class="col-4 col-md-4">
                    <label>Nơi nhập <span>*</span></label>
                    <select class="form-control" ng-disabled="disabledThongTinKH" name="KhoNhap" ng-model="thongTinKh.ID_KHO_NHAP" ng-options="item.ID as item.TEN_DON_VI for item in dmDonVis" required>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-12 col-md-12">
                    <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;margin-bottom: 5px;">
                        <legend class="scheduler-border" style="width: 150px;"><label class="bold-label"><b>Thông tin chung</b></label></legend>
                        <div class="row">
                            <div class="col-3 col-md-3">
                                <label>Căn cứ <span>*</span></label>
                                <input class="form-control" ng-disabled="disabledThongTinKH" ng-trim="true" ng-model="thongTinKh.CAN_CU" name="canCu" required />
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Ngày/cấp QĐ</label>
                                <input type="text" class="form-control" name="ngayCanCu" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGAY_CAN_CU">
                            </div>
                            <div class="col-3 col-md-3" disabled="disabled">
                                <label>Người lập kế hoạch </label>
                                <input type="text" name="NGUOI_LAP" ng-disabled="disabledNguoiLapKH" ng-model="thongTinKh.NGUOI_LAP" class="form-control" />
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Ngày lập kế hoạch <span>*</span></label>
                                <div class="input-group date" ng-disabled="disabledThongTinKH" data-date-format="dd/mm/yyyy">
                                    <input type="text" customzdatetime class="form-control" name="ngayLapKH" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGAY_KH" required>
                                    <span class="input-group-addon"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-3 col-md-3">
                                <label>Người nhận <span>*</span></label>
                                <input type="text" ng-disabled="disabledThongTinKH" ng-trim="true" name="nguoiNhan" ng-model="thongTinKh.NGUOI_NHAN" class="form-control" required />
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Nguồn hàng <span>*</span></label>
                                <select class="form-control" ng-disabled="disabledThongTinKH" name="nguonHang" ng-model="thongTinKh.ID_NGUON_GOC" ng-options="item.FLEX_VALUE_ID as item.DESCRIPTION for item in nguonHangs" required>
                                </select>
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Ngày xuất dự kiến từ <span>*</span></label>
                                <div class="input-group date" ng-disabled="disabledThongTinKH" data-date-format="dd/mm/yyyy">
                                    <input type="text" customzdatetime class="form-control" name="ngayXuatDKTu" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGAY_XUAT_DK_TU" required>
                                    <span class="input-group-addon"></span>
                                </div>
                            </div>
                            <div class="col-3 col-md-3">
                                <label>đến <span>*</span></label>
                                <div class="input-group date" ng-disabled="disabledThongTinKH" data-date-format="dd/mm/yyyy">
                                    <input type="text" customzdatetime class="form-control" name="ngayXuatDKDen" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGAY_XUAT_DK_DEN" required>
                                    <span class="input-group-addon"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row ">
                            <div class="col-3 col-md-3">
                                <label>Ngày nhập dự kiến <span>*</span></label>
                                <div class="input-group date" ng-disabled="disabledThongTinKH" data-date-format="dd/mm/yyyy">
                                    <input type="text" customzdatetime class="form-control" name="ngayNhapDK" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGAY_NHAN_DK" required>
                                    <span class="input-group-addon"></span>
                                </div>
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Vận chuyển <span>*</span></label>
                                <select class="form-control" name="vanChuyen" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.HT_VAN_CHUYEN" ng-options="item.FLEX_VALUE_ID as item.DESCRIPTION for item in hinhThucVanChuyens" required>
                                </select>
                            </div>
                            @*<div class="col-3 col-md-3">
                                    <label>Người duyệt <span>*</span></label>
                                    <select class="form-control" name="nguoiDuyet" ng-disabled="disabledThongTinKH" ng-model="thongTinKh.NGUOI_DUYET" ng-options="item.USER_ID as item.FULL_NAME for item in NguoiKys" required>
                                    </select>
                                </div>*@
                            <div class="col-3 col-md-3">
                                <label>Số phiếu tài chính  </label>
                                <input type="text" @*ng-disabled="disabledThongTinKH"*@ disabled name="soPhieuTaiChinh" ng-model="thongTinKh.SO_PHIEU_TC" class="form-control" />
                            </div>
                            <div class="col-3 col-md-3">
                                <label>Ngày thực nhập </label>
                                <div class="input-group date" @*ng-disabled="disabledThongTinKH"*@ disabled data-date-format="dd/mm/yyyy">
                                    <input type="text" customzdatetime class="form-control" name="ngayNhanThucTe" disabled @*ng-disabled="disabledThongTinKH"*@ ng-model="thongTinKh.NGAY_NHAN_TT">
                                    <span class="input-group-addon"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-bottom: 5px;">
                            <div class="col-12 col-md-12">
                                <label>Lý do điều chuyển</label>
                                <textarea class="form-control" ng-disabled="disabledThongTinKH" ng-trim="true" ng-model="thongTinKh.LY_DO">
                            </textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="row" style="margin-bottom: 5px;">
                <div class="col-12 col-md-12">
                    <label>Lý do từ chối duyệt</label>
                    <textarea class="form-control" name="LY_DO_TC_DUYET" @*ng-disabled="disabledThongTinKH"*@ ng-model="thongTinKh.LY_DO_TC_DUYET">
                            </textarea>
                </div>
            </div>
        </form>
        <div class="row">
            <div class="col-12 col-md-12" style="margin-bottom:10px;">
                <div class="col-12 col-md-12 col-lg-12 align-self-end" style="        margin-bottom: 5px;">
                    <div class="main-action d-flex align-items-center flex-wrap">
                        <button class="btn-action-m" data-toggle="modal" ng-disabled="disabledThongTinKH" ng-click="ThemHangHoa()">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            <span>Thêm mới hàng hóa</span>
                        </button>
                        <button class="btn-action-m" ng-disabled="disabledThongTinKH" ng-click="XoaHangHoaDaChon()">
                            <i class="fa fa-trash-o" aria-hidden="true"></i>
                            <span>Xoá hàng hóa</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row no-gutters" id="detail-info">
            <div class="col-12 col-md-12 content-table" style="width:30%;" ng-show="showTableHH" id="left-table">
                <table class="table-responsive table-hover result-point">
                    <thead class="point-table-head">
                        <tr>
                            <th class="text-center" style="width:3%;"><input type="checkbox" ng-model="checkAllHangHoa" ng-click="ChonTatCaHangHoa(2)" /> </th>
                            <th class="text-center" style="width:3%;">STT </th>
                            <th class="text-center">Tên hàng</th>
                            @*<th class="text-center">Hợp đồng</th>*@
                            <th class="text-center">ĐVT</th>
                            @*<th class="text-center" style="width:3%;">SL tồn</th>*@
                            <th class="text-center" style="width:3%;">SL kế hoạch</th>
                            <th class="text-center" style="width:3%;">SL thực tế</th>
                        </tr>
                    </thead>
                    <tbody style="background-color:white">
                        <tr ng-repeat="item in dsHangHoaDaChon" ng-class="{'selected':$index == selectedGood}">
                            <td class="text-center"><input type="checkbox" ng-model="item.SELECT" ng-click="TichChonHangHoa(2,$index)" ng-disabled="EditStatus" /></td>
                            <td class="text-center">
                                <label>{{item.STT}}</label>
                            </td>
                            <td>
                                <label>{{item.MA_HANG+' - '+item.TEN_HANG}}</label>
                            </td>
                            @*<td class="text-left"> <label>{{item.SO_HOP_DONG}}</label></td>*@
                            <td class="text-left"> <label>{{item.DVT}}</label></td>
                            @*<td class="text-right"> <label>{{item.SO_LUONG_TON}}</label></td>*@
                            <td class="text-right"> <label>{{item.SO_LUONG}}</label></td>
                            <td class="text-right"> <label>{{item.SO_LUONG_TT}}</label></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @Html.Partial("~/Views/KeHoachDieuChuyen/_PopupThemHangHoa.cshtml")

            @Html.Partial("~/Views/KeHoachDieuChuyen/_PopupThemChiTiet.cshtml")
            @Html.Partial("~/Views/KeHoachDieuChuyen/_enterPassword.cshtml")
            @Html.Partial("~/Views/KeHoachDieuChuyen/_PopupSearchHopDong.cshtml")
            @Html.Partial("~/Views/KeHoachDieuChuyen/_PopupLyDoKhongDuyet.cshtml")
            @Html.Partial("~/Views/KeHoachDieuChuyen/_PopupChonNguoiDuyet.cshtml")
        </div>
    </div>
    @section scripts{
        <script src="~/app/Controller/KeHoach/KeHoachDieuChuyenController.js"></script>
        <script>
            $(function () {
                $("#resizable").resizable();
            });
        </script>
    }
