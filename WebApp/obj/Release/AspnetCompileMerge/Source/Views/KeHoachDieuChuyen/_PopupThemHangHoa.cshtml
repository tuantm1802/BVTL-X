<div class="modal fade" id="them_hang_hoa">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới sản phẩm</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <form class="modal-body row no-gutters" @*style="height:50vh"*@ id="frm-them-hang-hoa">
                <div class="content-table mt-2 col-12 col-md-6 has-border">
                    <h4 style="font-weight:bold">Danh sách sản phẩm</h4>
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <div class="main-action">
                                <div class="form-search w-100">
                                    <input type="text" placeholder="Tìm kiếm" ng-model="AddHH_SearchSanPhamText">
                                    <button>
                                        <img src="~/App_Assets/images/search_icon.svg" ng-click="AddHH_TimKiem()" alt="">
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div style="max-height:350px !important; overflow-y:scroll;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th style="width:3%;"><input type="checkbox" ng-model="checkAllLeft" ng-click="ChonTatCaHangHoa(0)" /> </th>
                                    <th style="width:3%;">STT </th>
                                    <th style="width:4%;" class="text-center">Mã hàng<i id="or_ntn"></i></th>
                                    <th class="text-center">Tên hàng hóa<i id="or_ntn"></i></th>
                                    <th class="text-center">ĐVT<i id="or_ntn"></i></th>
                                    <th class="text-center">SL tồn<i id="or_ntn"></i></th>
                                    <th class="text-center">SL xuất dự kiến<i id="or_ntn"></i></th>
                                </tr>
                            </thead>
                            <tbody style="background-color:white">
                                <tr ng-repeat="item in dsHangHoaChon">
                                    <td class="text-center"><input type="checkbox" ng-model="item.SELECT" ng-click="TichChonHangHoa(0,$index)" /></td>
                                    <td class="text-center">
                                        {{$index +1}}
                                    </td>
                                    <td>
                                        {{item.MA_HANG}}
                                    </td>
                                    <td>
                                        {{item.TEN_HANG}}
                                    </td>
                                    <td>
                                        {{item.DVT}}
                                    </td>
                                    <td>
                                        {{item.SO_LUONG_TON | number}}
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" @*max="{{item.SO_LUONG_TON}}"*@ ng-change="ChangeSLHangHoa(item.SO_LUONG, item.SO_LUONG_TON,$index )" ng-model="item.SO_LUONG" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                        
                    </div>
                    <div class="content-table mt-2 col-12 col-md-1" style="display: block;">
                        <div class="centered" style="top:40%; padding:10px">
                            <button class="btn-action-m" ng-click="HuyChonHangHoa()">
                                <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
                            </button>
                        </div>
                        <div class="centered" style="top:60%; padding:10px">
                            <button class="btn-action-m" ng-click="ChonHangHoa()">
                                <img class="img-180-rotate" src="~/App_Assets/images/ic_back_xx.svg" alt="">
                            </button>
                        </div>
                    </div>
                    <div class="content-table mt-2 col-12 col-md-5 has-border">
                        <h4 style="font-weight:bold">Danh sách sản phẩm đã chọn</h4>
                        <div style="max-height:400px !important; overflow-y:scroll;">
                            <table class="table-responsive table-hover result-point">
                                <thead class="point-table-head">
                                    <tr>
                                        <th style="width:3%;"><input type="checkbox" ng-model="checkAllRight" ng-click="ChonTatCaHangHoa(1)" /></th>
                                        <th style="width:3%;">STT </th>
                                        <th style="width:4%;" class="text-center">Mã hàng<i id="or_ntn"></i></th>
                                        <th class="text-center">Tên hàng hóa<i id="or_ntn"></i></th>
                                        <th class="text-center">ĐVT<i id="or_ntn"></i></th>
                                        <th class="text-center">SL tồn<i id="or_ntn"></i></th>
                                        <th class="text-center">SL xuất dự kiến<i id="or_ntn"></i></th>
                                    </tr>
                                </thead>`
                                <tbody style="background-color:white">
                                    <tr ng-repeat="item in dsHangHoaDaChon">
                                        <td class="text-center"><input type="checkbox" ng-model="item.SELECT" ng-click="TichChonHangHoa(1,$index)" /></td>
                                        <td class="text-center">
                                            {{$index +1}}
                                        </td>
                                        <td>
                                            {{item.MA_HANG}}
                                        </td>
                                        <td>
                                            {{item.TEN_HANG}}
                                        </td>
                                        <td>
                                            {{item.DVT}}
                                        </td>
                                        <td>
                                            {{item.SO_LUONG_TON | number}}
                                        </td>
                                        <td>
                                            {{item.SO_LUONG | number}}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                    </div>
</form>
            <div class="modal-footer">
                <div class="main-action d-flex flex-wrap">
                    <button type="button" class="btn btn-action-m" ng-click="LuuDsHangHoa()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Chọn hàng hóa</span>
                    </button>
                </div>
                
            </div>
        </div>
    </div>
</div>
