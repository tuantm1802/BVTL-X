
@{
    ViewBag.Title = "Khu vực";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục Khu vực theo tiêu chuẩn định mức
    </h3>
</div>
<div ng-controller="KhuVucController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;  padding-right: 2px;">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12" align-self-end>
                                <div class="main-action d-flex pull-left">
                                    <button class="btn-action-m bg-green"
                                            ng-click="Add()"
                                            ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" style="margin-right: 10px;"
                                            ng-click="Undo()"
                                            ng-show="RoleBtnCancel">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>Huỷ thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" style="margin-right: 10px;"
                                            ng-click="Submit()"
                                            ng-show="RoleBtnSave">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                        <span>Lưu</span>
                                    </button>
                                    <button class="btn-action-m" style="margin-right: 10px;background-color:#f55442;"
                                            ng-click="Delete()"
                                            ng-show="RoleBtnDelete">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span> Xóa </span>
                                    </button>
                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right"
                                     style="margin-left:5px;">
                                    <div class="main-action">
                                        <div class="d-flex form-group"
                                             style="margin-bottom:0px;vertical-align:middle">
                                            <input ng-model="search"
                                                   type="text"
                                                   placeholder="Tìm kiếm"
                                                   class="form-control"
                                                   style="width:250px;margin-bottom:0px" />
                                            <button class="btn-action-m form-control"
                                                    style="color:white;width:40px;margin-bottom:0px">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="margin-top: 10px;">
                        <table class="table-hover result-point mt-2">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:2%;" class="text-center">
                                        <input type="checkbox"
                                               ng-disabled="isDisable"
                                               ng-model="selectAll"
                                               ng-click="checkAll()" />
                                    </th>
                                    <th style="width:2%;" class="text-center" ng-if="STT">STT</th>
                                    <th style="width:30%;" class="text-left" ng-if="TenKhuVuc">Tên khu vực</th>
                                    <th style="width:auto;" class="text-left" ng-if="MoTa">Mô tả chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DanhSach | filter : search"
                                    ng-dblclick="loadTemplate($index)">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace"
                                                   ng-disabled="isDisable"
                                                   ng-model="item.select" value="10" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="text-left" ng-if="STT">
                                        {{(modelSearch.pageSize * (modelSearch.currentPage-1)) + $index + 1}}
                                    </td>
                                    <td class="text-left" ng-if="TenKhuVuc">
                                        <span ng-if="!item.Edit">{{item.TEN_KHU_VUC}}</span>
                                        <input type="text" class="form-control"
                                               ng-if="item.Edit"
                                               ng-model="item.TEN_KHU_VUC">
                                    </td>
                                    <td class="text-left" ng-if="MoTa">
                                        <span ng-if="!item.Edit">{{item.MO_TA}}</span>
                                        <input type="text" class="form-control"
                                               ng-if="item.Edit"
                                               ng-model="item.MO_TA">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr ng-repeat="row in rows">
                                    <td class="text-center">
                                        <input type="checkbox" ng-model="item.selected" />
                                    </td>
                                    <td class="text-left" ng-if="STT">{{modelSearch.totalItems + $index + 1 }}</td>
                                    <td class="text-left" ng-if="TenKhuVuc">
                                        <input type="text" ng-model="row.TEN_KHU_VUC" placeholder="Nhập tên khu vực" />
                                    </td>
                                    <td class="text-left" ng-if="MoTa">
                                        <input type="text" ng-model="row.MO_TA" placeholder="Nhập mô tả ngắn gọn" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="pages-switch">
                            <ul class="pagination pagination-sm m-0 float-right"
                                uib-pagination total-items="modelSearch.totalItems"
                                items-per-page="modelSearch.pageSize"
                                ng-model="modelSearch.currentPage"
                                ng-change="pageChanged()"
                                max-size="modelSearch.maxSize"
                                boundary-links="true"
                                rotate="false"
                                previous-text="&lsaquo;"
                                next-text="&rsaquo;"
                                first-text="&laquo;"
                                last-text="&raquo;">
                            </ul>
                        </div>
                        @*@Html.Partial("~/Views/KhuVuc/AddKhuVuc.cshtml")*@
                    </div>
                </div>
            </div>
            <div class="bootbox modal fade bootbox-prompt"
                 id="exampleModal"
                 tabindex="-1"
                 role="dialog"
                 aria-labelledby="exampleModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog modal-lg">
                </div>
            </div>
        </div>
    </main>
</div>
@section scripts{
    <script src="~/app/Controller/KhuVucController.js"></script>
}