<div ng-controller="tieuchuantheonamtruoccontroller">
    <div id="modelTieuChuanTheoNam" class="modal fade " role="dialog">
        <div class="modal-dialog" style="width:600px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Tiêu chuẩn theo năm trước</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <div class="modal-body" style="padding:0px;">
                    <form class="col-md-12" style="margin-bottom:15px; margin-top:10px; margin-right:20px;">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12 align-self-end">
                                <div class="main-action">
                                    <div class="form-search w-100">
                                        <div class="col-sm-4 no-padding text-right">
                                            <label >Năm ban hành</label>
                                        </div>
                                        <div class="col-sm-8">
                                            <select class="form-control" style="width:100%;" ng-change="changeNam()" ng-model="nhap.NAM" ui-select2 required ng-options="item.NAM as item.NAM for item in nambh">
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12 align-self-end">
                                <div class="main-action">
                                    <div class="form-search w-100">
                                        <div class="col-sm-4 no-padding text-right">
                                            <label>Tiêu chuẩn</label>
                                        </div>

                                        <div class="col-sm-1 no-padding">
                                            <input type="checkbox" ng-true-value="'Y'" ng-false-value="'N'" class="form-control" ng-model="nhap.TTCB">
                                        </div>
                                        <div class="col-sm-6 no-padding text-left">
                                            <label>Hàng năm</label>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12 align-self-end">
                                <div class="main-action">
                                    <div class="form-search w-100">
                                        <div class="col-sm-4 no-padding text-right">

                                        </div>

                                        <div class="col-sm-1 no-padding">
                                            <input type="checkbox" ng-true-value="'Y'" ng-false-value="'N'" class="form-control" ng-model="nhap.TCP">
                                        </div>
                                        <div class="col-sm-6 no-padding text-left">
                                            <label>Phạm</label>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <div class="main-action d-flex flex-wrap">
                        <button class="btn-action-m cl-3" ng-click="submittctm()">
                            <img src="~/App_Assets/images/d_save.svg" alt="" class="exsit">
                            <img src="~/App_Assets/images/icon_save.svg" alt="" class="hover_m">
                            <span>Tính toán</span>
                        </button>
                        <button class="btn-action-m cl-3" data-dismiss="modal">
                            <img src="~/App_Assets/images/d_close.svg" alt="" class="exsit">
                            <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                            <span>Đóng</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div id="modelThongBaoTCNT" class="modal fade " role="dialog">
        <div class="modal-dialog" style="width:800px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Thông báo</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <div class="modal-body" style="padding:0px;">
                    <div class="col-md-12" style="margin-bottom:15px; margin-top:10px;">
                        {{thongbao_tcnt}}
                    </div>

                </div>
                <div class="modal-footer">
                    <div class="main-action d-flex flex-wrap">
                        <button class="btn-action-m cl-3" data-dismiss="modal">
                            <img src="~/App_Assets/images/d_close.svg" alt="" class="exsit">
                            <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                            <span>Đóng</span>
                        </button>
                    </div>
                    @*<button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>*@
                </div>
            </div>
        </div>
    </div>
</div>


