
@{
    ViewBag.Title = "Đơn vị sử dụng";
}

<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục đơn vị sử dụng
    </h3>
</div>
<div ng-controller="DanhMucDonViSuDungController">
    <div class="container-fluid">
        <div class="row" style="margin-bottom:15px;margin-top:10px">
            <div class="col-12 col-sm-12 col-md-7 col-lg-7">
                <div class="main-action d-flex pull-left pt-3">
                    <button class="btn-action-m" ng-click="ThemKH()" ng-show="RoleBtnCreate">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        <span>Thêm mới</span>
                    </button>
                    <button class="btn-action-m" ng-click="HuyKH()" ng-show="RoleBtnCancel">
                        <i class="fa fa-ban" aria-hidden="true"></i>
                        <span>Hủy thay đổi</span>
                    </button>
                    <button class="btn-action-m" ng-click="LuuKH()" ng-show="RoleBtnSave">
                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                        <span> Lưu </span>
                    </button>
                    <button class="btn-action-m bg-red" ng-click="XoaKH()" ng-show="RoleBtnDelete">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                        <span> Xóa </span>
                    </button>
                </div>
            </div>
            <div class="col-12 col-sm-12 col-md-3 col-lg-5">
                <div class="form-inline pull-right pt-3">
                    <div class="form-group" style="margin-right:15px;">
                        <select ng-change="changeKhoCha()" select2 ng-model="modelSearchKH.DON_VI_CHA_ID" style="width:250px;" class="form-control">
                            <option value="">-- Chọn kho cha --</option>
                            <option value="{{item.ID}}" ng-repeat="item in listKho">{{item.TEN_DON_VI}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <input type="text" ng-change="changeKH()" ng-model-options="{ debounce: 800 }" placeholder="Tìm kiếm" ng-model="modelSearchKH.TEN_DON_VI">
                            <div class="input-group-prepend-right">
                                <button class="main-action btn-action-m" style="color:white" ng-click="TimKiemKH()" @*ng-show="RoleBtnSearch"*@>
                                    <i class="fa fa-search" aria-hidden="true"></i>
                                </button>
                            </div>
                            
                        </div>
                        </div>
                </div>
                </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12 no-padding">
                <div class="content-table">
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head" style="width:100%">
                            <tr>
                                <th style="width:5%;" class="center"><input type="checkbox" class="form-control" ng-click="toggleAllKH()" ng-model="isAllSelectedKH" /> </th>
                                <th style="width:3%; padding:5px;">STT</th>
                                <th style="width:10%; padding:5px;">Mã đơn vị</th>
                                <th style="width:12%; padding:5px;">Tên đơn vị</th>

                                <th style="width:12%; padding:5px;">Nhóm đơn vị</th>
                                <th style="width:10%; padding:5px;">Đơn vị cha</th>

                                <th style="width:15%; padding:5px;">Sử dụng đơn vị</th>
                                <th style="width:5%; padding:5px;">Hiệu lực</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in dsNhapKho track by $index" ng-click="loadTemplate($index)">
                                <td class="text-center">
                                    <input type="checkbox" ng-disabled="item.MNG_UNIT_ID != UnitId || item.IS_DON_VI_SU_DUNG != 'Y'" class="ace" ng-model="item.CHECKEDKH" ng-change="optionToggledKH() value=" 10"">
                                </td>
                                <td class="text-center">
                                    {{(modelSearch.currentPage - 1)*modelSearch.pageSize + $index + 1}}
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.PHIEN_HIEU}}</span>
                                    <input ng-if="item.EDIT" type="text" ng-pattern="/^([a-zA-Z0-9]+)$/" ng-change="changeEdit($index)" to-Uppercase class="form-control" ng-model="item.PHIEN_HIEU">
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_DON_VI}}</span>
                                    <input ng-if="item.EDIT" type="text" ng-change="changeEdit($index)" class="form-control" ng-model="item.TEN_DON_VI">
                                </td>

                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_NHOM_DV}}</span>
                                    <select class="form-control" ng-if="item.EDIT" ng-model="item.NHOM_DV_SU_DUNG" ng-change="changeEdit($index, item)" select2 name="NHOM_DON_VI_ID" ng-options="itemk.ID as itemk.TEN_NHOM_DV for itemk in ListNhomDonVi" style="width:100%;">
                                        <option value="">--Chọn nhóm đơn vị--</option>
                                    </select>
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_DON_VI_CHA}}</span>
                                    <select ng-if="item.EDIT" class="form-control" ng-change="changeEdit($index, item)" style="width:100%" ng-model="item.DON_VI_CHA_ID" select2 required ng-options="i.ID as i.TEN_DON_VI for i in listKho">
                                        <option value=""> -- Chọn kho cha --  </option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-change="changeEdit($index)" ng-true-value="'Y'" ng-false-value="'N'" ng-model="item.DV_KHONG_DUNG" value="10" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-disabled="item.MNG_UNIT_ID != UnitId || item.IS_DON_VI_SU_DUNG != 'Y'" ng-change="changeEdit($index)" ng-true-value="'Y'" ng-false-value="'N'" ng-model="item.HIEU_LUC" value="10" />
                                </td>

                            </tr>
                        </tbody>
                        <tfoot>
                            <tr ng-repeat="row in rows">
                                <td class="text-center">
                                    <input type="checkbox" id="check" ng-model="row.CHECKEDKH" />
                                </td>
                                <td class="text-center">@*{{(modelSearch.totalItems+1)+ $index}}*@</td>
                                <td class="text-left">

                                    <input type="text" to-Uppercase class="form-control" ng-pattern="/^([a-zA-Z0-9]+)$/" ng-model="row.PHIEN_HIEU">
                                </td>
                                <td class="text-left">

                                    <input type="text" class="form-control" ng-model="row.TEN_DON_VI">
                                </td>

                                <td class="text-left">

                                    <select class="form-control" ng-model="row.NHOM_DV_SU_DUNG" select2 name="NHOM_DON_VI_ID" ng-options="itemk.ID as itemk.TEN_NHOM_DV for itemk in ListNhomDonVi" style="width:100%;">
                                        <option value="">--Chọn nhóm đơn vị--</option>
                                    </select>
                                </td>
                                <td class="text-left">

                                    <select class="form-control" style="width:100%" ng-model="row.DON_VI_CHA_ID" select2 required ng-options="i.ID as i.TEN_DON_VI for i in listKho">
                                        <option value=""> -- Chọn kho cha --  </option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-true-value="'Y'" ng-false-value="'N'" ng-model="row.DV_KHONG_DUNG" value="10" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-true-value="'Y'" ng-false-value="'N'" ng-model="row.HIEU_LUC" value="10" />
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="pages-switch">
                        <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section scripts{
    <script src="~/app/Controller/DanhMucDonViSuDungController.js"></script>

}
