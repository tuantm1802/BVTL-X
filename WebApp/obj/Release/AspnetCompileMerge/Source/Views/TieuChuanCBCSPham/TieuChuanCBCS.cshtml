<div class="container-fluid d-flex cons-ac-system"  ng-controller="TieuChuanCBCSPhamController" style="margin-top: 0px; padding-left: 0px; padding-right: 0px;">
    <div class="action-system pd-two ui-widget-content" id="resizable">
        <button id="btn-changes-s-nav">
            <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
        </button>
        <div class="fill-box">
            <h3 class="title-fill">
                Nhóm tiêu chuẩn
            </h3>
        </div>
        <div class="container">
            <div class="main-action pt-3">
                <div class="form-search w-100" ng-show="RoleBtnView">
                    <input type="text" placeholder="Tìm kiếm" ng-change="ChangeNhomTieuChuan()" ng-model="NhomTieuChuanText">
                    <button>
                        <img src="~/App_Assets/images/search_icon.svg" ng-click="ChangeNhomTieuChuan()" alt="">
                    </button>
                </div>
            </div>
            <div class="function-box" style="height: calc(100vh - 350px);">
                <div class="accordion js-accordion">
                    <div class="ztreeRoleBackground left" style="width:100%;">
                        <ul id="treeRole" class="ztree"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content-system no-border pb-0" style="overflow:hidden" ng-show="ShowContent">
        <div class="nav-box less-pd" style="margin-top:0px; padding-bottom:0px;height: calc(100vh - 246px);">
            <div class="container-fluid">
                <div class="form-infor pt-3 pb-3">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <div class="row no-gutters">
                                <div class="col-12 col-md-2 col-lg-2 align-self-end">
                                    <div class="main-action d-flex align-items-center flex-wrap" style="margin-bottom: 10px;">
                                        <button class="btn-action-m ct-fix-lap" ng-click="AddNew()" ng-show="RoleBtnCreate" title="Thêm mới">
                                            <img src="~/App_Assets/images/icon_add.svg" alt="">
                                            Thêm mới
                                        </button>

                                        <button class="btn-action-delete ct-fix-lap" ng-click="delete()" ng-show="RoleBtnDelete"  title="Xoá">
                                            <img src="~/App_Assets/images/icon_del.svg" alt="">
                                            &nbsp;Xoá
                                        </button>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-5">
                                    <label for="">Lực lượng: </label>
                                    <input type="text" class="form-control" id="justAnotherInputBox" ng-change="ChangeLucLuong()" ng-model="Abc" placeholder="lực lượng" autocomplete="on" />
                                </div>


                                <div class="col-12 col-md-6 col-lg-3">
                                    <label for="">Ngày cập nhật: </label>
                                    <input type="text" class="form-control" disabled ng-model="dateUpdate">
                                </div>

                                <div class="col-12 col-md-6 col-lg-2">
                                    <label for="">Năm BH: </label>
                                    <select ng-model="NamBanHanh" class="form-control">
                                        <option value="{{item.Value}}" ng-repeat="item in ListYear">{{item.Name}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="content-table">
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center"><input type="checkbox" class="form-control inputcheckBox" ng-model="CheckAll" ng-change="ChangeCheckAll()" /> </th>
                                <th class="text-center">Lực lượng</th>
                                <th class="text-center">Loại trang phục</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-center">Niên hạn</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in ListData" ng-class="{activerow:$index==selectedRow, tccbcsParentcolor:item.IS_MO_RONG=='Y'}">
                                <td class="center"><input type="checkbox" class="form-control inputcheckBox" ng-model="item.SELECT" ng-change="CheckLLTrangPhuc()" /> </td>
                                <td class="text-left">{{item.LUC_LUONG_NAME}}</td>
                                <td class="text-left">{{item.SP_NAME}}</td>
                                <td class="text-right"><span ng-show="item.IS_MO_RONG=='Y'">{{item.SO_LUONG_TC}}</span> <input ng-show="item.IS_MO_RONG=='N'" min="0" class="form-control" ng-change="ChangeSoLuong()" ng-model="item.SO_LUONG_TC" type="number" step="0.01" /> </td>
                                <td class="text-right">{{item.NIEN_HAN}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="pages-switch">
                        <div class="main-action d-flex align-items-center flex-wrap" style="padding-top: 21px;">
                            <button class="btn-action-m ct-fix-lap" type="button" ng-show="RoleBtnRollback" ng-disabled="disabledRollbackData" ng-click="RollbackData()">
                                <img src="~/App_Assets/images/ic_cancel_light.svg" />
                                <span>Hủy thay đổi</span>
                            </button>
                            <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnSave" ng-disabled="disabledSaveChange" ng-click="SaveChange()">
                                <img src="~/App_Assets/images/ic_save_light.svg" />
                                <span>Lưu</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("~/Views/TieuChuanCBCSPham/_add.cshtml")
</div>
