<form id="formAddFile" enctype="multipart/form-data" name="formAddFile">
    <div class="modal-header">
        <h4 class="modal-title">Danh sách</h4>
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
    </div>
    <div class="modal-body">
        <div class="bootbox-body">
            <div class="space-6"></div>
            <div class="row pt-3 pb-3">
                @*<div class="col-md-3">
                    <label>Lực lượng</label>
                    <input type="text" id="luc-luong-index" class="form-control" ng-change="ChangeLucLuong()" ng-model="lucLuong" placeholder="Lực lượng" autocomplete="on" />
                </div>*@
                <div class="col-md-5">
                    @*<label>Nhóm C.B</label>*@ 
                    <input type="text" id="nhom-cap-bac-index" class="form-control" ng-change="ChangeNhomCapBac()" ng-model="nhomCapBac" placeholder="Nhóm cấp bậc" autocomplete="on" />
                </div>
                <div class="col-md-4">
                    @*<label>L.Hàm</label>*@
                    <select class="form-control" ng-model="LoaiHamId">
                        <option value="">Chọn loại hàm</option>
                        <option value="{{item.ID}}" ng-repeat="item in ListLoaiHam">{{item.LOAI_HAM}}</option>
                    </select>
                </div>
                <div class="col-md-3  main-action">
                    @*<label></label>*@
                    <button class="btn-action-m  bg-green" ng-click="SearchTieuChuan()">
                        <i class="fa fa-search" aria-hidden="true"></i> <span>Tìm kiếm</span>
                    </button> 
                </div>
            </div>
            <div class="space-6"></div>
            <div class="row">
                <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                    <thead>
                        <tr>
                            <th class="text-center"">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" ng-model="selectAll" ng-click="checkAll()" />
                                    <span class="lbl"></span>
                                </label>
                            </th>
                            <th class="text-center">TT</th>
                            @*<th class="center">Lực lượng</th>*@
                            <th class="text-center">Cấp bậc</th>
                            <th class="text-center">Loại hàm </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in dsDmCBacLHam">
                            <td class="text-center">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" ng-model="item.Selected" value="{{item.ID}}" />
                                    <span class="lbl"></span>
                                </label>
                            </td>
                            <td class="text-center">{{$index + 1}}</td>
                            @*<td>{{item.TEN_LUC_LUONG}}</td>*@
                            <td>{{item.TEN_CB}}</td>
                            <td>{{item.LOAI_HAM}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="row content-table pull-right">
                        <div class="pages-switch"> 
                            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                        </div> 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <h5 class="day-make"></h5>
        <div class="main-action d-flex flex-wrap">
            <button class="btn-action-m bg-green cl-3" ng-click="btnChoiceCapBacLoaiHam()">
                <i class="fa fa-check-square-o" aria-hidden="true"></i>   <span>Chọn</span>
            </button>

            <button class="btn-action-m bg-orange cl-3" data-dismiss="modal" ng-click="cancel()">
                <i class="fa fa-ban" aria-hidden="true"></i>  <span>Hủy</span>
            </button>
        </div> 
    </div>
</form>