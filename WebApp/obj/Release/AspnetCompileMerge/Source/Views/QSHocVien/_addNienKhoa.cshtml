<div class="modal fade" id="add_nien_khoa">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{nienKhoa.TitleModal}} niên khóa</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <div class="modal-body">
                <form class="row form-infor" id="form-nien-khoa">
                    <div class="col-12 col-md-12">
                        <label for="">Khóa học: <span class="text-danger">{{TEN_KHOA_HOC}}</span></label>                        
                    </div>
                    <div class="col-6 col-md-6">
                        <label for="">Từ năm: <span class="text-danger">*</span></label>
                        <input class="form-control" name="TU_NAM" ng-model="nienKhoa.TU_NAM" required />
                    </div>
                    <div class="col-6 col-md-6">
                        <label for="">Đến năm: <span class="text-danger">*</span></label>
                        <input class="form-control" name="DEN_NAM" ng-model="nienKhoa.DEN_NAM" required />
                    </div>

                    <div class="col-12 col-md-12">
                        <label for="">Mô tả: </label>
                        <textarea class="form-control" ng-model="nienKhoa.MO_TA" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-action-m bg-green" ng-click="LuuNienKhoa()">
                    <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                </button>
            </div>
        </div>
    </div>
</div>
