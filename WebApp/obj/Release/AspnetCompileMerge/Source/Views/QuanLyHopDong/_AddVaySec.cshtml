<div class="modal fade" id="modalAddVaySec">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Thông tin chi tiết</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <div class="modal-body">
                <div class="form-infor has-border p-3">
                    <h4 class="form-title">
                        Thông tin vay séc
                    </h4>
                    <form class="row no-gutters" name="addVaySecForm" ng-validate="validationVaySec">
                        <div class="col-12 col-md-6">
                            <label for="">Số tiền TT: <span>*</span></label>
                            <div>
                                <input type="text" currency-input name="SO_TIEN_THANH_TOAN" class="form-control"
                                       ng-model="modelVaySec.SO_TIEN_THANH_TOAN" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Mã phiếu: </label>
                            <div>
                                <input type="text" name="SO_PHIEU_H55" class="form-control"
                                       ng-model="modelVaySec.SO_PHIEU_H55" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Ngày vay: <span>*</span></label>
                            <div class="input-group date w-datepicker" data-date-format="dd/mm/yyyy">
                                <input type="text" class="form-control" name="NGAY_THANH_TOAN" horizontal="left" value=""
                                       ng-model="modelVaySec.NGAY_THANH_TOAN">
                                <span class="input-group-addon"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Người nhận: <span>*</span></label>
                            <input type="text" name="NGUOI_NHAN" class="form-control"
                                   ng-model="modelVaySec.NGUOI_NHAN" />
                        </div>
                        <div class="col-12">
                            <label for="">Ghi chú:</label>
                            <textarea rows="3" name="GHI_CHU" class="form-control" style="height:auto"
                                      ng-model="modelVaySec.GHI_CHU"></textarea>
                        </div>
                    </form>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between">

                <h5 class="day-make"> <i></i></h5>

                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="addVaySec()" ng-show="luuVaySec">
                        <img src="/App_Assets/images/icon_save.svg" alt="">
                        <span>Lưu</span>
                    </button>

                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
