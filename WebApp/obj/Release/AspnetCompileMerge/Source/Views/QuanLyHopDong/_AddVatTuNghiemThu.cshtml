<div class="modal fade" id="modalAddNTVatTu">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới nghiệm thu vật tư</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="form-infor has-border p-3">
                    <h4 class="form-title">
                        Thông tin nghiệm thu vật tư
                    </h4>

                    <form class="row no-gutters" name="ntvtform" ng-validate="validationNTVatTu">
                        <div class="col-12 col-md-4 mb-3" ng-class="modelNTVTAE.requiredSoNghiemThu ? 'app-error': ''">
                            <label for="">Số nghiệm thu: <span>*</span></label>
                            <input type="text" to-uppercase ng-model="modelNTVTAE.soNghiemThu" name="soNghiemThu" class="form-control" />
                            @*<span ng-show="modelNTVTAE.requiredSoNghiemThu" class="error">Số nghiệm thu không được để trống</span>*@
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Ngày nghiệm thu: <span>*</span></label>
                            <div class="input-group date w-datepicker" data-date-format="dd/mm/yyyy" ng-class="modelNTVTAE.requiredNgayNghiemThu ? 'app-error': ''">
                                <input type="text" class="form-control" ng-model="modelNTVTAE.ngayNghiemThu" name="ngayNghiemThu" horizontal="left" value="">
                                <span class="input-group-addon"></span>
                                @*<span ng-show="modelNTVTAE.requiredNgayNghiemThu" class="error">Ngày nghiệm thu không được để trống</span>*@
                            </div>
                        </div>
                        <div class="col-12 col-md-4" ng-class="modelNTVTAE.requiredNguoiNghiemThu ? 'app-error': ''">
                            <label for="">Người nghiệm thu: <span>*</span></label>
                            <input type="text" ng-model="modelNTVTAE.nguoiNghiemThu" name="nguoiNghiemThu" class="form-control" value="">
                            @*<span ng-show="modelNTVTAE.requiredNguoiNghiemThu" class="error">Người nghiệm thu không được để trống</span>*@
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Mô tả:</label>
                            <input type="text" ng-model="modelNTVTAE.moTa" name="moTa" class="form-control" value="">
                        </div>
                    </form>
                </div>

                <div class="main-action d-flex align-items-center justify-content-between flex-wrap pt-3">
                    <div class="d-flex align-items-center flex-wrap ct-w">
                        @*<button class="btn-action-m" ng-click="addSanPham()" ng-disabled="isDisableHD">
                            <img src="~/App_Assets/images/icon_add.svg" alt="">
                            <span>Thêm mới</span>
                        </button>*@

                        <button class="btn-action-m" ng-click="removeSanPham()" ng-disabled="isDisableHD">
                            <img src="~/App_Assets/images/icon_del.svg" alt="">
                            <span>Xoá</span>
                        </button>

                        <button class="btn-action-m" ng-click="addSPVatTuNghiemThuModal()" data-toggle="modal" data-target="#modalAddDSNTVatTu" ng-disabled="isDisableHD">
                            <img src="~/App_Assets/images/icon_fl.svg" alt="">
                            <span>Danh sách sản phẩm</span>
                        </button>
                    </div>

                </div>

                <div class="content-table">
                    <table class="table table-bordered table-hover">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center"><input type="checkbox" ng-model="isCheckAllSP" class="ace" ng-change="changeCheckAllSP()"></th>
                                <th class="text-center">STT</th>
                                <th class="text-center">Tên hàng</th>
                                <th class="text-center">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in listSanPhamAdd">
                                <td class="text-center">
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="item.checked" />
                                        <span class="lbl"></span>
                                    </label>
                                </td>
                                <td>{{$index + 1}}</td>
                                <td ng-class="item.tenHang.error ?'error':''">
                                    <div ng-switch="item.tenHang.edit">
                                        <div ng-switch-when="true">
                                            <select class="form-control" style="width:100%;" ng-change="changeSanPham(item)" ng-model="item.tenHang.value" ui-select2 ng-options="item.ID as item.TEN_SP for item in listVatTuPhu">
                                            </select>
                                        </div>
                                        <div ng-switch-default>
                                            {{item.tenHang.value}}
                                        </div>
                                        <div ng-show="item.tenHang.error">
                                            <label class="error">Bạn chưa chọn sản phẩm</label>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" currency-input ng-class="item.soLuongHD.error? 'error': ''" ng-model="item.soLuongHD.value" class="form-control" value="">
                                    <div ng-show="item.soLuongHD.error">
                                        <label class="error">Bạn chưa nhập số lượng hóa đơn</label>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">

                <h5 class="day-make">Ngày tạo: <i>@DateTime.Now.ToString("dd/MM/yyyy")</i></h5>

                <div class="main-action d-flex flex-wrap">
                    @*<button class="btn-action-m cl-3">
                        <img src="~/App_Assets/images/ic_print_light.svg" alt="">

                        <span>In quyết toán</span>
                    </button>*@

                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/icon_cancel.svg" alt="">
                        <span>Huỷ thay đổi</span>
                    </button>

                    <button class="btn-action-m cl-3" ng-click="addNTVatTu()" ng-disabled="isDisableHD" ng-show="luuNghiemThuVatTuPhu">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Lưu</span>
                    </button>

                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
