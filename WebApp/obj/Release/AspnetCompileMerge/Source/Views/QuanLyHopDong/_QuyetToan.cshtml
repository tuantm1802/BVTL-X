<div class="row">
    <div class="col-md-3 quyet-toan-btn--wrap">
        <div class="main-action d-flex flex-wrap">
            <button class="btn-action-m cl-3 quyet-toan-btn" style="margin:auto" ng-click="saveQuyetToan()" ng-disabled="isDisableHD" ng-show="quyetToan">
                <img src="~/App_Assets/images/ic_print_light.svg" alt="">
                &nbsp;&nbsp;
                <span>Quyết toán</span>
            </button>
        </div>
        <div class="main-action d-flex flex-wrap">
            <button class="btn-action-m cl-3 mt-3 huy-quyet-toan-btn" style="margin:auto" ng-if="!isDungCapPhat" ng-click="dungCapPhat()" ng-show="dungCapPhat">
                <span>Dừng cấp phát</span>
            </button>
            <button class="btn-action-m cl-3 mt-3 huy-quyet-toan-btn" style="margin:auto" ng-if="isDungCapPhat" ng-click="dungCapPhat()" ng-show="dungCapPhat">
                <span>Hủy dừng cấp phát</span>
            </button>
        </div>
    </div>
    <div class="content-system col-md-9" style="margin:0px;padding:0;">
        <div class="nav-tabs-box">
            <ul class="nav nav-tabs" id="quyetToanTab" role="tablist">
                <li class="nav-item" ng-click="getQuyetToanPhieuNhapKho()">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#quyettoanphieunhapkho" role="tab">Phiếu nhập kho</a>
                </li>

                <li class="nav-item" ng-click="getQuyetToanPhieuGiaoThang()">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#quyettoanphieugiaothang" role="tab">Phiếu giao thẳng</a>
                </li>

                <li class="nav-item" ng-click="getQuyetToanPhieuXuatThang()">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#quyettoanphieuxuatthang" role="tab">Phiếu xuất thẳng</a>
                </li>
                <li class="nav-item" ng-click="getQuyetToanVatTuChinhConLai()">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#quyettoanvattuchinhconlai" role="tab">Vật tư chính còn lại</a>
                </li>
            </ul>
        </div>
        <div class="tab-content hd-overflow-open">
            <div class="tab-pane active" id="quyettoanphieunhapkho">
                @Html.Partial("~/Views/QuanLyHopDong/_QTPhieuNhapKho.cshtml")
            </div>
            <div class="tab-pane" id="quyettoanphieugiaothang">
                @Html.Partial("~/Views/QuanLyHopDong/_QTPhieuGiaoThang.cshtml")
            </div>
            <div class="tab-pane" id="quyettoanphieuxuatthang">
                @Html.Partial("~/Views/QuanLyHopDong/_QTPhieuXuatThang.cshtml")
            </div>
            <div class="tab-pane" id="quyettoanvattuchinhconlai">
                @Html.Partial("_Kho_TonKho_VatTu")
            </div>
        </div>
    </div>

</div>
