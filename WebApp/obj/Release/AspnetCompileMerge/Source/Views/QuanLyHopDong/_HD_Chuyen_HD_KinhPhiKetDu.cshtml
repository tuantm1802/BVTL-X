<div class="col-sm-12">
    <div class="main-action d-flex align-items-center justify-content-between flex-wrap mb-2 mt-1 mr-3">
        <div class="d-flex align-items-center flex-wrap ct-w ml-3">
            <button class="btn-action-m" data-toggle="modal" data-target="#modalAddKinhPhiKetDu"
                    ng-click="kpKetDuOpenModal()" ng-disabled="!isDisableHD" ng-show="luuChuyenKinhPhiKetDu">
                <img src="~/App_Assets/images/icon_add.svg" alt="">
                <span>Thêm mới</span>
            </button>
            <button class="btn-action-m" ng-click="removePhieuKetDu()" ng-disabled="!isDisableHD" ng-show="xoaChuyenKinhPhiKetDu">
                <img src="~/App_Assets/images/icon_del.svg" alt="">
                <span>Xoá</span>
            </button>
        </div>

        <div class="d-flex align-items-center flex-wrap ml-3">
            <label>Còn lại:&nbsp;&nbsp;&nbsp; {{modelHopDongView.GT_CON_THANH_TOAN | currency:''}}</label>
        </div>
    </div>

    <div class="col-sm-12">
        <div class="row">
            <div class="col-12 col-sm-12 content-table none-padding">
                <div class="row ml-0 mr-0">
                    <div class="col-sm-12">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" ng-model="isCheckAllVatTuKhongQuaKhoView" class="ace" ng-change="changeCheckAllVatTuKhongQuaKhoView()" />
                                            <span class="lbl"></span>
                                        </label>
                                    </th>
                                    <th class="center">STT</th>
                                    <th class="center">Số hợp đồng chuyển đến </th>
                                    <th class="center">Số tiền</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in kpKetDuList">
                                    <td class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.CHECKED" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.SO_HD_DEN}}</td>
                                    <td>{{item.SO_TIEN_THANH_TOAN | currency:""}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_HD_Chuyen_HD_KinhPhiKetDu_Add")