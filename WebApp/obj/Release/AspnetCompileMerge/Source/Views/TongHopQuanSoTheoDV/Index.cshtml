

@model dynamic


<div ng-controller="TongHopQuanSoTheoDVController">
    <div class="container-fluid d-flex flex-wrap">
        <div class="titlezone" style="border-bottom: 1px solid #f5f5f5;margin-top:25px;width:100%;">
            <h5 style="font-weight:bold">@(((string)ViewBag.Title).ToUpper())</h5>
            <input type="hidden" ng-init="modelSearch.type='@(Model.type)'" ng-model="modelSearch.type" />
        </div>
        <div class="row" style="width:100%">
            <div class="well form-infor" style="background-color: #f5f5f5;padding:25px;margin:25px 0;width:100%">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-12">
                        <div class="form-group" style="float:left;margin-right:15px">
                            <label>Đơn vị: </label>
                            <select id="slDonVi" select2="select2Options" ng-model="modelSearch.donvi" name="ID_DONVI" style="width: 300px;margin-right:15px" class="form-control"></select>
                            <input type="hidden" id="txtdonvi" value="@Model.donvi">
                        </div>
                        <div class="form-group" style="float:left;margin-right:15px">
                            <label>Số công văn: </label>
                            <input type="text" id="txtsocongvan" value="@Model.socongvan" style="width: 150px;margin-right:15px" class="form-control" ng-model="modelSearch.socongvan">
                        </div>
                        <div class="form-group" style="float:left;margin-right:15px">
                            <label>Ngày tạo báo cáo: </label>
                            <div class="input-group date" data-date-format="dd/mm/yyyy">
                                <input type="text" id="txtngaybaocao" customzdatetime value="@(((DateTime)Model.ngaybaocao).ToString("dd/MM/yyyy"))" style="width: 150px;" class="form-control" ng-model="modelSearch.ngaybaocao">
                                <span class="input-group-addon"></span>
                            </div>
                        </div>
                        <div class="form-group main-action d-flex pull-left pt-3" style="float:left">
                            <button class="btn-action-m" style="margin-top:12px" ng-click="XemBC()">
                                <i class="fa fa-yelp" aria-hidden="true"></i>
                                <span>Xem báo cáo</span>
                            </button>
                        </div>
                        
                    </div>
                    <div class="col-xs-12 col-sm-2">
                        
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-6">
                        
                    </div>
                </div>
            </div>
        </div>

        <div id="containerReportViewer" class="col-12 col-sm-12 col-md-12 col-lg-12" style=" height: calc(100vh - 195px) !important; overflow-y:auto !important; text-align:center">

            
        </div>


    </div>
</div>

@section scripts{

    <script src="~/app/Controller/Report/TongHopQuanSoTheoDV.js"></script>
}

