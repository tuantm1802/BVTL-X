<div class="modal-header">
    <h4 class="modal-title">Thông tin chi tiết</h4>
    <button type="button" class="close"  ng-click="cancel()">
        <img src="~/App_Assets/images/close.svg" alt="">
    </button>
</div>
<div class="modal-body">
    <form class="row" id="form-update">
        <div class="col-6 col-md-6">
            <label for="">Số hiệu CAND </label>
            <input class=" form-control" type="text" ng-model="model.SO_HIEU" name="SO_HIEU" />
        </div>
        <div class="col-6 col-md-6">
            <label for="">Giới tính </label>
            <select class=" form-control" ng-model="model.GIOI_TINH">
                <option value="M">Nam</option>
                <option value="F">Nữ</option>
            </select>
        </div>
        <div class="col-6 col-md-6">
            <label for="">Cấp bậc </label>
            <select class="form-control" ng-model="model.CAP_BAC_ID">
                <option ng-repeat="item in ListCapBac" value="{{item.Id}}">{{item.Name}}</option>
            </select>
        </div>
        <div class="col-6 col-md-6">
            <label for="">Loại hàm </label>
            <select class="form-control" ng-model="model.LOAI_HAM_ID">
                <option ng-repeat="item in ListLoaiHam" value="{{item.Id}}">{{item.Name}}</option>
            </select>
        </div>
        <div class="col-6 col-md-6">
            <label for="">Chức vụ </label>
            <input class=" form-control" type="text" ng-model="model.CHUC_VU" name="CHUC_VU" />
        </div>
        <div class="col-6 col-md-6">
            <label for="">Vị trí công tác </label>
            <input class=" form-control" type="text" ng-model="model.VI_TRI_CONG_TAC" name="VI_TRI_CONG_TAC" />
        </div>
        <div class="col-6 col-md-6">
            <label for="">Lực lượng </label>
            <select class="form-control" ng-model="model.LUC_LUONG_ID">
                <option ng-repeat="item in ListLucLuong" value="{{item.Id}}">{{item.Name}}</option>
            </select>
        </div>
        <div class="col-6 col-md-6">
            <label for="">Cỡ giày </label>
            <input class=" form-control" type="number" ng-model="model.CO_GIAY" name="CO_GIAY" />
        </div>
        <div class="col-6 col-md-6">
            <label for="">Cỡ mũ </label>
            <input class=" form-control" type="number" ng-model="model.CO_MU" name="CO_MU" />
        </div>
        <div class="col-6 col-md-6">
            <label for="">Cỡ QA </label>
            <input class=" form-control" type="number" ng-model="model.CO_QA" name="CO_QA" />
        </div>
    </form>
</div>
<div class="modal-footer main-action">
    <button class="btn-action-m bg-green" ng-click="CapNhat()">
        <i class="fa fa-check-square-o" aria-hidden="true"></i> <span>Cập nhật</span>
    </button>
    <button class="btn-action-m bg-green" ng-click="cancel()">
        <i class="fa fa-ban" aria-hidden="true"></i>  <span>Hủy</span>
    </button>
</div>