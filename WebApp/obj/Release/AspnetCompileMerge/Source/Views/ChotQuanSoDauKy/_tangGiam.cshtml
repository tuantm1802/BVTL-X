
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                <div class="row no-gutters">
                    <div class="col-12 col-md-6 col-lg-2">
                        @*<label for="">Lực lượng: </label>*@
                        <select class="form-control" ng-model="DauKy_TrongKy">
                            <option value="DK" selected>Đầu kỳ</option>
                            <option value="TK" selected>Trong kỳ</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Lực lượng: </label>*@
                        <input type="text" ng-model="lucLuong" ng-change="ChangeLucLuong()" placeholder="Lực lượng" autocomplete="on"
                               ui-combo-tree combo-tree-init="LucLuongTreeInit" on-callback="LucLuongCallback(data)" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Nhóm cấp bậc: </label>*@
                        <input type="text" ng-model="nhomCapBac" ng-change="ChangeNhomCapBac()" placeholder="Nhóm cấp bậc" autocomplete="on"
                               ui-combo-tree combo-tree-init="NhomCBTreeInit" on-callback="NhomCBCallback(data)" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Cấp bậc: </label>*@
                        <select class="form-control" ng-model="capBac" ng-options="item.Id as item.Name for item in ListCapBacs">
                            <option value="" selected>Chọn cấp bậc</option>
                        </select>
                    </div>
                    <div class="main-action">
                        @*<label for=""> </label>*@
                        <div class="form-search w-100" style="height: 28px; ">
                            <button ng-click="LoadDataCBTangGiam()" style="border-radius: 5px;">
                                <img src="../App_Assets/images/search_icon.svg" alt="">
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-table">
    @*<tree-gridqs show-checkbox="tg_tree_Table_Checkbox"
        expand-level="3"
        body-defs="tg_body_defs"
        tree-data="tg_tree_data"
        expand-on="tg_expanding_property"
        col-defs="tg_col_defs"
        icon-leaf="tg_treetable_docu"
        icon-expand="treetable_close"
        icon-collapse="treetable_open"
        event-change-checkbox="tg_ChangeTreeTableCheckbox(item)"
        event-choose-row="tg_ClickTreeTableRow(item)"></tree-gridqs>*@

    <table class="table-responsive table-hover result-point">
        <thead class="point-table-head">
            <tr>
                <th rowspan="2" class="text-center">Cấp bậc </th>
                <th rowspan="2" class="text-center">Loại hàm</th>
                <th colspan="2" class="text-center">Quân số chuyển đến</th>
                <th colspan="2" class="text-center">Quân số chuyển đi</th>
                <th rowspan="2" class="text-center">Tổng cộng</th>
            </tr>
            <tr>
                <th class="text-center">Nam </th>
                <th class="text-center">Nữ </th>
                <th class="text-center">Nam </th>
                <th class="text-center">Nữ </th>
            </tr>
        </thead>
        <tbody style="background-color:white">
            <tr ng-repeat="item in tg_tree_data">
                <td class="text-center">{{item.TEN_CB_MOI}} </td>
                <td class="text-center">{{item.LOAI_HAM_MOI}} </td>
                <td class="text-center">{{item.SL_NAM_MOI}} </td>
                <td class="text-center">{{item.SL_NU_MOI}} </td>
                <td class="text-center">{{item.SL_NAM_CU}} </td>
                <td class="text-center">{{item.SL_NU_CU}} </td>
                <td class="text-center">{{item.SL_TONG}} </td>
            </tr>
        </tbody>
    </table>
</div>