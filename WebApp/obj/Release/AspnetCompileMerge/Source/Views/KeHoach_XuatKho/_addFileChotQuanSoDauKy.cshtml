<form id="formAddFile" enctype="multipart/form-data" name="formAddFile">
    <div class="modal-header">
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
        <h4 class="modal-title">Tệp quân số</h4>
    </div>
    <div class="modal-body">
        <div class="bootbox-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <input type="file" ui-chose-file class="custom-file-input" id="file-input" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" ng-click="Upload()">Tải lên</button>
        <button type="button" class="btn btn-default" ng-click="cancel()">Đóng</button>
    </div>
</form>