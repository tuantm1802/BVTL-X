@{
    ViewBag.Title = "Index";
}
<style>

    .row {
        margin-left: 0px;
        margin-right: 0px;
    }

    .form-control {
        padding: 0px 0px;
    }

    .table-responsive {
        display: table
    }

    .modal .btn-container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #resizable {
        height: 87vh
    }
</style>


<div class="container-fluid d-flex cons-ac-system" style=" margin-top: 0px " ng-controller="BienBanKiemKeController">
    @Html.Partial("~/Views/BienBanKiemKe/HangDoiBienBanKiemKe.cshtml")
    <div class="content-system no-border pb-0">
        <div style="font-size: 20pt;font-weight: bold;color: #00933f; text-align:center; align-content:center;justify-content:center">BIÊN BẢN KIỂM KÊ</div>
        <div class="main-action d-flex align-items-center justify-content-between flex-wrap">

            <div class="d-flex align-items-center flex-wrap">
                <button class="btn-action-m" ng-click="ThemPhieu()">
                    <img src="~/App_Assets/images/icon_add.svg" alt="">
                    <span>Thêm mới</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_edit.svg" alt="">
                    <span>Sửa</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                    <span>Xoá</span>
                </button>

                <button class="btn-action-m" ng-click="LuuPhieu()">
                    <img src="~/App_Assets/images/icon_save.svg" alt="">
                    <span>Lưu</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_cancel.svg" alt="">
                    <span>Huỷ thay đổi</span>
                </button>
                <button class="btn-action-m" data-toggle="modal" data-target="#kho_anh">
                    <img src="~/App_Assets/images/icon_cancel.svg" alt="">
                    <span>Đính kèm</span>
                </button>
            </div>

            <button class="btn-action-m">
                <img src="~/App_Assets/images/l7_hover.svg" alt="">
                <span>In phiếu xuất</span>
            </button>
        </div>
        <div class="form-infor has-border p-3">
            <h4 class="form-title">
                Thông tin phiếu
            </h4>
            <div class="row no-gutters">
                <div class="col-12 col-md-4">
                    <label for="">Số phiếu: <span>*</span></label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.SO_PHIEU" />
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Kho kiểm kê: <span>*</span></label>
                    <select class="form-control" ng-model="thongTinKho.KHO" ng-options="option.NAME for option in danhmuckho">
                        <option value="">- - - Chọn kho - - -</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Ngày kiểm kê: <span>*</span></label>
                    <div id="dateFrom_2" class="input-group date" data-date-format="dd/mm/yyyy">
                        <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_KIEM_KE_VW">
                        <span class="input-group-addon"></span>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Kế hoạch số: <span>*</span></label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.SO_KE_HOACH" />
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Trạng thái: </label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.TRANG_THAI" />
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Người viết phiếu: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_VIET_PHIEU_VW" ng-options="option.HoTen for option in canbo">
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Đính kèm: </label>
                    <form method="post" enctype="multipart/form-data" id="frmUpload">
                        <input type="file" name="file" id="file" accept="image/jpeg" style="width: 100%;" onchange="angular.element(this).scope().ImageUpload(event)" multiple />
                    </form>
                </div>
            </div>
        </div>
        <div class="content-table mt-2">
            <table class="table-responsive table-hover result-point" style="overflow-y:scroll">
                <thead class="point-table-head">
                    <tr>
                        <th class="e-cursor-pointer" style="width:3%">
                            <button type="button" class="btn btn-primary" ng-click="ThemCanBo()" id="btnThemCanBo">
                                <i class="glyphicon glyphicon-plus-sign"></i>
                            </button>
                        </th>
                        <th>STT </th>
                        <th style="width:50%" class="text-center" @*style="width:12%;"*@>Họ tên<i id="or_ntn"></i></th>
                        <th class="text-center" style="width:22%">Chức vụ<i id="or_dv"></i></th>
                        <th class="text-center" style="width:22%">Vị trí<i id="or_nn"></i></th>
                    </tr>
                </thead>
                <tbody style="background-color:white">
                    <tr ng-repeat="item in dsCanBo">
                        <td class="text-center list-receipt" style="color:red">
                            <button ng-click="XoaCanBo($index)" style="vertical-align: -webkit-baseline-middle;" id="btnXoaCanBo">
                                <i class="glyphicon glyphicon-minus-sign"></i>
                            </button>
                        </td>
                        <td class="text-center">
                            <label class="form-control">{{item.STT}}</label>
                        </td>
                        <td class="text-center">
                            <select class="form-control" ng-model="item.CAN_BO" ng-options="option.HoTen for option in canbo" ng-change="ChonCanBo($index)"></select>
                        </td>
                        <td class="text-center">
                            <input class="form-control" ng-model="item.CV_TV" disabled />
                        </td>
                        <td class="text-center">
                            <input class="form-control" ng-model="item.CB_TV" disabled />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- /.card-header -->
        <div class="content-table mt-2">
            <table class="table-responsive table-hover result-point" style="overflow-y:scroll">
                <thead class="point-table-head">
                    <tr>
                        <th class="e-cursor-pointer" style="width:3%">
                            <button type="button" class="btn btn-primary" ng-click="ThemHangHoa()" id="btnThemHangHoa">
                                <i class="glyphicon glyphicon-plus-sign"></i>
                            </button>
                        </th>
                        <th style="width:3%;">STT </th>
                        <th class="text-center" @*style="width:12%;"*@>Hàng hóa<i id="or_ntn"></i></th>
                        <th class="text-center" style="width:11%;">Đơn vị tính<i id="or_dv"></i></th>
                        <th class="text-center" style="width:5%;">SL kế hoạch<i id="or_nn"></i></th>
                        <th class="text-center" style="width:5%;">SL thực tế<i id="or_nn"></i></th>
                        <th class="text-center" style="width:5%;">SL chênh lệch<i id="or_nn"></i></th>
                        <th class="text-center" style="width:10%;">Đơn giá<i id="or_ng"></i></th>
                        <th class="text-center" style="width:10%;">Thành tiền<i id="or_ng"></i></th>
                        <th class="text-center" style="width:10%;">Thành tiền thực tế<i id="or_ng"></i></th>
                        <th class="text-center" style="width:10%;">Thành tiền chênh lệch<i id="or_ng"></i></th>
                        <th class="text-center" style="width:10%;">Phân loại<i id="or_ng"></i></th>
                    </tr>
                </thead>
                <tbody style="background-color:white">
                    <tr ng-repeat="item in dsHangHoa">
                        <td class="text-center list-receipt" style="color:red">
                            <button ng-click="XoaHangHoa($index)" style="vertical-align: -webkit-baseline-middle;" id="btnXoaHangHoa">
                                <i class="glyphicon glyphicon-minus-sign"></i>
                            </button>
                        </td>
                        <td class="text-center">
                            <label class="form-control">{{item.STT}}</label>
                        </td>
                        <td>
                            <select class="form-control" ng-model="item.HANG_HOA" ng-options="option.MaHang+' - '+option.TenHang for option in hanghoa"></select>
                        </td>
                        <td>
                            <select class="form-control" ng-model="item.DVT_VW" ng-options="option.NAME for option in donvitinh"></select>
                        </td>
                        <td><input type="number" class="form-control" ng-model="item.SO_LUONG_KH" ng-change="ValueCount(item,$index)"></td>
                        <td><input type="number" class="form-control" ng-model="item.SO_LUONG_TT" ng-change="ValueCount(item,$index)"></td>
                        <td><input type="number" class="form-control" ng-model="item.SO_LUONG_LECH" ng-change="ValueCount(item,$index)"></td>
                        <td><input type="text" step="10000" class="form-control" ng-model="item.DON_GIA" ng-change="ValueCount(item,$index)" currency-input></td>
                        <td><input type="text" class="form-control" ng-model="item.THANH_TIEN_KH" currency-input disabled></td>
                        <td><input type="text" class="form-control" ng-model="item.THANH_TIEN_TT" currency-input disabled></td>
                        <td><input type="text" class="form-control" ng-model="item.THANH_TIEN_LECH" currency-input disabled></td>
                        <td><input type="text" class="form-control" ng-model="item.PHAN_LOAI_TAI_SAN"></td>
                    </tr>
                </tbody>
            </table>
            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
        </div>
    </div>
    @Html.Partial("~/Views/NhapKho/_ModalKhoAnh.cshtml")
</div>

@section scripts{
    <script src="~/app/Controller/Kho/BienBanKiemKeController.js"></script>
    <script>
        $("#menu-toggle").click(function (e) {
            e.preventDefault();
            $("#wrapper").toggleClass("active");
        });
        function UpAnh() {
            var fileSelectEle = document.getElementById('file');
            if (fileSelectEle.value.length > 0) {
                var fileInput = $('#file');
                var file = fileInput.get(0).files[0];
                var reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = function () {
                    console.log(reader.result);
                    document.getElementById("img").setAttribute(
                        'src', reader.result
                    );
                };
                reader.onerror = function (error) {
                    console.log('Error: ', error);
                };
            }
        }
    </script>
}
