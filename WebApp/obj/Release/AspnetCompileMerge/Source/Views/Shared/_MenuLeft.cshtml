@{
    var menuLevel1 = new List<Model.ModelExtend.MenuModel>();
    var menuLevel2 = new List<Model.ModelExtend.MenuModel>();
    var menuLevel3 = new List<Model.ModelExtend.MenuModel>();
    var menus = Session["Menus"] as List<Model.ModelExtend.MenuModel>;
    var userSession = (Simple.Base.UserLogin)HttpContext.Current.Session["USER_SESSION"];
    if (menus != null && menus.Count > 0)
    {
        menuLevel1 = menus.Where(x => x.PARENT_ID == null || x.PARENT_ID == 0).OrderBy(x => x.ORDER_LEVEL).ToList();

        if (menuLevel1 != null && menuLevel1.Count > 0)
        {
            for (int i = 0; i < menuLevel1.Count; i++)
            {
                var listChild = menus.Where(x => x.PARENT_ID == menuLevel1[i].PAGE_ID).ToList();
                menuLevel1[i].CountChild = listChild != null ? listChild.Count : 0;
            }
            var menuLevel1IDs = menuLevel1.Select(x => x.PAGE_ID).ToList();
            menuLevel2 = menus.Where(x => menuLevel1IDs.Contains((int)x.PARENT_ID)).OrderBy(x => x.ORDER_LEVEL).ToList();
            if (menuLevel2 != null && menuLevel2.Count > 0)
            {
                for (int i = 0; i < menuLevel2.Count; i++)
                {
                    var listChild2 = menus.Where(x => x.PARENT_ID == menuLevel2[i].PAGE_ID).ToList();
                    menuLevel2[i].CountChild = listChild2 != null ? listChild2.Count : 0;
                }
                var menuLevel2IDs = menuLevel2.Select(x => x.PAGE_ID).ToList();
                menuLevel3 = menus.Where(x => menuLevel2IDs.Contains((int)x.PARENT_ID)).OrderBy(x => x.ORDER_LEVEL).ToList();
                if (menuLevel3 != null && menuLevel3.Count > 0)
                {
                    for (int i = 0; i < menuLevel3.Count; i++)
                    {
                        var listChild3 = menus.Where(x => x.PARENT_ID == menuLevel3[i].PAGE_ID).ToList();
                        menuLevel3[i].CountChild = listChild3 != null ? listChild3.Count : 0;
                    }
                }
            }
        }
    }
}
<div id="sidebar" class="sidebar h-sidebar navbar-collapse collapse ace-save-state">
    <script type="text/javascript">
        try { ace.settings.loadState('sidebar') } catch (e) { }
    </script>

    <div class="sidebar-shortcuts" id="sidebar-shortcuts">
        <div class="sidebar-shortcuts-large" id="sidebar-shortcuts-large">
            <button class="btn btn-success">
                <i class="ace-icon fa fa-signal"></i>
            </button>

            <button class="btn btn-info">
                <i class="ace-icon fa fa-pencil"></i>
            </button>

            <button class="btn btn-warning">
                <i class="ace-icon fa fa-users"></i>
            </button>

            <button class="btn btn-danger">
                <i class="ace-icon fa fa-cogs"></i>
            </button>
        </div>

    </div><!-- /.sidebar-shortcuts -->
    @if (menuLevel1 != null && menuLevel1.Count > 0)
    {
        // lấy id menu đang active
        string url = HttpContext.Current.Request.Url.AbsoluteUri;
        var meuActive = menus.FirstOrDefault(x => x.PARENT_ID >0 && url.Contains(x.HREF_URL));

        var idActive = menuLevel1.FirstOrDefault().PAGE_ID;
        if (meuActive != null)
        {
            idActive = (int)meuActive.PARENT_ID;
        }
        <ul class="nav nav-list">
            @foreach (var itemM1 in menuLevel1)
            {

                <li class="@(idActive == itemM1.PAGE_ID ? "active" :"") open hover">
                    @if (itemM1.CountChild > 0)
                    {
                        var menuChikd2 = menuLevel2.Where(x => x.PARENT_ID == itemM1.PAGE_ID).ToList();
                        <a href="@menuChikd2.FirstOrDefault().HREF_URL" class="dropdown-toggle">
                            <i class="menu-icon fa @(!string.IsNullOrEmpty(itemM1.CSS_CLASS) ? itemM1.CSS_CLASS : "fa-desktop")"></i>
                            <span class="menu-text">
                                @itemM1.PAGE_NAME
                            </span>
                            <b class="arrow fa fa-angle-down"></b>
                        </a>
                        <b class="arrow"></b>
                        <ul class="submenu">
                            @foreach (var itemM2 in menuChikd2)
                            {
                                <li class="hover @(itemM2.IS_UNDERLINED == 0 ? "" : "underlined-li-menu")">
                                    @if (itemM2.CountChild > 0)
                                    {
                                        var menuChikd3 = menuLevel3.Where(x => x.PARENT_ID == itemM2.PAGE_ID).ToList();
                                        <a href="@menuChikd3.FirstOrDefault().HREF_URL" class="dropdown-toggle">
                                            <i class="menu-icon fa @(!string.IsNullOrEmpty(itemM2.CSS_CLASS) ? itemM1.CSS_CLASS : "fa-desktop")"></i>
                                            <span class="menu-text">
                                                @itemM2.PAGE_NAME
                                            </span>
                                            <b class="arrow fa fa-angle-down"></b>
                                        </a>
                                        <b class="arrow"></b>
                                        <ul class="submenu">
                                            @foreach (var itemM3 in menuChikd3)
                                            {
                                                <li class="hover">
                                                    <a href="@itemM3.HREF_URL">
                                                        <i class="menu-icon fa fa-caret-right"></i>
                                                        @itemM3.PAGE_NAME
                                                    </a>
                                                    <b class="arrow"></b>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        if (itemM2.HREF_URL == "TCTNT")
                                        {
                                            <a data-toggle="modal" data-target="#modelTieuChuanTheoNam">
                                                <i class="menu-icon fa fa-caret-right"></i>
                                                Tiêu chuẩn theo năm trước
                                            </a>

                                            <b class="arrow"></b>
                                        }
                                        else
                                        {
                                            <a href="@itemM2.HREF_URL">
                                                <i class="menu-icon fa @(!string.IsNullOrEmpty(itemM1.CSS_CLASS) ? itemM1.CSS_CLASS : "fa-caret-right")"></i>
                                                @itemM2.PAGE_NAME
                                            </a>
                                            <b class="arrow"></b>
                                        }
                                    }
                                </li>
                            }
                        </ul>

                    }
                    else
                    {
                        <a href="@itemM1.HREF_URL" class="dropdown-toggle">
                            <i class="menu-icon fa @(!string.IsNullOrEmpty(itemM1.CSS_CLASS) ? itemM1.CSS_CLASS : "fa-desktop")"></i>
                            <span class="menu-text">
                                @itemM1.PAGE_NAME
                            </span>
                            <b class="arrow fa fa-angle-down"></b>
                        </a>
                        <b class="arrow"></b>
                    }

                </li>

            }
        </ul>
    }
