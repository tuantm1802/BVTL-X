<div class="modal fade" id="chi_tiet_hang">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới hợp đồng</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body row no-gutters" @*style="height:50vh"*@>
                <div class="content-table has-border">
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center" style="width:3%;"><input type="checkbox" /> </th>
                                <th class="text-center" style="width:3%;">STT </th>
                                <th style="width:4%;" class="text-center">Mã hàng<i id="or_ntn"></i></th>
                                <th class="text-center">Tên hàng<i id="or_ntn"></i></th>
                                <th class="text-center">Kho nhập<i id="or_ntn"></i></th>
                                <th class="text-center">Hợp đồng<i id="or_ntn"></i></th>
                                <th class="text-center">Chất lượng<i id="or_ntn"></i></th>
                                <th class="text-center">Số khung<i id="or_ntn"></i></th>
                                <th class="text-center">Số máy<i id="or_ntn"></i></th>
                                <th class="text-center">Model<i id="or_ntn"></i></th>
                                <th class="text-center">Năm SX<i id="or_ntn"></i></th>
                                <th class="text-center">Nhóm hàng<i id="or_ntn"></i></th>
                                <th class="text-center">Loại hàng<i id="or_ntn"></i></th>
                            </tr>
                        </thead>
                        <tbody style="background-color:white">
                            <tr ng-repeat="item in ">
                                <td class="text-center"><input type="checkbox" ng-model="item.Selected" /></td>
                                <td class="text-center"><label class="form-control">{{item.ID}}</label></td>
                                <td><label class="form-control">{{item.MaHang}}</label></td>
                                <td><label class="form-control">{{item.TenHang}}</label></td>
                                <td><select class="form-control" ng-model="item.KHO" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.HOP_DONG" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.CHAT_LUONG" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.SO_KHUNG" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.SO_MAY" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.MODEL" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.NAM_SAN_XUAT" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.NHOM_HANG" ng-options="option.NAME for option in donvitinh"></select></td>
                                <td><select class="form-control" ng-model="item.LOAI_HANG" ng-options="option.NAME for option in donvitinh"></select></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" ng-click="LuuDsHangHoa()">
                    <img src="~/App_Assets/images/icon_save.svg" alt="">
                    <span>Lưu thông tin</span>
                </button>
            </div>


        </div>
    </div>
</div>