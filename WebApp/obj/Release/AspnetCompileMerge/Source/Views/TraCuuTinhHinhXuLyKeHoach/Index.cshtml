                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in DanhSachChungTu">
                                    <td class="text-center">
                                        {{$index + 1}}
                                    </td>
                                    <td class="text-left">
                                        {{item.SO_CHUNG_TU}}
                                    </td>
                                    <td class="text-left">
                                        {{item.TEN_KHO}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGAY_VIET_PHIEU}}
                                    </td>
                                    <td class="text-left">
                                        {{item.TEN_NGUOI_VIET_PHIEU}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGAY_XK}}
                                    </td>
                                    @*<td class="text-left">
                                        {{item.CAN_BO_XUAT_KHO}}
                                    </td>*@
                                    <td class="text-left">
                                        {{item.NGUOI_NHAN}}
                                    </td>
                                    <td class="text-left">
                                        {{item.CAN_BO_VAN_CHUYEN}}
                                    </td>
                                    <td class="text-center">
