                                        {{item.LOAI_PHIEU == 'X' ? 'Phiếu xuất ĐC' : 'Phiếu nhập ĐC'}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGAY_VIET_PHIEU}}
                                    </td>
