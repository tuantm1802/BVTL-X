
@{
    ViewBag.Title = "Tra cứu tình hình xử lý kế hoạch";
}
<style>
    .disable-click {
        pointer-events: none;
    }
    .item-kh:hover{
        cursor: pointer;
    }
    .active-tr {
        background-color: #4CAF50 !important;
        color: #ffffff;
    }
</style>
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a> / Tra cứu tình hình xử lý kế hoạch
    </h3>
</div>
<div class="content-system no-border" style="margin-left: 0px; padding: 15px;" ng-controller="TraCuuTinhHinhXLKHController">
    <div class="form-infor has-border p-3 firts-to-h" style="padding-bottom: 5px !important;">
        <div class="row no-gutters">
            <div class="row">
                <div class="col-md-5">
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">Số KH</label>
                            <input type="text" class="form-control" placeholder="" ng-model="searchModel.SoKH">
                        </div>
                        <div class="col-md-12">
                            <label for="">Loại KH</label>
                            <select name="" id="" class="form-control" ng-model="searchModel.LoaiKH">
                                <option value="">Tất cả</option>
                                <option value="N">KH nhập kho</option>
                                <option value="X">KH xuất kho</option>
                                <option value="GT">KH giao thẳng</option>
                                <option value="DC">KH điều chuyển</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>Từ ngày</label>
                            <div class="input-group date" data-date-format="dd/mm/yyyy">
                                <input type="text" customzdatetime class="form-control" ng-model="searchModel.TuNgay">
                                <span class="input-group-addon"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label for="">Đến ngày</label>
                            <div class="input-group date" data-date-format="dd/mm/yyyy">
                                <input type="text" customzdatetime class="form-control" ng-model="searchModel.DenNgay">
                                <span class="input-group-addon"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label for="">Trạng thái</label>
                            <select name="" id="" class="form-control" ng-model="searchModel.TrangThai">
                                <option value="">Tất cả</option>
                                <option value="CD">Chưa duyệt</option>
                                <option value="A">Đã duyệt</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn-action-m bg-green form-control" style="color:white" ng-click="TimKiemKeHoach()">
                                <i class="fa fa-search" aria-hidden="true"></i> <span>Tìm kiếm</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="content-table">
                        <table class="table-responsive result-point">
                            <thead class="point-table-head">
                                <tr class="bd-normal">
                                    <th class="text-center ht3-number-cand" style="width: 30%;">
                                        Số kế hoạch
                                    </th>
                                    <th class="text-center ht3-genral" style="width: 15%;">
                                        Ngày lập KH
                                    </th>
                                    <th class="text-center ht3-rank">
                                        Người lập KH
                                    </th>
                                    <th class="text-center ht3-position" style="width: 20%;">
                                        Căn cứ
                                    </th>
                                    <th class="text-center ht3-size">
                                        Loại KH
                                    </th>
                                    <th class="text-center ht3-size">
                                        Trạng thái
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="item-kh">
                                <tr ng-repeat="item in DanhSachKeHoach" ng-click="ChonKeHoach(item, $index)" ng-class="{'active-tr': selectedItem == $index}">
                                    <td class="text-left">{{item.SO_KH}}</td>
                                    <td class="text-center">
                                        {{FormatDate(item.NGAY_TAO)}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGUOI_LAP}}
                                    </td>
                                    <td class="text-left">
                                        {{item.CAN_CU}}
                                    </td>
                                    <td class="text-center">
                                        {{item.LOAI_KH}}
                                    </td>
                                    <td class="text-center">
                                        {{item.TRANG_THAI == 'A' ? ' Đã Duyệt' : 'Chưa Duyệt'}}
                                        @*{{GetTrangThaiText(item.TRANG_THAI)}}*@
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="col-sm-12">
                            <div class="row content-table pull-right">
                                <div class="pages-switch">
                                    <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelKH.totalItems" items-per-page="modelKH.pageSize" ng-model="modelKH.currentPage" ng-change="pageKHChanged()" max-size="modelKH.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="nav-box spe-height" style="height: 800.375px;">
        <div class="nav-tabs-box">
            <ul class="nav nav-tabs tab-main" id="myTab" role="tablist">
                <li class="nav-item fc-w-to-tab">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#nhap-kho" role="tab" ng-class="{'active': tabCheck == 'NK', 'disable-click': tabCheck != 'NK'}">Nhập kho</a>
                </li>

                <li class="nav-item fc-w-to-tab">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#xuat-kho" role="tab" ng-class="{'active': tabCheck == 'XK', 'disable-click': tabCheck != 'XK'}">Xuất kho</a>
                </li>

                <li class="nav-item fc-w-to-tab">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#giao-thang" role="tab" ng-class="{'active': tabCheck == 'GT', 'disable-click': tabCheck != 'GT'}">Giao thẳng</a>
                </li>

                <li class="nav-item fc-w-to-tab">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#dieu-chuyen" role="tab" ng-class="{'active': tabCheck == 'DC', 'disable-click': tabCheck != 'DC'}">Điều chuyển</a>
                </li>
            </ul>
        </div>


        <div class="container-fluid sl-1-row">
            <div class="tab-content mt-3" id="myTabContent">
                <div class="tab-pane fade" id="nhap-kho" role="tabpanel" aria-labelledby="home-tab" ng-class="{'show active': tabCheck == 'NK', 'disable-click': tabCheck != 'NK'}">
                    <div class="content-table">
                        <table class="table-responsive result-point">
                            <thead class="point-table-head">
                                <tr class="bd-normal">
                                    <th class="text-center ht3-number-cand" style="width: 3%;">
                                        STT
                                    </th>
                                    <th class="text-center ht3-genral" style="width: 20%;">
                                        Số chứng từ
                                    </th>
                                    <th class="text-center ht3-rank" style="width: 15%;">
                                        Kho nhập
                                    </th>
                                    <th class="text-center ht3-position" style="width: 8%">
                                        Ngày viết phiếu
                                    </th>
                                    <th class="text-center ht3-size">
                                        Người viết phiếu
                                    </th>
                                    <th class="text-center ht3-size">
                                        Ngày nhập kho
                                    </th>
                                    <th class="text-center ht3-size">
                                        Cán bộ nhập hàng
                                    </th>
                                    <th class="text-center ht3-size">
                                        Cán bộ vận chuyển
                                    </th>
                                    <th class="text-center ht3-size">
                                        Trạng thái
                                    </th>
                                    <th class="text-center ht3-size">
                                        Xem chứng từ
                                    </th>
                                    <th class="text-center ht3-size">
                                        Xem đính kèm
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in DanhSachChungTu">
                                    <td class="text-center">
                                        {{$index + 1}}
                                    </td>
                                    <td class="text-left">
                                        {{item.SO_CHUNG_TU}}
                                    </td>
                                    <td class="text-left">
                                        {{item.TEN_KHO}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGAY_VIET_PHIEU}}
                                    </td>
                                    <td class="text-left">
                                        {{}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGAY_XK}}
                                    </td>
                                    <td class="text-left">
                                        {{item.NGUOI_NHAN}}
                                    </td>
                                    <td class="text-left">
                                        {{item.CAN_BO_VAN_CHUYEN}}
                                    </td>
                                    <td class="text-center">
                                        {{GetTrangThaiText(item.TRANG_THAI)}}
                                    </td>
                                    <td class="text-center">
                                        <a class="" ng-click="XemChungTuNhapKho(item)">
                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a class="btn-action-m" ng-click="XemDinhKemNhapKho()">
                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="xuat-kho" role="tabpanel" aria-labelledby="profile-tab" ng-class="{'show active': tabCheck == 'XK', 'disable-click': tabCheck != 'XK'}">
