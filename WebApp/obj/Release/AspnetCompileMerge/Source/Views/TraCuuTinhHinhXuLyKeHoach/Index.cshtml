                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a class="btn-action-m" ng-click="XemDinhKemGiaoThang()">
                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="dieu-chuyen" role="tabpanel" aria-labelledby="profile-tab" ng-class="{'show active': tabCheck == 'DC', 'disable-click': tabCheck != 'DC'}">
                    <div class="content-table">
                        <table class="table-responsive result-point">
                            <thead class="point-table-head">
                                <tr class="bd-normal">
                                    <th class="text-center ht3-number-cand">
                                        STT
                                    </th>
                                    <th class="text-center ht3-genral">
