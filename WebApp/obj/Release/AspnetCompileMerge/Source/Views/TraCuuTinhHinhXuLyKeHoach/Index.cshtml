                                    <td class="text-left">
                                        {{item.NGUOI_NHAN}}
                                    </td>
                                    <td class="text-left">
                                        {{item.CAN_BO_VAN_CHUYEN}}
                                    </td>
                                    <td class="text-center">
                                        {{GetTrangThaiText(item.TRANG_THAI)}}
                                    </td>
                                    <td class="text-center">
                                        <a class="" ng-click="XemChungTuXuatKho(item)">
                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a class="btn-action-m" ng-click="XemDinhKemXuatKho()">
                                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="giao-thang" role="tabpanel" aria-labelledby="profile-tab" ng-class="{'show active': tabCheck == 'GT', 'disable-click': tabCheck != 'GT'}">
                    <div class="content-table">
                        <table class="table-responsive result-point">
                            <thead class="point-table-head">
                                <tr class="bd-normal">
                                    <th class="text-center ht3-number-cand">
                                        STT
                                    </th>
                                    <th class="text-center ht3-genral">
                                        Số chứng từ
                                    </th>
                                    <th class="text-center ht3-rank">
