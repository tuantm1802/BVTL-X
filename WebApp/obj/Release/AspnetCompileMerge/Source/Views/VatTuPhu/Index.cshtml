<style>
    .fixTableHead {
        overflow-y: scroll;
    }

        .fixTableHead thead th {
            position: sticky !important;
            top: 1px;
        }

        .fixTableHead table {
        }
</style>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Home/Index">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Vật tư phụ</li>
    </ol>
</nav>

<main class="main-ac-system" ng-controller="VatTuPhuController" style="padding-top: 20px;">
    <div class="container-fluid d-flex cons-ac-system">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>
            <div class="fill-box">
                <h3 class="title-fill">
                    Vật tư phụ
                </h3>
            </div>
            <div class="container">
                <div class="main-action pt-3">
                    <div class="form-search w-100">
                        <input ng-model="search" type="text" placeholder="Tìm kiếm">
                        <button>
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="fill-box">
                    <h3 class="title-fill">
                        Nhóm vật tư phụ
                    </h3>
                </div>
                <div class="function-box" style="height: 425px!important;">
                    <div class="content-table">
                        <table class="table-responsive table-hover result-point">
                            <tbody class="">
                                <tr style="height:10px !important;" ng-repeat="item in DSNhomVTP|filter:search"
                                    ng-class="{activerow:$index==selectedRowNhomVTP}" ng-click="SelectNhomVTP($index,item)">
                                    <td class="text-left">{{item.TEN_NHOM_SP}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
        <div class="content-system no-border pb-0" ng-show="ShowContent" style="margin-right:0px;">
            <div class="col-12 col-md-12 col-lg-12" align-self-end>
                <div class="main-action d-flex align-items-center justify-content-between flex-wrap pt-3"
                     style="display:inline-block; margin-bottom: 10px;">
                    <div class="d-flex align-items-center flex-wrap ct-w">
                        <button class="btn-action-m bg-green" type="button"
                                ng-click="Add()" ng-show="RoleBtnCreate">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            <span>Thêm mới</span>
                        </button>
                        <button class="btn-action-m bg-green" type="button"
                                style="margin-right: 10px;"
                                ng-click="Undo()" ng-show="RoleBtnCancel">
                            <i class="fa fa-ban" aria-hidden="true"></i>
                            <span>Huỷ thay đổi</span>
                        </button>
                        <button class="btn-action-m bg-green" type="button"
                                ng-click="Submit()" ng-show="RoleBtnSave"
                                style="margin-right: 10px;">
                            <i class="fa fa-floppy-o" aria-hidden="true"></i>
                            <span>Lưu</span>
                        </button>
                        <button class="btn-action-m bg-red" type="button"
                                ng-click="Delete()" ng-show="RoleBtnDelete"
                                style="margin-right: 10px;">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                            <span>Xoá</span>
                        </button>

                    </div>
                    <div class="main-action pt-3">
                        <div class="form-search" style="width:300px;margin-right:0px !important; margin-bottom:0px !important;">
                            <input type="text" ng-model="searchr" placeholder="Tìm kiếm" />
                            <button class="btn-action-m bg-green ">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="space-8">

            </div>
            <div class="content-system content-table mt-2 fixTableHead" style="border:none !important; height:500px;">
                <table class="table-hover result-point mt-2 " style="margin-right:0px;">
                    <thead class="point-table-head " style="width:100%;">
                        <tr>
                            <th style="width:10%;" class="text-center">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" ng-model="SELECTALL" ng-click="SelectedAll()" value="10" />
                                    <span class="lbl"></span>
                                </label>
                            </th>
                            <th style="width:15%;" class="text-left">STT</th>
                            <th style="width:30%;" class="text-left">Tên vật tư</th>
                            <th style="width:30%;" class="text-left">Mô tả</th>
                            <th style="width:30%;" class="text-left">Nhóm vật tư</th>
                            <th style="width:30%;" class="text-left">Đơn vị tính</th>

                        </tr>

                    </thead>
                    <tbody>
                        <tr ng-repeat="item in DSVatTuPhu|filter:searchr" ng-click="loadTemplate($index)">
                            <td class="text-center">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" ng-model="item.SELECT" value="10" />
                                    <span class="lbl"></span>
                                </label>
                            </td>
                            <td class="text-left" ng-if="STT">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>
                            <td class="text-left" ng-if="TenVatTu">
                                <span ng-if="!item.Edit">{{item.TEN_SP}}</span>
                                <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.TEN_SP">
                            </td>
                            <td class="text-left" ng-if="MoTa">
                                <span ng-if="!item.Edit">{{item.MO_TA}}</span>
                                <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.MO_TA">

                            </td>
                            <td class="text-left" ng-if="NhomVT">
                                <span>{{item.TEN_NHOM_SP}}</span>
                            </td>
                            <td class="text-left" ng-if="DonViTinh">
                                <span ng-if="!item.Edit">{{item.DVT}}</span>
                                <div ng-if="item.Edit">
                                    <select ng-model="item.DVT_ID" ng-options="x.ID as x.TEN_DVT for x in ListDVT">
                                        @*
                                        <option ng-repeat="option in ListDVT" value="{{option.ID}}">{{option.TEN_DVT}}</option>*@
                                    </select>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr ng-repeat="row in rows">
                            <td class="text-center">
                                <input type="checkbox" id="check" ng-true-value="{{item.ID}}" ng-false-value="''" ng-model="item.selected" />
                            </td>
                            <td class="text-left" ng-if="STT">{{modelSearch.totalItems+1}}</td>
                            <td class="text-left" ng-if="TenVatTu">
                                <input ng-class="row.TSP? 'error': ''" type="text" ng-model="row.TEN_SP" />
                                <div ng-show="row.TSP">
                                    <label class="error">Bạn chưa nhập tên sản phẩm</label>
                                </div>
                            </td>
                            <td class="text-left" ng-if="MoTa">
                                <input type="text" ng-model="row.MO_TA" />
                            </td>
                            <td class="text-left" ng-if="NhomVT">
                                <span>{{row.TEN_NHOM_SP}}</span>
                            </td>
                            <td class="text-left" ng-if="DonViTinh">
                                <select ng-class="row.DVTID? 'error': ''" ng-model="row.DVT_ID">
                                    <option ng-repeat="option in ListDVT" ng-value="option.ID">{{option.TEN_DVT}}</option>
                                </select>
                                <div ng-show="row.DVTID">
                                    <label class="error">Bạn chưa chọn đơn vị tính</label>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="bootbox modal fade bootbox-prompt" id="exampleModal"
             tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
            </div>
        </div>
    </div>
</main>

@section scripts{
<script src="~/app/Controller/VatTuPhuController.js"></script>
}