@{
    ViewBag.Title = "Danh mục trang phục";
}
<style>
    .table .cap {
        margin-bottom: 0px;
        margin: 0px;
        padding: 0px;
        border: 0px;
        border-spacing: 0;
    }

    .table-bordered {
        border-left: 0px;
        border-right: 0px;
    }

    .table-nested .cell-members {
        width: 60px;
    }

    .table-nested .indent-icon {
        display: inline-block;
    }

    .table-nested .indentt {
        display: inline-block;
    }

    .table-nested .parent > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1.svg);
        font-family: FontAwesome;
        display: inline-block;
        -moz-transition: -moz-transform 0.3s;
        -o-transition: -o-transform 0.3s;
        -webkit-transition: -webkit-transform 0.3s;
        transition: transform 0.3s;
    }

    .table-nested .parent > .cell-name > .indentt {
        content: url(../../App_Assets/images/f_drop_3.svg);
    }

    .table-nested .opened > tr > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1_active.svg);
    }

    .app-error .select2-selection {
        border: 1px solid #D4D4D4;
    }
</style>
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục trang phục
    </h3>
</div>
<div ng-controller="TrangPhucController">
    <main style="padding-top: 20px;">
        <div class="container-fluid d-flex cons-ac-system">
            <div class="action-system pd-two ui-widget-content" id="resizable" style="height:700px">
                <button id="btn-changes-s-nav">
                    <img src="../App_Assets/images/ic_back_xx.svg" alt="">
                </button>

                <div class="fill-box">
                    <h3 class="title-fill">
                        Nhóm trang phục
                    </h3>
                </div>

                <div class="container">
                    <div class="main-action pt-3">
                        <div class="form-search w-100">
                            <input type="text" placeholder="Tìm kiếm" id="txtSearch"
                                   ng-model-options="{ debounce: 800 }" ng-change="ChangeSearch()" ng-model="searchNhomTP">
                            <button>
                                <i class="fa fa-search" aria-hidden="true"
                                   ng-click="GetDataNhomTrangPhucController()"></i>
                            </button>
                        </div>

                    </div>

                    <div>
                        <div class="function-box" style="height:600px;">
                            <div class="ztreeRoleBackground left" style="width:100%;">
                                <ul id="treeViewNhomTrangPhuc" class="ztree"></ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid border" ng-show="ShowContent" style="margin-left:15px;">
                <div class="row" style="padding-top:10px;">
                    <div class="col-12 col-md-12 col-lg-12" align-self-end>
                        <div class="main-action d-flex flex-wrap" style="margin-left:20px;">
                            <button class="btn-action-m bg-green"
                                    ng-click="addData()" ng-show="RoleBtnCreate">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                                <span>Thêm mới</span>
                            </button>
                            <button class="btn-action-m"
                                    ng-click="Delete()" ng-show="RoleBtnDelete"
                                    style="margin-right: 10px;background-color:#f55442;">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                                <span> Xóa </span>
                            </button>
                            <div class="main-action pt-3">
                                <div class="form-search" style="height:28px;width:300px;margin-left:400px">

                                    <input type="text" ng-model="search" ng-model-options="{ debounce: 800 }" ng-change="GetDataTrangPhucController()" placeholder="Tìm kiếm" />
                                    <button class="btn-action-m" style="color:white">
                                        <i class="fa fa-search" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form pt-3">
                                <label for=""><strong>Năm</strong></label>
                                <select ng-model="Years" select2 ng-change="GetDataTrangPhucController()" style="width:100px;">
                                    <option ng-repeat="x in ListNam" value="{{x.Text}}">{{x.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-table" style="margin-top:10px;">
                    <table class="cap table-nested table content-table table-bordered table-hover result-point mt-2">
                        <thead class="point-table-head" style="width:100%;">
                            <tr>
                                <th style="width:4%;min-width:32px" class="text-center ht4-number">
                                    &nbsp;
                                </th>
                                <th style="width:5%;min-width:42px" class="text-center ht4-number">
                                    <input type="checkbox" class="ace form-control" />
                                </th>
                                <th style="width:5%;" class="cell-members">
                                    <span>Chi tiết</span>
                                </th>
                                <th style="width:8%;" class="cell-members">
                                    <span>Mã hàng</span>
                                </th>
                                <th style="width:22%;" class="cell-name">
                                    <span>Tên Trang phục</span>
                                </th>
                                <th style="width:8%;" class="cell-members">
                                    <span>Đơn vị tính</span>
                                </th>
                                <th style="width:8%;" class="cell-members">
                                    <span>Giới tính </span>
                                </th>
                                @*<th style="width:8%; border-right:0px !important;" class="cell-members">
                                        <span>Có cỡ số</span>
                                    </th>*@
                                <th style="width:8%;" class="cell-members">
                                    <span>May đo</span>
                                </th>
                                @*<th style="width:8%;" class="cell-members">
                                        <span>Khác</span>
                                    </th>*@
                                <th style="width:8%;" class="cell-members">
                                    <span>Nhận tiền</span>
                                </th>
                                <th style="width:8%;" class="cell-members">
                                    <span>Nhận hiện vật</span>
                                </th>
                                @*<th style="width:8%; border-right:0px !important;" class="cell-members">
                                        <span>Hiệu lực</span>
                                    </th>*@
                            </tr>
                        </thead>
                        <tbody style="width:100%;" ng-class="{opened: item.opened}"
                               ng-include="&#39;table_tree.html&#39;"
                               ng-repeat="item in dataTrangPhuc|filter:search"></tbody>
                    </table>
                </div>
                <script id="table_tree.html" type="text/ng-template">
                    <tr ng-class="{parent: item.children}"
                        ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)"
                        style="margin: 0px;">
                        <td style="width:4%;" class="cell-name text-center" ng-click="item.opened = !item.opened">
                            <div ng-if="item.parent" class="indent-icon" @*style="padding-left: {{40*level}}px"*@></div>
                            <div ng-if="!item.parent" class="indentt" style="width:14px"></div>
                        </td>
                        <td class="cell-input" style="width:5%;">
                            <div>
                                <input type="checkbox" class="form-control"
                                       ng-disabled="item.status"
                                       ng-model="item.selected"
                                       ng-click="checkAllchild(item)" />
                            </div>
                        </td>
                        <td class="text-center" style="width:5%;">
                            <button class="btn" ng-click="ttChiTiet(item)">
                                <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                            </button>
                        </td>
                        <td style="width:8%;">
                            <span>{{item.MA_H55}}</span>
                        </td>
                        <td style="width:22%;" class="cell-name" ng-model="item.TEN_SP">
                            @*<div ng-if="item.parent" class="indent-icon" style="padding-left: {{50*level}}px"></div>
                                <div ng-if="!item.parent" class="indentt" style="padding-left: {{50*level}}px"></div>*@
                            <span>{{item.TEN_SP}}</span>
                        </td>
                        <td style="width:8%; padding: 10px !important;" ng-model="item.TEN_DV_TINH"
                            class="cell-members">
                            <span>{{item.TEN_DV_TINH}}</span>
                        </td>
                        <td style="width:8%; padding: 10px !important;" ng-model="item.GIOI_TINH"
                            class="cell-members">
                            <span>{{showGioiTinh(item.GIOI_TINH)}}</span>
                        </td>
                        @*Ẩn cột cỡ số và Khác theo ý của A.An phòng 07*@
                        @*<td style="width:8%; padding: 10px !important; border-right:0px !important;"
                                ng-model="item.ICS" class="cell-members">
                                <input type="checkbox" ng-model="item.ICS" disabled />
                            </td>*@
                        <td style="width:8%; padding: 10px !important;" ng-model="item.IMD" class="cell-members">
                            <input type="checkbox" ng-model="item.IMD" disabled />
                        </td>
                        @*<td style="width:8%; padding: 10px !important;" ng-model="item.IKHAC" class="cell-members">
                                <input type="checkbox" ng-model="item.IKHAC" disabled />
                            </td>*@
                        <td style="width:8%; padding: 10px !important;" ng-model="item.INT" class="cell-members">
                            <input type="checkbox" ng-model="item.INT" disabled />
                        </td>
                        <td style="width:8%; padding: 10px !important;"
                            ng-model="item.ITP" class="cell-members">
                            <input type="checkbox" ng-model="item.ITP" disabled />
                        </td>
                        @*<td style="width:8%; padding: 10px !important; border-right:0px !important;"
                                ng-model="item.IS_HIEULUC" class="cell-members">
                                <input type="checkbox" ng-model="item.IS_HIEULUC" disabled />
                            </td>*@

                    </tr>


                    <tr class="children" style="margin: 0px;"
                        ng-if="item.children &amp;&amp; item.children.length &gt; 0">
                        <td colspan="12" style="width:100%;">
                            <table class="table cap table-striped table-hover" ng-class="{opened: item.opened}"
                                   ng-include="&#39;table_tree.html&#39;"
                                   ng-init="level = level + 1" ng-repeat="item in item.children"
                                   style="width: calc(100% + 2px) !important;border-left:0px !important; border-right:0px !important;margin-left:-1px;margin-top: -1px;"></table>
                        </td>
                    </tr>

                </script>
            </div>
        </div>
    </main>
</div>

@section scripts{
    <script src="~/Content/js/jquery.ztree.exhide.min.js"></script>
    <script src="~/app/Controller/TrangPhucController.js"></script>
}