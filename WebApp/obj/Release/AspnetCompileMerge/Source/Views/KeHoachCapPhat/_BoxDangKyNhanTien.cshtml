<form id="formDSDKNhanTien" enctype="multipart/form-data" name="formDSDKNhanTien">
 
    <!-- Modal Header -->
    <div class="modal-header">
        <h4 class="modal-title">Danh sách nhận tiền & hiện vật</h4>
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
    </div>

    <!-- Modal body -->
    <div class="modal-body" style="max-height: calc(100vh - 160px);">
        <div class="content-table" style="max-height: calc(100vh - 255px); overflow: auto;">
            <div class="col-12 col-md-12 col-lg-12"> 
                <tree-grid show-checkbox="tree_Table_Checkbox_dknt"
                           expand-level="3"
                           body-defs="body_defs_dknt"
                           tree-data="tree_data_dknt"
                           expand-on="expanding_property_dknt"
                           col-defs="col_defs_dknt"
                           icon-leaf="v_treetable_docu_dknt"
                           icon-expand="treetable_close_dknt"
                           icon-collapse="treetable_open_dknt"
                           event-change-checkbox="ChangeTreeTableCheckbox_dknt(item)"
                           event-choose-row="ClickTreeTableRow_dknt(item)"></tree-grid> 
            </div>
        </div>
    </div>

    <!-- Modal footer -->
    <div class="modal-footer d-flex justify-content-between">
        <h5 class="day-make"></h5>
        <div class="main-action d-flex flex-wrap"> 
            <button class="btn-action-m bg-orange" ng-click="cancel()">
                <i class="fa fa-times" aria-hidden="true"></i>    <span> Đóng</span>
            </button>
        </div>
    </div>
</form>

