@{
    ViewBag.Title = "Kế hoạch cấp phát";
}
<style>
    /*.function-box {
        height: calc(100vh - 235px);
    }

    .content-table {
        height: calc(100vh - 410px);
    }

    .nav-box {
        height: calc(100vh - 221px) !important;
    }

    .list-buttun-ct {
        width: calc(100% - 20px);
    }

        .list-buttun-ct .main-action .btn-action-m {
            margin-bottom: 10px;
        }*/
    .nav-tabs .nav-item .nav-link::after {
        content: "";
        position: absolute;
        width: 1px;
        height: 23px;
        background: #666666;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
    }
</style>
<main ng-controller="KeHoachCapPhatController" style="margin-top: 20px;">
    <div class="container-fluid d-flex cons-ac-system">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>

            <div class="fill-box">
                <h3 class="title-fill">
                    <i class="fa fa-folder-open color-green" aria-hidden="true"></i>  Đơn vị
                </h3>
            </div>

            <div class="container">
                <div class="btn-group" data-toggle="buttons" style="padding-top:10px;  font-size:14px;">
                    <label class="btn btn-primaryMenu active form-check-label waves-effect waves-light" ng-click="ChangeTreeViewDmDonVi(1)">
                        <input class="form-check-input" name="rdoDmDonVi" type="radio" checked="" autocomplete="off" value="1" style="color:transparent"> <i class="fa fa-users" aria-hidden="true"></i> Nhóm đơn vị
                    </label>

                    <label class="btn btn-primaryMenu form-check-label waves-effect waves-light" ng-click="ChangeTreeViewDmDonVi(2)">
                        <input class="form-check-input" name="rdoDmDonVi" type="radio" autocomplete="off" style="color:transparent" value="2" /><i class="fa fa-map-marker" aria-hidden="true"></i>  Khu vực
                    </label>
                </div>
                <div class="main-action pt-3">
                    <div class="form-search w-100">
                        <input type="text" placeholder="Tìm kiếm" ng-model="txtSearchDmDonVi">
                        <button class="bg-green" style="color:white" ng-click="btnSearchDmDonVi()">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="function-box">
                    <div class="ztreeRoleBackground left" style="width:100%;">
                        <ul id="treeRole" class="ztree"></ul>
                    </div>
                </div>

                <div class="content-table ng-hide" ng-init="IsVisibleTab=false" ng-show="IsVisibleTab" style="padding-top:15px">
                    @*<div class="row" style="padding-top:15px">
                            <div class="col-lg-12" ng-show="IsVisibleThemMoiKH">
                                <div class="form-group row">
                                    <div class="col-12 col-md-5 col-lg-5 main-action">
                                        <button class="btn-action-m bg-green form-control" ng-click="btnKHThemMoi()">
                                            <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>*@
                    <div class="row">
                        <div class="col-12 col-md-4 col-lg-4">
                            <div class="form-group row">
                                <lable class="col-12 col-md-2 col-lg-2" style="padding-top:3px">Năm: </lable>
                                <div class="col-12 col-md-10 col-lg-10">
                                    <select ng-model="cbbNam" class="form-control" ng-change="idx_ChangeKHTheoNam()">
                                        <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Name}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 col-lg-4">
                            <div class="form-group row">
                                <lable class="col-12 col-md-2 col-lg-2" style="padding-top:3px">Kỳ: </lable>
                                <div class="col-12 col-md-10 col-lg-10">
                                    <select name="" ng-model="cbbKy" class="form-control" ng-change="idx_ChangeKHTheoKy()">
                                        <option value="XH">Xuân hạ</option>
                                        <option value="TD">Thu đông</option>
                                        <option value="CN">Cả năm</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 col-lg-4 main-action">
                            <button class="btn-action-m bg-green form-control" ng-click="btnKHThemMoi()">
                                <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                            </button>
                        </div>
                    </div>
                    @*Danh sách kế hoạch*@
                    <div class="nav-box">
                        <div class="nav-tabs-box">
                            <ul class="nav nav-tabs tab-main" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#TAB_KH_CAP" title="Kế hoạch cấp" role="tab">Kế hoạch cấp</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#TAB_KH_CHO_XL" title="Kế hoạch (chờ xử lý)" role="tab">Kế hoạch (chờ xử lý)</a>
                                </li>
                            </ul>
                        </div>
                        <div class="container-fluid sl-1-row">
                            <div class="tab-content" id="myTabContent">
                                <div class="tab-pane fade show active" id="TAB_KH_CAP" role="tabpanel" aria-labelledby="home-tab">
                                    <table class="table-responsive table-hover result-point mt-2 small-table">
                                        <thead class="point-table-head">
                                            <tr>
                                                <th class="text-center mn-number">Số KH</th>
                                                <th class="text-center mn-day">Ngày tạo</th>
                                                <th class="text-center mn-status">Trạng thái</th>
                                                <th class="text-center mn-status">#</th>
                                            </tr>
                                        </thead>
                                        <tbody class="">
                                            <tr ng-repeat="item in ListKHCapPhat" ng-class="{activerow:$index==selectedRowKeHoach}" style="cursor:pointer">
                                                <td class="text-center" ng-click="CP_SelectKeHoach(item,$index)">{{item.SO_KH}}</td>
                                                <td class="text-center" ng-click="CP_SelectKeHoach(item,$index)">{{item.NGAY_TAO_TEXT}}</td>
                                                <td class="text-center" ng-click="CP_SelectKeHoachChoXl(item,$index)">
                                                    {{item.TRANG_THAI == 'U' ? 'Chờ duyệt' : item.TRANG_THAI == 'A' ? 'Đã duyệt' : item.TRANG_THAI == 'D' ? 'Đã hủy' : item.TRANG_THAI == 'I' ? 'Khởi tạo' : 'Từ chối duyệt'}}

                                                </td>
                                                <td class="text-center">
                                                    @* Hiển thị nút tạm dừng khi trạng thái = I (Chờ duyệt) *@
                                                    <button style="font-size: 16px; color: firebrick; position:relative; z-index:99; background: transparent" title="Chuyển trạng thái chờ xử lý" ng-click="FnDoiTrangThaiKh(item,'P')"><i class="fa fa-exchange" aria-hidden="true"></i></button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="tab-pane fade" id="TAB_KH_CHO_XL" role="tabpanel" aria-labelledby="profile-tab">
                                    <table class="table-responsive table-hover result-point mt-2 small-table">
                                        <thead class="point-table-head">
                                            <tr>
                                                <th class="text-center mn-number">Số KH</th>
                                                <th class="text-center mn-day">Ngày tạo</th>
                                                <th class="text-center mn-status">Trạng thái</th>
                                                <th class="text-center mn-status">#</th>
                                            </tr>
                                        </thead>
                                        <tbody class="">
                                            <tr ng-repeat="item in ListKHCapPhatChoXl" ng-class="{activerow:$index==selectedRowKeHoach}" style="cursor:pointer">
                                                <td class="text-center">{{item.SO_KH}}</td>
                                                <td class="text-center">{{item.NGAY_TAO_TEXT}}</td>
                                                <td class="text-center">
                                                    Tạm dừng
                                                </td>
                                                <td class="text-center">
                                                    @* Hiển thị nút tiếp tục khi trạng thái != A, I  (Tạm dừng) *@
                                                    <button style="font-size: 16px; color: firebrick; position:relative; z-index:99; background: transparent" title="Chuyển trạng thái xử lý" ng-click="FnDoiTrangThaiKh(item.ID_KH, 'U')"><i class="fa fa-exchange" aria-hidden="true"></i></button>
                                                    <button style="font-size: 16px; color: firebrick; position:relative; z-index:99; background: transparent" title="Xóa kế hoạch chờ xử lý" ng-show="item.TRANG_THAI != 'D'" ng-click="XoaKeHoachChoXL(item.ID_KH)"><i class="fa fa-trash-o" aria-hidden="true"></i></button>
                                                    @*<div class="main-action d-flex align-items-center justify-content-between flex-wrap">
                                                            <div class="d-flex align-items-center flex-wrap">
                                                                <button class="btn-action-delete" ng-show="item.TRANG_THAI != 'D'" style="font-size: 16px; color: firebrick; background: transparent" ng-click="XoaKeHoachChoXL(item.ID_KH)">
                                                                    <i class="fa fa-trash-o" style="color: red;" aria-hidden="true"></i>
                                                                </button>
                                                            </div>
                                                        </div>*@
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                    @*End*@
                </div>
            </div>
        </div>

        <div class="content-system no-border pb-0 ng-hide" ng-show="ViewKeHoach">
            @* bread crumb *@
            <div class="fill-box-bread-crumb">
                <h3 class="bread_crumb">
                    <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>  /  Cấp phát  /   Kế hoạch cấp phát
                </h3>
            </div>
            @*End bread crumb*@
            <div class="form-infor has-border p-3 firts-to-h">
                <div class="row no-gutters">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="">Sổ kế hoạch: </label>
                        <input type="text" class="form-control" placeholder="{{CP_SelectKeHoachItem.SO_KH}}" disabled>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="">Đơn vị: </label>
                        <input type="text" class="form-control" ng-model="TEN_DON_VI" disabled>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="">Năm: </label>
                        <input type="text" class="form-control" placeholder="{{cbbNam}}" disabled>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="">Kỳ: </label>
                        <input type="text" class="form-control" placeholder="{{cbbKy == 'CN' ? 'Cả Năm' : cbbKy == 'XH' ? 'Xuân hạ' : 'Thu đông'}}" disabled>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Lý do cấp: </label>
                        <div class="d-flex align-item-center">
                            <input type="text" class="form-control" value="{{CP_SelectKeHoachItem.MO_TA}}" ng-model="CP_SelectKeHoachItem.MO_TA">
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Phương phức vận chuyển: </label>
                        <div class="d-flex align-item-center">
                            <select ng-model="CP_SelectKeHoachItem.PHUONG_THUC_VAN_CHUYEN" name="phuongThucVanChuyen" ng-options="item.FLEX_VALUE_ID as item.DESCRIPTION for item in listPhuongThucVanChuyen" select2 class="form-control" style="width:100%">
                            </select>
                            <div class="main-action" style="padding-left: 20px; margin-top: -3px;">
                                <button class="btn-action-m bg-green margin-top-3" ng-disabled="disableKHDuyet" ng-click="btnPhuongThucVC(CP_SelectKeHoachItem.ID_KH, CP_SelectKeHoachItem.PHUONG_THUC_VAN_CHUYEN, CP_SelectKeHoachItem.MO_TA)">
                                    <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Cán bộ nhận hàng: </label>
                        <input type="text" class="form-control" placeholder="{{CP_SelectKeHoachItem.NGUOI_PHU_TRACH}}" disabled>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="" style="font-weight:bold">{{CP_SelectKeHoachItem.TRANG_THAI == 'R' ? 'Lý do từ chối duyệt: ' : ''}} </label>
                        <span>{{CP_SelectKeHoachItem.TRANG_THAI == 'R' ? CP_SelectKeHoachItem.LY_DO_TU_CHOI_DUYET : ''}}</span>
                    </div>
                </div>
            </div>

            <div class="nav-box">
                <div class="nav-tabs-box">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="home-tab" data-toggle="tab" href="#ke_hoach" title="Kế hoạch cấp" role="tab">Kế hoạch cấp</a>
                        </li>

                        <li class="nav-item" ng-click="OpenTabNTDoiTC()">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#nhan_doi" title="Nhận tiền đổi tiêu chuẩn" role="tab">Nhận tiền đổi tiêu chuẩn</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#dang_ky" ng-click="ChooseTabDangKyCoSo()" title="Đăng ký cỡ số - giao KH may đo" role="tab">Đăng ký cỡ số - giao KH may đo</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#nhap_phieu" ng-click="ChooseTabLapPXK()" title="Lập phiếu xuất kho" role="tab">Lập phiếu xuất kho</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#giai_phap" title="Giải trình cấp phát" role="tab">Giải trình cấp phát</a>
                        </li>
                    </ul>
                </div>

                <div class="container-fluid sl-1-row">
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="ke_hoach" role="tabpanel" aria-labelledby="home-tab">
                            @{Html.RenderAction("_TabKeHoachCap", "KeHoachCapPhat");}
                        </div>

                        <div class="tab-pane fade" id="nhan_doi" role="tabpanel" aria-labelledby="profile-tab">
                            @{Html.RenderAction("_TabNhanTienDoiTieuChuan", "KeHoachCapPhat");}
                        </div>

                        <div class="tab-pane fade" id="dang_ky" role="tabpanel" aria-labelledby="profile-tab">
                            @*Đang cập nhật...*@
                            @{Html.RenderAction("_TabDKyCoSoGiaoKH", "KeHoachCapPhat");}
                        </div>

                        <div class="tab-pane fade" id="nhap_phieu" role="tabpanel" aria-labelledby="profile-tab">
                            @{Html.RenderAction("_TabLapPhieuXuatKho", "KeHoachCapPhat");}
                            @Html.Partial("~/Views/KeHoachCapPhat/_LPXK_ChonKho.cshtml")
                            @Html.Partial("~/Views/KeHoachCapPhat/_LPXK_ChonHopDong.cshtml")
                            @Html.Partial("~/Views/KeHoachCapPhat/_LPXK_ChiTietPXK.cshtml")
                            @Html.Partial("~/Views/KeHoachCapPhat/_LPXK_ChiTietGiaoKHSX.cshtml")
                            @Html.Partial("~/Views/KeHoachCapPhat/_LPXK_PXKDinhKem.cshtml")
                        </div>
                        <div class="tab-pane fade" id="giai_phap" role="tabpanel" aria-labelledby="profile-tab">
                            @{Html.RenderAction("_TabGiaiTrinhCapPhat", "KeHoachCapPhat");}
                        </div>
                    </div>

                </div>
            </div>
        </div>



    </div>
    @Html.Partial("~/Views/KeHoachCapPhat/_CHNienHan.cshtml")
</main>
@section scripts{
    <script src="~/app/Controller/CapPhat/KeHoachCapPhatController.js"></script>
}