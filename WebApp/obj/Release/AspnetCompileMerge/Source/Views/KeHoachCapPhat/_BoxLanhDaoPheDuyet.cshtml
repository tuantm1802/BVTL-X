
<form id="formGuiPheDuyetKH" enctype="multipart/form-data" name="formGuiPheDuyetKH">
    <!-- Modal Header -->
    <div class="modal-header">
        <h4 class="modal-title">Chọn lãnh đạo ký duyệt</h4>
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
    </div>

    <!-- Modal body -->
    <div class="modal-body" style="max-height: calc(100vh - 160px);">
        <div class="col-md-12">
            <div class="form-group row">
                <div class="col-12 col-md-2 col-lg-2">
                    <label>Lãnh đạo: <span class="color-red">*</span> </label>
                </div>
                <div class="col-12 col-md-10 col-lg-10">
                    <select  ng-model="cbbDsLanhDaoKyDuyet" ng-change="CP_ChangeLanhDao()" class="form-control"> 
                        <option ng-repeat="item in DsLanhDaoKyDuyet" value="{{item.USER_ID}}">{{item.FULL_NAME}} - {{item.UNIT_NAME}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group row">
                <div class="col-12 col-md-2 col-lg-2">
                    <label>Nội dung trình: </label>
                </div>
                <div class="col-12 col-md-10 col-lg-10">
                    <textarea type="text" ng-model="txtarNoiDungTrinh" class="form-control-area" rows="3" />
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div> 
    <!-- Modal footer -->
    <div class="modal-footer d-flex justify-content-between">
        <h5 class="day-make"></h5>
        <div class="main-action d-flex flex-wrap">
            <button type="button" class="btn-action-m bg-green cl-3" ng-click="CP_GuiPheDuyet()">
                <i class="fa fa-check-square-o" aria-hidden="true"></i>   <span>Gửi</span>
            </button>
            <button class="btn-action-m bg-orange" ng-click="cancel()">
                <i class="fa fa-times" aria-hidden="true"></i>    <span> Đóng</span>
            </button>
        </div>
    </div>
</form>

