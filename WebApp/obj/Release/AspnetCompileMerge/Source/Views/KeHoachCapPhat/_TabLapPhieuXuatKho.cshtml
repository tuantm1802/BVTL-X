    <div class="row" style="margin-top: 5px;">
        <div class="col-md-4">
            <div class="main-action d-flex align-items-center flex-wrap">
                <button class="btn-action-m" ng-disabled="disableKHDuyet" ng-click="LPXK_XuatKhoUuTien()">
                    <span>Xuất kho ưu tiên</span>
                </button>
                <button class="btn-action-m" ng-disabled="disableKHDuyet" ng-click="LPXK_XuatKhoKhac()">
                    <span>Xuất kho khác</span>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <p>{{LPXK_Message}}</p>
        </div>
        <div class="col-md-4">
            <div class="main-action d-flex align-items-center flex-wrap">
                <button class="btn-action-m" ng-disabled="disableKHDuyet" ng-click="LPXK_XuatGiaoTay()">
                    <span>Xuất giao tay</span>
                </button>
                <button class="btn-action-m" ng-disabled="disableKHDuyet" ng-click="LPXK_XuatThangTuHD()">
