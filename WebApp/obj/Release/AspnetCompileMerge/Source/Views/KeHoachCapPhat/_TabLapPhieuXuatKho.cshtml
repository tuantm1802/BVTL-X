<div class="col-md-12" style=" position:relative">
    <div class="row">
        <div class="col-md-6" style="padding:0px; padding-right:5px;">
            <div class="form-infor has-border p-3">
                <h4 class="form-title">
                    Phiếu xuất kho
                </h4>
                <div class="row no-gutters">
                    <div class="content-table" style="height:300px; overflow-y:scroll;width: 100%;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center" style="width:5%"><input type="checkbox" /></th>
                                    <th class="text-center" style="width:15%">Chi tiết</th>
                                    <th class="text-center" style="width:20%">Mã phiếu</th>
                                    @*<th class="text-center" style="width:20%">Số phiếu H55</th>*@
                                    <th class="text-left">Kho xuất</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in LPXK_ListPhieuXuatKho">
                                    <td><input type="checkbox" /></td>
                                    <td>
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m ct-fix-lap" type="button" title="Xem chi tiết" ng-click="LPXK_GetDetailPXK(1,item)">
                                                <i class="fa fa-eye" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>{{item.MA_LENH}}</td>
                                    @*<td>{{item.SO_PHIEU_H55}}</td>*@
                                <td>{{(item.TEN_KHO_XUAT != null && item.TEN_KHO_XUAT != '') ? item.TEN_KHO_XUAT : item.TEN_CONG_TY }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="form-infor has-border p-3" style="margin-top: 8.5px;">
                <h4 class="form-title">
                    Giao kế hoạch sản xuất
                </h4>
                <div class="row no-gutters">
                    <div class="content-table" style="height:300px; overflow-y:scroll;width: 100%;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center" style="width:5%"><input type="checkbox" /></th>
                                    <th class="text-center" style="width:15%">Chi tiết</th>
                                    <th class="text-center" style="width:15%">Mã phiếu</th>
                                    <th class="text-left">Công ty</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in LPXK_ListGKHSX ">
                                    <td><input type="checkbox" /></td>
                                    <td>
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m ct-fix-lap" type="button" title="Xem chi tiết" ng-click="LPXK_GetDetailPXK(0,item)">
                                                <i class="fa fa-eye" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>{{item.MA_PHIEU}}</td>
                                    <td>{{item.TEN_CONG_TY}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6" style="padding:0px; ">
            <div class="tb-cu">
