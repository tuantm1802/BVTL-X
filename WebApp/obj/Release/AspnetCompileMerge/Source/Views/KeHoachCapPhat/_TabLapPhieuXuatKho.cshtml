                    </li>

                    <li class="nav-item">
                        <a class="nav-link" id="lpxkUTKH-tab" data-toggle="tab" href="#lpxk_2" role="tab">Ứng trước kế hoạch</a>
                    </li>
                </ul>

                <div class="tab-content mt-1 pl-3 pr-3" style="padding-left:10px !important; padding-right:10px !important;">
