                                                        <div class="form-search w-100">
                                                            <input type="text" placeholder="Tìm kiếm" ng-model="TrangPhucText">
                                                            <button class="bg-green" style="color:white" ng-click="ChangeLoaiTrangPhuc()">
                                                                <i class="fa fa-search" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-table">
                                        <div style="height:310px; overflow-y:scroll;">
                                            <table class="table-responsive table-hover result-point">
                                                <thead class="point-table-head">
                                                    <tr>
                                                        <th class="left">Tên hàng</th>
                                                        <th class="text-right" style="width:20%">Số lượng</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="">
                                                    <tr ng-repeat="item in LPXK_ListSPD">
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>

                                </fieldset>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
