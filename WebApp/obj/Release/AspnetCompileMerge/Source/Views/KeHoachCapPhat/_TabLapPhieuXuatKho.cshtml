                                        <div class="form-search w-100">
                                            <input type="text" placeholder="Tìm kiếm" ng-model="LPXK_TenHangText">
                                            <button class="bg-green" style="color:white" ng-click="LPXK_GetSearchDetailPXK()">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix">

                        </div>
