                                            <td>{{item.TEN_SP}}</td>
                                            <td>{{item.SL_NO_KY_TRUOC}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                    <div class="tab-pane fade" id="lpxk_2" role="tabpanel" aria-labelledby="lpxkUTKH-tab">
                        <div class="row">
                            <div class="col-sm-12" style="padding:0px;padding-right:10px;">
                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                                    <legend class="scheduler-border" style="width: 270px;"><label class="bold-label">Danh sách đổi tiêu chuẩn</label></legend>
                                    <div class="row">
                                        <div class="col-md-12 text-right pull-right">
                                            <div class="row">
                                                <div class="col-sm-4 no-padding text-right">
                                                    <label>Tìm kiếm</label>
                                                </div>
                                                <div class="col-sm-8">
