<div class="form-infor has-border p-3">
    <div class="row no-gutters">
        <div class="col-12 col-md-6">
            <div class="main-action d-flex flex-wrap">
                <button class="btn-action-m cl-3" ng-disabled="disableKHDuyet" ng-click="TabDKCSGKHMD_Luu()">
                    <img src="~/App_Assets/images/icon_save.svg">
                    <span>Lưu</span>
                </button>
                <button class="btn-action-m cl-3" ng-disabled="disableKHDuyet">
                    <span>Đề xuất (Auto)</span>
                </button>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="main-action">
                <div class="form-search w-100">
                    <input type="text" placeholder="Tìm kiếm" ng-model="TabDKCSGKHMD_KeywordTrangPhuc">
                    <button>
                        <img src="~/App_Assets/images/search_icon.svg" ng-click="TabDKCSGKHMD_SearchTrangPhuc()" alt="">
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row no-gutters">
    <div class="col-12 col-md-5">
        <fieldset class="scheduler-border pb-2" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;padding-bottom: 5px !important;">
            <legend class="scheduler-border" style="width: 225px;"><label class="bold-label">Trang phục khác</label></legend>
            <div class="content-table" style="height:auto; overflow-y:scroll;">
                <table class="table-responsive table-hover result-point small-table">
                    <thead class="point-table-head">
                        <tr>
                            @*<th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="TabDKCSGKHMD_CheckAllTPKhac" ng-change="TabDKCSGKHMD_ChangeCheckAllTPKhac()" /> </th>*@
                            <th>STT</th>
                            <th>Trang phục</th>
                            <th>SL kế hoạch</th>
                            <th>Đăng ký</th>
                        </tr>
                    </thead>
                    <tbody class="">
                        <tr ng-repeat="item in TabDKCSGKHMD_TrangPhucKhacs">
                            @*<td class="center"><input type="checkbox" ng-change="TabDKCSGKHMD_CheckedTPKhac($index)" class="form-control" ng-model="item.SELECT" /> </td>*@
                            <td>{{$index +1}}</td>
                            <td>{{item.TEN_SP}}</td>
                            <td>{{item.SO_LUONG_KH | number}}</td>
                            <td>
                                <input ng-model="item.SO_LUONG_DK" min="0" ng-change="TabDKCSGKHMD_TPKChangeSoLuongDK(item, $index)" class="form-control" type="number" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </fieldset>
    </div>
    <div class="col-12 col-md-7">
        <div class="tb-cu">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#dang-ky-co-so" role="tab">Đăng ký cỡ số</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#giao-kh-may-do" role="tab">Giao kế hoạch may đo</a>
                </li>
            </ul>

            <div class="tab-content mt-1">
                <div class="tab-pane fade show active" id="dang-ky-co-so" role="tabpanel" aria-labelledby="profile-tab">
                    <div class="content-table" style="height:auto; overflow-y:scroll;">
                            <table class="table-nested table table-striped table-bordered table-hover small-table">
                                <thead>
                                    <tr>
                                        @*<th class="cell-input">
                                            <input ng-checked="TabDKCSGKHMD_CheckAllTPDKCS" class="form-control" ng-click="toggleAllCheckboxes($event)" type="checkbox" />
                                        </th>*@
                                        <th class="left" style="width:8%;"></th>
                                        <th class="text-center">Trang phục</th>
                                        <th class="text-center" style="width: 75px !important;">Tồn kho bộ </th>
                                        <th class="text-center" style="">SL kế hoạch </th>
                                        <th class="text-center" style="width: 75px !important;">Còn đăng ký </th>
                                    </tr>
                                </thead>
                                <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_treedkcs.html&#39;" ng-repeat="item in TabDKCSGKHMD_DangKyCoSos">
                                </tbody>
                            </table>
                            <script id="table_treedkcs.html" type="text/ng-template">
                                <tr ng-class="{parent: item.children}" ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)">
                                    @*<td class="cell-input">
                                        <input ng-change="TabDKCSGKHMD_ChangeCheckbox(item, parentScope)" ng-model="item.selected" class="form-control" type="checkbox" />
                                    </td>*@
                                    <td class="cell-name" style="width:8%;padding-left:5px;vertical-align: middle;text-align: center;" ng-click="item.opened = !item.opened">
                                        <div class="indent" ng-if="item.parent" style="padding-left: {{15*level}}px"></div>
                                    </td>
                                    <td class="cell-name" style="padding: 8px !important;">
                                        <b>{{item.name}}</b>
                                    </td>
                                    <td class="cell-name" style="padding: 8px !important;width: 93px !important;">
                                        {{item.SO_LUONG_TK}}
                                    </td>
                                    <td class="cell-members" style="padding: 8px !important;width: 124px !important;">
                                        <span  ng-if="item.parent">{{item.SO_LUONG_KH}}</span>
                                        <input  ng-if="!item.parent" ng-change="TabDKCSGKHMD_ChangeSoLuongKeHoach(item)" min="0" ng-model="item.SO_LUONG_KH" class="form-control" type="number" />
                                    </td>
                                    <td class="cell-members" style="padding: 8px !important;width: 100px !important;">
                                        {{item.SO_LUONG_DK}}
                                    </td>
                                </tr>
                                <tr class="children" ng-if="item.children &amp;&amp; item.children.length &gt; 0">
                                    <td colspan="6">
                                        <table class="table-nested table table-striped table-bordered table-hover">
                                            <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_treedkcs.html&#39;" ng-init="level = level + 1" ng-repeat="item in item.children"></tbody>
                                        </table>
                                    </td>
                                </tr>
                            </script>
                    </div>
                </div>
                <div class="tab-pane fade" id="giao-kh-may-do" role="tabpanel" aria-labelledby="profile-tab">
                    <div class="content-table" style="height:auto; overflow-y:scroll;">
                        
                        <table class="table-responsive table-hover result-point small-table">
                            <thead class="point-table-head">
                                <tr>
                                    @*<th rowspan="2" class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="TabDKCSGKHMD_CheckAllTPGKHMD" ng-change="TabDKCSGKHMD_ChangeCheckAllTPGKHMD()" /> </th>*@
                                    <th rowspan="2" class="left">STT</th>
                                    <th rowspan="2" class="left">Tên trang phục</th>
                                    <th rowspan="2" class="text-right" style="width:10%">SL kế hoạch </th>
                                    <th rowspan="2" class="text-right" style="width:10%">SL giao SX </th>
                                    <th class="text-right" style="width:10%" ng-show="TabDKCSGKHMD_IsShowCtyUT1 == true">{{TabDKCSGKHMD_TenCtyUT1}} </th>
                                    <th class="text-right" style="width:10%" ng-show="TabDKCSGKHMD_IsShowCtyUT2 == true">{{TabDKCSGKHMD_TenCtyUT2}} </th>
                                </tr>
                                <tr>
                                    <th class="text-right" style="width:10%" ng-show="TabDKCSGKHMD_IsShowCtyUT1 == true">SL giao SX </th>
                                    <th class="text-right" style="width:10%" ng-show="TabDKCSGKHMD_IsShowCtyUT2 == true">SL giao SX </th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in TabDKCSGKHMD_GiaoKHMayDos">
                                    @*<td class="center"><input type="checkbox" ng-change="TabDKCSGKHMD_CheckedTPGKHMD($index)" class="form-control" ng-model="item.SELECT" /> </td>*@
                                    <td>{{$index +1}}</td>
                                    <td>{{item.TEN_SP}}</td>
                                    <td>{{item.SO_LUONG_KH | number}}</td>
                                    <td><input ng-change="TabDKCSGKHMD_ChangeSoLuongGiaoSX($index)" min="0" ng-model="item.TONG_SL_GIAO_SX" class="form-control" type="number" /></td>
                                    <td ng-show="TabDKCSGKHMD_IsShowCtyUT1 == true"><input ng-change="TabDKCSGKHMD_ChangeSoLuongCty($index, item, 1)" min="0" ng-model="item.SL_GIAO_SX_CTUT1" class="form-control" type="number" /> </td>
                                    <td ng-show="TabDKCSGKHMD_IsShowCtyUT2 == true"><input ng-change="TabDKCSGKHMD_ChangeSoLuongCty($index, item, 2)" min="0" ng-model="item.SL_GIAO_SX_CTUT2" class="form-control" type="number" /> </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>
