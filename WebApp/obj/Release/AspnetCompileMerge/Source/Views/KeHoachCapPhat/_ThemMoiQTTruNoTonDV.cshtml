                </form>*@
                <table class="table-responsive table-hover result-point small-table">
                    <thead class="point-table-head">
                        <tr>
                            <th class="text-center" style="width:5%">
                        <label class="pos-rel">
                            <input type="checkbox" class="ace" ng-model="selectAllKeHoach" ng-click="checkAllDsKeHoach()" />
                            <span class="lbl"></span>
                        </label>
                    </th>
                    <th class="center">TT</th>
                            <th class="text-left">Số quyết toán</th>
                            <th class="text-center">Ngày tạo phiếu</th>
                            <th class="text-center">Năm kinh phí</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr ng-repeat="item in ListQTTruNoTonDV" ng-click="ShowDSSanPhamByKeHoach(item.ID_KH,$index)" class="e-cursor-pointer" ng-class="{selectedrow:$index==selectedRow}">
                            <td class="text-left"><input type="checkbox" ng-model="item.Selected" value="{{item.ID_KH}}" ng-click="checkValDsKeHoach($index)"></td>
                            <td class="text-center">{{$index + 1}}</td>
                            <td class="text-left tb-ip">{{item.SO_KH}}</td>
                            <td class="text-center">{{item.NGAY_TAO_TEXT}}</td>
                            <td class="text-center">{{item.NAM}}</td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="content-table mt-2 col-12 col-md-7 has-border" style="max-height: calc(100vh - 255px);">
                <div ng-show="showMessageTP" class="text-center ">
                    <span class="font-italic text-warning" ng-bind-html="messageContentTP | unsafe"></span>
                    <span ng-click="showHideMessageTP()"> (x) </span>
                </div>
                <div class="main-action d-flex flex-wrap" style="margin-bottom:5px; ">
                    
                    <button class="btn-action-m bg-green" ng-disabled="disableThemTrangPhuc" ng-click="btnThemMoiTheoDs('BX')">
                        <i class="fa fa-list" aria-hidden="true"></i>  <span>Thêm theo danh sách</span>
                    </button>
                    <button class="btn-action-m bg-green" ng-disabled="disabledTrangPhuc" ng-click="LuuKHQuyetToanTrangPhuc()">
                        <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                    </button>
                    <button class="btn-action-m bg-green" ng-disabled="disabledTrangPhuc" ng-click="HuyKHQuyetToanTrangPhuc()">
                        <i class="fa fa-ban" aria-hidden="true"></i>    <span> Huỷ thay đổi</span>
                    </button>
                    <button class="btn-action-m bg-red" ng-disabled="disabledTrangPhuc" ng-click="XoaKHQuyetToanTrangPhuc()">
                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Xóa </span>
                    </button>
                </div>

                <div class="content-table" style="max-height: calc(100vh - 390px); overflow: auto;">
                    <table class="table-responsive table-hover result-point small-table">
                        <thead class="point-table-head">
                            <tr>
                                <th style="width: 5%;" class="text-center tb-ip"><input type="checkbox" ng-model="selectAllTrangPhuc" ng-click="CheckAllTrangPhuc()"></th>
                                <th style="width: 70%;" class="text-center tb-clothes">Trang phục</th>
                                <th style="width: 25%;" class="text-center tb-number">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in ListTrangPhucTruNoTonDV">
                                <td class="text-left"><input type="checkbox" ng-model="item.Selected" value="{{item.ID}}" ng-click="checkValDsTrangPhuc($index)"></td>
                                <td class="text-left">
                                    <input type="hidden" ng-model="item.ID" />
                                    <select class="form-control" ui-select2 ng-model="item.ID_SP" ng-options="item.ID as item.TEN_SP for item in listSanPhamTruNoModal" ng-change="ChangeEnableTrangPhuc()"></select>
                                </td>
                                <td class="text-right"><input class="form-control" type="number" ng-model="item.SL_NO_CON_LAI" ng-change="ChangeEnableTrangPhuc()" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <!-- Modal footer -->
        <div class="modal-footer main-action">
            @*<button class="btn-action-m bg-green" ng-click="btnQuyetToan()">
                <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Quyết toán</span>
            </button>*@
            <button class="btn-action-m bg-orange" ng-click="cancel()">
                <i class="fa fa-times" aria-hidden="true"></i>    <span> Đóng</span>
            </button>
        </div>
    </div>
        
        
