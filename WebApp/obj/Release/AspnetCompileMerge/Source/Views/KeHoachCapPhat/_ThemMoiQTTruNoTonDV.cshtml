                    </button>*@
                    <button class="btn-action-m bg-green" ng-disabled="disableHuy" ng-click="HuyThayDoiQTTruNoTonDV()">
                        <i class="fa fa-ban" aria-hidden="true"></i>    <span> Huỷ thay đổi</span>
                    </button>
                    <button class="btn-action-m bg-red" ng-disabled="disableXoa" ng-click="XoaQTTruNoTonDV()">
                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Xóa </span>
                    </button>
                </div>
                <div ng-show="showMessage" class="text-center ">
                    <span class="font-italic text-warning" ng-bind-html="messageContent | unsafe"></span>
                    <span ng-click="showHideMessage()"> (x) </span>
                </div>
                @*<form >
                    <div class="main-action d-flex flex-wrap form-row align-items-center" style="margin-bottom:5px; " ng-disabled="disableThemMoi" id="divThemMoiQTTruNoTonDV">
                        
                        <div class="col-sm-6 my-1">
                            <label>Số quyết toán</label>
