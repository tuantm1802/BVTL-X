<form id="formDanhSachSPDoiTC" enctype="multipart/form-data" name="formAddFile">
    <div class="modal-header">
        <h4 class="modal-title">Danh sách sản phẩm đổi tiêu chuẩn</h4>
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-sm-6" style="padding:0px;padding-right:10px;">
                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                    <legend class="scheduler-border" style="width: 225px;"><label class="bold-label">Danh sách sản phẩm đổi</label></legend>
                    <div class="content-table" style="height:300px; overflow-y:scroll;">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width:5%">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="selectAll" ng-click="checkAllSPDoiTC()" />
                                            <span class="lbl"></span>
                                        </label>
                                    </th>
                                    <th class="text-center" style="width:5%">TT </th>
                                    <th class="left">Trang phục</th>
                                    <th class="text-right" style="width:15%">SL Cấp </th>
                                    <th class="text-right" style="width:15%">SL Đổi </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in TempDanhSachSPDoiTC">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-change="CheckSPDoi()" ng-model="item.Selected" value="{{item.ID}}" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="center"> {{$index +1}}</td>
                                    <td>{{item.TEN_SP}} </td>
                                    <td class="text-right"> {{item.SL_KE_HOACH}} </td>
                                    <td class="text-right">{{item.SL_DOI}} </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            </div>
            <div class="col-sm-6" style="padding:0px;">
                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                    <legend class="scheduler-border" style="width: 250px;"><label class="bold-label">Danh sách sản phẩm nhận</label></legend>
                    <div class="content-table" style="height:300px; overflow-y:scroll;">
                        <table class="table-responsive table-hover result-point small-table">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center" style="width:5%">TT </th>
                                    <th class="left">Trang phục</th>
                                    <th class="text-right" style="width:15%">SL nhận </th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in ListSanPhamNhan" style="cursor:pointer">
                                    <td class="text-center"> {{$index +1}}</td>
                                    <td>{{item.TEN_SP}} </td>
                                    <td class="text-center"> {{item.SL_DOI}} </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>

            </div>
        </div>
    </div>
    <div class="modal-footer">
        <h5 class="day-make"></h5>
        <div class="main-action d-flex flex-wrap">
            <button class="btn-action-m bg-green cl-3" ng-click="ChonSanPhamDoiTC()">
                <i class="fa fa-check-square-o" aria-hidden="true"></i>   <span>Chọn</span>
            </button>

            <button class="btn-action-m bg-orange cl-3" data-dismiss="modal" ng-click="cancel()">
                <i class="fa fa-ban" aria-hidden="true"></i>  <span>Hủy</span>
            </button>
        </div>
    </div>
</form>