
@model dynamic
@{
    ViewBag.Title = "Index";
}
<div ng-controller="SoLuongHocVienTruongCANDController">
    <div class="container-fluid d-flex flex-wrap">
        <div class="col-12 col-sm-12 col-md-2 col-lg-2">
            <div class="main-action pull-left pt-3 w-100">
                <label>Đơn vị</label>
                <select ng-model="modelSearch.don_vi_id" class="form-control">
                    <option value="">Chọn đơn vị</option>
                    <option value="{{item.ID}}" ng-repeat="item in listDonvi">{{item.TEN_DON_VI}}</option>
                </select>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-2 col-lg-2">
            <div class="main-action pull-left pt-3 w-100">
                <label>Số công văn: </label>
                <input type="text" id="txtsocongvan" value="@Model.socongvan" style="width: 100%;  margin-right: 15px" class="form-control" ng-model="modelSearch.socongvan">
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-2 col-lg-2">
            <div class="main-action pull-left pt-3 w-100">
                <label>Ngày tạo báo cáo: </label>
                <div class="input-group date" data-date-format="dd/mm/yyyy">
                    <input type="text" id="txtngaybaocao" customzdatetime value="@(((DateTime)Model.ngaybaocao).ToString("dd/MM/yyyy"))" style="width: 150px;" class="form-control" ng-model="modelSearch.ngaybaocao">
                    <span class="input-group-addon"></span>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-2 col-lg-2">
            <div class="main-action pull-left pt-3 w-100">
                <label>&nbsp;</label>
                <button class="btn-action-m" ng-click="XemBC()">
                    <i class="fa fa-yelp" aria-hidden="true"></i>
                    <span>Xem báo cáo</span>
                </button>
            </div>
        </div>

        <div id="containerReportViewer" class="col-12 col-sm-12 col-md-12 col-lg-12" style=" height: calc(100vh - 195px) !important;  text-align:center">

        </div>


    </div>
</div>

@section scripts{
    <script src="~/app/Controller/Report/SoLuongHocVienTruongCANDController.js"></script>
}