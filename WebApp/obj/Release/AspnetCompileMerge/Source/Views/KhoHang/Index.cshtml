                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head" style="width:100%">
                            <tr>
                                <th style="width:7%;" class="center"><input type="checkbox" class="form-control" ng-click="toggleAllLT()" ng-model="isAllSelectedLT" /> </th>

                                <th style="width:40%; padding:5px;">Kho chính</th>
                                <th style="width:40%; padding:5px;">Kho liên thông</th>

                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in dsKhoLT track by $index">
                                <td class="text-center">
                                    <input type="checkbox" class="form-control" ng-model="item.CHECKEDLT" ng-change="optionToggledLT()">
                                </td>

                                <td class="text-left">
                                    <select class="form-control" style="width:100%" ng-model="item.ID_KHO_CHINH" select2 required ng-options="i.ID as i.TEN_DON_VI for i in listKho"></select>
                                </td>
                                <td class="text-left">
                                    <select class="form-control" style="width:100%" ng-model="item.ID_KHO_LIEN_THONG" select2 required ng-options="i.ID as i.TEN_DON_VI for i in listKho"></select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="pages-switch">
                        <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearchLT.totalItems" show-length-per-page="true" items-per-page="modelSearchLT.pageSize" ng-model="modelSearchLT.currentPage" ng-change="pageChangedLT()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid d-flex cons-ac-system pt-10" style="padding-top: 20px;" ng-show="loaiDM == 'SP'">

            <div class="action-system pd-two ui-widget-content" id="resizable">
                <div class="container">
                    <div class="fill-box">
                        <h3 class="title-fill">
                            Danh sách kho liên thông
                        </h3>
                    </div>
                    <div class="content-table" style="height: calc(100vh - 250px)">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:40%; padding:5px;">Kho chính</th>
                                    <th style="width:40%; padding:5px;">Kho liên thông</th>

                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in dsKhoLT track by $index" ng-click="clickKhoSP(item)" ng-class="{active : chonKho == item.ID_KHO_CHINH}">
                                    <td class="text-left">
                                        {{item.TEN_KHO_CHINH}}
                                    </td>
                                    <td class="text-left">
                                        {{item.TEN_KHO_LT}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="content-system no-border pb-0">
                <div class="fill-box">
                    <h3 class="title-fill">
                        Danh sách sản phẩm không liên thông
                    </h3>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-9 col-lg-9">
                        <div class="main-action d-flex pull-left pt-3">
                            <button class="btn-action-m" ng-click="ThemSP()" ng-show="RoleBtnCreateSP">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                                <span>Thêm mới</span>
                            </button>
                            <button class="btn-action-m" ng-click="HuySP()" ng-show="RoleBtnCancelSP">
                                <i class="fa fa-ban" aria-hidden="true"></i>
                                <span>Hủy thay đổi</span>
                            </button>
                            <button class="btn-action-m" ng-click="LuuSP()" ng-show="RoleBtnSaveSP">
                                <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                <span> Lưu </span>
                            </button>
                            <button class="btn-action-m bg-red" ng-click="XoaSP()" ng-show="RoleBtnDeleteSP">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                                <span> Xóa </span>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-3 col-lg-3">
                        <div class="main-action pt-3">
                            <div class="form-search w-100">
                                <input type="text" ng-change="changesp()" placeholder="Tìm kiếm" ng-model="modelSearchSP.TEN_SP">
                                <button ng-show="RoleBtnSearchSP">
                                    <img src="~/App_Assets/images/search_icon.svg" ng-click="TimKiemSP()" alt="">
                                </button>
                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding:0;">
                    <div class="content-table" style=" height: calc(100vh - 285px) !important; overflow-y:auto !important;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:7%;" class="center"><input type="checkbox" class="form-control" ng-click="toggleAllSP()" ng-model="isAllSelectedSP" /> </th>
                                    <th style="width:5%; padding:5px;">STT</th>
                                    <th style="width:15%; padding:5px;">Mã H55</th>
                                    <th style="width:30%; padding:5px;">Tên sản phẩm</th>

                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in dsSP track by $index">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-control" ng-model="item.CHECKEDSP" ng-change="optionToggledSP()">
                                    </td>
                                    <td class="text-centrer">
                                        {{$index + 1}}
                                    </td>
                                    <td class="text-left">
                                        {{item.MA_H55}}
                                    </td>
                                    <td class="text-left">
                                        {{item.TEN_SP}}
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    }

    <div class="modal fade" id="modal_CH">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
