    var user = Session["USER_SESSION"] as Simple.Base.UserLogin;
}


<div ng-controller="DanhMucKhoHangController">

    <div class="fill-box-bread-crumb">
        <h3 class="bread_crumb">
            <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục kho hàng
        </h3>
    </div>
