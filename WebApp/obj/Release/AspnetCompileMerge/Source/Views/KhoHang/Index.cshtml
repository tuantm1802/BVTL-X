                    <button class="btn-action-m" ng-click="ThemLT()" ng-show="RoleBtnCreateLT">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        <span>Thêm mới</span>
                    </button>
                    <button class="btn-action-m" ng-click="HuyLT()" ng-show="RoleBtnCancelLT">
