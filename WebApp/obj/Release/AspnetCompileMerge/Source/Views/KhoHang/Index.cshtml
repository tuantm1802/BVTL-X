                <div class="modal-header">
                    <h4 class="modal-title">Danh sách Kho</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <form class=" col-md-12" id="formSubmit">

                        <div class="col-5 none-padding-left">
                            <div class="main-action">
                                <div class="form-search w-100">
                                    <input type="text" placeholder="Tìm kiếm" ng-model="KeywordCH">
                                    <button>
                                        <img src="~/App_Assets/images/search_icon.svg" ng-click="SearchKeywordCH()" alt="">
                                    </button>
                                </div>
                            </div>


                        </div>
                        <div class="row">
                            <div class="col-sm-5 none-padding">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"><label class="bold-label">Danh sách Kho chưa sử dụng</label></legend>

                                    <div class="content-table" style="height:422px; overflow-y: scroll;">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AllChuaSD" ng-change="CheckAllChuaSD()" /> </th>
                                                    <th>STT</th>
                                                    <th>Mã kho</th>
                                                    <th>Tên kho</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in ds_chua_sd">
                                                    <td class="center"><input type="checkbox" ng-change="CheckChuaSD($index)" class="form-control" ng-model="item.SELECT" /> </td>
                                                    <td>{{$index + 1}}</td>
                                                    <td>{{item.PHIEN_HIEU}}</td>
                                                    <td>{{item.TEN_DON_VI}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-sm-1">

                                <div class="main-action d-flex pull-left p-3 bold-label">
                                    <button class="btn-action-m" ng-click="CoSD()">
                                        <i class="fa fa-angle-right" aria-hidden="true"></i>
                                        <span></span>
                                    </button>

                                </div>
                            </div>
                            <div class="col-sm-1">

                                <div class="main-action d-flex pull-right p-3 bold-label">

                                    <button class="btn-action-m" ng-click="KhongSD()">
                                        <i class="fa fa-angle-left" aria-hidden="true"></i>
                                        <span></span>
                                    </button>

                                </div>
                            </div>
                            <div class="col-sm-5 none-padding">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"><label class="bold-label">Danh sách Kho đang sử dụng</label></legend>
                                    <div class="content-table" style="height:422px; overflow-y:scroll;">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AllDangSD" ng-change="CheckAllDangSD()" /> </th>
                                                    <th>STT</th>
                                                    <th>Mã kho</th>
                                                    <th>Tên kho</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in ds_dang_ssd">
