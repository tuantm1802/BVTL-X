    <div class="container-fluid" ng-show="loaiDM == 'KH'">
        <div class="row" style="margin-bottom:15px;margin-top:10px">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">

                <div class="main-action d-flex pull-left">
                    @if (user.Appcode == Common.AppCodeConfig.P1)
                    {
                        <button class="btn-action-m" ng-click="ThemKH()" ng-show="RoleBtnCreate">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            <span>Thêm mới</span>
                        </button>
                        <button class="btn-action-m" ng-click="HuyKH()" ng-show="RoleBtnCancel">
                            <i class="fa fa-ban" aria-hidden="true"></i>
                            <span>Hủy thay đổi</span>
                        </button>
                        <button class="btn-action-m" ng-click="LuuKH()" ng-show="RoleBtnSave">
                            <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                            <span> Lưu </span>
                        </button>
                        <button class="btn-action-m bg-red" ng-click="XoaKH()" ng-show="RoleBtnDelete">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                            <span> Xóa </span>
                        </button>
                    }
                    @if (user.Appcode != Common.AppCodeConfig.P1)
                    {

                        <button class="btn-action-m" ng-click="btnCauHinh()" ng-show="RoleBtnCauHinh">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            <span>Cấu hình</span>
                        </button>

                    }
                </div>

            </div>
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <div class="form-inline pull-right">
                    @*<div class="form-group" style="margin-right:15px;">
                            <select ng-change="changeKhoCha()" select2 style="width:250px" ng-model="modelSearchKH.DON_VI_CHA_ID" class="form-control">
                                <option value="">-- Chọn kho cha --</option>
                                <option value="{{item.ID}}" ng-repeat="item in listKho">{{item.TEN_DON_VI}}</option>
                            </select>
                        </div>*@
                    <div class="form-group">
                        <div class="input-group">
                            <input type="text" ng-model-options="{ debounce: 800 }" ng-change="changeKH()" placeholder="Tìm kiếm" ng-model="modelSearchKH.TEN_DON_VI" class="form-control">
                            <div class="input-group-prepend-right">
                                <button class="main-action btn-action-m" style="color:white" ng-click="TimKiemKH()" @*ng-show="RoleBtnSearch"*@>
                                    <i class="fa fa-search" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12 no-padding">
                <div class="content-table">
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head" style="width:100%">
                            <tr>
                                <th style="width:5%;" class="center"><input type="checkbox" class="form-control" ng-click="toggleAllKH()" ng-model="isAllSelectedKH" /> </th>
                                <th style="width:3%; padding:5px;">STT</th>
                                <th style="width:10%; padding:5px;">Mã kho</th>
                                <th style="width:12%; padding:5px;">Tên kho</th>
                                <th style="width:10%; padding:5px;">Khu vực</th>
                                @*<th style="width:12%; padding:5px;">Nhóm đơn vị</th>*@
                                <th style="width:10%; padding:5px;">Loại kho</th>
                                <th style="width:15%; padding:5px;">Địa chỉ</th>
                                <th style="width:15%; padding:5px;">Trạng thái</th>
                                @if (user.Appcode == Common.AppCodeConfig.P1)
                                {
                                    <th style="width:5%; padding:5px;">Hiệu lực</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in dsNhapKho track by $index" ng-click="loadTemplate($index)">
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-model="item.CHECKEDKH" ng-change="optionToggledKH() value=" 10"">
                                </td>
                                <td class="text-center">
                                    {{(modelSearch.currentPage - 1)*modelSearch.pageSize + $index + 1}}
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.PHIEN_HIEU}}</span>
                                    <input ng-if="item.EDIT" type="text" ng-pattern="/^([a-zA-Z0-9]+)$/" ng-change="changeEdit($index)" to-Uppercase class="form-control" ng-model="item.PHIEN_HIEU">
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_DON_VI}}</span>
                                    <input ng-if="item.EDIT" type="text" ng-change="changeEdit($index)" class="form-control" ng-model="item.TEN_DON_VI">
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_KHU_VUC}}</span>
                                    <select class="form-control" ng-if="item.EDIT" ng-model="item.KHU_VUC_ID" ng-change="changeEdit($index)" @*ng-change="chengaKV(item, 'EDIT')"*@ select2 name="KHU_VUC_ID" ng-options="itemk.ID as itemk.TEN_KHU_VUC for itemk in ListKhuVuc" style="width:100%;">
                                        <option value="">--Chọn Khu vực--</option>
                                    </select>
                                </td>
                                <!--<td class="text-left">
                                <span ng-if="!item.EDIT">{{item.TEN_NHOM_DV}}</span>
                                <select class="form-control" ng-if="item.EDIT"  ng-model="item.NHOM_DON_VI_ID" ng-change="changeEdit($index, item)"-->
                                @*ng-change="chengaKV(item, 'EDIT')"*@
                                <!--select2 name="NHOM_DON_VI_ID" ng-options="itemk.ID as itemk.TEN_NHOM_DV for itemk in ListNhomDonVi" style="width:100%;">
                                        <option value="">--Chọn nhóm đơn vị--</option>
                                    </select>
                                </td>-->
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_LOAI_KHO}}</span>
                                    <select ng-if="item.EDIT" class="form-control" ng-change="changeEdit($index)" style="width:100%" ng-model="item.LOAI_KHO" select2 required ng-options="i.ID as i.TEN for i in listLoaiKho">
                                        @*<option value=""> -- Chọn loại kho --  </option>*@
                                    </select>
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.CONTACT_ADDRESS}}</span>
                                    <input ng-if="item.EDIT" type="text" ng-change="changeEdit($index)" class="form-control" ng-model="item.CONTACT_ADDRESS">
                                </td>
                                <td class="text-left">
                                    <span ng-if="!item.EDIT">{{item.TEN_TRANG_THAI}}</span>
                                    <select ng-if="item.EDIT" class="form-control" ng-change="changeEdit($index)" style="width:100%" ng-model="item.TRANG_THAI" select2 required ng-options="i.ID as i.TEN for i in listTrangThai">
                                        <option value=""> -- Chọn trạng thái --  </option>
                                    </select>
                                </td>
                                @if (user.Appcode == Common.AppCodeConfig.P1)
                                {
                                    <td class="text-center">
                                        <input type="checkbox" class="ace" ng-change="changeEdit($index)" ng-true-value="'Y'" ng-false-value="'N'" ng-model="item.HIEU_LUC" value="10" />
                                    </td>
                                }
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr ng-repeat="row in rows">
                                <td class="text-center">
                                    <input type="checkbox" id="check" ng-model="row.CHECKEDKH" />
                                </td>
                                <td class="text-center">{{modelSearch.pageSize * modelSearch.currentPage > modelSearch.totalItems ?  modelSearch.totalItems+1+$index : modelSearch.pageSize * modelSearch.currentPage +1+$index}}</td>
                                <td class="text-left">

                                    <input type="text" to-Uppercase class="form-control" ng-pattern="/^([a-zA-Z0-9]+)$/" ng-model="row.PHIEN_HIEU">
                                </td>
                                <td class="text-left">

                                    <input type="text" class="form-control" ng-model="row.TEN_DON_VI">
                                </td>
                                <td class="text-left">

                                    <select class="form-control" ng-model="row.KHU_VUC_ID" ng-change="chengaKV(row, 'INSERT')" select2 name="KHU_VUC_ID" ng-options="itemk.ID as itemk.TEN_KHU_VUC for itemk in ListKhuVuc" style="width:100%;">
                                        <option value="">--Chọn Khu vực--</option>
                                    </select>
                                </td>
                                @*<td class="text-left">

            <select class="form-control" ng-model="row.NHOM_DON_VI_ID" ng-change="chengaKV(row, 'INSERT')" select2 name="NHOM_DON_VI_ID" ng-options="itemk.ID as itemk.TEN_NHOM_DV for itemk in ListNhomDonVi" style="width:100%;">
                <option value="">--Chọn nhóm đơn vị--</option>
            </select>
        </td>*@
                                <td class="text-left">

                                    <select class="form-control" style="width:100%" ng-model="row.LOAI_KHO" select2 required ng-options="i.ID as i.TEN for i in listLoaiKho">
                                        @*<option value=""> -- Chọn loại kho --  </option>*@
                                    </select>
                                </td>
                                <td class="text-left">

                                    <input type="text" class="form-control" ng-model="row.CONTACT_ADDRESS">
                                </td>
                                <td class="text-left">

                                    <select class="form-control" style="width:100%" ng-model="row.TRANG_THAI" select2 required ng-options="i.ID as i.TEN for i in listTrangThai">
                                        <option value=""> -- Chọn trạng thái --  </option>
                                    </select>
                                </td>
                                @if (user.Appcode == Common.AppCodeConfig.P1)
                                {
                                    <td class="text-center">
                                        <input type="checkbox" class="ace" ng-true-value="'Y'" ng-false-value="'N'" ng-model="row.HIEU_LUC" value="10" />
                                    </td>
                                }
                                </tr>
                        </tfoot>
                    </table>
                    <div class="pages-switch">
                        <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" show-length-per-page="true" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (user.Appcode == Common.AppCodeConfig.P7)
    {
        <div class="container-fluid d-flex flex-wrap" ng-show="loaiDM == 'LT'">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
