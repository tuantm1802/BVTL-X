<div class="action-system pd-two ui-widget-content ui-resizable" id="resizable">
    <button id="btn-changes-s-nav">
        <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
    </button>
    <div class="container">
        <div class="form-infor p-3">
            <h4 class="form-title">
                Tìm kiếm
            </h4>
            <form id="e-danhsachhoso">
                <div class="row no-gutters">
                    <div class="col-12 col-md-12">
                        <label>Kho</label>
                        <select class="form-control" ng-model="hangDoi.Kho" ng-options="option.ID as option.TEN_DON_VI for option in listKho">
                            <option value="">- - - Chọn kho - - -</option>
                        </select>
                    </div>
                    <div ng-if="chkNVPK" class="col-12 col-md-12">
                        <label>Nhóm dữ liệu</label>
                        <select class="form-control" ng-model="hangDoi.NhomDuLieu" ng-change="GetListLoaiHangHoa()" ng-options="option.CODE as option.NAME for option in listNhomDL">
                            <option value="">- - - Chọn nhóm dữ liệu - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-12">
                        <label>Loại hàng</label>
                        <select class="form-control" ng-model="hangDoi.LoaiHangHoa" ng-change="GetListNhomHangHoa()" ng-options="option.ID as option.NAME for option in listLoaiHangHoa">
                            <option value="">- - - Chọn loại hàng - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-12">
                        <label>Nhóm hàng</label>
                        <input type="text" class="form-control" ng-change="ChangeNhomHangHoa()" ng-model="hangDoi.NhomHangHoa" placeholder="- - - Chọn nhóm hàng - - -" autocomplete="on"
                                                                           ui-combo-tree combo-tree-init="NhomHHTreeInit" on-callback="NhomHHCallback(data)" root-item="RootItem" />
                        </div>
                    <div class="col-12 col-md-12">
                        <label>Tại thời điểm</label>
                        <div class="input-group date" data-date-format="dd/mm/yyyy">
                            <input type="text" customzdatetime class="form-control" ng-model="hangDoi.ThoiDiem">
                            <span class="input-group-addon"></span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="d-flex align-item-center">
            <div class="main-action" style="margin: 0 auto;">
                <button class="btn-action-m bg-green" ng-click="TimKiem()">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </div>
    </div>
</div>