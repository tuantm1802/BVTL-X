<table id="dynamic-table" class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th class="center">Số kế hoạch </th>
            <th style="width:25%;" class="center">Ngày tạo </th>
            <th style="width:25%;" class="center" >Trạng thái </th>
        </tr>
    </thead>
    <tbody>
        <tr ng-repeat="item in ListKHCapPhat" ng-class="{activerow:$index==selectedRowKeHoach}" ng-click="CP_SelectKeHoach(item,$index)">
            <td class="text-center">{{item.SO_KH}}</td>
            <td class="text-center">{{item.NGAY_TAO_TEXT}}</td>
            <td class="text-left">{{item.TRANG_THAI == 'I' ? 'Khởi tạo' : item.TRANG_THAI == 'A' ? 'Đã duyệt' : 'Đã hủy'}}</td>
        </tr>
    </tbody>
</table>