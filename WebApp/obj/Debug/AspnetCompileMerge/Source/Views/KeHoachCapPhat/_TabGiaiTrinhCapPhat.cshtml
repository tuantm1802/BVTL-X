
<div class="row" style="margin-top: 5px;">
    <div class="col-md-12">
        <div class="main-action d-flex align-items-center flex-wrap">
            <button class="btn-action-m" ng-click="DuyetKeHoachXuatKkho()">
                <i class="fa fa-check-square-o" aria-hidden="true"></i> <span>Duyệt xuất kho</span>
            </button>

            <button class="btn-action-m" ng-click="GiaiTrinhCapPhat()">
                <i class="fa fa-file-excel-o" aria-hidden="true"></i> <span>Xuất kho excel</span>
            </button>

            <button class="btn-action-m" ng-click="ChonLanhDaoPheDuyetKH()" ng-show="hdChonLanhDaoPheDuyetKH">
                <i class="fa fa-plus" aria-hidden="true"></i>  <span>Trình lãnh đạo ký duyệt</span>
            </button>
            <button class="btn-action-m" ng-click="DuyetKeHoach()" ng-show="hdDuyetKeHoach">
                <i class="fa fa-check-square-o" aria-hidden="true"></i> <span>Duyệt KH</span>
            </button>
            <button class="btn-action-m" ng-click="TuChoiDuyetKeHoach()" ng-show="hdTuChoiDuyetKH">
                <i class="fa fa-ban" aria-hidden="true"></i> <span>Hủy duyệt KH</span>
            </button>
        </div>
    </div>
</div>