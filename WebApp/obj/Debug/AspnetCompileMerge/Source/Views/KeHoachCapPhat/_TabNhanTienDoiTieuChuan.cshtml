                                </div>

                            </fieldset>
                        </div>
                        <div class="col-sm-6" style="padding:0px;">
                            <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                                <legend class="scheduler-border" style="width: 235px;"><label class="bold-label">Danh sách được nhận</label></legend>
                                <div class="row">
                                    <div class="col-12 col-md-12 col-lg-12">
                                        <div class="main-action pt-3" style="margin-top:20px">
                                            @*<div class="form-search w-100">
                                                    <input type="text" placeholder="Tìm kiếm" ng-model="SPN_TenSanPham" ng-change="SPN_TimKiem()">
                                                    <button class="bg-green" style="color:white" ng-click="SPN_TimKiem()">
                                                        <i class="fa fa-search" aria-hidden="true"></i>
                                                    </button>
                                                </div>*@
                                        </div>
                                    </div>
                                </div>
                                <div class="content-table" style="height:365px; overflow-y:scroll;">
                                    <table class="table-responsive table-hover result-point small-table">
                                        <thead class="point-table-head">
                                            <tr>
                                                <th class="text-center" style="width:5%">TT </th>
                                                <th class="left">Trang phục</th>
                                                <th class="text-right" style="width:15%">SL nhận </th>
                                            </tr>
                                        </thead>
                                        <tbody class="">
                                            <tr ng-repeat="item in ListSanPhamDich" style="cursor:pointer">
                                                <td class="text-center"> {{$index +1}}</td>
                                                <td>{{item.TEN_SP}} </td>
                                                <td class="text-center"> {{item.SL_DOI}} </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>