                                                <i class="fa fa-floppy-o" aria-hidden="true"></i>
                                                <span>Lưu</span>
                                            </button>
                                            <button class="btn-action-m ct-fix-lap bg-green"  type="button" ng-click="HuyDanhSachDoiTC()">
                                                <i class="fa fa-ban" aria-hidden="true"></i>
                                                <span>Hủy thay đổi</span>
                                            </button>
