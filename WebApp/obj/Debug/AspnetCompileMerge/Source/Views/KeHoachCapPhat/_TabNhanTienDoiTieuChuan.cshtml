                                <button class="btn-action-m bg-green pull-left" ng-click="btnDSDKNhanTien()">
                                    <i class="fa fa-plus" aria-hidden="true"></i>  <span>SL đăng ký</span>
                                </button>
                                @*<button class="btn-action-m bg-green pull-left" ng-click="btnDSDKNhanTienTuDong()">
