@{
    ViewBag.Title = "Cấu hình cấp bậc";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Cấu hình cấp bậc
    </h3>
</div>
<div ng-controller="CauHinhCapBacController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;  padding-right: 2px;">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-2 col-md-2 col-lg-2">
                                <label style="color:#f5f5f5">Loại hàm: </label>
                                <div class="main-action d-flex">
                                    <button class="btn-action-m bg-green"
                                            ng-click="addData()" ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-red"
                                            ng-click="deleteData()" ng-show="RoleBtnDelete"
                                            style="margin-right: 10px;background-color:#f55442;">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xoá</span>
                                    </button>
                                </div>
                            </div>
                            <div class="col-2 col-md-2 col-lg-2">
                                <label>Loại quân số: </label>
                                <select class="form-control" ng-model="modelSearch.LoaiQuanSo" ng-options="item.Id as item.Name for item in LoaiQuanSos">
                                    <option value="" selected>-----Chọn loại QS-------</option>
                                </select>
                            </div>
                            <div class="col-2 col-md-2 col-lg-2">
                                <label>Lực lượng: </label>
                                <input type="text" class="form-control" id="justAnotherInputBox" ng-change="ChangeLucLuong()" ng-model="Abc" placeholder="lực lượng" autocomplete="off" />
                                @*<select class="form-control" ng-model="modelSearch.LucLuongId" ng-options="item.ID as item.TEN_NHOM_CB for item in NhomCapBacs">
                                        <option value="" selected>-----Chọn lực lượng-------</option>
                                    </select>*@
                            </div>
                            <div class="col-2 col-md-2 col-lg-2">
                                <label>Nhóm CB: </label>
                                @*<input type="text" class="form-control" id="justAnotherNhomCB" ng-change="ChangeNhomCB()" ng-model="Abc" placeholder="lực lượng" autocomplete="off" />*@

                                <select class="form-control" ng-model="modelSearch.NhomCBId" ng-options="item.ID as item.TEN_NHOM_CB for item in NhomCapBacs">
                                    <option value="" selected>-----Chọn nhóm cấp bậc-------</option>
                                </select>
                            </div>
                            <div class="col-2 col-md-2 col-lg-2">
                                <label>Loại hàm: </label>
                                <select class="form-control" ng-model="modelSearch.LoaiHamId" ng-options="item.ID as item.LOAI_HAM for item in LoaiHams">
                                    <option value="" selected>-----Chọn loại hàm-------</option>
                                </select>
                            </div>
                            <div class="col-2 col-md-2 col-lg-2">
                                <label style="color:#f5f5f5">Loại hàm: </label>
                                <div class="main-action d-flex">
                                    <button class="btn-action-m form-control" ng-click="SearchCapBac()" ng-show="RoleBtnSearch">
                                        <i class="fa fa-search" aria-hidden="true"></i>
                                        <span>Tìm kiếm</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="margin-top:10px;">
                        <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center" style="width:5%;">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="CheckAll" ng-change="ChangeCheckAll()" />
                                            <span class="lbl"></span>
                                        </label>
                                    </th>
                                    <th class="text-center">STT</th>
                                    <th class="text-center">Lực lượng</th>
                                    <th class="text-center">Cấp bậc</th>
                                    <th class="text-center">Loại hàm</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in ListData">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.selected" ng-change="ChangeCheck()" value="10" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="text-center">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>
                                    <td>{{item.TEN_LL}}</td>
                                    <td>{{item.TEN_CB}}</td>
                                    <td>{{item.LOAI_HAM}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="pages-switch">
                            <ul class="pagination pagination-sm m-0 float-right"
                                uib-pagination total-items="modelSearch.totalItems"
                                items-per-page="modelSearch.pageSize"
                                ng-model="modelSearch.currentPage"
                                ng-change="pageChanged()"
                                max-size="modelSearch.maxSize"
                                boundary-links="true"
                                rotate="false"
                                previous-text="&lsaquo;"
                                next-text="&rsaquo;"
                                first-text="&laquo;"
                                last-text="&raquo;">
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
    @Html.Partial("~/Views/CauHinhCapBac/_add.cshtml")
</div>

@section scripts{
    <script src="~/app/Controller/CauHinhCapBacController.js"></script>
}



