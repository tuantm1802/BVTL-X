<div class="modal fade" id="AddModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:1000px;">
        <div class="modal-content" style="width: 1200px; margin-left: -72%;">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Quân số trùng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-4 col-md-4 col-lg-4">
                        <label>Lực lượng: </label>
                        <input type="text" class="form-control" id="justAnotherLLAdd" ng-change="Add_ChangeLucLuong()" ng-model="Abc" placeholder="lực lượng" autocomplete="off" />

                    </div>
                    <div class="col-3 col-md-3 col-lg-3">
                        <label>Nhóm CB: </label>
                        @*<input type="text" class="form-control" id="justAnotherNhomCB" ng-change="Add_ChangeNhomCB()" ng-model="Abc" placeholder="lực lượng" autocomplete="off" />*@

                        <select class="form-control" ng-model="Add_NhomCBId" ng-options="item.ID as item.TEN_NHOM_CB for item in NhomCapBacs">
                            <option value="" selected>-----Chọn nhóm cấp bậc-------</option>
                        </select>
                    </div>
                    <div class="col-3 col-md-3 col-lg-3">
                        <label>Loại hàm: </label>
                        <select class="form-control" ng-model="Add_LoaiHamId" ng-options="item.ID as item.LOAI_HAM for item in LoaiHams">
                            <option value="" selected>-----Chọn loại hàm-------</option>
                        </select>
                    </div>
                    <div class="col-2 col-md-2 col-lg-2">
                        <label style="color:#f5f5f5">Loại hàm: </label>
                        <div class="main-action d-flex">
                            <button class="btn-action-m form-control" ng-click="SearchDataAdd()">
                                <i class="fa fa-search" aria-hidden="true"></i>
                                <span>Tìm kiếm</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="content-table" style="overflow: auto;padding-top:10px;height:500px;">
                    <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center" >
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="Add_CheckAll" ng-change="Add_ChangeCheckAll()" />
                                        <span class="lbl"></span>
                                    </label>
                                </th>
                                <th class="text-center" >STT</th>
                                <th class="text-center" >Lực lượng</th>
                                <th class="text-center" >Cấp bậc</th>
                                <th class="text-center" >Loại hàm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in DataAdd">
                                <td class="text-center">
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="item.selected" ng-change="Add_ChangeCheck()" value="10" />
                                        <span class="lbl"></span>
                                    </label>
                                </td>
                                <td class="text-center">{{$index + 1}}</td>
                                <td>{{item.TEN_LL}}</td>
                                <td>{{item.TEN_CB}}</td>
                                <td>{{item.LOAI_HAM}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-action-m bg-green" ng-click="Luu()">
                    <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Chọn</span>
                </button>
                <button class="btn-action-m bg-orange" data-dismiss="modal">
                    <i class="fa fa-times" aria-hidden="true"></i>    <span> Thoát</span>
                </button>
            </div>
        </div>
    </div>
</div>