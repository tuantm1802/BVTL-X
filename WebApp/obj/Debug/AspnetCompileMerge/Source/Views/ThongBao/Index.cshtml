
@{
    ViewBag.Title = "Danh sách thông báo";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Home/Index">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Thông báo</li>
    </ol>
</nav>
<div ng-controller="ThongBaoController">
    <main>
        <div class="container-fluid d-flex cons-ac-system">
            <div class="row  no-gutters w-100">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding-left:0px;padding-right:2px;height:100%;">
                    <div class="row" style="width:100%">
                        <div class="well form-infor" style="background-color: #f5f5f5;padding:25px;margin:25px 0;width:100%">
                            <div class="row">
                                <div class="col-xs-12 col-sm-4 col-md-12">
                                    <div class="form-group" style="float:left;margin-right:15px">
                                        <label>Loại thông báo: </label>
                                        <select name="loaithongbao" ng-change="LoadPage()" ng-model="modelSearch.loaithongbao">
                                            <option value="0">--- Tất cả các loại thông báo ---</option>
                                            <option value="2">Cấp phát</option>
                                            <option value="-1">Thông báo chung</option>
                                        </select>
                                    </div>
                                    <div class="form-group main-action d-flex pull-left pt-3 mr-2" style="float:left">
                                        <button ng-click="readThongBaoListIds()" class="btn-action-m" style="margin-top:12px">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            Đã đọc
                                        </button>
                                    </div>
                                    <div class="form-group main-action d-flex pull-left pt-3" style="float:left">
                                        <button ng-click="deleteThongBaoListIds()" class="btn-action-delete" style="margin-top:12px">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                            Xoá đã chọn
                                        </button>
                                    </div>

                                </div>
                                <div class="col-xs-12 col-sm-2">

                                </div>
                                <div class="col-xs-12 col-sm-5 col-md-6">

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table">
                        <table class="table-responsive table-hover result-point p7_hd">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center" style="width:5%;"><input type="checkbox" class="ace" ng-model="selectAll" ng-click="checkAll()" /></th>
                                    <th style="width:15%;">Chức năng </th>
                                    <th>Nội dung </th>
                                    <th style="width:10%;" class="text-center">Thời gian gửi </th>
                                    <th class="text-center" style="width:5%;">
                                        
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-class="fontbold(item.TRANG_THAI)" ng-repeat="item in ListThongBao">
                                    <td class="text-center"><input type="checkbox" class="ace" ng-model="item.SELECT" value="{{item.ID}}" /></td>
                                    <td>{{item.TEN_CHUC_NANG}}</td>
                                    <td><a class="href-underline" ng-href="{{item.URL_CHUC_NANG}}" ng-click="readThongBaoListId(item.ID)">{{item.NOI_DUNG}}</a></td>
                                    <td>{{fdate(item.NGAY_TAO)}}</td>
                                    <td class="text-center">
                                        <a href="javascript:void(0)" class="seen" ng-click="deleteThongBaoListId(item.ID)"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="content-table pull-right">
                                <div class="pages-switch">
                                    <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.recordPerPage" ng-model="modelSearch.currentPage" ng-change="LoadPage()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts{
    <script src="~/app/Controller/ThongBaoController.js"></script> 
}
