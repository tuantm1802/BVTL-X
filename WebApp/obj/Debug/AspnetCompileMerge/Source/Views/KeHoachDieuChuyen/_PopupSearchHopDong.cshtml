<div class="modal fade" id="search-hop-dong">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Tìm kiếm hợp đồng</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <!-- Modal body -->
            <form class="modal-body row no-gutters" @*style="height:50vh"*@ id="frm-them-hang-hoa">
                <div class="content-table mt-2 col-12 col-md-12 has-border">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-10 col-md-10">
                            <div class="row">
                                <div class="col-6 col-md-6">
                                    <label>Số hợp đồng</label>
                                    <input class="form-control" ng-model="SearchHH_SoHopDong" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="">Công ty </label>
                                    <select class="form-control" ng-model="SearchHH_CongTy" ng-options="option.ID as option.TEN_CONG_TY for option in congTys" name="SearchHH_CongTy">
                                        <option value="">- - - Chọn công ty - - -</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-6">
                                    <label>Từ ngày</label>
                                    <div class="input-group date" data-date-format="dd/mm/yyyy">
                                        <input type="text" customzdatetime class="form-control" ng-model="SearchHH_TuNgay">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-6">
                                    <label>Đến ngày</label>
                                    <div class="input-group date" data-date-format="dd/mm/yyyy">
                                        <input type="text" customzdatetime class="form-control" ng-model="SearchHH_DenNgay">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-2 col-sm-2 col-md-2 col-lg-2">
                            <label for="" style="color:white;    font-size: 09px;margin-bottom: 12px;">Tìm kiếm hợp đồng</label>
                            <div class="main-action d-flex align-items-center justify-content-between flex-wrap" id="sub-action">
                                <div class="d-flex align-items-center flex-wrap">
                                    <button class="btn-action-m" ng-click="LayDanhSachHopDong()" title="Tìm kiếm hợp đồng">
                                        <i class="fa fa-search" aria-hidden="true"></i>
                                        <span>Tìm kiếm</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="height:310px; overflow-y:scroll;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th style="width:3%;">STT </th>
                                    <th class="text-center">Mã hợp đồng<i id="or_ntn"></i></th>
                                    <th class="text-center">Tên hợp đồng<i id="or_ntn"></i></th>
                                    <th class="text-center">Ngày ký<i id="or_ntn"></i></th>
                                    <th class="text-center">Ngày hết hạn<i id="or_ntn"></i></th>
                                    <th class="text-center">Ngày thanh lý<i id="or_ntn"></i></th>
                                    <th class="text-center">Công ty<i id="or_ntn"></i></th>
                                    <th class="text-center">Ghi chú<i id="or_ntn"></i></th>
                                </tr>
                            </thead>
                            <tbody style="background-color:white">
                                <tr ng-repeat="item in danhmuchopdong" ng-click="SearchHH_SelectedHopDong(item)">
                                    <td class="text-center">
                                        {{$index +1}}
                                    </td>
                                    <td>
                                        {{item.SO_HD }}
                                    </td>
                                    <td>
                                        {{item.TEN_HD}}
                                    </td>
                                    <td>
                                        {{item.NGAY_KY}}
                                    </td>
                                    <td>
                                        {{item.NGAY_CHOT_HD}}
                                    </td>
                                    <td>
                                        {{item.NGAY_THANH_LY_DK}}
                                    </td>
                                    <td>
                                        {{item.TEN_CONG_TY}}
                                    </td>
                                    <td>
                                        {{item.MO_TA}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </form>
            <div class="modal-footer">
                <div class="main-action d-flex flex-wrap">
                    <button type="button" class="btn btn-action-m" ng-click="SearchHH_ChooseHopDong()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Chọn</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Hủy</span>
                    </button>
                </div>
                
            </div>
        </div>
    </div>
</div>
