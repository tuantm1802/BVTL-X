<div class="modal fade" id="chi_tiet_hang_hoa_theo_hd">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Thông tin chi tiết</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <div class="modal-body">
                <form class="row" id="chi-tiet-hh-form">
                    <div class="col-12 col-md-5">
                        <label for="">Hợp đồng <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_HOP_DONG" ng-options="option.ID_HOP_DONG as option.SO_HD for option in danhmuchopdong" ng-change="ChangeHopDong(option)" name="hopdong" required>
                            <option value="">- - - Chọn hợp đồng - - -</option>
                        </select>
                    </div>
                    <div class="col-1 col-md-1">
                        <label for="" style="color:white;    font-size: 09px;margin-bottom: 12px;">Tìm kiếm hợp đồng</label>
                        <div class="main-action d-flex align-items-center justify-content-between flex-wrap">
                            <button type="button" class="btn-action-m" ng-click="ShowPopupSearchHD()" title="Mở tìm kiếm hợp đồng">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Nguồn kinh phí <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_NGUON_KP" ng-options="option.FLEX_VALUE_ID as option.DESCRIPTION for option in nguonKinhPhis" name="nguonKinhPhi" required>
                            <option value="">- - - Chọn nguồn kinh phí - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Nhóm hàng <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_NHOM_HH" ng-options="option.FLEX_VALUE_CATEGORY_ID as option.DESCRIPTION for option in nhomHangs" name="nhomhang" required>
                            <option value="">- - - Chọn nhóm hàng - - -</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="">Loại hàng <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_LOAI_HH" ng-options="option.FLEX_VALUE_CATEGORY_ID as option.DESCRIPTION for option in loaiHangs" name="loaihang" required>
                            <option value="">- - - Chọn loại hàng - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="">Số lượng tồn </label>
                        <input class=" form-control" disabled type="number" ng-model="HangHoa_SLTon" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="">Số lượng <span>*</span></label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.SO_LUONG" max="{{HangHoa_SLTon}}" ng-change="ValueCount($index)" name="soluong" required />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Chất lượng <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_CHAT_LUONG" ng-options="option.FLEX_VALUE_ID as option.DESCRIPTION for option in chatLuongs" name="chatluong" required>
                            <option value="">- - - Chọn chất lượng - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Model</label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MODEL" name="model" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Năm sản xuất</label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.NAM_SX" name="namsanxuat" />
                    </div>
                    <div class="col-12 col-md-6" ng-show="SerialStatus != 3">
                        <label for="">Số khung </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT2" ng-change="ChangeSoKhung_SoMay()" name="sokhung" />
                    </div>
                    <div class="col-12 col-md-6" ng-show="SerialStatus != 3">
                        <label for="">Số máy </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT3" ng-change="ChangeSoKhung_SoMay()" name="somay" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="">BKS </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.BKS" name="bks" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Ghi chú </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.GHI_CHU" name="ghichu" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Đơn giá </label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.DON_GIA" step="10000" ng-change="ValueCount($index)" name="dongia" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Thành tiền </label>
                        <input class=" form-control" type="number" disabled ng-model="chitietTheoHangHoa.THANH_TIEN" name="thanhtien" />
                    </div>

                    <div class="col-12 col-md-12" ng-show="SerialStatus != 2">
                        <label for="">Số serial </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.SO_SERIAL" name="serial" ng-keyup="AddModel($event)" />
                    </div>

                    <div ng-repeat="item in dsmodel track by $index" class="tag-widget" ng-show="SerialStatus != 2">
                        <span>{{item}}</span>
                        <button type="button" class="tag-close" ng-click="XoaModel($index)">
                            <i class="fa fa-times-circle"></i>
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="row" style="width: 35%;">
                    <div class="col-3 col-md-3 text-right">
                        <span>Tạo bản sao</span>
                    </div>
                    <div class="col-3 col-md-3 text-right">
                        <input class=" form-control" type="checkbox" ng-model="TaoBanSao" />
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="main-action d-flex flex-wrap">
                            <button type="button" class="btn btn-action-m" ng-click="LuuChiTiet()">
                                <img src="~/App_Assets/images/icon_save.svg" alt="">
                                <span>Lưu</span>
                            </button>
                            <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                                <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                                <span>Bỏ qua</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
