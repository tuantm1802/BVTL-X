<form id="formAddFile" enctype="multipart/form-data" name="formAddFile">
    <!-- Modal Header -->
    <div class="modal-header">
        <h4 class="modal-title">Danh sách quân số chi tiết</h4>
        <button type="button" class="close" ng-click="cancel()">
            <img src="../App_Assets/images/close.svg" alt="">
        </button>
    </div>

    <!-- Modal body -->
    <div class="modal-body">
        <div class="nav-tabs-box">
            <ul class="nav nav-tabs tab-main" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#cong-tac" role="tab">CB Công tác</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#nghia-vu" role="tab">C.Sỹ Nghĩa Vụ</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#cho-huu" role="tab">CB Chờ hưu</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#biet-phai" role="tab">CB Biệt Phái - Đi học</a>
                </li>

                @*<li class="nav-item">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#di-hoc" role="tab">CB Đi học</a>
                    </li>*@

                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#tuyen-moi" role="tab">T.Mới-Ph.Hàm</a>
