                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <select class="form-control" ng-change="LoadPage()" placeholder="Cấp bậc" ng-model="capBac" ng-options="item.Id as item.Name for item in ListCapBacs">
                        <option value="" selected>Chọn cấp bậc</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <input type="text" ng-model="lucLuong" ng-change="ChangeLucLuong()" placeholder="Lực lượng" autocomplete="on"
