                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <select class="form-control" ng-change="LoadPage()" ng-model="loaiHam" ng-options="item.Id as item.Name for item in ListLoaiHams">
                        <option value="" selected>- Chọn loại hàm -</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-1">
