<div class="modal fade" id="addCNVCA">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm số lượng đầu kỳ</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">

                <div class="col-sm-12 form-row" style="padding:0px;padding-right:10px;">
                    <div class="col-6 col-md-6 form-group">
                        <label for="">Nam: </label>
                        <input type="text" placeholder="" class="form-control" ng-model="cnvca.SL_NAM_DK">
                    </div>
                    <div class="col-6 col-md-6 form-group">
                        <label for="">Nữ: </label>
                        <input type="text" placeholder="" class="form-control" ng-model="cnvca.SL_NU_DK">
                    </div>
                </div>


            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">
                <h5 class="day-make"></h5>
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="AddCNVCA()">
                        <img src="~/App_Assets/images/d_save.svg" alt="" class="exsit">
                        <img src="~/App_Assets/images/icon_save.svg" alt="" class="hover_m">
                        <span>Lưu</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/d_close.svg" alt="" class="exsit">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                        <span>Hủy</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
