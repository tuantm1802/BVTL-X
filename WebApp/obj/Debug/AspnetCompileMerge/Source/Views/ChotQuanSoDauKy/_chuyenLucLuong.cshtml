<div class="row">
    
    <div class="col-md-12">
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                <div class="row no-gutters">
                    <div class="col-12 col-md-6 col-lg-2">
                        @*<label for="">Lực lượng: </label>*@
                        <select class="form-control" ng-model="DauKy_TrongKy">
                            <option value="DK" selected>Đầu kỳ</option>
                            <option value="TK" selected>Trong kỳ</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Lực lượng: </label>*@
                        <input type="text" ng-model="lucLuong" ng-change="ChangeLucLuong()" placeholder="Lực lượng" autocomplete="on"
                               ui-combo-tree combo-tree-init="LucLuongTreeInit" on-callback="LucLuongCallback(data)" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Nhóm cấp bậc: </label>*@
                        <input type="text" ng-model="nhomCapBac" ng-change="ChangeNhomCapBac()" placeholder="Nhóm cấp bậc" autocomplete="on"
                               ui-combo-tree combo-tree-init="NhomCBTreeInit" on-callback="NhomCBCallback(data)" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        @*<label for="">Cấp bậc: </label>*@
                        <select class="form-control" ng-model="capBac" ng-options="item.Id as item.Name for item in ListCapBacs">
                            <option value="" selected>Chọn cấp bậc</option>
                        </select>
                    </div>
                    <div class="main-action">
                        @*<label for=""> </label>*@
                        <div class="form-search w-100" style="height: 28px; ">
                            <button ng-click="LoadDataCBChuyenLL()" style="border-radius: 5px;">
                                <img src="../App_Assets/images/search_icon.svg" alt="">
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-table">
    <tree-grid show-checkbox="cll_tree_Table_Checkbox"
               expand-level="3"
               body-defs="cll_body_defs"
               tree-data="cll_tree_data"
               expand-on="cll_expanding_property"
               col-defs="cll_col_defs"
               icon-leaf="cll_treetable_docu"
               icon-expand="treetable_close"
               icon-collapse="treetable_open"
               event-change-checkbox="cll_ChangeTreeTableCheckbox(item)"
               event-choose-row="cll_ClickTreeTableRow(item)"></tree-grid>
</div>
