
<div class="modal-header">
    <h4 class="modal-title">Thông báo lỗi</h4>
    <button type="button" class="close" ng-click="cancel()">
        <img src="~/App_Assets/images/close.svg" alt="">
    </button>
</div>
<div class="modal-body">
    <div class="content-table mt-2" style="overflow: auto;height: calc(100vh - 280px);">
        <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
            <thead class="point-table-head">
                <tr>
                    <th class="text-center">STT</th>
                    <th class="text-center">Sheet</th>
                    <th class="text-center">Hàng</th>
                    <th class="text-center">Cột</th>
                    <th class="text-center">Mô tả</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in model">
                    <td class="text-center">{{$index + 1}}</td>
                    <td>{{item.TenSheet}}</td>
                    <td>{{item.Hang}}</td>
                    <td>{{item.Cot}}</td>
                    <td>{{item.MoTaLoi}}</td>
                </tr>
            </tbody>
        </table>
    </div>
