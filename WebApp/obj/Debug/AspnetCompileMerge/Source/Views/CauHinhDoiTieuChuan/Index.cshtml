@{
    ViewBag.Title = "Cấu hình đổi tiêu chuẩn";
}

<style type="text/css">
    .tccbcsParentcolor {
        background-color: #ffe2e2 !important;
        color: #900 !important;
    }
</style>
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Home/Index">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cấu hình đổi tiêu chuẩn</li>
    </ol>
</nav>
<div ng-controller="CauHinhDoiTieuChuanController">
    <main >
        <div class="container-fluid d-flex cons-ac-system">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-3 col-md-6 col-lg-3" style="padding-left:0px;padding-right:2px;height:100%;">
                    <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                        <legend class="scheduler-border" style="        width: 250px;"><label class="bold-label"><b>Cấu hình đổi tiêu chuẩn</b></label></legend>
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                <div class="main-action">
                                    <div class="form-search w-100">
                                        <input type="text" placeholder="Tìm kiếm" ng-model="TC_MaDoiTieuChuan">
                                        <button>
                                            <img src="~/App_Assets/images/search_icon.svg" ng-click="TC_TimKiem()" alt="">
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="content-table">
                            <table class="table-responsive table-hover result-point" height="345px" >
                                <thead class="point-table-head">
                                    <tr>
                                        <th class="text-center">STT</th>
                                        <th class="text-center">Ngày tạo</th>
                                        <th class="text-center">Mô tả</th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <tr ng-repeat="item in DSTieuChuan" ng-class="{activerow:$index==selectedRowTieuChuan}" ng-click="TC_SelectTieuChuan(item,$index )">
                                        <td class="text-center">{{$index +1}}</td>
                                        <td class="text-center">{{item.NGAY_TAO_TEXT}}</td>
                                        <td class="text-left">{{item.SO_QUYET_DINH}}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="pages-switch" style="padding-top:10px !important;">
                                <div class="main-action d-flex align-items-center flex-wrap" >
                                    <button class="btn-action-m ct-fix-lap" type="button" ng-click="TC_LamMoi()">
                                        <i class="fa fa-refresh" aria-hidden="true"></i>
                                        <span>Làm mới</span>
                                    </button>
                                    <button class="btn-action-m ct-fix-lap" ng-click="TC_ThemMoi()">
                                        <img src="~/App_Assets/images/icon_add.svg" alt="">
                                        <span>Thêm mới</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="col-12 col-sm-9 col-md-6 col-lg-9" style="padding: 0px;  padding-right: 2px;">
                    <div class="row" ng-show="ShowBoxRight">
                        <div class="col-6 col-sm-6 col-md-6 col-lg-6" style=" padding-right: 0px; padding-right: 2px;">
                            <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                                <legend class="scheduler-border" style="        width: 265px;"><label class="bold-label"><b>Danh sách sản phẩm đổi</b></label></legend>
                                <div class="row">
                                    <div class="col-sm-12 text-left">
                                        <label><b>Mã tiêu chuẩn đổi: {{TC_TieuChuanSelect.SO_QUYET_DINH}}</b></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12 col-md-3 col-lg-3 align-self-end">
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m ct-fix-lap" ng-click="SPD_ThemMoi()" title="Thêm mới">
                                                <img src="~/App_Assets/images/icon_add.svg" alt="">
                                            </button>
                                            <button class="btn-action-m ct-fix-lap" ng-click="SPD_Xoa()" title="Xoá">
                                                <img src="~/App_Assets/images/icon_del.svg" alt="">
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-9 col-lg-9">
                                        <div class="main-action pt-3">
                                            <div class="form-search w-100">
                                                <input type="text" placeholder="Tìm kiếm" ng-model="SPD_TenSanPham">
                                                <button>
                                                    <img src="~/App_Assets/images/search_icon.svg" ng-click="SPD_TimKiem()" alt="">
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="content-table">
                                    <div style="height:310px; overflow-y:scroll;">
                                        <table class="table-nested table table-striped table-bordered table-hover">
                                            <thead>
                                                <tr>
                                                    <th class="cell-input">
                                                        @*<input ng-checked="(DSSanPhamDoi | selected).length == DSSanPhamDoi.length"  class="form-control" ng-click="toggleAllCheckboxes($event)" type="checkbox" />*@
                                                    </th>
                                                    <th style="width:8%;">
                                                        STT
                                                    </th>
                                                    <th class="cell-members">
                                                        Tên sản phẩm
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_tree.html&#39;" ng-repeat="item in DSSanPhamDoi">
                                            </tbody>
                                        </table>
                                        <script id="table_tree.html" type="text/ng-template">
                                            <tr ng-class="{parent: item.children}" ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)">
                                              <td class="cell-input"  ng-if="!item.parent">
                                                <input ng-change="toggleCheckbox(item, parentScope)" ng-model="item.selected" class="form-control" type="checkbox" />
                                              </td>
                                                <td class="cell-name"  ng-if="item.parent" ng-click="item.opened = !item.opened">
                                                <div class="indent" style="padding-left: {{15*level}}px"></div>

                                              </td>
                                                <td class="cell-name" style="padding: 8px !important;" colspan="2"  ng-if="item.parent">
                                               <b>{{item.name}}</b>
                                              </td>
                                              <td class="cell-name"  style="padding: 8px !important;width:8%;" ng-if="!item.parent">
                                                {{$index +1}}
                                              </td>
                                              <td class="cell-members" style="padding: 8px !important;"  ng-if="!item.parent">
                                                 {{item.name}}
                                              </td>
                                            </tr>
                                            <tr class="children" ng-if="item.children &amp;&amp; item.children.length &gt; 0">
                                              <td colspan="4">
                                                <table class="table table-striped table-bordered table-hover">
                                                  <tbody ng-class="{opened: item.opened}" ng-include="&#39;table_tree.html&#39;" ng-init="level = level + 1" ng-repeat="item in item.children"></tbody>
                                                </table>
                                              </td>
                                            </tr>
                                        </script>
                                    </div>
                                    <div class="pages-switch" style="padding-top:10px !important;">
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m ct-fix-lap" type="button" ng-click="SPD_HuyThayDoi()">
                                                <img src="~/App_Assets/images/ic_cancel_light.svg" />
                                                <span>Hủy thay đổi</span>
                                            </button>
                                            <button class="btn-action-m ct-fix-lap" ng-click="SPD_Luu()">
                                                <img src="~/App_Assets/images/ic_save_light.svg" alt="">
                                                <span>Lưu</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-6 col-sm-6 col-md-6 col-lg-6" style="padding-left: 2px;">
                            <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                                <legend class="scheduler-border" style="        width: 275px;"><label class="bold-label"><b>Danh sách sản phẩm nhận</b></label></legend>
                                <div class="row">
                                    <div class="col-sm-12 text-left">
                                        <label><b>Sản phẩm đổi: {{TenSanPhamDoi}}</b></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12 col-md-3 col-lg-3 align-self-end">
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m ct-fix-lap" ng-click="SPN_ThemMoi()" title="Thêm mới">
                                                <img src="~/App_Assets/images/icon_add.svg" alt="">
                                            </button>
                                            <button class="btn-action-m ct-fix-lap" ng-click="SPN_Xoa()" title="Xoá">
                                                <img src="~/App_Assets/images/icon_del.svg" alt="">
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-9 col-lg-9">
                                        <div class="main-action pt-3">
                                            <div class="form-search w-100">
                                                <input type="text" placeholder="Tìm kiếm" ng-model="SPN_TenSanPham" ng-change="SPN_TimKiem()">
                                                <button>
                                                    <img src="~/App_Assets/images/search_icon.svg" ng-click="SPN_TimKiem()" alt="">
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="content-table" style="height:310px; overflow-y:scroll;">
                                    <table class="table-responsive table-hover result-point">
                                        <thead class="point-table-head">
                                            <tr>
                                                <th class="center"><input type="checkbox" class="form-control" ng-model="SPN_CheckAll" ng-change="SPN_ChangeCheckAll()" /> </th>
                                                <th class="center">STT </th>
                                                <th class="center">Tên sản phẩm </th>
                                                <th class="center">Số lượng </th>
                                            </tr>
                                        </thead>
                                        <tbody class="">
                                            <tr ng-repeat="item in DSSanPhamNhan">
                                                <td class="center"><input ng-change="SPN_ChooseSanPhamNhan()" class="form-control" type="checkbox" class="form-control" ng-model="item.SELECT" /> </td>
                                                <td class="text-center">{{$index +1}}</td>
                                                <td class="text-left"><select class="form-control" ng-change="SPN_ChangeSanPhamNhan($index, item.TEN_SP)" ui-select2 ng-model="item.SP_ID" ng-options="item.ID as item.TEN_SP for item in ListSanPhamALL"></select></td>
                                                <td class="text-right"><input type="number" class="form-control" ng-model="item.SoLuong" min="1" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="pages-switch" style="padding-top: 10px;">
                                    <div class="main-action d-flex align-items-center flex-wrap">
                                        <button class="btn-action-m ct-fix-lap" type="button" ng-click="SPN_DSSanPham()">
                                            <img src="~/App_Assets/images/icon_fl.svg" />
                                            <span>Danh sách sản phẩm</span>
                                        </button>
                                        <button class="btn-action-m ct-fix-lap" type="button" ng-click="SPN_HuyThayDoi()">
                                            <img src="~/App_Assets/images/ic_cancel_light.svg" />
                                            <span>Hủy thay đổi</span>
                                        </button>
                                        <button class="btn-action-m ct-fix-lap" ng-click="SPN_Luu()">
                                            <img src="~/App_Assets/images/ic_save_light.svg" />
                                            <span>Lưu</span>
                                        </button>
                                    </div>
                                </div>
                            </fieldset>
                        </div>


                    </div>
                </div>
            </div>


        </div>
    </main>
    @Html.Partial("~/Views/CauHinhDoiTieuChuan/_add.cshtml")
    @Html.Partial("~/Views/CauHinhDoiTieuChuan/_addSPDoi.cshtml")
    @Html.Partial("~/Views/CauHinhDoiTieuChuan/_addSPNhan.cshtml")
</div>


@section Scripts{
    <script src="~/app/Controller/TieuChuan_DinhMuc/CauHinhDoiTieuChuanController.js"></script>
    <script src="~/Content/js/jquery.ztree.core.js"></script>
    <script src="~/Content/js/jquery.ztree.excheck.js"></script>
}
