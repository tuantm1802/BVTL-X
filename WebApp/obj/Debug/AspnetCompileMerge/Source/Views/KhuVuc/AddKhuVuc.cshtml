<div class="modal" id="list_khu_vuc">
    <div class="modal-dialog modal-sm modal-dialog-centered modal-dialog-scrollable b-width_1 ">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Chọn khu vực</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <form class="form-infor has-border p-3">
                <div class="row no-gutters">
                    <div class="col-12 col-md-7">
                        <label for="">Phòng ban</label>
                        <input type="text"
                               class="form-control"
                               placeholder="{{TEN_PHONG_BAN}}"
                               disabled>
                    </div>
                </div>
                <div class="content-table has-border" style="padding-top:10px;">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <div class="main-action">
                                <div class="form-search w-100">
                                    <input type="text"
                                           ng-model="searchInModal"
                                           placeholder="Tìm kiếm"
                                           class="form-control"
                                           style="width:250px;margin-bottom:0px" />
                                    <button class="btn-action-m form-control"
                                            style="color:white;width:40px;margin-bottom:0px">
                                        <i class="fa fa-search" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2 style="font-weight:bold">Danh sách khu vực</h2>
                    <div style="max-height:350px !important; overflow-y:scroll;">
                        <table class=" table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th style="width:2%;" class="text-center">
                                        <input type="checkbox" ng-model="selectAllModal" ng-click="checkAllModal()" />
                                    </th>
                                    <th style="width:3%;">STT </th>
                                    <th class="text-center">Tên khu vực</th>
                                    <th class="text-center">Mô tả</th>
                                </tr>
                            </thead>
                            <tbody style="background-color:white">
                                <tr ng-repeat="khuVuc in listAllKhuVuc | filter : searchInModal">
                                    <td class="text-center">
                                        <input type="checkbox"
                                               ng-model="khuVuc.Selected" />
                                    </td>
                                    <td class="text-center">
                                        {{$index +1}}
                                    </td>
                                    <td>
                                        {{khuVuc.TEN_KHU_VUC_PB}}
                                    </td>
                                    <td>
                                        {{khuVuc.MO_TA_PB}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary bg-green" ng-click="SubmitPhongBan()">Lưu</button>
                    <button type="button" class="btn-secondary bg-red" ng-click="cancel()" data-bs-dismiss="modal">Đóng</button>
                </div>
            </form>
        </div>
    </div>
</div>
