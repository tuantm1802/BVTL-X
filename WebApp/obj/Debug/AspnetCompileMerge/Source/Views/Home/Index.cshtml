
@{
    ViewBag.Title = "Trang chủ";
}
<style type="text/css">
    body {
        overflow: hidden;
    }
</style>
<main class="main-home">
    <div class="container d-flex justify-content-center align-items-center">
        <div class="row no-gutters">
            <div class="col-12 col-sm-12 col-md-4 col-lg-4 align-self-end wow fadeInLeft" data-wow-duration=".5" data-wow-delay=".5s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic1.svg" alt="">
                        </div>

                        <div class="text-box">
                            <h4>Quân số</h4>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-12 col-md-4 col-lg-4 align-self-end wow fadeInLeft" data-wow-duration="1s" data-wow-delay="1s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic2.svg" alt="">
                        </div>

                        <div class="text-box">
                            <h4>Kế hoạch cấp phát</h4>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-12 col-md-4 col-lg-4 wow fadeInUp" data-wow-duration="3s" data-wow-delay="3s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic3.svg" alt="" class="bg-w">
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-12 col-md-4 col-lg-4 align-self-end wow fadeInUp" data-wow-duration="1.5s" data-wow-delay="1.5s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic4.svg" alt="">
                        </div>

                        <div class="text-box">
                            <h4>Chuyển tiền địa phương</h4>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-12 col-md-4 col-lg-4 align-self-end wow fadeInLeft" data-wow-duration="2s" data-wow-delay="2s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic5.svg" alt="">
                        </div>

                        <div class="text-box">
                            <h4>Nợ tồn đơn vị</h4>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-12 col-sm-12 col-md-4 col-lg-4 align-self-end wow fadeInLeft" data-wow-duration="2.5s" data-wow-delay="2.5s">
                <div class="link-box">
                    <a href="">
                        <div class="images-box">
                            <img src="~/App_Assets/images/h_ic6.svg" alt="">
                        </div>

                        <div class="text-box">
                            <h4>Báo cáo</h4>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

