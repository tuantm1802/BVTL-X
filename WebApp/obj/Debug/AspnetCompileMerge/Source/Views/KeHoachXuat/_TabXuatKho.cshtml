<div class="form-infor has-border p-3">
    <div class="row no-gutters">
        <div class="col-12 col-md-4">
            <label for="">Căn cứ: <span>*</span></label>
            <input class=" form-control" type="text" ng-model="thongTinKho.TEN_KHO" />
        </div>

        <div class="col-12 col-md-4">
            <label for="">Người lập KH: </label>
            <select class="form-control" ng-model="thongTinKho.NGUOI_PHU_TRACH_VW" ng-options="option.CapBac+' '+option.HoTen for option in canbo">
                <option value="">- - - Chọn cán bộ - - -</option>
            </select>
        </div>

        <div class="col-12 col-md-4">
            <label for="">Ngày lập KH: <span>*</span></label>
            <div class="input-group date" data-date-format="dd/mm/yyyy">
                <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_CT_VW">
                <span class="input-group-addon"></span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <label for="">Người nhận: </label>
            <select class="form-control" ng-model="thongTinKho.NGUOI_PHU_TRACH_VW" ng-options="option.CapBac+' '+option.HoTen for option in canbo">
                <option value="">- - - Chọn cán bộ - - -</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label for="">Nguồn hàng: <span>*</span></label>
            <input class=" form-control" type="text" ng-model="thongTinKho.SO_HOP_DONG" />
        </div>

        <div class="col-12 col-md-4">
            <label for="">Nguồn kinh phí: <span>*</span></label>
            <input class=" form-control" type="text" ng-model="thongTinKho.SO_HOP_DONG" />
        </div>

        <div class="col-12 col-md-4">
            <label for="">Ngày xuất dự kiến: <span>*</span></label>
            <div class="input-group date" data-date-format="dd/mm/yyyy">
                <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_KY_HD_VW">
                <span class="input-group-addon"></span>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <label for="">Ngày nhận dự kiến: <span>*</span></label>
            <div class="input-group date" data-date-format="dd/mm/yyyy">
                <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_KY_HD_VW">
                <span class="input-group-addon"></span>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <label for="">Vận chuyển: </label>
            <select class="form-control" ng-model="thongTinKho.NGUOI_NHAN" ng-options="option.HoTen for option in canbo">
                <option value="">- - - Chọn hình thức vận chuyển - - -</option>
            </select>
        </div>

        <div class="col-12 col-md-12">
            <label for="">Lý do xuất: </label>
            <input class=" form-control" type="text" ng-model="thongTinKho.NGAY_KY_HD_VW" />
        </div>

        <div ng-repeat="item in dsmodel">
            <i class="glyphicon glyphicon-heart"></i>

        </div>

    </div>
</div>
<div class="main-action d-flex align-items-center justify-content-between flex-wrap" id="sub-action">
    <div class="d-flex align-items-center flex-wrap">
        <button class="btn-action-m" data-toggle="modal" data-target="#them_hang_hoa">
            <img src="~/App_Assets/images/icon_add.svg" alt="">
            <span>Thêm mới hàng hóa</span>
        </button>
        <button class="btn-action-m" ng-click="XoaHangHoaDaChon()">
            <img src="~/App_Assets/images/icon_del.svg" alt="">
            <span>Xoá hàng hóa</span>
        </button>
    </div>
    <div>Tên hàng: {{tenHangHoaDaChon}}</div>
    <div>Số lượng: {{soLuongDaChon}}</div>
    <div>Thành tiền: {{thanhTienDaChon}}</div>
    <div class="d-flex align-items-center flex-wrap">
        <button class="btn-action-m" ng-click="ThemMoiChiTietHangHoa()">
            <img src="~/App_Assets/images/icon_add.svg" alt="">
            <span>Thêm chi tiết</span>
        </button>
        <button class="btn-action-m">
            <img src="~/App_Assets/images/icon_del.svg" alt="">
            <span>Xóa</span>
        </button>
    </div>
</div>
<div class="row no-gutters" id="detail-info">
    <div class="content-table mt-2 col-12 col-md-3 has-border" id="left-table">
        <table class="table-responsive table-hover result-point">
            <thead class="point-table-head">
                <tr>
                    <th class="text-center" style="width:3%;"><input type="checkbox" ng-model="checkAllHangHoa" ng-click="ChonTatCaHangHoa(2)" /> </th>
                    <th class="text-center" style="width:3%;">STT </th>
                    <th class="text-center">Hàng hóa<i id="or_ntn"></i></th>
                    <th class="text-center" style="width:3%;">Số lượng<i id="or_nn"></i></th>
                </tr>
            </thead>
            <tbody style="background-color:white">
                <tr ng-repeat="item in dsHangHoaDaChon" ng-click="ShowChiTietHangHoa($index)" ng-class="{'selected':$index == selectedGood}">
                    <td class="text-center"><input type="checkbox" ng-model="item.oSELECTED" ng-click="TichChonHangHoa(2,$index)" ng-disabled="EditStatus" /></td>
                    <td class="text-center">
                        <label>{{item.STT}}</label>
                    </td>
                    <td>
                        <label>{{item.MA_HANG+' - '+item.TEN_HANG}}</label>
                    </td>
                    <td class="text-center"> <label>{{item.SO_LUONG}}</label></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="content-table mt-2 col-12 col-md-9 has-border sticky-top" id="right-table">
        <table class="table-responsive table-hover result-point" style="background-color:honeydew">
            <thead class="point-table-head sticky-top">
                <tr>
                    <th class="text-center sticky-top" style="width:3%;"><img class="img-normal" id="img-toggle" src="~/App_Assets/images/ic_back_xx.svg" alt="" ng-click="ThayDoiTableChiTiet()"></th>
                    <th class="text-center sticky-top">Kho<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">Hợp đồng<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">Số khung<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">Số máy<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">Model<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">SL<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top">Chất lượng<i id="or_ntn"></i></th>
                    <th class="text-center sticky-top"><i id="or_ntn"></i></th>
                </tr>
            </thead>
            <tbody style="background-color:honeydew">
                <tr ng-repeat="item in dsChitietTheoHangHoa">
                    <td class="text-center">{{item.STT}}</td>
                    <td class="text-center"> {{item.KHO.NAME}}</td>
                    <td class="text-center"> {{item.HOP_DONG.NAME}}</td>
                    <td class="text-center">{{item.MO_TA_CT1}}</td>
                    <td class="text-center">{{item.MO_TA_CT2}}</td>
                    <td class="text-center">{{item.MODEL}}</td>
                    <td class="text-center">{{item.SO_LUONG}}</td>
                    <td class="text-center">{{item.CHAT_LUONG.TEN_CHAT_LUONG}}</td>
                    <td class="text-center">
                        <input type="button" ng-click="SuaChiTietHangHoa($index)" class="next" ng-disabled="EditStatus" value="Sửa" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>