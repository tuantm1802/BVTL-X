<div class="modal fade" id="kho_anh">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1" role="document" @*style="max-width:80vw"*@>
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Ảnh đính kèm</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <div class="modal-body" style="overflow-y:auto; max-height:85vh">
                <div class="row" id="gallery">
                    <div class="col-12 col-sm-6 col-lg-3" style="border:1px solid gray" ng-repeat="item in danhsachanh">
                        <div class="btn-container">
                            <input type="checkbox" ng-model="item.checked" class="checkbox-img"/>
                        </div>
                        <div data-toggle="modal" data-target="#exampleModal">
                            <img class="w-100" src={{item.src}} alt="{{$index}} slide" data-target="#carouselExample" data-slide-to={{$index}} loading="lazy">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="btn-container">
                    <input type="checkbox" class="checkbox-img" ng-model="checkAll" ng-click="ChonTatCa()"/>
                    <label>Chọn tất cả</label>
                </div>
                <button type="button" class="btn btn-secondary" ng-click="XoaAnhDinhKem()">
                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                    <span>Xóa ảnh đính kèm</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade modal-blackbg" id="exampleModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div id="carouselExample" class="carousel slide" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#carouselExample" ng-repeat="item in danhsachanh" ng-class="{'active':$index === 0}" data-slide-to={{$index}}></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item" ng-repeat="item in danhsachanh" ng-class="{'active':$index === 0}">
                            <img class="d-block w-100" src={{item.src}} alt="First slide" loading="lazy">
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
