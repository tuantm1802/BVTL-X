<div class="modal fade" id="cs-hang_hoa_theo_hd">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Chỉnh sửa hàng hóa theo hợp đồng</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <div class="modal-body">
                <form class="row" id="cs-chi-tiet-form">
                    <div class="col-12 col-md-4">
                        <label for="">Kho xuất: <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_KHO" ng-options="option.ID as option.NAME for option in danhmuckho" name="cs-khoxuat" required>
                            <option value="">- - - Chọn kho - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Hợp đồng: </label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_HOP_DONG" ng-options="option.ID as option.NAME for option in danhmuchopdong" name="cs-hopdong" required>
                            <option value="">- - - Chọn hợp đồng - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Nhóm hàng: <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_NHOM_HH" ng-options="option.ID as option.TEN_NHOM_HANG for option in dmnhomhang" name="cs-nhomhang" required>
                            <option value="">- - - Chọn nhóm hàng - - -</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="">Loại hàng: </label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_LOAI_HH" ng-options="option.ID as option.TEN_LOAI_HANG for option in dmloaihang" name="cs-loaihang" required>
                            <option value="">- - - Chọn loại hàng - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Số lượng: <span>*</span></label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.SO_LUONG" step="1" ng-change="ValueCount($index)" name="cs-soluong" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Chất lượng: <span>*</span></label>
                        <select class="form-control" ng-model="chitietTheoHangHoa.ID_CHAT_LUONG" ng-options="option.ID as option.TEN for option in dmchatluong" name="cs-chatluong" required>
                            <option value="">- - - Chọn chất lượng - - -</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="">Năm sản xuất: <span>*</span></label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.NAM_SX" step="1" name="cs-namsanxuat" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Số khung: <span>*</span></label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT1" name="cs-sokhung" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Số máy: </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT2" name="cs-somay" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="">BKS: </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT3" name="cs-bks" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Đơn giá: </label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.DON_GIA" step="10000" ng-change="ValueCount($index)" name="cs-dongia" required />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="">Thành tiền: </label>
                        <input class=" form-control" type="number" ng-model="chitietTheoHangHoa.THANH_TIEN" name="cs-thanhtien" required />
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="">Số serial: </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.MO_TA_CT4" name="serial" ng-keyup="AddModel($event)" />
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="">Ghi chú: </label>
                        <input class=" form-control" type="text" ng-model="chitietTheoHangHoa.GHI_CHU" name="cs-ghichu" />
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" ng-click="LuuChinhSuaChiTiet()">
                    <img src="~/App_Assets/images/icon_save.svg" alt="">
                    <span>Thêm</span>
                </button>
            </div>
        </div>
        </div>
    </div>
