<div class="modal fade" id="qsTrungModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:1000px;">
        <div class="modal-content" style="width: 1200px; margin-left: -72%;">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Quân số trùng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="content-table" style="overflow: auto;padding-top:10px;">
                    <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center" rowspan="2">
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="CheckAllQSTrung" ng-change="ChangeCheckAllQSTrung()" />
                                        <span class="lbl"></span>
                                    </label>
                                </th>
                                <th class="text-center" rowspan="3">STT</th>
                                <th class="text-center" rowspan="3">Số hiệu CAND</th>
                                <th class="text-center" rowspan="3">Giới tính</th>
                                <th class="text-center" colspan="5">Đơn vị trùng số hiệu CSND</th>
                                <th class="text-center" rowspan="3">Cỡ giày</th>
                                <th class="text-center" rowspan="3">Cỡ mũ</th>
                                <th class="text-center" rowspan="3">Cỡ QA</th>
                                <th class="text-center" rowspan="3">Loại CB</th>
                                <th class="text-center" rowspan="3">Trạng thái</th>
                                <th class="text-center" rowspan="3">Giữ lại</th>
                            </tr>
                            <tr>
                                <th class="text-center" colspan="2">Cấp bậc - loại hàm (hiện tại)</th>
                                <th class="text-center" colspan="3">Chức vụ - đơn vị - lực lượng (hiện tại) </th>
                            </tr>
                            <tr>
                                <th class="text-center">Cấp bậc</th>
                                <th class="text-center">Loại hàm</th>
                                <th class="text-center">Chức vụ</th>
                                <th class="text-center">Vị trí công tác</th>
                                <th class="text-center">Lực lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in ListQSTrung">
                                <td>
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="item.selected" ng-change="ChangeCheckQSTrung()" value="10" />
                                        <span class="lbl"></span>
                                    </label>
                                </td>
                                <td class="text-center">{{$index + 1}}</td>
                                <td>{{item.SO_HIEU_TEXT}}</td>
                                <td>{{item.GIOI_TINH_TEXT}}</td>
                                <td>{{item.TEN_CAP_BAC}}</td>
                                <td>{{item.TEN_LOAI_HAM}}</td>
                                <td>{{item.CHUC_VU}}</td>
                                <td>{{item.TEN_DON_VI}}</td>
                                <td>{{item.TEN_LUC_LUONG}}</td>
                                <td>{{item.CO_GIAY}}</td>
                                <td>{{item.CO_MU}}</td>
                                <td>{{item.CO_QA}}</td>
                                <td>{{item.LOAI_CB}}</td>
                                <td>{{item.TRANG_THAI_TEXT}}</td>
                                <td>
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="item.Deleteed" />
                                        <span class="lbl"></span>
                                    </label>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-sm-12">
                    <div class="row content-table pull-right">
                        <div class="pages-switch">
                            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="SoLuongKetQuaQSTrung" items-per-page="10" ng-model="currentPageQSTrung" ng-change="pageChangedQSTrung()" max-size="3" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-action-m bg-green" ng-click="LuuLog()">
                    <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                </button>
                <button class="btn-action-m bg-orange" data-dismiss="modal">
                    <i class="fa fa-times" aria-hidden="true"></i>    <span> Thoát</span>
                </button>
            </div>
        </div>
    </div>
</div>