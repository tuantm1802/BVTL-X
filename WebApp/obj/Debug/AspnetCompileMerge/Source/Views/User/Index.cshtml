
@{
    ViewBag.Title = "Người dùng";
}


<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Người dùng
    </h3>
</div>
<div ng-controller="UserController">
    <main>
        <div class="container-fluid d-flex cons-ac-system">
            <div class="row  no-gutters w-100">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding-left:0px;padding-right:2px;height:100%;">
                    <div class="row mt-3">
                        <div class="col-12 col-sm-9 col-md-9 col-lg-9">
                            <div class="main-action d-flex align-items-center flex-wrap">
                                <button class="btn-action-m" ng-show="RoleBtnCreate == true" ng-click="add()" title="Thêm mới">
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                    &nbsp;Thêm mới
                                </button>
                                <button class="btn-action-m" ng-show="RoleBtnSearch == true" ng-click="LoadPage()" title="Làm mới">
                                    <i class="fa fa-refresh" aria-hidden="true"></i>
                                    &nbsp; Làm mới
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-3 col-md-3 col-lg-3">
                            <div class="form-group pull-right">
                                <div class="input-group">
                                    <input name="keyword" ng-model="modelSearch.KeyWord" ng-model-options="{ debounce: 800 }" ng-change="LoadPage()" class="form-control" value="" />
                                    <div class="input-group-prepend-right">
                                        <button class="btn-action-m" style="color:white">
                                            <i class="fa fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style=" overflow-y:scroll">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center">STT</th>
                                    <th class="text-center">Tên đăng nhập</th>
                                    <th class="text-center">Họ và tên</th>
                                    <th class="text-center">Số điện thoại</th>
                                    <th class="text-center">Nhóm quyền</th>
                                    <th class="text-center">Nhóm người dùng</th>
                                    <th class="text-center">Đơn vị</th>
                                    <th class="text-center">Trạng thái </th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in ListUser" ng-click="ViewDetail(item.USER_ID, $index)" ng-class="{activerow:$index==selectedRow}">
                                    <td class="text-center">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>
                                    <td>{{item.LOGIN_NAME}}</td>
                                    <td>{{item.FULL_NAME}}</td>
                                    <td>{{item.TEL_NO}}</td>
                                    <td>{{item.ROLE_DESC}}</td>
                                    <td>{{item.USER_GROUP == 'A' ? 'Quản trị' : 'Nghiệp vụ'}}</td>
                                    <td>{{item.UNIT_NAME}}</td>
                                    <td class="text-center">{{item.ENABLED_FLAG == 'Y' ? 'Sử dụng' : 'Không sử dụng'}}</td>
                                    <td class="text-center">
                                        <div class="main-action d-flex align-items-center flex-wrap">
                                            <button class="btn-action-m " ng-show="RoleBtnUpdate == true" ng-click="edit(item.USER_ID)" title="Sửa">
                                                <img src="~/App_Assets/images/icon_edit.svg" alt="">
                                            </button>
                                            <button class="btn-action-delete" ng-show="RoleBtnDelete == true" ng-click="delete(item.USER_ID, item.FULL_NAME)" title="Xoá">
                                                <img src="~/App_Assets/images/icon_del.svg" alt="">
                                            </button>

                                            <button class="btn-action-m " ng-show="RoleBtnLock == true && item.IsLock == 0" ng-click="lockUser(item.USER_ID)" title="Khóa">
                                                <img src="~/App_Assets/images/iconlockWhite.svg" alt="">
                                            </button>
                                            <button class="btn-action-m" ng-show="RoleBtnUnlock == true && item.IsLock == 1" ng-click="unlockUser(item.USER_ID, item.FULL_NAME)" title="Mở khóa">
                                                <img src="~/App_Assets/images/iconUnlockWhite.svg" alt="">
                                            </button>
                                        </div>
                                        
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row" style="width:100%;">
                        <div class="col-sm-12">
                            <div class="row content-table pull-right">
                                <div class="pages-switch">
                                    <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>


@section scripts{
    <script src="~/app/Controller/UserController.js"></script>
}
