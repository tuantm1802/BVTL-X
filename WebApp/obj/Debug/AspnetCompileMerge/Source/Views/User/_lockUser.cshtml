<div class="modal-header">
    <h4 class="modal-title">Nhập ý kiến</h4>
    <a href="#" data-action="close" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <img src="~/App_Assets/images/close.svg" alt="">
    </a>
</div>
<div class="modal-body">
    <form class=" col-md-12" id="formSubmitLock">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label class="requiredInput">Ý kiến khóa</label>
                    <textarea class="form-control" rows="2" ng-model="Content" name="Content"></textarea>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <div class="main-action d-flex flex-wrap">
        <button class="btn-action-m" ng-click="submit()">
            <img src="~/App_Assets/images/icon_save.svg" alt="">
            <span>Lưu</span>
        </button>
        <button class="btn-action-cancel" data-dismiss="modal" ng-click="cancel()">
            <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
            <span>Hủy</span>
        </button>
    </div>
</div>