<div class="modal fade" id="them_hang_hoa">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content" style="width:700px !important;">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới sản phẩm</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <form class="modal-body row no-gutters" @*style="height:50vh"*@ id="frm-them-hang-hoa">
                <div class="content-table mt-2 col-12 col-md-12 has-border">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <label>Sản phẩm nhập đổi cỡ</label>
                            <select class="form-control" ui-select2 ng-model="SanPhamNhapId" ng-options="item.ID_SP as item.TEN_SP for item in dsHangHoaNhapChon">
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <label>Sản phẩm xuất đổi cỡ</label>
                            <select class="form-control" ui-select2 ng-model="SanPhamXuatId" ng-options="item.ID_SP as item.TEN_SP for item in dsHangHoaXuatChon">
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <label>Số lượng</label>
                            <input class="form-control" ng-model="SoLuong" />
                        </div>
                    </div>
                </div>
            </form>
            <div class="modal-footer">
                <div class="main-action d-flex flex-wrap">
                    <button type="button" class="btn btn-action-m" ng-click="LuuDsHangHoa()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Thêm</span>
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
