@{
    ViewBag.Title = "Kế hoạch nhập trả - đổi cỡ";
}
<style>

    .nav-tabs .nav-item .nav-link::after {
        content: "";
        position: absolute;
        width: 1px;
        height: 23px;
        background: #666666;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
    }
</style>
<main ng-controller="KeHoachNhapTraDoiCoController" style="margin-top: 20px;">
    <div class="container-fluid d-flex cons-ac-system">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>

            <div class="fill-box">
                <h3 class="title-fill">
                    <i class="fa fa-folder-open color-green" aria-hidden="true"></i>  Đơn vị
                </h3>
            </div>

            <div class="container">
                <div class="main-action pt-3">
                    <div class="form-search w-100">
                        <input type="text" placeholder="Tìm kiếm" ng-model="txtSearchDmDonVi">
                        <button class="bg-green" style="color:white" ng-click="btnSearchDmDonVi()">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="function-box">
                    <div class="ztreeRoleBackground left" style="width:100%;">
                        <ul id="treeRole" class="ztree"></ul>
                    </div>
                </div>

                <div class="content-table ng-hide" ng-init="IsVisibleTab=false" ng-show="IsVisibleTab">
                    <div class="row" style="padding-top:10px;">
                        <div class="col-12 col-md-6 col-lg-6">
                            <div class="form-group row">
                                <lable class="col-12 col-md-2 col-lg-2" style="padding-top:3px">Năm: </lable>
                                <div class="col-12 col-md-10 col-lg-10">
                                    <select ng-model="cbbNam" class="form-control" ng-change="idx_ChangeKHTheoNam()">
                                        <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Name}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-6" ng-show="RoleBtnCreate">
                            <div class="form-group row">
                                <div class="col-12 col-md-12 col-lg-12 main-action">
                                    <button class="btn-action-m bg-green form-control" ng-click="ThemKeHoach()">
                                        <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="height:300px; overflow-y:scroll;width: 100%;">
                        <table class="table-responsive table-hover result-point mt-2 small-table">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="text-center mn-number">Số KH</th>
                                    <th class="text-center mn-day">Ngày tạo</th>
                                    <th class="text-center mn-status">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in ListKeHoach" ng-class="{activerow:$index==selectedRowKeHoach}" style="cursor:pointer">
                                    <td class="text-center" ng-click="ShowThongTin(item,$index)">{{item.SO_KH}}</td>
                                    <td class="text-center" ng-click="ShowThongTin(item,$index)">{{item.NGAY_TAO_TEXT}}</td>
                                    <td class="text-center" ng-click="ShowThongTin(item,$index)">
                                        {{item.TRANG_THAI_TEXT}}

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-system no-border pb-0 ng-hide" ng-show="ViewKeHoach">
            @* bread crumb *@
            <div class="fill-box-bread-crumb">
                <h3 class="bread_crumb">
                    <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>  /  Cấp phát  /   Kế hoạch nhập trả - đổi cỡ
                </h3>
            </div>
            @*End bread crumb*@


            <div class="row">
                <div class="col-12 col-md-12">
                    <div class="main-action d-flex align-items-center justify-content-between flex-wrap">
                        <div class="d-flex align-items-center flex-wrap">
                            <button class="btn-action-delete" ng-show="RoleBtnDelete" ng-click="XoaKeHoach()" ng-disabled="disabledDelete">
                                <img src="~/App_Assets/images/icon_del.svg" alt="">
                                <span>Xoá</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnRollback" ng-click="HuyThayDoi()" ng-disabled="disabledRollback">
                                <span>Hủy thay đổi</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnUpdate" ng-click="SuaKeHoach()" ng-disabled="disabledEdit">
                                <img src="~/App_Assets/images/icon_edit.svg" alt="">
                                <span>Sửa</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnSave" ng-click="LuuPhieu()" ng-disabled="disabledSave">
                                <img src="~/App_Assets/images/icon_save.svg" alt="">
                                <span>Lưu</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnSendApprove" ng-click="TrinhDuyet()" ng-disabled="disabledSendApprove">
                                <img src="~/App_Assets/images/icon_save.svg" alt="">
                                <span>Trình duyệt</span>
                            </button>
                            <button class="btn-action-m" ng-show="RoleBtnPrint" ng-click="InPhieu()" ng-disabled="disabledPrint">
                                <img src="~/App_Assets/images/l7_hover.svg" alt="">
                                <span>In kế hoạch</span>
                            </button>

                        </div>

                    </div>
                </div>
            </div>
            <form class="form-infor" id="main-info">


                <div class="row">
                    <div class="col-12 col-md-12">
                        <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;margin-bottom: 5px;">
                            <legend class="scheduler-border" style="width: 150px;"><label class="bold-label"><b>Thông tin chung</b></label></legend>
                            <div class="row">
                                <div class="col-4 col-md-4">
                                    <label>Số kế hoạch</label>
                                    <input type="text" name="NGUOI_LAP" ng-model="thongTinKh.SO_KH" class="form-control" />
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Nơi giao</label>
                                    <input type="text" name="NGUOI_LAP" ng-model="thongTinKh.TEN_DON_VI" class="form-control" />
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Kho nhập <span>*</span></label>
                                    <select class="form-control" ng-disabled="HsStatus" name="KhoNhap" ng-model="thongTinKh.ID_KHO_NHAP" ng-options="item.ID as item.TEN_DON_VI for item in dmKhos">
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-4 col-md-4">
                                    <label>Ngày lập kế hoạch <span>*</span></label>
                                    <div class="input-group date" ng-disabled="HsStatus" data-date-format="dd/mm/yyyy">
                                        <input type="text" customzdatetime class="form-control" name="ngayLapKH" ng-disabled="HsStatus" ng-model="thongTinKh.NGAY_TAO">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Ngày thực nhập</label>
                                    <div class="input-group date" ng-disabled="true" data-date-format="dd/mm/yyyy">
                                        <input type="text" customzdatetime class="form-control" name="ngayLapKH" ng-disabled="true" ng-model="thongTinKh.NGAY_NHAP_TT_W">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Người giao</label>
                                    <input type="text" name="TEN_NGUOI_GIAO" ng-disabled="HsStatus" ng-model="thongTinKh.TEN_NGUOI_GIAO" class="form-control" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-4 col-md-4">
                                    <label>Số phiếu tài chính</label>
                                    <input type="text" name="NGUOI_LAP" ng-model="thongTinKh.SO_PHIEU_TC" class="form-control" />
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Lý do nhập</label>
                                    <textarea class="form-control" ng-disabled="HsStatus" ng-trim="true" ng-model="thongTinKh.MO_TA"></textarea>
                                </div>
                                <div class="col-4 col-md-4">
                                    <label>Hình thức vận chuyển <span>*</span></label>
                                    <select class="form-control" name="vanChuyen" ng-disabled="HsStatus" ng-model="thongTinKh.PHUONG_THUC_VAN_CHUYEN" ng-options="item.FLEX_VALUE_ID as item.DESCRIPTION for item in hinhThucVanChuyens">
                                    </select>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </form>

            <div class="row no-gutters" id="detail-info">
                <div class="col-12 col-md-12 content-table" style="width:100%;" id="left-table">
                    <div class="nav-box">
                        <div class="nav-tabs-box">
                            <ul class="nav nav-tabs tab-main" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#TAB_NOI_DUNG" title="Nội dung" role="tab">Nội dung</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#TAB_LAP_PHIEU" title="Lập phiếu" role="tab">Lập phiếu</a>
                                </li>
                            </ul>
                        </div>
                        <div class="container-fluid sl-1-row">
                            <div class="tab-content" id="myTabContent">
                                <div class="tab-pane fade show active" id="TAB_NOI_DUNG" role="tabpanel" aria-labelledby="home-tab">
                                    <div class="row">
                                        <div class="col-4 col-md-4" style="margin-bottom:10px;">
                                            <div class="main-action d-flex align-items-center flex-wrap">
                                                <button class="btn-action-m" data-toggle="modal" ng-disabled="HsStatus" ng-click="ThemHangHoa()">
                                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                                    <span>Thêm mới hàng hóa</span>
                                                </button>
                                                <button class="btn-action-m" ng-disabled="HsStatus" ng-click="XoaHangHoaDaChon()">
                                                    <i class="fa fa-trash-o" aria-hidden="true"></i>
                                                    <span>Xoá hàng hóa</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-8 col-md-8 col-lg-8 align-self-end" style="        margin-bottom: 5px;">
                                            <div class="main-action pt-3">
                                                @*<div class="form-search w-100">
                                            <input type="text" placeholder="Tìm kiếm" ng-model="txtSearchDmDonVi">
                                            <button class="bg-green" style="color:white" ng-click="btnSearchDmDonVi()">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>*@
                                            </div>
                                        </div>
                                    </div>
                                    <div class="content-table">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th class="text-center" style="width:3%;"><input type="checkbox" ng-model="checkAllHangHoa" ng-click="ChonTatCaHangHoa(2)" /> </th>
                                                    <th class="text-center">STT </th>
                                                    <th class="text-center">SP nhập đổi cỡ</th>
                                                    <th class="text-center">SP xuất đổi cỡ</th>
                                                    <th class="text-center">ĐVT</th>
                                                    <th class="text-center">SL kế hoạch</th>
                                                </tr>
                                            </thead>
                                            <tbody style="background-color:white">
                                                <tr ng-repeat="item in dsHangHoaDaChon" ng-class="{'selected':$index == selectedGood}">
                                                    <td class="text-center"><input type="checkbox" ng-model="item.SELECT" ng-click="TichChonHangHoa(2,$index)" ng-disabled="EditStatus" /></td>
                                                    <td class="text-center">
                                                        <label>{{$index +1}}</label>
                                                    </td>
                                                    <td>
                                                        <label>{{item.TEN_SP_NHAP}}</label>
                                                    </td>
                                                    <td>
                                                        <label>{{item.TEN_SP_XUAT}}</label>
                                                    </td>
                                                    <td class="text-left"> <label>{{item.TEN_DVT}}</label></td>
                                                    <td class="text-right"> <label>{{item.SL_KE_HOACH}}</label></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="TAB_LAP_PHIEU" role="tabpanel" aria-labelledby="profile-tab">
                                    <div class="row">
                                        <div class="col-sm-7  col-md-7">
                                            <div style="height: 200px !important; overflow-y: scroll; margin-bottom: 10px;">
                                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;margin-bottom: 5px;">
                                                    <legend class="scheduler-border" style="width: 150px;"><label class="bold-label"><b>Phiếu nhập kho</b></label></legend>
                                                    <table class="table-responsive table-hover result-point">
                                                        <thead class="point-table-head">
                                                            <tr>
                                                                <th style="width:3%;"><input type="checkbox" ng-model="checkAllLeft" @*ng-click="ChonTatCaHangHoa(0)"*@ /> </th>
                                                                <th style="width:3%;">Chi tiết </th>
                                                                <th class="text-center">Mã phiếu<i id="or_ntn"></i></th>
                                                                <th class="text-center">Số phiếu tài chính<i id="or_ntn"></i></th>
                                                                <th class="text-center">Kho nhập<i id="or_ntn"></i></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody style="background-color:white">
                                                            <tr ng-repeat="item in dsPhieuNhapKho">
                                                                <td class="text-center"><input type="checkbox" ng-model="item.SELECT" @*ng-click="TichChonHangHoa(0,$index)"*@ /></td>
                                                                <td class="text-center">
                                                                    <div class="main-action d-flex align-items-center flex-wrap">
                                                                        <button class="btn-action-m ct-fix-lap" type="button" title="Xem chi tiết" ng-click="LPXK_GetDetailPXK(0,item)">
                                                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    {{item.MA_PHIEU}}
                                                                </td>
                                                                <td>
                                                                    {{item.SO_PHIEU_TC}}
                                                                </td>
                                                                <td>
                                                                    {{item.TEN_KHO}}
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </fieldset>
                                            </div>
                                            <div style="height:200px !important; overflow-y:scroll; ">
                                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;margin-bottom: 5px;">
                                                    <legend class="scheduler-border" style="width: 150px;"><label class="bold-label"><b>Phiếu xuất kho</b></label></legend>
                                                    <table class="table-responsive table-hover result-point">
                                                        <thead class="point-table-head">
                                                            <tr>
                                                                <th style="width:3%;"><input type="checkbox" ng-model="checkAllLeft" @*ng-click="ChonTatCaHangHoa(0)"*@ /> </th>
                                                                <th style="width:3%;">Chi tiết </th>
                                                                <th class="text-center">Mã phiếu<i id="or_ntn"></i></th>
                                                                <th class="text-center">Số phiếu tài chính<i id="or_ntn"></i></th>
                                                                <th class="text-center">Kho xuất<i id="or_ntn"></i></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody style="background-color:white">
                                                            <tr ng-repeat="item in dsPhieuXuatKho">
                                                                <td class="text-center"><input type="checkbox" ng-model="item.SELECT" @*ng-click="TichChonHangHoa(0,$index)"*@ /></td>
                                                                <td class="text-center">
                                                                    <div class="main-action d-flex align-items-center flex-wrap">
                                                                        <button class="btn-action-m ct-fix-lap" type="button" title="Xem chi tiết" ng-click="LPXK_GetDetailPXK(1,item)">
                                                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    {{item.MA_PHIEU}}
                                                                </td>
                                                                <td>
                                                                    {{item.SO_PHIEU_TC}}
                                                                </td>
                                                                <td>
                                                                    {{item.TEN_KHO}}
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </fieldset>
                                            </div>
                                        </div>
                                        <div class="col-sm-5  col-md-5">
                                            <div style="height:420px !important; overflow-y:scroll;">
                                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;margin-bottom: 5px;">
                                                    <legend class="scheduler-border" style="width: 150px;"><label class="bold-label"><b>Nợ kế hoạch</b></label></legend>
                                                    <table class="table-responsive table-hover result-point">
                                                        <thead class="point-table-head">
                                                            <tr>
                                                                <th class="text-center">Tên hàng hóa<i id="or_ntn"></i></th>
                                                                <th class="text-center">Số lượng<i id="or_ntn"></i></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody style="background-color:white">
                                                            <tr ng-repeat="item in dsHangHoaNoKH">
                                                                <td>
                                                                    {{item.TEN_SP}}
                                                                </td>
                                                                <td>
                                                                    {{item.SO_LUONG | number}}
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-4 col-md-4">
                                            <div class="main-action d-flex align-items-center flex-wrap">
                                                <button class="btn-action-m" ng-disabled="HsStatus" ng-click="LPXK_XuatKhoUuTien()">
                                                    <span>Xuất kho ưu tiên</span>
                                                </button>
                                                <button class="btn-action-m" ng-disabled="HsStatus" ng-click="LPXK_XuatKhoKhac()">
                                                    <span>Xuất kho khác</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-sm-4 col-md-4">
                                            <p>{{LPXK_Message}}</p>
                                        </div>
                                        <div class="col-sm-4 col-md-4">
                                            <div class="main-action d-flex align-items-center flex-wrap">
                                                <button class="btn-action-m" ng-disabled="HsStatus" ng-click="LPXK_XuatGiaoTay()">
                                                    <span>Xuất giao tay</span>
                                                </button>
                                                <button class="btn-action-m" ng-disabled="HsStatus" ng-click="LPXK_XuatThangTuHD()">
                                                    <span>Xuất thẳng từ hợp đồng</span>
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>

                @Html.Partial("~/Views/KeHoachNhapTraDoiCo/_PopupThemHangHoa.cshtml")

                @Html.Partial("~/Views/KeHoachNhapTraDoiCo/_enterPassword.cshtml")
                @Html.Partial("~/Views/KeHoachNhapTraDoiCo/_PopupChonNguoiDuyet.cshtml")
                @Html.Partial("~/Views/KeHoachNhapTraDoiCo/_LPXK_ChiTietPXK.cshtml")
            </div>
        </div>



    </div>
</main>
@section scripts{
    <script src="~/app/Controller/CapPhat/KeHoachNhapTraDoiCoController.js"></script>
}