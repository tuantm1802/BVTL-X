<div class="modal fade" id="LPXK_ChiTietPXK">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">{{LPXK_TitlePopupChiTiet}}</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <!-- Modal body -->
            <div class="modal-body">
                <form class=" col-md-12" id="formSubmit">
                    <div class="row">
                        <div class="col-sm-12" style="padding:0px;padding-right:10px;">
                            <div class="form-infor has-border p-3">
                                <div class="row">
                                    <div class="col-6 col-md-6">
                                        <label for="">Mã phiếu</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.MA_PHIEU" />
                                    </div>
                                    <div class="col-6 col-md-6" ng-if="LPXK_ChiTietPXK ==1">
                                        <label>Kho xuất</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.TEN_KHO" />
                                    </div>
                                    <div class="col-6 col-md-6" ng-if="LPXK_ChiTietPXK ==0">
                                        <label>Kho nhập</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.TEN_KHO" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-6">
                                        <label for="">Ngày lập</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.NGAY_TAO" />
                                    </div>
                                    <div class="col-6 col-md-6">
                                        <label for="">Hình thức vận chuyển</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.PHUONG_THUC_VAN_CHUYEN" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12 col-md-12">
                                        <label>Lý do</label>
                                        <input disabled class="form-control" ng-model="LPXK_PhieuXuatKho.MO_TA" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="height:300px; overflow-y:scroll;">
                        <table class="table-responsive table-hover result-point">
                            <thead class="point-table-head">
                                <tr>
                                    <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="LPXK_CT_CheckAllKho" /> </th>
                                    <th>STT</th>
                                    <th>Mã H55</th>
                                    <th>Tên hàng</th>
                                    <th>ĐVT</th>
                                    <th>Số lượng</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <tr ng-repeat="item in LPXK_ListPXK_Detail">
                                    <td class="center"><input type="checkbox" class="form-control" ng-model="item.SELECTED" /> </td>
                                    <td>{{$index +1}}</td>
                                    <td>{{item.MA_HANG}}</td>
                                    <td>{{item.TEN_HANG}}</td>
                                    <td>{{item.DVT}}</td>
                                    <td>{{item.SO_LUONG}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">
                <h5 class="day-make"></h5>
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

