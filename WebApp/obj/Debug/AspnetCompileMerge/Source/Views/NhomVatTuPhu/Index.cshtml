@{
    ViewBag.Title = "Nhóm vật tư phụ";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Nhóm vật tư phụ
    </h3>
</div>
<div ng-controller="NhomVatTuPhuController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;  padding-right: 2px;">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12">
                                <div class="main-action d-flex pull-left">
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Add()" ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Undo()" ng-show="RoleBtnCancel"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>Huỷ thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Submit()" ng-show="RoleBtnSave"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                        <span>Lưu</span>
                                    </button>
                                    <button class="btn-action-m bg-red" type="button"
                                            ng-click="Delete()" ng-show="RoleBtnDelete"
                                            style="margin-right: 10px;background-color:#f55442;">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xoá</span>
                                    </button>
                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right" style="margin-left:5px;">
                                    <div class="main-action">
                                        <div class="d-flex form-group" style="margin-bottom:0px;vertical-align:middle">
                                            <input type="text" ng-model="search" placeholder="Tìm kiếm" class="form-control" style="width:250px;margin-bottom:0px" />
                                            <button class="btn-action-m form-control" style="color:white;width:40px;margin-bottom:0px">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="content-table" style="margin-top: 10px;">
                        <table class="table-hover result-point mt-2">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:3%;" class="text-center">
                                        <input type="checkbox" ng-model="selectAll" ng-click="checkAll()" />
                                    </th>
                                    <th class="text-left" style="width:3%;" ng-if="STT">STT</th>
                                    <th class="text-left" style="width:auto;" ng-if="TenNhomVT">Tên nhóm vật tư</th>
                                    <th class="text-left" style="width:20%;" ng-if="DonViTinh">Đơn vị tính</th>
                                    <th class="text-left" style="width:20%;" ng-if="MoTa">Mô tả</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DanhSach | filter : search" ng-click="loadTemplate($index)">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.SELECT" value="10" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="text-left" ng-if="STT">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>
                                    <td class="text-left" ng-if="TenNhomVT"><span ng-if="!item.Edit">{{item.TEN_NHOM_SP}}</span> <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.TEN_NHOM_SP"></td>
                                    <td class="text-left" ng-if="DonViTinh">
                                        <span ng-if="!item.Edit">{{item.DVT}}</span>
                                        <div ng-if="item.Edit">
                                            <select class="form-control" ng-model="item.DVT_ID">
                                                <option ng-repeat="option in ListDVT" ng-value="option.ID">{{option.TEN_DVT}}</option>
                                            </select>
                                        </div>
                                    </td>
                                    <td class="text-left" ng-if="MoTa"><span ng-if="!item.Edit">{{item.MO_TA}}</span><input type="text" ng-if="item.Edit" class="form-control" ng-model="item.MO_TA"></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr ng-repeat="row in rows">
                                    <td class="text-center">
                                        <input type="checkbox" id="check" ng-model="item.selected" />
                                    </td>
                                    <td class="text-left" ng-if="STT">{{modelSearch.totalItems+1 + $index}}</td>
                                    <td class="text-left" ng-if="TenNhomVT"><input class="form-control" type="text" ng-model="row.TEN_NHOM_SP" /></td>
                                    <td class="text-left" ng-if="DonViTinh">
                                        <select class="form-control" ng-model="row.DVT_ID">
                                            <option ng-repeat="option in ListDVT" ng-value="option.ID">{{option.TEN_DVT}}</option>
                                        </select>
                                    </td>
                                    <td class="text-left" ng-if="MoTa"><input class="form-control" type="text" ng-model="row.MO_TA" /></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="pages-switch mb-2">
                            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" show-length-per-page="true" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                        </div><!-- /.span -->
                    </div>
                </div>
            </div>

            <div class="bootbox modal fade bootbox-prompt" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">

                </div>
            </div>
        </div>
    </main>
</div>
@section scripts{
<script src="~/app/Controller/NhomVatTuPhuController.js"></script>
}