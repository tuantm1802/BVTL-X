            <!-- Modal Header -->
<div class="modal-header">
    <h4 class="modal-title">Chi tiết chứng từ</h4>
    <button type="button" class="close" data-dismiss="modal" ng-click="cancel()">
        <img src="~/App_Assets/images/close.svg" alt="">
    </button>
</div>
<!-- Modal body -->
<div class="modal-body">
    <div class="form-infor has-border p-3">
        <form class="row" id="thuc-luc-form">
            <div class="col-4 col-md-4">
                <label for="">Nhập kho </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_KHO" name="NhapKho" disabled />
            </div>
            <div class="col-8 col-md-8">
                
            </div>

            <div class="col-4 col-md-4">
                <label for="">Căn cứ </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.CAN_CU" name="CanCu" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Nguồn hàng </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.NGUON_HANG" name="NguonHang" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Ngày nhập dự kiến </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.NGAY_NHAN_DK" name="NgayNhapDuKien" disabled />
            </div>

            <div class="col-8 col-md-8">
                <label for="">Lý do </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.LY_DO_NHAP" name="NgayNhapDuKien" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Vận chuyển </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.HT_VAN_CHUYEN" name="NgayNhapDuKien" disabled />
            </div>

            <div class="col-4 col-md-4">
                <label for="">Ngày viết phiếu </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.NGAY_CT" name="NgayNhapDuKien" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Người viết phiếu </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_NGUOI_NHAN" name="NgayNhapDuKien" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Lãnh đạo phòng 9</label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_NGUOI_KY_1" name="model" disabled/>
            </div>

            <div class="col-4 col-md-4">
                <label for="">Ngày thự tế </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_NGUOI_KY_1" name="model" disabled/>
            </div>
            <div class="col-4 col-md-4">
                <label for="">Cán bộ nhập </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.ID_NGUOI_TAO" name="model" disabled/>
            </div>
            <div class="col-4 col-md-4">
                <label for="">Lãnh đạo nhập </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_NGUOI_KY_2" name="model" disabled/>
            </div>

            <div class="col-4 col-md-4">
                <label for="">Cán bộ vận chuyển </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuNhap.TEN_NGUOI_GIAO" name="model" disabled/>
            </div>
            <div class="col-4 col-md-8">

            </div>
            <div class="col-md-5">
                <div class="content-table">
                    <table class="table-responsive result-point">
                        <thead class="point-table-head">
                            <tr class="bd-normal">
                                <th class="text-center ht3-number-cand">
                                    STT
                                </th>
                                <th class="text-center ht3-genral">
                                    Mã hàng
                                </th>
                                <th class="text-center ht3-rank">
                                    Tên hàng
                                </th>
                                <th class="text-center ht3-position">
                                    ĐVT
                                </th>
                                <th class="text-center ht3-size">
                                    SL
                                </th>
                                <th class="text-center ht3-size">
                                    Tổng tiền
                                </th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in DanhSachHangHoa" ng-click="ChonHangNhapKho(item, $index)" ng-class="{'active-tr': selectedItem == $index}">
                                <td class="text-center">
                                    {{$index + 1}}
                                </td> 
                                <td class="text-center">
                                    {{item.MA_HANG}}
                                </td>
                                <td class="text-left">
                                    {{item.TEN_HANG}}
                                </td>
                                <td class="text-left">
                                    {{item.DVT}}
                                </td>
                                <td class="text-left">
                                    {{item.SO_LUONG_TT}}
                                </td>
                                <td class="text-left">
                                    {{item.THANH_TIEN_TT | number: 0}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-7">
                <div class="form-infor has-border p-3 firts-to-h" style="padding-bottom: 5px !important;">
                    <div class="row no-gutters">
                        <div class="col-md-6"> <label for="">Chi tiết: <span>{{tenHangDaChon}}</span></label></div>
                        <div class="col-md-6"> <label for="">Số lượng: <span>{{soLuongDaChon}}</span></label></div>
                    </div>
                    <div class="row no-gutters">
                        <div class="content-table" style="width: 100%;">
                            <table class="table-responsive result-point" style="display: block;">
                                <thead class="point-table-head">
                                    <tr class="bd-normal">
                                        <th class="text-center ht3-number-cand">
                                            Kho nhập
                                        </th>
                                        <th class="text-center ht3-genral">
                                            Hợp đồng
                                        </th>
                                        <th class="text-center ht3-rank">
                                            SL
                                        </th>
                                        <th class="text-center ht3-position">
                                            Số khung
                                        </th>
                                        <th class="text-center ht3-size">
                                            Số máy
                                        </th>
                                        <th class="text-center ht3-size">
                                            Serial
                                        </th>
                                        <th class="text-center ht3-size">
                                            Model
                                        </th>
                                        <th class="text-center ht3-size">
                                            Năm SX
                                        </th>
                                        <th class="text-center ht3-size">
                                            Thành tiền
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <tr ng-repeat="item in DanhSachHangHoaChiTiet | filter:{ID_HANG:idHangHoaDaChon}">
                                        <td class="text-center">
                                            {{item.ID_KHO}}
                                        </td>
                                        <td class="text-left">
                                            {{item.SO_HOP_DONG}}
                                        </td>
                                        <td class="text-left">
                                            {{item.SO_LUONG_TT}}
                                        </td>
                                        <td class="text-left">
                                            {{}}
                                        </td>
                                        <td class="text-left">
                                            {{}}
                                        </td>
                                        <td class="text-left">
                                            {{}}
                                        </td>
                                        <td class="text-left">
                                            {{}}
                                        </td>
                                        <td class="text-left">
                                            {{}}
                                        </td>
                                        <td class="text-left">
                                            {{item.THANH_TIEN_TT}}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Modal footer -->
<div class="modal-footer d-flex justify-content-between">
    <h5 class="day-make"></h5>
    <div class="main-action d-flex flex-wrap">
        <button class="btn-action-m cl-3" ng-click="cancel()">
            <img src="../App_Assets/images/d_close.svg" alt="" class="exsit">
            <img src="../App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
            <span>Đóng</span>
        </button>
    </div>
</div>
