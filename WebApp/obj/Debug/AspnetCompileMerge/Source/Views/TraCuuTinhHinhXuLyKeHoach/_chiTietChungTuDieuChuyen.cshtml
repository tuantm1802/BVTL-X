            <!-- Modal Header -->
<div class="modal-header">
    <h4 class="modal-title">Chi tiết chứng từ</h4>
    <button type="button" class="close" data-dismiss="modal">
        <img src="~/App_Assets/images/close.svg" alt="">
    </button>
</div>
<!-- Modal body -->
<div class="modal-body">
    <div class="form-infor has-border p-3">
        <form class="row" id="thuc-luc-form">
            <div class="col-4 col-md-4">
                <label for="">Khi xuất </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.TEN_KHO_NHAN" name="KhoNhap" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Kho nhập </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.TEN_KHO_XUAT" name="KhoXuat" disabled />
            </div>
            <div class="col-4 col-md-4">

            </div>

            <div class="col-4 col-md-4">
                <label for="">Căn cứ </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.CAN_CU" name="CanCu" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Nguồn hàng </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.NGUON_HANG" name="NguonHang" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Người nhận </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.TEN_NGUOI_NHAN" name="TEN_NGUOI_NHAN" disabled />
            </div>

            <div class="col-8 col-md-8">
                <label for="">Lý do </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.LY_DO_CHUYEN" name="LY_DO_CHUYEN" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Vận chuyển </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.HT_VAN_CHUYEN" name="HT_VAN_CHUYEN" disabled />
            </div>

            <div class="col-4 col-md-4">
                <label for="">Xuất dự kiến từ </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.NGAY_XUAT_DK_TU" name="NGAY_XUAT_DK_TU" disabled />
