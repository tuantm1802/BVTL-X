                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.NGAY_NHAN_DK" name="NGAY_NHAN_DK" disabled />
            </div>

            <div class="col-4 col-md-4">
                <label for="">Ngày viết phiếu </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.NGAY_CT" name="NGAY_CT" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Người viết phiếu </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.TEN_NGUOI_VIET_PHIEU" name="TEN_NGUOI_VIET_PHIEU" disabled />
            </div>
            <div class="col-4 col-md-4">
                <label for="">Lãnh đạo phòng 10 </label>
                <input class=" form-control" type="text" ng-model="ChiTietPhieuDieuChuyen.TEN_NGUOI_KY_1" name="TEN_NGUOI_KY_1" disabled />
