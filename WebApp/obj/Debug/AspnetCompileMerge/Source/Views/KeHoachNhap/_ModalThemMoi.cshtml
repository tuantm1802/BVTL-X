<div class="modal fade" id="them_hang_hoa">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới hợp đồng</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <form class="modal-body row no-gutters" @*style="height:50vh"*@  id="frm-them-hang-hoa">
                <div class="content-table mt-2 col-12 col-md-5 has-border">
                    <h4 style="font-weight:bold">Danh sách hàng hóa</h4>
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head">
                            <tr>
                                <th style="width:3%;"><input type="checkbox" ng-model="checkAllLeft" ng-click="ChonTatCaHangHoa(0)"/> </th>
                                <th style="width:3%;">STT </th>
                                <th style="width:4%;" class="text-center">Mã hàng<i id="or_ntn"></i></th>
                                <th class="text-center">Tên hàng<i id="or_ntn"></i></th>
                                <th class="text-center">Đơn vị tính<i id="or_ntn"></i></th>
                            </tr>
                        </thead>
                        <tbody style="background-color:white">
                            <tr ng-repeat="item in dsHangHoaChon">
                                <td class="text-center"><input type="checkbox" ng-model="item.Selected" ng-click="TichChonHangHoa(0,$index)"/></td>
                                <td class="text-center">
                                    <label class="form-control">{{item.ID_HANG}}</label>
                                </td>
                                <td>
                                    <label class="form-control">{{item.MA_HANG}}</label>
                                </td>
                                <td>
                                    <label class="form-control">{{item.TEN_HANG}}</label>
                                </td>
                                <td>
                                    <select class="form-control" ng-model="item.DVT_VW" ng-options="option.NAME for option in donvitinh"></select>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="content-table mt-2 col-12 col-md-2" style="display: block;">
                    <div class="centered" style="top:40%; padding:10px">
                        <button class="btn-action-m" ng-click="HuyChonHangHoa()">
                            <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
                        </button>
                    </div>
                    <div class="centered" style="top:60%; padding:10px">
                        <button class="btn-action-m" ng-click="ChonHangHoa()">
                            <img class="img-180-rotate" src="~/App_Assets/images/ic_back_xx.svg" alt="">
                        </button>
                    </div>

                </div>
                <div class="content-table mt-2 col-12 col-md-5 has-border">
                    <h4 style="font-weight:bold">Danh sách hàng hóa đã chọn</h4>
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head">
                            <tr>
                                <th style="width:3%;"><input type="checkbox" ng-model="checkAllRight" ng-click="ChonTatCaHangHoa(1)"/></th>
                                <th style="width:3%;">STT </th>
                                <th class="text-center">Hàng hóa<i id="or_ntn"></i></th>
                                <th style="width:11%;">Đơn vị tính<i id="or_dv"></i></th>
                                <th style="width:11%;">Số lượng<i id="or_nn"></i></th>
                            </tr>
                        </thead>`
                        <tbody style="background-color:white">
                            <tr ng-repeat="item in dsHangHoaDaChon">
                                <td class="text-center"><input type="checkbox" ng-model="item.Selected" ng-click="TichChonHangHoa(1,$index)"/></td>
                                <td class="text-center">
                                    <label class="form-control">{{item.ID_HANG}}</label>
                                </td>
                                <td>
                                    <label class="form-control">{{item.MA_HANG+' - '+item.TEN_HANG}}</label>
                                </td> 
                                <td>
                                    <label class="form-control">{{item.DVT_VW.NAME}}</label>
                                </td>
                                <td><input type="number" class="form-control" ng-model="item.SO_LUONG"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" ng-click="LuuDsHangHoa()">
                    <img src="~/App_Assets/images/icon_save.svg" alt="">
                    <span>Chọn hàng hóa</span>
                </button>
                @*<button type="button" class="btn btn-secondary" ng-click="XoaAnhDinhKem()">
                    <img src="~/App_Assets/images/icon_close.svg" alt="">
                    <span>Đóng</span>
                </button>*@
            </div>
        </div>
    </div>
</div>