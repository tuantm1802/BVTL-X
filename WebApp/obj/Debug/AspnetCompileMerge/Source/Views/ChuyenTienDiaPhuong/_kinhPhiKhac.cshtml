<style>
    .fixTableHead {
        overflow-y: scroll;
    }

        .fixTableHead thead th {
            position: sticky !important;
            top: 1px;
        }
    .choose {
        border-radius:30px;
    }
        .choose :focus {
            background-color: lightgreen;
        }
        .fixTableHead table {
        }
</style>
<div class="tab-pane fade" id="kinh-phi-khac" role="tabpanel" aria-labelledby="profile-tab">
    <div class="row">
        <div class="col-md-5">
            <div class="fill-box">
                <h3 class="title-fill">
                    Kinh phí thường xuyên
                </h3>
            </div>

            <div class="col-md-12 main-action">
                <div class="row">
                    <button class="btn-action-m bg-green" ng-click="DSDonVi()">
                        <span>Danh sách đơn vị</span>
                    </button>
                    <button class="btn-action-m bg-green" ng-click="DeleteKptx()">
                        <span>Xóa</span>
                    </button>
                </div>
            </div>
            <div class="content-system content-table mt-2 fixTableHead" style="border:none !important; height:calc(100vh - 340px);">
                <table class="table-hover result-point mt-2 fixTableHead">
                    <thead class="point-table-head" style="width:100%">
                        <tr>
                            <th style="width:5%;" class="text-center" rowspan="2">
                                <input type="checkbox" ng-model="SelectAllKptx" ng-click="CheckAllKptx()"/>
                            </th>
                            <th style="width:5%;" rowspan="2">STT</th>
                            <th style="width:40%;" class="text-left">Đơn vị</th>
                            <th style="width:25%;" class="text-left">KP Hóa trang NV</th>
                            <th style="width:25%;" class="text-left">KP  Bảo hộ lao động</th>
                        </tr>

                    </thead>
                    <tbody>
                        <tr ng-repeat="item in ListKinhPhiThuongXuyen" ng-click="loadTemplateKptx($index)">
                            <td class="text-center">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" value="10" ng-model="item.Selected" />
                                    <span class="lbl"></span>
                                </label>
                            </td>
                            <td>{{$index + 1}}</td>
                            <td>{{item.TEN_DON_VI}}</td>
                            <td>
                                <span ng-if="!item.Edit">
                                    {{item.KP_HOA_TRANG | number}}
                                </span>
                                <div ng-if="item.Edit">
                                    <input type="text"  class="form-control" ng-model="item.KP_HOA_TRANG">
                                </div>
                            </td>
                            <td>
                                <span ng-if="!item.Edit">
                                    {{item.KP_BAO_HO_LD | number}}
                                </span>
                                <div ng-if="item.Edit">
                                    <input type="text" class="form-control" ng-model="item.KP_BAO_HO_LD">
                                </div>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr ng-repeat="item in rows">
                            <td class="text-center">
                                <label class="pos-rel">
                                    <input type="checkbox" class="ace" value="10" />
                                    <span class="lbl"></span>
                                </label>
                            </td>
                            <td></td>
                            <td>
                                {{item.TEN_DON_VI}}
                            </td>
                            <td>
                                <input type="text" ng-class="item.KPHT? 'error': ''" class="form-control" ng-model="item.KP_HOA_TRANG">
                                <div ng-show="item.KPHT">
                                    <label class="error">{{item.textht}}</label>
                                </div>
                            </td>
                            <td>
                                <input type="text" ng-class="item.KPBH? 'error': ''" class="form-control" ng-model="item.KP_BAO_HO_LD">
                                <div ng-show="item.KPBH">
                                    <label class="error">{{item.textbh}}</label>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="col-md-12 main-action">
                <div class="row">
                    <button class="btn-action-m bg-green" ng-click="BackKptx()">
                        <span>Hủy thay đổi</span>
                    </button>
                    <button class="btn-action-m bg-green" ng-click="SaveKptx()">
                        <span>Lưu</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="fill-box">
                <h3 class="title-fill">
                    Kinh phí tăng thêm
                </h3>
            </div>
            <div class="col-md-12">
                <div class=" row">
                    <div class="col-md-4">
                        <div class="main-action">
                            <div class="row">
                                <button class="btn-action-m bg-green" ng-click="AddKP()">
                                    <span>Thêm kinh phí</span>
                                </button>
                                <button class="btn-action-m bg-green" ng-click="XoaKpTT()">
                                    <span>Xóa</span>
                                </button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="function-box" style="height: calc(100vh - 340px);">
                                <div class="ztreeRoleBackground left" style="width:100%;">
                                    <ul class="ztree choose" ng-repeat="item in ListKinhPhiTangThem" ng-click="SelectKP(item)">
                                        <li class="level0 choose" tabindex="0" hidefocus="true" treenode="">
                                            <span title="" class="button level0 switch center_docu" treenode_switch=""></span>
                                            <a class="level0" title="">
                                                <span title="" treenode_ico="" class="button ico_docu" style=""></span>
                                                <span class="node_name">{{item.TEN_KINH_PHI_TANG_THEM}}</span>
                                            </a>
                                        </li>
                                    </ul>
                                    <ul class="ztree" ng-repeat="item in ListAddKp">
                                        <li class="level0" tabindex="0" hidefocus="true" treenode="">
                                            <span title="" class="button level0 switch center_docu" treenode_switch=""></span>
                                            <a class="level0" title="">
                                                <span title="" treenode_ico="" class="button ico_docu" style=""></span>
                                                <input type="text" ng-class="item.KPT? 'error': ''" class="form-control" ng-model="item.TEN_KINH_PHI_TANG_THEM">
                                                <div ng-show="item.KPT">
                                                    <label class="error">Bạn chưa nhập tên kinh phí</label>
                                                </div>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-12 main-action">
                                <div class="row">
                                    <button class="btn-action-m bg-green" ng-click="BackKptt()">
                                        <span>Hủy thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="SaveKpTT()">
                                        <span>Lưu</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="main-action">
                            <div class="row">
                                <button class="btn-action-m bg-green" ng-click="AddDonViKPTT()">
                                    <span>Thêm đơn vị</span>
                                </button>
                                <button class="btn-action-m bg-green" ng-click="DeleteKptt()">
                                    <span>Xóa</span>
                                </button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="content-system content-table mt-2 fixTableHead" style="border:none !important; height:calc(100vh - 340px);">
                                <table class="table-hover result-point mt-2">
                                    <thead class="point-table-head" style="width:100%">
                                        <tr>
                                            <th style="width:5%;" class="text-center" rowspan="2">
                                                <input type="checkbox" ng-model="SelectAllKptt" ng-click="CheckAllKptt()"/>
                                            </th>
                                            <th style="width:5%;" rowspan="2">STT</th>
                                            <th style="width:40%;" class="text-left">Đơn vị</th>
                                            <th style="width:25%;" class="text-left">{{TenKpTT}}</th>
                                        </tr>

                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in ListKinhPhiTangThemDT"  ng-click="loadTemplateKptt($index)">
                                            <td class="text-center">
                                                <label class="pos-rel">
                                                    <input type="checkbox" class="ace" value="10" ng-model="item.Selected"/>
                                                    <span class="lbl"></span>
                                                </label>
                                            </td>
                                            <td>{{$index + 1}}</td>
                                            <td>{{item.TEN_DON_VI}}</td>
                                            <td>
                                                <span ng-if="!item.Edit">
                                                    {{item.GIA_TRI | number}}
                                                </span>
                                                <div ng-if="item.Edit">
                                                    <input type="text" class="form-control" ng-model="item.GIA_TRI">
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr ng-repeat="item in addkptt">
                                            <td class="text-center">
                                                <label class="pos-rel">
                                                    <input type="checkbox" class="ace" value="10" />
                                                    <span class="lbl"></span>
                                                </label>
                                            </td>
                                            <td></td>
                                            <td>
                                                {{item.TEN_DON_VI}}
                                            </td>
                                            <td>
                                                <input type="text" ng-class="item.GT? 'error': ''" class="form-control" ng-model="item.GIA_TRI">
                                                <div ng-show="item.GT">
                                                    <label class="error">{{item.text}}</label>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="col-md-12 main-action">
                                <div class="row">
                                    <button class="btn-action-m bg-green" ng-click="BackKpttDt()">
                                        <span>Hủy thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="SaveKpTTDT()">
                                        <span>Lưu</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>