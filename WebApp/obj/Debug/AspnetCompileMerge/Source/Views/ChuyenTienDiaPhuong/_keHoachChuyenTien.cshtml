                    </thead>
                    <tbody>
                        <tr ng-repeat="item in ListDonVikh">
                            <td>{{item.STT}}</td>
                            <td ng-dblclick="KeHoachChuyenTienDT(item)">{{item.TEN_DON_VI}}</td>
                            <td>{{item.NT_CBCS | number}}</td>
                            <td>{{item.NT_PHAM | number}}</td>
                            <td>{{item.QUYET_TOAN | number}}</td>
                            <td>{{item.DN_CBCS | number}}</td>
                            <td>{{item.DN_PHAM | number}}</td>
                            <td>{{item.KINH_PHI_DN | number}}</td>
                            <td>{{item.KP_HOA_TRANG | number}}</td>
                            <td>{{item.KP_BAO_HO_LD | number}}</td>
                            <td>0</td>
                            <td>0</td>
                            <td>{{item.KP_BAO_HO_LD + item.KP_HOA_TRANG | number}}</td>
                            <td>{{item.NT_CBCS + item.DN_CBCS - item.KP_HOA_TRANG - item.KP_BAO_HO_LD | number}}</td>
