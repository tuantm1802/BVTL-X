@using ReportViewerForMvc;
<form id="KehoachChuyenTienDT" name="KehoachChuyenTienDT" >
    <!-- Modal Header -->
    <div class="modal-header">
        <h4 class="modal-title">Danh sách đơn vị</h4>
        <button type="button" class="close" ng-click="cancel()">
            <img src="../App_Assets/images/close.svg" alt="">
        </button>
    </div>

    <!-- Modal body -->
    <div class="modal-body">
        <div class="row" style="width:100%">
            <div class="well form-infor" style="background-color: #f5f5f5;padding:25px;margin:25px 0;width:100%">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-12">
                        <div class="form-group" style="float:left;margin-right:15px">
                            <label>Số công văn: </label>
                            @*<input type="text" id="txtsocongvan" value="@Model.socongvan" style="width: 150px;margin-right:15px" class="form-control" ng-model="modelSearch.socongvan">*@
                            <input type="text" style="width: 150px;" class="form-control" ng-model="Socv">
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="modal fade" id="modal1" role="dialog">
        <div class="modal-dialog" style="max-width:none !important">
            <div class="modal-content">
                <div class="modal-body">
                    <div id="containerReportViewer" class="col-12 col-sm-12 col-md-12 col-lg-12" style=" height: calc(100vh - 195px) !important; overflow-y:auto !important; text-align:center">
                        @*@Html.ReportViewer(ViewBag.ReportViewer as Microsoft.Reporting.WebForms.ReportViewer)*@
                        @Html.Partial("_ChiTietKeHoachChuyenTien")
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal footer -->
    <div class="modal-footer d-flex justify-content-between">
        <h5 class="day-make"></h5>
        <div class="main-action d-flex flex-wrap">
            <button class="btn-action-m cl-3" ng-click="XemBC()">
                <img src="../App_Assets/images/l7.svg" alt="" class="exsit">
                <img src="../App_Assets/images/ic_print_light.svg" alt="" class="hover_m">
                <span>Chọn</span>
            </button>
            <button class="btn-action-m cl-3" ng-click="cancel()">
                <img src="../App_Assets/images/d_close.svg" alt="" class="exsit">
                <img src="../App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                <span>Đóng</span>
            </button>
        </div>
    </div>
</form>

