<style>
    .table .cap {
        margin-bottom: 0px;
    }

    .table-nested .cell-members {
        width: 60px;
    }

    .table-nested .indent-icon {
        display: inline-block;
    }

    .table-nested .indentt {
        display: inline-block;
    }

    .table-nested .parent > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1.svg);
        font-family: FontAwesome;
        display: inline-block;
        -moz-transition: -moz-transform 0.3s;
        -o-transition: -o-transform 0.3s;
        -webkit-transition: -webkit-transform 0.3s;
        transition: transform 0.3s;
    }

    .table-nested .parent > .cell-name > .indentt {
        content: url(../../App_Assets/images/f_drop_3.svg);
    }

    .table-nested .opened > tr > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1_active.svg);
    }
</style>

@{
    ViewBag.Title = "Nhóm trang phục";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục nhóm trang phục
    </h3>
</div>
<div ng-controller="NhomTrangPhucController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12"
                     style="padding: 0px;  padding-right: 2px;">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12" align-self-end">
                                <div class="main-action d-flex pull-left">
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Addmm()" ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Hiden()" ng-show="RoleBtnCancel"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>Huỷ thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="submit()" ng-show="RoleBtnSave"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-floppy-o" aria-hidden="true"></i>
                                        <span>Lưu lại</span>
                                    </button>
                                    <button class="btn-action-m bg-red" type="button"
                                            ng-click="delete()" ng-show="RoleBtnDelete"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xoá</span>
                                    </button>
                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right" style="margin-left:5px;">
                                    <div class="d-flex form-group" style="margin-bottom:0px;vertical-align:middle">
                                        <input type="text" ng-model="search" placeholder="Tìm kiếm" class="form-control" style="width:250px;margin-bottom:0px" />
                                        <button class="btn-action-m form-control" style="color:white;width:40px;margin-bottom:0px">
                                            <i class="fa fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="content-table" style="margin-top:10px;">
                        <table class="cap table-nested table content-table table-bordered table-hover">
                            <thead style="width:100%">
                                <tr>
                                    <th style="width:5%;" class="text-center">
                                        <label>
                                            <input type="checkbox" class="form-control"
                                                   ng-model="selectAll" ng-click="CheckAll()" />
                                        </label>
                                    </th>
                                    <th style="width:5%; border-left:0px !important;"
                                        class="cell-members">STT</th>
                                    <th style="width:45%;" class="cell-name">Tên nhóm </th>
                                    <th style="width:25%;" class="cell-members">Mô tả</th>
                                    <th style="width:20%; border-right: 0px !important;"
                                        class="cell-members">Loại trang phục</th>
                                </tr>
                            </thead>
                            <tbody style="width:100%;border-top: 1px solid #dee2e6;" ng-class="{opened: item.opened}"
                                   ng-include="&#39;table_tree.html&#39;"
                                   ng-repeat="item in DanhSach | filter: search">
                            </tbody>
                            <tfoot style="width:100%" ng-if="noSelected">
                                <tr ng-repeat="row in rows">
                                    <td style="width:5%;" class="cell-input">
                                        <input type="checkbox" id="check" ng-true-value="{{item.ID}}"
                                               ng-false-value="''" />
                                    </td>
                                    <td style="width:5%; border-left:0px !important;" class="cell-members"></td>
                                    <td style="width:45%;">
                                        <input ng-class="row.SP? 'error': ''" class="form-control"
                                               placeholder="Nhập tên nhóm trang phục" type="text"
                                               ng-model="row.TEN_NHOM_SP" />
                                        <div ng-show="row.SP">
                                            <label class="error">Bạn chưa nhập tên nhóm trang phục</label>
                                        </div>
                                    </td>
                                    <td style="width:25%;">
                                        <input class="form-control" type="text"
                                               ng-model="row.MO_TA" placeholder="Nhập mô tả" />
                                    </td>
                                    <td style="width:20%; border-right:0px !important;">
                                        <div ng-class="row.LOAI_TP ? 'error': ''">
                                            <select class="form-control"
                                                    ng-model="row.LOAI_TP"
                                                    @*ng-options="x.id as x.text for x in loaitp" *@>
                                                <option ng-repeat="x in loaitp" value="{{x.text}}">{{x.text}}</option>
                                            </select>
                                            <div ng-show="row.loaiTP">
                                                <label class="error">Bạn chưa chọn loại trang phục</label>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <script id="table_tree.html" type="text/ng-template">
                        <tr ng-class="{parent: item.children}"
                            ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)"
                            ng-dblclick="loadTemplate($index, level, item)">
                            <td style="width:5%; padding: 8px !important;" class="cell-input">
                                <input ng-disabled="item.status" ng-model="item.selected"
                                       ng-click="checkAllchild(item)" class="form-control" type="checkbox" />
                            </td>
                            <td style="width:5%; padding: 8px !important;border-left:0px !important;"
                                class="cell-members">
                                <span ng-model="STT">{{item.stt}}</span>
                            </td>
                            <td style="width:45%;" class="cell-name"
                                ng-click="item.opened = !item.opened">
                                <div ng-if="item.parent" class="indent-icon"
                                     style="padding-left: {{50*level}}px">
                                </div>
                                <div ng-if="!item.parent" class="indentt"
                                     style="padding-left: {{50*level}}px ">
                                </div>
                                <span ng-if="!item.Edit">{{item.TEN_NHOM_SP}}</span>
                                <input style="width:200px; display: inline-block;" type="text" ng-if="item.Edit"
                                       class="form-control" ng-model="item.TEN_NHOM_SP">
                            </td>

                            <td style="width:25%; padding: 8px !important;" class="cell-members">
                                <span ng-if="!item.Edit">{{item.MO_TA}}</span>
                                <input type="text" ng-if="item.Edit"
                                       class="form-control" ng-model="item.MO_TA">
                            </td>
                            <td style="width:20%; padding: 8px !important; border-right:0px !important;" class="text-left">
                                <span ng-if="!item.Edit">{{item.LOAI_TP}}</span>
                                <select type="text" ng-if="item.Edit"
                                        ng-model="item.LOAI_TP" class="form-control"
                                        @*ng-options="x.id as x.text for x in loaitp" *@>
                                    <option ng-repeat="x in loaitp | filter:FilterLoaiTPByParent(parentScope.item.LOAI_TP)" value="{{x.id}}">{{x.text}}</option>
                                </select>
                            </td>
                        </tr>
                        <tr class="children" ng-if="item.children &amp;&amp; item.children.length &gt; 0">
                            <td colspan="6" style="border-left:0px !important; border-right:0px !important;">
                                <table class="table table-striped table-bordered table-hover"
                                       style="border-left:0px !important; border-right:0px !important;"
                                       ng-class="{opened: item.opened}" ng-include="&#39;table_tree.html&#39;"
                                       ng-init="level = level + 1" ng-repeat="item in item.children | filter: search">
                                </table>
                            </td>
                        </tr>
                        <tr ng-if="item.selected &amp;&amp; !item.status &amp;&amp; !noSelected"
                            ng-repeat="row in rows">
                            <td style="width:5%;" class="cell-input">
                                <input type="checkbox" id="check" ng-true-value="{{item.ID}}" ng-false-value="''" />
                            </td>
                            <td style="width:5%; border-left:0px !important;" class="cell-members"></td>
                            <td style="width:40%;">
                                <div style="padding-left: {{50*(level+1)}}px">
                                    <input type="text" ng-class="row.SP? 'error': ''"
                                           ng-model="row.TEN_NHOM_SP"
                                           class="form-control" placeholder="Nhập tên nhóm trang phục" />
                                    <div ng-show="row.SP">
                                        <label class="error">Bạn chưa nhập tên nhóm trang phục</label>
                                    </div>
                                </div>
                            </td>
                            <td style="width:25%;">
                                <input class="form-control" type="text"
                                       ng-model="row.MO_TA" placeholder="Nhập mô tả" />
                            </td>
                            <td style="width:15%; border-right:0px !important;">
                                <div ng-class="row.loaiTP ? 'error': ''">
                                    <select class="form-control" ng-model="row.LOAI_TP"
                                            @*ng-options="x.id as x.text for x in loaitp" *@>
                                        <option ng-repeat="x in loaitp | filter:FilterLoaiTPByParent(row.LOAI_TP)" value="{{x.id}}">{{x.text}}</option>
                                    </select>
                                    <div ng-show="row.loaiTP">
                                        <label class="error">Bạn chưa chọn loại trang phục</label>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </script>
                </div>
            </div>
        </div>
    </main>
</div>
@section scripts{
    <script src="~/app/Controller/NhomTrangPhuc.js"></script>
}