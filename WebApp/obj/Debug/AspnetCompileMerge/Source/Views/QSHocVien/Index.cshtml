                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="add-hoc-vien">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Thêm học viên</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <div class="modal-body">
                    <form class="row form-infor" id="form-them-hoc-vien">
                        <div class="col-4 col-md-4">
                            <label for="">Loại học viên: <span class="text-danger">*</span></label>
                            <select class="form-control" name="LOAI_HOC_VIEN" ng-model="HocVienModel.LOAI_HOC_VIEN" required >
                                @*<option value="" selected>Chọn loại học viên</option>*@
                                <option value="1" @*ng-show="HocVienModel.CAP_BAC == 1 || HocVienModel.CAP_BAC == 2"*@>Học viên CAND</option>
                                <option value="2" @*ng-show="HocVienModel.CAP_BAC == 3 || HocVienModel.CAP_BAC == 4 || HocVienModel.CAP_BAC == 5"*@>Cán bộ đi học</option>
                            </select>
                        </div>
                        <div class="col-4 col-md-4">
                            <label for="">Lực lượng: <span class="text-danger">*</span></label>
                            <input type="text" ng-model="HocVienModel.LUC_LUONG_ID_TXT" name="LUC_LUONG" ng-change="ChangeLucLuong()" placeholder="Lực lượng" autocomplete="on"
                                   ui-combo-tree combo-tree-init="LucLuongTreeInit" on-callback="LucLuongCallback(data)" />
                            <input type="hidden" ng-model="HocVienModel.LUC_LUONG_ID"/>
                        </div>
                        <div class="col-4 col-md-4">
                            <label for="">Cấp bậc: <span class="text-danger">*</span></label>
                            @*<select class="form-control" ng-change="ChangeCapBac()" ng-model="HocVienModel.CAP_BAC">
                                <option value="1" >Học viên "ĐH-CĐ"</option>
                                <option value="2" >Học viên "Trung học"</option>
                                <option value="3" >Học viên cấp SQ</option>
                                <option value="4" >Học viên cấp HSQ</option>
                                <option value="5" >Học viên cấp tướng</option>
                            </select>*@
                            <select class="form-control" ng-change="" name="CAP_BAC" placeholder="Cấp bậc" ng-model="HocVienModel.CAP_BAC" ng-options="item.Id as item.Name for item in ListCapBacs">
                                <option value="" selected>- Chọn cấp bậc -</option>
                            </select>
                        </div>


                        @*<div class="col-6 col-md-6">
                            <label for="">Năm học: <span class="text-danger">*</span></label>
                            <select class="form-control" ng-model="HocVienModel.NAM_HOC">
                                <option value="" selected>-- Chọn năm học --</option>
                                <option value="0">HV nhập học lần đầu</option>
                                <option value="1">HV năm 1 -> 2</option>
                                <option value="2">HV năm 2 -> 3</option>
                                <option value="3">HV năm 3 -> 4</option>
                                <option value="4">HV năm 4 -> 5</option>
                                <option value="5">HV năm 5 -> 6</option>
                                <option value="9">HV kỳ cuối</option>
                            </select>
                        </div>*@
                        <div class="col-4 col-md-4">
                            <label for="">Số lượng nam: <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" name="SL_NAM" ng-model="HocVienModel.SL_NAM" ng-change="sumSoLuongNamNu()" required />
                        </div>
                        <div class="col-4 col-md-4">
                            <label for="">Số lượng nữ: <span class="text-danger">*</span></label>
                            <input class="form-control" type="number" name="SL_NU" ng-model="HocVienModel.SL_NU" ng-change="sumSoLuongNamNu()" required />
                        </div>
                        <div class="col-4 col-md-4">
                            <label for="">Tổng cộng:</label>
                            <input class="form-control" type="number" name="SL_TONG" disabled ng-model="HocVienModel.SL_TONG" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn-action-m bg-teal" ng-click="LuuHocVien()">
                        <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="add-khoa-hoc">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Thêm mới khóa học</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <div class="modal-body">
                    <form class="row form-infor" id="form-hoc-vien">

                        <div class="col-12 col-md-12">
                            <label for="">Mã khóa học: <span class="text-danger">*</span></label>
                            <input class="form-control" name="TEN_KHOA_HOC" ng-model="khoaHoc.MA_KHOA_HOC" required />
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Tên khóa học: <span class="text-danger">*</span></label>
                            <input class="form-control" name="TEN_KHOA_HOC" ng-model="khoaHoc.TEN_KHOA_HOC" required />
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Mô tả: </label>
                            <textarea class="form-control" ng-model="khoaHoc.MO_TA" rows="3"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn-action-m bg-green" ng-click="LuuKhoaHoc()">
                        <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("_addNienKhoa")

</main>

@section scripts{
    <script src="~/app/Controller/QuanSo/QSHocVienController.js"></script>
}