
@{
    ViewBag.Title = "Học viên";
}
<style>
    .function-box {
        height: calc(100vh - 235px);
    }

    .content-table {
        height: calc(100vh - 348px);
    }

    .nav-box {
        height: calc(100vh - 194px) !important;
    }
</style>
<main ng-controller="QSHocVienController" style="padding-top: 20px;">
    <div class="container-fluid d-flex cons-ac-system" style="height: calc(100vh - 125px);">
        <div class="action-system pd-two ui-widget-content" id="resizable" style="width:25%">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>

            <div class="fill-box">
                <h3 class="title-fill">
                    Đơn vị
                </h3>
            </div>

            <div class="container">
                <div class="main-action pt-3">
                    <div class="form-search w-100">
                        <input type="text" placeholder="Tìm kiếm">
                        <button>
                            <img src="../App_Assets/images/search_icon.svg" alt="">
                        </button>
                    </div>
                </div>

                <div class="function-box">
                    <div class="ztreeRoleBackground left" style="width:100%;">
                        <ul id="treeRole" class="ztree"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-system no-border pb-0" ng-show="IsShowRight">
            <div class="form-infor has-border p-3 firts-to-h" style="padding-bottom: 5px !important;">
                <div class="row no-gutters">
                    <div class="col-3 col-md-3 col-lg-3">
                        <input type="text" class="form-control" placeholder="{{TEN_DON_VI}}" disabled>
                    </div>
                    <div class="col-3 col-md-3 col-lg-3">
                        <input type="text" class="form-control" placeholder="{{TEN_KHOA_HOC}}" disabled>
                    </div>
                    <div class="col-3 col-md-3 col-lg-3">
                        <input type="text" class="form-control" placeholder="{{NIEN_KHOA}}" disabled>
                    </div>
                    <div class="col-3 col-md-3 col-lg-3">
                        <select ng-model="NAM" class="form-control" ng-change="ChangeNam()">
                            <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Name}}</option>
                        </select>
                    </div>

                    @*<div class="col-12 col-md-6 col-lg-3">
            <select ng-model="KY" class="form-control">
                <option value="XH">Xuân hạ</option>
                <option value="TD">Thu đông</option>
            </select>
        </div>*@
                </div>
            </div>
            <div class="nav-box" style="height: auto !important;">
                <div class="row">
                    <div class="action-system pd-two ui-widget-content col-md-3" style="padding: 0px">
                        <div class="fill-box">
                            <h3 class="title-fill" style="padding-left: 10px;">
                                Khóa học
                            </h3>
                        </div>

                        <div class="container" style="height:calc(100vh - 500px)">
                            <div class="main-action pt-3">
                                <div class="form-search w-100" style="padding-left: 10px;">
                                    <input type="text" placeholder="Tìm kiếm">
                                    <button>
                                        <img src="../App_Assets/images/search_icon.svg" alt="">
                                    </button>
                                </div>
                            </div>
                            <div class="row" style="padding-left: 10px;">
                                <div class="col-md-12  main-action d-flex">
                                    <button class="btn-action-m bg-green" ng-click="AddKhoaHoc()">
                                        <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="DeleteKhoaHoc()">
                                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Xóa </span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="EditKhoaHoc()">
                                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Sửa </span>
                                    </button>
                                </div>
                            </div>

                            <div class="function-box" style="height:calc(100vh - 600px)">
                                <div class="ztreeRoleBackground left" style="width:100%;">
                                    <ul class="ztree">
                                        <li ng-repeat="item in ListKhoaHoc" ng-click="SelectedKhoaHoc(item, $index)" class="level0" tabindex="0" hidefocus="true" treenode="">
                                            <span title="" class="button level0 switch center_docu"></span>
                                            <a class="level0" ng-class="{'curSelectedNode selected-khoa-hoc': itemKhoaHocSelect == $index}" data-id="{{item.ID}}" title="{{item.TEN_KHOA_HOC}}">
                                                <span title="" treenode_ico="" class="button ico_docu" style=""></span>
                                                <span class="node_name">{{item.TEN_KHOA_HOC}}</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <!-- Niên khóa -->
                        <div class="fill-box">
                            <h3 class="title-fill" style="padding-left: 10px;">
                                Niên khóa
                            </h3>
                        </div>
                        <div class="container" style="height:calc(100vh - 500px)">

                            <div class="row" style="padding-left: 10px;">
                                <div class="col-md-12  main-action d-flex mt-2">
                                    <button class="btn-action-m bg-green" ng-click="AddNienKhoa()">
                                        <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="DeleteNienKhoa()">
                                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Xóa </span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="EditNienKhoa()">
                                        <i class="fa fa-trash" aria-hidden="true"></i>    <span> Sửa </span>
                                    </button>
                                </div>
                            </div>

                            <div class="function-box" style="height:calc(100vh - 530px)">
                                <div class="ztreeRoleBackground left" style="width:100%;">
                                    <ul class="ztree">
                                        <li ng-repeat="item in ListNienKhoa" ng-click="SelectedNienKhoa(item, $index)" class="level0" tabindex="0" hidefocus="true" treenode="">
                                            <span title="" class="button level0 switch center_docu"></span>
                                            <a class="level0" ng-class="{'curSelectedNode selected-khoa-hoc': itemNienKhoaSelect == $index}" data-id="{{item.ID}}" title="{{item.TU_NAM}}">
                                                <span title="" treenode_ico="" class="button ico_docu" style=""></span>
                                                <span class="node_name">{{item.TU_NAM}} - {{item.DEN_NAM}} </span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="no-border pb-0 col-md-9" ng-show="IsShowHocVien">
                        <div class="nav-box">
                            <div class="row">
                                <div class="col-md-12 main-action d-flex">
                                    <button class="btn-action-m bg-green" ng-click="AddHocVien()">
                                        <i class="fa fa-plus" aria-hidden="true"></i>  <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-disabled="disabledDelHocVien" ng-click="DeleteHocVien()">
                                        <i class="fa fa-trash" aria-hidden="true"></i><span> Xóa </span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-disabled="disabledEditHocVien" ng-model="hocVienIdToEdit" ng-click="EditHocVien()">
                                        <i class="fa fa-trash" aria-hidden="true"></i><span> Sửa </span>
                                    </button>
                                    <button class="btn-action-m bg-green" ng-click="CopySoLieuNamTruoc()">
                                        <i class="fa fa-backspace" aria-hidden="true"></i>    <span> Copy Số liệu năm trước </span>
                                    </button>
                                    <div class="col-12 text-right" style="flex:0%">
                                        <label><mark>{{kyHocVien}}</mark></label>
                                    </div>
                                </div>
                            </div>
                            <div class="content-table">
                                <div class="form-infor has-border p-3 firts-to-h" style="padding-bottom: 5px !important;">
                                    <div class="row no-gutters">
                                        <div class="content-table" id="left-table" style="width:100%">
                                            <table class="table-responsive table-hover result-point">
                                                <thead class="point-table-head">
                                                    <tr>
                                                        <th class="text-center" style="width:5%;"><input type="checkbox" ng-model="checkAll" ng-click="ChonTatCa()" /> </th>
                                                        <th class="text-center" style="width:30%;">Lực lượng<i id="or_ntn"></i></th>
                                                        <th class="text-center" style="width:30%;">Cấp bậc</th>
                                                        <th class="text-center" style="width:20%;">Loại học viên</th>
                                                        <th class="text-center" style="width:5%;">Nam</th>
                                                        <th class="text-center" style="width:5%;">Nữ</th>
                                                        <th class="text-center" style="width:5%;">Tổng cộng</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="background-color:white">
                                                    @*<tr ng-repeat="item in dsHocVien" ng-click="ShowChiTietHangHoa($index)" ng-class="{'selected':$index == selectedGood}">*@
                                                    <tr ng-repeat="item in dsHocVien" ng-click="" ng-class="">
                                                        <td class="text-center"><input type="checkbox" ng-model="item.Selected" ng-click="TichChonHocVien($index)" ng-disabled="EditStatus" /></td>
                                                        <td class="text-center"><label>{{item.TEN_LUC_LUONG}}</label></td>
                                                        <td class="text-center">{{item.TEN_CAP_BAC}}</td>
                                                        <td class="text-center"> {{item.TEN_LOAI_HOC_VIEN}}</td>
                                                        <td class="text-center"> {{item.SL_NAM}}</td>
                                                        <td class="text-center"> {{item.SL_NU}}</td>
                                                        <td class="text-center"> <label>{{item.SL_TONG}}</label></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

