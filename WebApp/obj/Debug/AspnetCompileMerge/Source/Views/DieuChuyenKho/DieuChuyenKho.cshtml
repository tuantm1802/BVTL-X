
@{
    ViewBag.Title = "Index";
}
<style>
    .row {
        margin-left: 0px;
        margin-right: 0px;
    }
    .form-control {
        padding: 0px 0px;
    }
    .content-table table {
        display: block
    }
    .table-responsive {
        display: table
    }
    #resizable {
        height: 87vh
    }
</style>


<div class="container-fluid d-flex cons-ac-system" style=" margin-top: 0px " ng-controller="DieuChuyenKhoController">
    @Html.Partial("~/Views/DieuChuyenKho/HangDoiDieuChuyen.cshtml")
    <div class="e-col-sm-12 col-sm-12" id="page-content-wrapper">
        <div style="font-size: 20pt;font-weight: bold;color: #00933f; text-align:center; align-content:center;justify-content:center">ĐIỀU CHUYỂN KHO</div>
        <div class="main-action d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center flex-wrap">
                <button class="btn-action-m" ng-click="ThemPhieu()">
                    <img src="~/App_Assets/images/icon_add.svg" alt="">
                    <span>Thêm mới</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_edit.svg" alt="">
                    <span>Sửa</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                    <span>Xoá</span>
                </button>

                <button class="btn-action-m" ng-click="LuuPhieu()">
                    <img src="~/App_Assets/images/icon_save.svg" alt="">
                    <span>Lưu</span>
                </button>

                <button class="btn-action-m">
                    <img src="~/App_Assets/images/icon_cancel.svg" alt="">
                    <span>Huỷ thay đổi</span>
                </button>
                <button class="btn-action-m" data-toggle="modal" data-target="#kho_anh">
                    <img src="~/App_Assets/images/icon_cancel.svg" alt="">
                    <span>Đính kèm</span>
                </button>
            </div>

            <button class="btn-action-m">
                <img src="~/App_Assets/images/l7_hover.svg" alt="">
                <span>In phiếu điều chuyển</span>
            </button>

        </div>
        <div class="form-infor has-border p-3">
            <h4 class="form-title">
                Thông tin phiếu
            </h4>
            <div class="row no-gutters">
                <div class="col-12 col-md-4">
                    <label for="">Số phiếu: <span>*</span></label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.SO_PHIEU" disabled />
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Kho xuất: <span>*</span></label>
                    <select class="form-control" ng-model="thongTinKho.KHO_XUAT" ng-options="option.NAME for option in danhmuckho" name="khoxuat" disabled>
                        <option value="">- - - Chọn kho xuất - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Kho nhập: <span>*</span></label>
                    <select class="form-control" ng-model="thongTinKho.KHO_NHAN" ng-options="option.NAME for option in danhmuckho" name="khoxuat" disabled>
                        <option value="">- - - Chọn kho nhập - - -</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Ngày viết phiếu: <span>*</span></label>
                    <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_CT_VW" disabled>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Người viết phiếu: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_KY_1" ng-options="option.CapBac+' '+option.HoTen for option in canbo" disabled>
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Lãnh đạo phòng 9: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_KY_2" ng-options="option.CapBac+' '+option.HoTen for option in canbo" disabled>
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>

                <div class="col-12 col-md-8">
                    <label for="">Lý do chuyển: <span>*</span></label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.LY_DO_CHUYEN" disabled />
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Trạng thái: <span>*</span></label>
                    <input class=" form-control" type="text" ng-model="thongTinKho.TRANG_THAI" disabled />
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Ngày chuyển kho: <span>*</span></label>
                    <div class="input-group date" data-date-format="dd/mm/yyyy">
                        <input type="text" customzdatetime class="form-control" ng-model="thongTinKho.NGAY_CHUYEN_VW">
                        <span class="input-group-addon"></span>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Cán bộ kho: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_KY_3" ng-options="option.CapBac+' '+option.HoTen for option in canbo">
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Trưởng kho: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_KY_4" ng-options="option.CapBac+' '+option.HoTen for option in canbo">
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label for="">Người giao: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_GIAO" ng-options="option.HoTen for option in canbo">
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Người nhận: </label>
                    <select class="form-control" ng-model="thongTinKho.NGUOI_NHAN" ng-options="option.HoTen for option in canbo">
                        <option value="">- - - Chọn cán bộ - - -</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="">Đính kèm: </label>
                    <form method="post" enctype="multipart/form-data" id="frmUpload">
                        <input type="file" name="file" id="file" accept="image/jpeg" style="width: 100%;" onchange="angular.element(this).scope().ImageUpload(event)" multiple />
                    </form>
                </div>
            </div>
        </div>

        <div class="content-table mt-2">
            <table class="table-responsive table-hover result-point">
                <thead class="point-table-head">
                    <tr>
                        <th class="text-center" style="width:3%;">STT </th>
                        <th class="text-center" @*style="width:12%;"*@>Hàng hóa<i id="or_ntn"></i></th>
                        <th class="text-center" style="width:10%;">Đơn vị tính<i id="or_dv"></i></th>
                        <th class="text-center" style="width:10%;">SL kế hoạch<i id="or_nn"></i></th>
                        <th class="text-center" style="width:10%;">SL thực tế<i id="or_nn"></i></th>
                        <th class="text-center" style="width:10%;">Đơn giá<i id="or_ng"></i></th>
                        <th class="text-center" style="width:10%;">Thành tiền<i id="or_ng"></i></th>
                        <th class="text-center" style="width:25%;">Ghi chú<i id="or_ng"></i></th>
                    </tr>
                </thead>
                <tbody style="background-color:white">
                    <tr ng-repeat="item in dsHangHoa" @*ng-class="{'selected':item.ID_NHAP_XUAT==ID_NHAP_XUAT}" ng-click="chiTiet(item, $index)*@>
                        <td class="text-center">
                            <label class="form-control">{{item.STT}}</label>
                        </td>
                        <td>
                            <select class="form-control" ng-model="item.HANG_HOA" ng-options="option.MaHang+' - '+option.TenHang for option in hanghoa" disabled></select>
                        </td>
                        <td>
                            <select class="form-control" ng-model="item.DVT_VW" ng-options="option.NAME for option in donvitinh" disabled></select>
                        </td>
                        <td><input type="number" class="form-control" ng-model="item.SO_LUONG_KH" ng-change="ValueCount(item,$index)" disabled></td>
                        <td><input type="number" class="form-control" ng-model="item.SO_LUONG_TT" ng-change="ValueCount(item,$index)"></td>
                        <td><input type="number" step="10000" class="form-control" ng-model="item.DON_GIA" ng-change="ValueCount(item,$index)" disabled></td>
                        <td><input type="number" class="form-control" ng-model="item.THANH_TIEN_KH" disabled></td>
                        <td><input type="text" class="form-control" ng-model="item.GHI_CHU" disabled></td>
                    </tr>
                </tbody>
            </table>
            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
        </div>
        <!-- /.card-body -->
    </div>
    @Html.Partial("~/Views/NhapKho/_ModalKhoAnh.cshtml")
</div>
@section scripts{
    <script src="~/app/Controller/Kho/DieuChuyenKhoController.js"></script>
    <script>
        $("#menu-toggle").click(function (e) {
            e.preventDefault();
            $("#wrapper").toggleClass("active");
            if ($("#img-toggle").hasClass("img-normal")) {
                $("#img-toggle").removeClass("img-normal").addClass("img-180-rotate");
            }
            else if ($("#img-toggle").hasClass("img-180-rotate")) {
                $("#img-toggle").removeClass("img-180-rotate").addClass("img-normal");
            }
        });
        function UpAnh() {
            var fileSelectEle = document.getElementById('file');
            if (fileSelectEle.value.length > 0) {
                var fileInput = $('#file');
                var file = fileInput.get(0).files[0];
                var reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = function () {
                    $("#filebase64").val(reader.result.split(',')[1]);

                };
            }
        };
    </script>
}
