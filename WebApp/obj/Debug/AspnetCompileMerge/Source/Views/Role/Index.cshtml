@{
    ViewBag.Title = "Nhóm quyền";
}

<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Nhóm quyền
    </h3>
</div>
<div ng-controller="RoleController">
    <main>
        <div class="container-fluid d-flex cons-ac-system">
            <div class="row  no-gutters w-100">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding-left:0px;padding-right:2px;height:100%;">
                    <div class="row mb-2 mt-3">
                        <div class="col-sm-12 col-md-5 col-lg-5">
                            <div class="main-action d-flex align-items-center flex-wrap">
                                <button class="btn-action-m" ng-show="RoleBtnCreate == true" ng-click="add()" title="Thêm mới">
                                    <i class="fa fa-plus-circle"></i>
                                    &nbsp;Thêm mới
                                </button>
                                @*<button class="btn-action-m" ng-show="RoleBtnSearch == true" ng-click="Refesh()" title="Làm mới">
                                    <i class="fa fa-refresh"></i>
                                    &nbsp;Làm mới
                                </button>*@
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-7 col-lg-7">
                            <div class="form-group pull-right">
                                <div class="input-group">
                                    <input type="text" ng-model-options="{ debounce: 800 }" ng-change="Refesh()" placeholder="Tìm kiếm" ng-model="modelSearch.KeyWord" class="form-control ng-pristine ng-valid ng-empty ng-touched">
                                    <div class="input-group-prepend-right">
                                        <button class="btn-action-m" style="color:white">
                                            <i class="fa fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="content-table" style=" overflow-y:scroll">
                                <table class="table-responsive table-hover result-point">
                                    <thead class="point-table-head">
                                        <tr>
                                            <th class="text-center" style="width:4%;">STT </th>
                                            <th ng-click="SortData('ROLE_TYPE')" style="width:15%;cursor:pointer" class="text-center">Mã &nbsp;<i class="fa fa-sort"></i></th>
                                            <th ng-click="SortData('ROLE_DESC')" class="text-center;" style="cursor:pointer">Tên quyền &nbsp;<i class="fa fa-sort"></i></th>
                                            <th ng-click="SortData('UNIT_NAME')" class="text-center;" style="cursor:pointer">Đơn vị &nbsp;<i class="fa fa-sort"></i></th>
                                            <th ng-click="SortData('ENABLED_FLAG')" style="width:10%;cursor:pointer" class="text-center">Trạng thái&nbsp;<i class="fa fa-sort"></i></th>
                                            <th class="text-center" style="width:8%;">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody class="">
                                        <tr ng-repeat="item in ListRole" ng-click="ViewDetail(item.ROLE_ID, $index)" ng-class="{activerow:$index==selectedRow}">
                                            <td class="text-center">{{$index + 1}}</td>
                                            <td>{{item.ROLE_TYPE}}</td>
                                            <td>{{item.ROLE_DESC}}</td>
                                            <td>{{item.UNIT_NAME}}</td>
                                            <td class="text-left">{{item.ENABLED_FLAG == 'Y' ? 'Sử dụng' : 'Không sử dụng'}}</td>
                                            <td class="text-center">
                                                <div class="main-action d-flex align-items-center flex-wrap">
                                                    <button class="btn-action-m " ng-click="edit(item.ROLE_ID)" ng-show="RoleBtnUpdate == true" title="Sửa">
                                                        <img src="~/App_Assets/images/icon_edit.svg" alt="">
                                                    </button>
                                                    <button class="btn-action-delete" ng-click="delete(item.ROLE_ID, item.ROLE_DESC)" ng-show="RoleBtnDelete == true" title="Xoá">
                                                        <img src="~/App_Assets/images/icon_del.svg" alt="">
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="width:100%;">
                        <div class="col-sm-12">
                            <div class="row content-table pull-right">
                                <div class="pages-switch">
                                    <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts{
    <script src="~/app/Controller/RoleController.js"></script>
    <script src="~/Content/js/jquery.ztree.core.js"></script>
    <script src="~/Content/js/jquery.ztree.excheck.js"></script>
}
