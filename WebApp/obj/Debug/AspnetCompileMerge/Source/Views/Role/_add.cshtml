
<div class="modal-header">
    <h4 class="modal-title">Thêm mới nhóm quyền</h4>
    <a href="#" data-action="close" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <img src="~/App_Assets/images/close.svg" alt="">
    </a>
</div>
<div class="modal-body">
    <div class="row" style="margin-left: 10px; margin-right: 10px;">
        <div class="col-lg-12">
            <form class="form-horizontal form-infor" role="form" id="formSubmit">
                <div class="form-group">
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-9">
                            <label class="requiredInput">Tên quyền</label>
                            <textarea class="form-control" ng-model="model.ROLE_DESC" name="ROLE_DESC"></textarea>
                        </div>
                        <div class="col-lg-3">
                            <label class="requiredInput">Mã</label>
                            <input type="text" class="form-control" ng-model="model.ROLE_TYPE" name="ROLE_TYPE" required>
                        </div>
                    </div>
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-5">
                            <label class="requiredInput">Phòng ban</label>
                            <select class="form-control" ng-model="model.APP_CODE" select2 name="APP_CODE" ng-change="ChangeAppCode()" ng-options="item.APP_CODE as item.DESCRIPTION for item in ListAppCode"></select>
                        </div>
                        <div class="col-lg-4">
                            <label class="requiredInput">Phạm vi</label>
                            <select class="form-control" ng-model="model.SCOPE" select2 name="SCOPE" required ng-options="item.ID as item.Name for item in ListSCOPE"></select>
                        </div>
                        <div class="col-lg-3">
                            <label class="requiredInput">Đơn vị</label>
                            <select class="form-control" ng-model="model.UNIT_ID" select2 name="UNIT_ID" ng-options="item.UNIT_ID as item.UNIT_NAME for item in ListUnit"></select>
                        </div>
                        @*<div class="col-lg-4">
                        <label>DOMAIN_CODE</label>
                        <input type="text" class="form-control" ng-model="model.DOMAIN_CODE" name="DOMAIN_CODE">
                    </div>*@
                    </div>
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-lg-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border" style="margin-bottom:0px;">Chức năng nhóm quyền</legend>
                                <div style="height:250px; overflow: auto;">
                                    <div class="ztreeRoleBackground left" style="overflow-x:hidden;overflow-y:auto ;height: 100%;">
                                        <ul id="treeRole" class="ztree"></ul>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>

</div>
<div class="modal-footer">
    <div class="main-action d-flex flex-wrap">
        <button class="btn-action-m" ng-click="submit()">
            <img src="~/App_Assets/images/icon_save.svg" alt="">
            <span>Lưu</span>
        </button>
        <button class="btn-action-cancel" data-dismiss="modal" ng-click="cancel()">
            <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
            <span>Hủy</span>
        </button>
    </div>
</div>

