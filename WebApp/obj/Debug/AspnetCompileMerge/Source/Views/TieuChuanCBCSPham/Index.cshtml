@{
    ViewBag.Title = "Tiêu chuẩn (CBCS - Phạm)";
}

<style type="text/css">
    .tccbcsParentcolor {
        background-color: #ffe2e2 !important;
        color: #900 !important;
    }
</style>
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Tiêu chuẩn (CBCS - Phạm)
    </h3>
</div>
<main>
    <div class="container-fluid d-flex cons-ac-system mt-1">
        <div style="width:100%;border: 1px solid #DDDDDD;">
            <div class="nav-tabs-box">
                <ul class="nav nav-tabs tab-main" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="home-tab" title="Tiêu chuẩn CBCS" data-toggle="tab" href="#tieuChuanCBCS" role="tab">Tiêu chuẩn CBCS</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" id="profile-tab" title="Tiêu chuẩn phạm" data-toggle="tab" href="#tieuChuanPham" role="tab">Tiêu chuẩn phạm</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" id="profile-tab" title="Cấu hình đổi tiêu chuẩn" data-toggle="tab" href="#cauHinhDoiTC" role="tab">Cấu hình đổi tiêu chuẩn</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" id="profile-tab" title="Cấu hình SP đính kèm" data-toggle="tab" href="#cauHinhSPDinhKem" role="tab">Cấu hình SP đính kèm</a>
                    </li>
                </ul>
            </div>

            <div class="container-fluid">
                <div class="tab-content" id="myTabContent">
                    <div style="height: calc(100vh - 233px);" class="tab-pane fade show active" id="tieuChuanCBCS" role="tabpanel" aria-labelledby="home-tab">
                        @Html.Partial("~/Views/TieuChuanCBCSPham/TieuChuanCBCS.cshtml")
                    </div>
                    <div style="height: calc(100vh - 233px);" class="tab-pane fade" id="tieuChuanPham" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("~/Views/TieuChuanCBCSPham/TieuChuanPham.cshtml")
                    </div>
                    <div style="height: calc(100vh - 233px);" class="tab-pane fade" id="cauHinhDoiTC" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("~/Views/TieuChuanCBCSPham/CauHinhDoiTC.cshtml")
                    </div>
                    <div style="height: calc(100vh - 233px);" class="tab-pane fade" id="cauHinhSPDinhKem" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("~/Views/TieuChuanCBCSPham/CauHinhSPDinhKem.cshtml")
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>


@section Scripts{
    <script src="~/app/Controller/TieuChuan_DinhMuc/TieuChuanCBCSPhamController.js"></script>
    <script src="~/app/Controller/TieuChuan_DinhMuc/TieuChuanPhamController.js"></script>
    <script src="~/app/Controller/TieuChuan_DinhMuc/CauHinhDoiTieuChuanController.js"></script>
    <script src="~/app/Controller/TieuChuan_DinhMuc/CauHinhSPDinhKemController.js"></script>
    <script src="~/Content/js/jquery.ztree.core.js"></script>
    <script src="~/Content/js/jquery.ztree.excheck.js"></script>
}


