<div class="container-fluid"  ng-controller="TieuChuanPhamController">
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
            <div class="row">
                <div class="col-12 col-md-3 col-lg-3 align-self-end" style="margin-bottom:10px">
                    <div class="main-action d-flex align-items-center flex-wrap">
                        <button class="btn-action-m ct-fix-lap" ng-click="Them()" ng-show="RoleBtnCreate" title="Thêm mới">
                            <img src="~/App_Assets/images/icon_add.svg" alt="">&nbsp;Thêm
                        </button>
                        <button class="btn-action-delete ct-fix-lap" ng-click="Xoa()" ng-show="RoleBtnDelete" title="Xoá">
                            <img src="~/App_Assets/images/icon_del.svg" alt="">&nbsp;Xoá
                        </button>
                    </div>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <label>Tiêu chuẩn</label>

                    @*<select ng-change="changeNhomTC()" ng-model="modelSearch.NHOM_TIEU_CHUAN_ID" class="form-control">
                        <option value="{{item.ID_NHOM}}" ng-repeat="item in nhomtc">{{item.TEN_NHOM_TC}}</option>

                    </select>*@
                    <select class="form-control" style="width:100%" ng-change="changeNhomTC()" ng-model="modelSearch.NHOM_TIEU_CHUAN_ID" ui-select2 required ng-options="item.ID_NHOM as item.TEN_NHOM_TC for item in nhomtc"></select>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <label>Năm ban hành</label>
                    @*<select ng-change="changeNam()" ng-model="modelSearch.NAM" class="form-control">
                        <option value="{{item.ID}}" ng-repeat="item in nambh">{{item.NAME}}</option>
                    </select>*@
                    <select class="form-control" style="width:100%" ng-change="changeNam()" ng-model="modelSearch.NAM" ui-select2 required ng-options="item.ID as item.NAME for item in nambh"></select>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <label></label>
                    <div class="main-action">
                        <div class="form-search w-100" ng-show="RoleBtnView">
                            <input type="text" placeholder="Tìm kiếm" ng-model="modelSearch.SEARCH">
                            <button>
                                <img src="~/App_Assets/images/search_icon.svg" ng-click="TimKiem()" alt="">
                            </button>
                        </div>

                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="content-table" style="overflow:unset">
                        <table class="table-responsive table-hover result-point table-body-scroll">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:10%;" class="center"><input type="checkbox" class="form-control" ng-click="toggleAll()" ng-model="isAllSelected" /> </th>
                                    <th style="width:30%; padding:5px;" ng-click="ORDER_KH($event)">Nhóm tiêu chuẩn  <i id="or_skh"></i></th>
                                    <th style="width:20%; padding:5px;" ng-click="ORDER_NTN()">Loại phạm  <i id="or_ntn"></i></th>
                                    <th style="width:20%; padding:5px;" ng-click="ORDER_DV()">Trang phục  <i id="or_dv"></i></th>
                                    <th style="width:10%; padding:5px;" ng-click="ORDER_NN()">Số lượng  <i id="or_nn"></i></th>
                                    <th style="width:10%; padding:5px;" ng-click="ORDER_NG()">Niên hạn  <i id="or_ng"></i></th>
                                </tr>
                            </thead>
                            <tbody class="function-box no-boder" style="height: calc(100vh - 420px);">
                                <tr ng-repeat="item in dsNhapKho track by $index">
                                    <td style="width:10%;" class="text-center">
                                        <input type="checkbox" class="form-control" ng-model="item.CHECKED" ng-change="optionToggled()">
                                    </td>
                                    <td class="text-left" style="width:30%;">
                                        {{item.NHOM_TIEU_CHUAN_ID != null ? (nhomtc|filter:{ID_NHOM:item.NHOM_TIEU_CHUAN_ID}:true)[0].TEN_NHOM_TC : ""}}
                                    </td>
                                    <td class="text-left" style="width:20%;">
                                        <select class="form-control" style="width:100%" ng-model="item.LOAI_PHAM_ID" ui-select2 required ng-options="item.ID as item.TEN_LOAI_PHAM for item in loaipham">
                                        </select>
                                    </td>
                                    <td class="text-left" style="width:20%;">
                                        <select class="form-control" style="width:100%" ng-model="item.SP_ID" ui-select2 required ng-options="item.ID as item.TEN_SP for item in sanpham"></select>
                                    </td>
                                    <td class="text-right" style="width:10%;">
                                        <input type="number" min="0" step="0.01" class="form-control" ng-model="item.SO_LUONG_TC">
                                    </td>

                                    <td class="text-right" style="width:10%;">
                                        <input type="number" min="0" step="1" class="form-control" ng-model="item.NIEN_HAN">
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="pages-switch" style="padding-top: 10px;">
                        <div class="main-action d-flex align-items-center flex-wrap">
                            <button class="btn-action-m ct-fix-lap" type="button" ng-show="RoleBtnRollback" ng-click="Huy()">
                                <img src="~/App_Assets/images/ic_cancel_light.svg" />
                                <span>Hủy thay đổi</span>
                            </button>
                            <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnSave" ng-click="Luu()">
                                <img src="~/App_Assets/images/ic_save_light.svg" />
                                <span>Lưu</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
