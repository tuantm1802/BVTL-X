<div class="modal fade" id="modelThem" xmlns="http://www.w3.org/1999/html">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{Title}}</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <div class="modal-body">
                <div class="form-infor has-border p-3">

                    <form id="e-danhsachhoso">
                        <div class="row">
                            <div class="col-12 col-md-12">
                                <label style="font-weight: bold;">{{SelectedKhoVL}}</label>
                            </div>
                            <div class="col-12 col-md-4">
                                <label>Số phiếu <span style="color:red">*</span></label>
                                <input type="text" ng-pattern="/^([a-zA-Z0-9]+)$/" to-uppercase class="form-control" ng-model="model.SO_PHIEU">
                                <input type="text" ng-hide="true" class="form-control" ng-model="model.ID_KHO">
                                <input type="text" ng-hide="true" class="form-control" ng-model="model.ID">
                            </div>
                            <div class="col-12 col-md-8">
                                <label>Lý do </label>
                                <input type="text" class="form-control" ng-model="model.LY_DO">
                            </div>

                        </div>
                    </form>
                    <br />
                 
                </div>
                <div class="form-infor">
                    <div class="row no-gutters">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                            <div class="main-action d-flex pull-left pt-3">
                                <button class="btn-action-m" ng-click="ThemSP()">
                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                    <span>Thêm mới</span>
                                </button>
                                <button class="btn-action-m bg-red" ng-click="XoaSP()">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                    <span> Xóa </span>
                                </button>
                                <button class="btn-action-m ct-fix-lap" type="button" ng-click="SPN_DSSanPham()">
                                    <img src="~/App_Assets/images/icon_fl.svg" />
                                    <span>Danh sách sản phẩm</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-table" style="height:326px; overflow-y:scroll;">

                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head" style="width:100%">
                            <tr>

                                <th style="width:5%;" class="center"><input type="checkbox" class="form-control" ng-change="toggleAllSP()" ng-model="isAllSelectedSP" /> </th>
                                <th style="width:3%; padding:5px;">STT</th>
                                <th style="width:20%; padding:5px;">Tên mặt hàng</th>
                                <th style="width:5%; padding:5px;">ĐVT</th>
                                <th style="width:8%; padding:5px;">Số lượng tồn</th>
                                <th style="width:8%; padding:5px;">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in DSSanPhamNhan track by $index">
                                <td class="text-center">
                                    <input type="checkbox" class="ace" ng-model="item.SELECT" ng-change="optionToggledSP()">
                                </td>
                                <td class="text-center">
                                    {{$index + 1}}
                                </td>
                                <td class="text-left">
                                    <select class="form-control" ng-change="changeMatHang($index, item.ID_SP)" style="width:100%" ng-model="item.ID_SP" select2 required ng-options="i.ID_HANG as i.NAME for i in ListHangHoa">
                                        <option value=""> -- Chọn mặt hàng --  </option>
                                    </select>
                                </td>
                                <td class="text-left">
                                    <span>{{item.DVT}}</span>
                                </td>
                                <td class="text-left">
                                    <span>{{item.SO_LUONG_TON}}</span>
                                </td>
                                <td class="cell-members">
                                    <input type="number" min="0" step="1" max="{{item.SO_LUONG_TON}}" class="form-control" ng-model="item.SO_LUONG">
                                </td>

                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m" ng-click="HuySP()">
                        <i class="fa fa-ban" aria-hidden="true"></i>
                        <span>Hủy thay đổi</span>
                    </button>
                    <button class="btn-action-m" ng-click="LuuSP()">
                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                        <span> Lưu </span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/d_close.svg" alt="" class="exsit">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                        <span>Đóng</span>
                    </button>
                </div>
               
            </div>
        </div>
    </div>
</div>