@{
    ViewBag.Title = "Kiểm kê kho";
}
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Kiểm kê kho
    </h3>
</div>
<div ng-controller="KiemKeKhoController" style="padding-top:5px;">
    <div class="container-fluid d-flex cons-ac-system none-padding-right" style="height: calc(100vh - 162px);">
        <div class="action-system pd-two ui-widget-content" id="resizable" style="width:30%;">
            <button id="btn-changes-s-nav">
                <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
            </button>
            <div class="fill-box">
                <h3 class="title-fill">
                    Kiểm kê kho
                </h3>
            </div>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item has-one-fl">
                    <a class="nav-link active" ng-click="kho_vl()" id="home-tab" data-toggle="tab" href="#ds_kho_vl" role="tab">
                        Kho vật lý
                    </a>
                </li>

                <li class="nav-item has-one-fl">
                    <a class="nav-link" id="profile-tab" ng-click="kho_hd()" data-toggle="tab" href="#ds_kho_hd" role="tab">
                        Kho hợp đồng
                    </a>
                </li>
            </ul>
            <div class="container">
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="ds_kho_vl" role="tabpanel" aria-labelledby="home-tab" style="margin-top: 0px!important;">
                        @Html.Partial("_Kho_VL")
                    </div>
                    <div class="tab-pane fade" id="ds_kho_hd" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_Kho_HD")
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12 none-padding" ng-show="ShowKhoVLContent">
                @Html.Partial("_HangHoa_Kho_VL")
            </div>
            <div class="col-12 col-sm-12 col-md-12 col-lg-12" ng-show="ShowKhoHDContent">
                @Html.Partial("_HangHoa_Kho_HD")
            </div>
        </div>

    </div>

    @Html.Partial("_TheKhoVL")
    @Html.Partial("~/Views/KiemKeKho/_Themmoi.cshtml")
    @Html.Partial("~/Views/KiemKeKho/_addSpDinhKem.cshtml")
  
</div>
    @section scripts{
        <script src="~/app/Controller/Kho/KiemKeKhoController.js"></script>
    }
