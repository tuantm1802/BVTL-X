
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="ControlProjectController">
    <main>
        <div class="container-fluid d-flex cons-ac-system">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding-left:0px;padding-right:2px;height:100%;">
                    <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                        <legend class="scheduler-border" style="        width: 250px;"><label class="bold-label"><b>Table tree</b></label></legend>
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                <div class="content-table">
                                    <div style="height:310px; overflow-y:scroll;">
                                        <tree-grid show-checkbox ="tree_Table_Checkbox"
                                                   expand-level  = "3"
                                                  tree-data     = "tree_data"
                                                  expand-on     = "expanding_property"
                                                  col-defs      = "col_defs"
                                                  icon-leaf     = "treetable_docu"
                                                  icon-expand   = "treetable_close"
                                                  icon-collapse = "treetable_open"
                                                   event-change-checkbox = "ChangeTreeTableCheckbox(item)"
                                                   event-choose-row = "ClickTreeTableRow(item)"
                                                   ></tree-grid>
                                       
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                        
                    </fieldset>
                </div>
            </div>
        </div>
    </main>
</div>


@section Scripts{
    <script src="~/app/Controller/ControlProjectController.js"></script>
}


