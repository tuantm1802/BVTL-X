<div style="width:1000px;">
    <div class="modal-content" ">
        <!-- Modal Header -->
        <div class="modal-header">
            <h4 class="modal-title">Chỉnh sửa giao diện hiển thị</h4>
            <button type="button" class="close" data-dismiss="modal" ng-click="cancel()">
                <img src="~/App_Assets/images/close.svg" alt="">
            </button>
        </div>
        <!-- Modal body -->
        <div class="modal-body sl-row-1">
            <div class="row">
                @*<div class="col-sm-4 col-sm-offset-1">
                        <div class="list-group" id="list1">
                            <a href="#" class="list-group-item active">
                                Dữ liệu được hiển thị
                                <input title="Toggle all" ng-click="toggleA()" ng-model="togA" type="checkbox" class="pull-right">
                            </a>
                            <span ng-repeat="item in listA">
                                <a href="#" class="list-group-item">
                                    {{item.Name}}
                                    <input ng-click="selectA(item)" value="{{item.id}}" ng-checked="selectedA.indexOf(item.id)>-1" ng-model="togA" type="checkbox" class="pull-right">
                                </a>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-2 v-center text-center">
                        <div>
                            <button title="Send to list 1" class="btn-action-m" ng-click="BTA()">trái</button>
                            <button title="Send to list 2" class="btn-action-m" ng-click="BTB()">phải</button>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="list-group" id="list2">
                            <a href="#" class="list-group-item active">
                                Trường sẵn có
                                <input title="Toggle all" ng-click="toggleB()" ng-model="togB" type="checkbox" class="pull-right">
                            </a>
                            <span ng-repeat="item in listB">
                                <a href="#" class="list-group-item">
                                    {{item.Name}}
                                    <input ng-click="selectB(item)" value="{{item.id}}" ng-checked="selectedB.indexOf(item.id)>-1" ng-model="togB" type="checkbox" class="pull-right">
                                </a>
                            </span>
                        </div>
                    </div>*@
                <div class="col-sm-4 col-sm-offset-1" ng-repeat="list in models">
                    <div class="list-group">
                        <a class="list-group-item active">
                            {{list.listName}}
                        </a>
                        <div>
                            <ul dnd-list dnd-drop="onDrop(list, item, index)">
                                <li class="list-group-item" ng-repeat="item in list.items"
                                    dnd-draggable="getSelectedItemsIncluding(list, item)"
                                    dnd-dragstart="onDragstart(list, event)"
                                    dnd-moved="onMoved(list)"
                                    dnd-dragend="list.dragging = false"
                                    dnd-selected="item.selected = !item.selected"
                                    ng-class="{'selected': item.selected}"
                                    ng-hide="list.dragging && item.selected">
                                    {{item.label}}
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>

            </div>

        </div>
        <!-- Modal footer -->
        <div class="modal-footer">
            <div class="main-action d-flex flex-wrap">
                <button class="btn-action-m cl-3" ng-click="Save()">
                    <img src="/App_Assets/images/d_save.svg" alt="" class="exsit">
                    <img src="/App_Assets/images/icon_save.svg" alt="" class="hover_m">
                    <span>Lưu</span>
                </button>
                <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                    <img src="~/App_Assets/images/d_cancel.svg" alt="" class="exsit">
                    <img src="~/App_Assets/images/ic_cancel_light.svg" alt="" class="hover_m">
                    <span>Đóng</span>
                </button>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script src="~/app/Controller/NhomTieuChuan.js"></script>
}