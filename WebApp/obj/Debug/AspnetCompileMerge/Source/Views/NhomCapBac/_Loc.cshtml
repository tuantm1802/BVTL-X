

<div class="model-dialog">
    <div class="modal-header ">
        <button type="button" class="bootbox-close-button close" ng-click="cancel()">×</button>
    </div>
    <div class="row">
        <div class="col-md-12 text-center"><h3>Chỉnh sửa giao diện hiển thị</h3></div>
        <div class="col-sm-4 col-sm-offset-1">
            <div class="list-group" id="list1">
                <div class="list-group-item active">
                    Dữ liệu được hiển thị
                    <input type="checkbox" class="pull-right" value="10" title="Toggle all" ng-model="togA"  ng-click="toggleA()" >
                </div>
                <span ng-repeat="item in listA">
                    <div href="#" class="list-group-item">
                        {{item.Name}}
                        <input value="{{item.id}}" ng-checked="selectedA.indexOf(item.id)>-1" ng-model="togA" type="checkbox" class="pull-right" ng-click="selectA(item)" >
                    </div>
                </span>
            </div>
        </div>
        <div class="col-md-2 v-center text-center">
            <div class="btn-group">
                <button title="Send to list 1" class="btn btn-default" ng-click="BTA()"><i class="glyphicon glyphicon-chevron-left"></i></button>
                <button title="Send to list 2" class="btn btn-default" ng-click="BTB()"><i class="glyphicon glyphicon-chevron-right"></i></button>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="list-group" id="list2">
                <div href="#" class="list-group-item active">
                    Trường sẵn có
                    <input title="Toggle all" ng-click="toggleB()" ng-model="togB" type="checkbox" class="pull-right">
                </div>
                <span ng-repeat="item in listB">
                    <div href="#" class="list-group-item">
                        {{item.Name}}
                        <input ng-click="selectB(item)" value="{{item.id}}" ng-checked="selectedB.indexOf(item.id)>-1" ng-model="togB" type="checkbox" class="pull-right">
                    </div>
                </span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-primary" ng-click="Save()">Lưu</button>
        <button type="button" class="btn btn-default" ng-click="cancel()">Hủy</button>
    </div>
</div>
@section scripts{
    <script src="~/app/Controller/NhomCapBac.js"></script>
}