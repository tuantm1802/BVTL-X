@{
    ViewBag.Title = "Nhóm cấp bậc";
}

<style>
    .table .cap {
        margin-bottom: 0px;
        margin: 0px;
        padding: 0px;
        border: 0px;
        border-spacing: 0;
    }

    .table-bordered {
        border-left: 0px;
        border-right: 0px;
    }

    .table-nested .cell-members {
        width: 60px;
    }

    .table-nested .indent-icon {
        display: inline-block;
    }

    .table-nested .indentt {
        display: inline-block;
    }

    .table-nested .parent > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1.svg);
        font-family: FontAwesome;
        display: inline-block;
        -moz-transition: -moz-transform 0.3s;
        -o-transition: -o-transform 0.3s;
        -webkit-transition: -webkit-transform 0.3s;
        transition: transform 0.3s;
    }

    .table-nested .parent > .cell-name > .indentt {
        content: url(../../App_Assets/images/f_drop_3.svg);
    }

    .table-nested .opened > tr > .cell-name > .indent-icon:before {
        content: url(../../App_Assets/images/f_drop_1_active.svg);
    }
</style>
<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục nhóm cấp bậc
    </h3>
</div>
<div ng-controller="NhomCapBacController">
    <main class="main-system">
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100" style="height:480px;">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                    <div class="well" style="background-color: #f5f5f5;padding:20px;margin:0 0;width:100%">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12" align-self-end">
                                <div class="main-action d-flex pull-left">
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Addmm()" ng-show="RoleBtnCreate">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm mới</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="Hiden()" ng-show="RoleBtnCancel"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>Huỷ thay đổi</span>
                                    </button>
                                    <button class="btn-action-m bg-green" type="button"
                                            ng-click="submit()" ng-show="RoleBtnSave"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-floppy-o" aria-hidden="true"></i>
                                        <span>Lưu lại</span>
                                    </button>
                                    <button class="btn-action-m bg-red" type="button"
                                            ng-click="delete()" ng-show="RoleBtnDelete"
                                            style="margin-right: 10px;">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xoá</span>
                                    </button>
                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right"
                                     style="margin-left:5px;">
                                    <div class="d-flex form-group"
                                         style="margin-bottom:0px;vertical-align:middle">
                                        <input type="text" ng-model="search"
                                               placeholder="Tìm kiếm" class="form-control"
                                               style="width:250px;margin-bottom:0px" />
                                        <button class="btn-action-m form-control"
                                                style="color:white;width:40px;margin-bottom:0px">
                                            <i class="fa fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="content-table" style="margin-top:10px;">
                        <table class="table-nested table content-table capbac table-bordered table-hover">
                            <thead style="width:100%;">
                                <tr>
                                    <th style="width:5%;" class="text-center">
                                        <input type="checkbox" ng-model="selectAll" ng-click="CheckAll()" />
                                    </th>
                                    <th style="width:5%; border-left:0px !important;" class="cell-members">STT</th>
                                    <th style="width:35%;" ng-if="tncb" class="cell-name">Tên nhóm cấp bậc</th>
                                    <th style="width:25%;" ng-if="mt" class="cell-members">Mô tả</th>
                                    <th style="width:10%;" ng-if="stt" class="cell-members">Số thứ tự</th>
                                    <th style="width:10%;" ng-if="tb" class="cell-members">Tân binh</th>
                                    <th style="width:10%; border-right:0px !important;"
                                        ng-if="khvt" class="cell-members">Ký hiệu viết tắt</th>
                                </tr>
                            </thead>
                            <tbody style="width:100%;border-top: 1px solid #dee2e6;"
                                   ng-class="{opened: item.opened}" ng-include="&#39;table_tree.html&#39;"
                                   ng-repeat="item in DanhSach|filter:search"></tbody>
                            <tfoot style="width:100%;" ng-if="noSelected">
                                <tr ng-repeat="row in rows">
                                    <td style="width:5%;" class="cell-input">
                                        <input type="checkbox"
                                               ng-true-value="{{item.ID}}"
                                               ng-false-value="''" />
                                    </td>
                                    <td style="width:5%; border-left:0px !important;" class="cell-members"></td>

                                    <td style="width:35%;" class="cell-name" ng-if="tncb">
                                        <input type="text" ng-class="row.CB? 'error': ''"
                                               placeholder="Nhập tên nhóm cấp bậc"
                                               ng-model="row.TEN_NHOM_CB" class="form-control" />
                                        <div ng-show="row.CB">
                                            <label class="error">Bạn chưa nhập tên nhóm cấp bậc</label>
                                        </div>
                                    </td>
                                    <td style="width:25%;" class="cell-members" ng-if="mt">
                                        <input ng-class="row.MT? 'error': ''" type="text"
                                               ng-model="row.MO_TA"
                                               placeholder="Nhập mô tả" class="form-control" />
                                        <div ng-show="row.MT">
                                            <label class="error">Bạn chưa nhập mô tả</label>
                                        </div>
                                    </td>
                                    <td style="width:10%;" class="cell-members" ng-if="stt">
                                        <input ng-class="row.ST? 'error': ''"
                                               type="text" class="form-control"
                                               placeholder="STT" ng-model="row.SO_THU_TU" />
                                        <div ng-show="row.ST">
                                            <label class="error">Bạn chưa nhập STT</label>
                                        </div>
                                    </td>
                                    <td style="width:10%;" class="cell-members"
                                        ng-if="tb">
                                        <input type="checkbox" ng-model="row.ISB" />
                                    </td>
                                    <td style="width:10%; border-right:0px !important;" class="cell-members" ng-if="khvt">
                                        <input ng-class="row.KH? 'error': ''"
                                               class="form-control" type="text"
                                               placeholder="Ký hiệu"
                                               ng-model="row.KY_HIEU_VIET_TAT" />
                                        <div ng-show="row.KH">
                                            <label class="error">Bạn chưa nhập ký hiệu viết tắt</label>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <script id="table_tree.html" type="text/ng-template">
                        <tr ng-class="{parent: item.children}"
                            ng-init="parentScope = $parent.$parent; initCheckbox(item, parentScope.item)"
                            ng-dblclick="loadTemplate($index, level, item)"
                            style="margin: 0px;border-top: 1px solid #dee2e6;">
                            <td class="cell-input" style="width:5%;padding: 8px !important; ">
                                <div>
                                    <input type="checkbox" ng-disabled="item.status"
                                           ng-model="item.selected"
                                           ng-click="checkAllchild(item)"
                                           class="form-control" />
                                </div>
                            </td>
                            <td style="width:5%; padding: 8px !important; border-left:0px !important;" class="cell-members">
                                <span ng-model="STT">{{item.stt}}</span>

                            </td>
                            <td style="width:35%;" ng-if="tncb" class="cell-name" ng-click="item.opened = !item.opened">
                                <div ng-if="item.parent" class="indent-icon" style="padding-left: {{50*level}}px"></div>
                                <div ng-if="!item.parent" class="indentt" style="padding-left: {{50*level}}px"></div>
                                <span ng-if="!item.Edit">{{item.TEN_NHOM_CB}}</span>
                                <input type="text" style="width:200px; display: inline-block;"
                                       ng-if="item.Edit" class="form-control"
                                       ng-model="item.TEN_NHOM_CB">
                            </td>
                            <td style="width:25%; padding: 8px !important;" ng-if="mt" class="cell-members">
                                <span ng-if="!item.Edit">{{item.MO_TA}}</span>
                                <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.MO_TA">
                            </td>
                            <td style="width:10%; padding: 8px !important;" ng-if="stt" class="cell-members">
                                <span ng-if="!item.Edit">{{item.SO_THU_TU}}</span>
                                <input type="text" ng-if="item.Edit" class="form-control" ng-model="item.SO_THU_TU">
                            </td>
                            <td style="width:10%; padding: 8px !important;" ng-if="tb" class="cell-members">
                                <input type="checkbox" ng-model="item.ISB" />
                            </td>
                            <td style="width:10%; padding: 8px !important; border-right:0px !important;"
                                ng-if="khvt" class="cell-members">
                                <span ng-if="!item.Edit">{{item.KY_HIEU_VIET_TAT}}</span>
                                <input type="text" ng-if="item.Edit" class="form-control"
                                       ng-model="item.KY_HIEU_VIET_TAT">
                            </td>
                        </tr>
                        <tr class="children"
                            ng-if="item.children &amp;&amp; item.children.length &gt; 0"
                            style="margin: 0px;">
                            <td colspan="7" style="border-left:0px !important; border-right:0px !important;">
                                <table class="table cap table-striped table-hover"
                                       ng-class="{opened: item.opened}"
                                       ng-include="&#39;table_tree.html&#39;"
                                       ng-init="level = level + 1"
                                       ng-repeat="item in item.children"
                                       style="border-left:0px !important; border-right:0px !important;">
                                </table>
                            </td>
                        </tr>
                        <tr ng-if="item.selected &amp;&amp; !item.status &amp;&amp; !noSelected"
                            ng-repeat="row in rows">
                            <td style="width:5%;" class="cell-input">
                                <input type="checkbox"
                                       ng-true-value="{{item.ID}}"
                                       ng-false-value="''" />
                            </td>
                            <td style="width:5%; border-left:0px !important;" class="cell-members"></td>

                            <td style="width:35%;" class="cell-name" ng-if="tncb">
                                <div style="padding-left:{{50*(level+1)}}px">
                                    <input type="text" ng-class="row.CB? 'error': ''"
                                           placeholder="Nhập tên nhóm cấp bậc"
                                           ng-model="row.TEN_NHOM_CB"
                                           class="form-control" />
                                    <div ng-show="row.CB">
                                        <label class="error">Bạn chưa nhập tên nhóm cấp bậc</label>
                                    </div>
                                </div>
                            </td>
                            <td style="width:25%;" class="cell-members" ng-if="mt">
                                <input ng-class="row.MT? 'error': ''"
                                       type="text"
                                       placeholder="Nhập mô tả"
                                       ng-model="row.MO_TA"
                                       class="form-control" />
                                <div ng-show="row.MT">
                                    <label class="error">Bạn chưa nhập mô tả</label>
                                </div>
                            </td>
                            <td style="width:10%;" class="cell-members" ng-if="stt">
                                <input ng-class="row.ST? 'error': ''"
                                       type="text"
                                       placeholder="STT"
                                       class="form-control"
                                       ng-model="row.SO_THU_TU" />
                                <div ng-show="row.ST">
                                    <label class="error">Bạn chưa nhập STT</label>
                                </div>
                            </td>
                            <td style="width:10%;" class="cell-members" ng-if="tb">
                                <input type="checkbox" ng-model="row.ISB" />
                            </td>
                            <td style="width:10%; border-right:0px !important;"
                                class="cell-members" ng-if="khvt">
                                <input ng-class="row.KH? 'error': ''"
                                       class="form-control"
                                       placeholder="Ký hiệu"
                                       type="text"
                                       ng-model="row.KY_HIEU_VIET_TAT" />
                                <div ng-show="row.KH">
                                    <label class="error">Bạn chưa nhập ký hiệu viết tắt</label>
                                </div>
                            </td>
                        </tr>
                    </script>
                </div>
            </div>
        </div>
    </main>
</div>
@section scripts{
    <script src="~/app/Controller/NhomCapBac.js"></script>
}