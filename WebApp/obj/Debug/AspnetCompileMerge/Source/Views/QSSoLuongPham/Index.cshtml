
@{
    ViewBag.Title = "Số lượng phạm";
}
<main ng-controller="SoLuongPhamController" style="padding-top: 20px;">
    <div class="container-fluid d-flex cons-ac-system" style="height: calc(100vh - 125px);">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="../App_Assets/images/ic_back_xx.svg" alt="">
            </button>

            <div class="fill-box">
                <h3 class="title-fill">
                    Đơn vị
                </h3>
            </div>

            <div class="container">
                <div class="main-action pt-3">
                    <div class="form-search w-100">
                        <input type="text" placeholder="Tìm kiếm">
                        <button>
                            <img src="../App_Assets/images/search_icon.svg" alt="">
                        </button>
                    </div>
                </div>

                <div class="function-box" style="height: calc(100vh - 235px);">
                    <div class="ztreeRoleBackground left" style="width:100%;">
                        <ul id="treeRole" class="ztree"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-system no-border pb-0 ng-hide" ng-init="IsShowRight = false" ng-show="IsShowRight">
            <div class="form-infor has-border p-3 firts-to-h  mb-2" style="padding-bottom: 5px !important;">
                <div class="row no-gutters">
                    <div class="col-12 col-md-9 col-lg-10">
                        <label for="">Đơn vị</label>
                        <input type="text" class="form-control" placeholder="{{TEN_DON_VI}}" disabled>
                    </div>

                    <div class="col-12 col-md-3 col-lg-2">
                        <label for="">Năm</label>
                        <select ng-model="NAM" class="form-control">
                            <option ng-repeat="item in ListNam" value="{{item.Id}}">{{item.Name}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12 main-action d-flex">
                        <button class="btn-action-m bg-green" ng-click="Luu()">
                            <i class="fa fa-floppy-o" aria-hidden="true"></i> <span>Lưu</span>
                        </button>
                    </div>
                </div>
                <div class="content-table mt-2 row" style="">
                    <table class="table-responsive table-hover result-point" style="margin-bottom: 0px;">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center">STT</th>
                                <th class="text-center">Loại phạm</th>
                                <th class="text-center">Nam</th>
                                <th class="text-center">Nữ</th>
                                <th class="text-center">Tổng </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in ListPham">
                                <td class="text-center">
                                    {{$index + 1}}
                                </td>
                                <td>
                                    <select disabled class="form-control" ng-model="item.LOAI_PHAM_ID" ng-options="i.ID as i.TEN_LOAI_PHAM for i in ListLoaiPham"></select>
                                </td>
                                <td>
                                    <input class="form-control" type="number" ng-model="item.SL_NAM"/>
                                </td>
                                <td>
                                    <input class="form-control" type="number" ng-model="item.SL_NU"/>
                                </td>
                                <td>
                                    <input class="form-control" type="number" ng-model="item.TONG = item.SL_NAM + item.SL_NU"  disabled/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>
@section scripts{
    <script src="~/app/Controller/QuanSo/SoLuongPhamController.js"></script>
}