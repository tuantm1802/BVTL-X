
@{
    ViewBag.Title = "Đơn vị tính";
    var user = Session["USER_SESSION"] as Simple.Base.UserLogin;
}

<div class="fill-box-bread-crumb">
    <h3 class="bread_crumb">
        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>/ Danh mục đơn vị tính
    </h3>
</div>

<div ng-controller="DonViTinhController">
    <main>
        <div class="container-fluid d-flex flex-wrap">
            <div class="row  no-gutters w-100">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;  padding-right: 2px;">
                    <div class="well">
                        <div class="row">
                            <div class="col-12 col-md-12 col-lg-12" align-self-end>
                                <div class="main-action d-flex pull-left">
                                    @if (user.Appcode == Common.AppCodeConfig.P1)
                                    {
                                        <button class="btn-action-m" ng-click="Addmm()" ng-show="RoleBtnCreate">
                                            <i class="fa fa-plus" aria-hidden="true"></i>
                                            <span>Thêm mới</span>
                                        </button>

                                        <button class="btn-action-m bg-red" ng-click="delete()" ng-show="RoleBtnDelete">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                            <span> Xóa </span>
                                        </button>
                                        <button class="btn-action-m" ng-click="Hiden()"
                                                ng-show="RoleBtnCancel" style="margin-right: 10px;">
                                            <i class="fa fa-ban" aria-hidden="true"></i>
                                            <span>Huỷ thay đổi</span>
                                        </button>
                                        <button class="btn-action-m" ng-click="submit()"
                                                ng-show="RoleBtnSave" style="margin-right: 10px;">
                                            <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                            <span>Lưu lại</span>
                                        </button>
                                    }
                                    @if (user.Appcode != Common.AppCodeConfig.P1)
                                    {

                                        <button class="btn-action-m" ng-click="btnCauHinh()" ng-show="RoleBtnCauHinh">
                                            <i class="fa fa-plus" aria-hidden="true"></i>
                                            <span>Cấu hình</span>
                                        </button>

                                    }


                                </div>
                                <div class="main-action d-flex align-items-center flex-wrap pull-right" style="margin-left:5px;">
                                    <div class="main-action">
                                        <div class="d-flex form-group" style="margin-bottom:0px;vertical-align:middle">
                                            <input type="text" ng-model="modelSearch.TEN_DVT" my-enter="searchDVT()" class="form-control" placeholder="Tìm kiếm" style="width:250px;margin-bottom:0px" />
                                            <button class="main-action btn-action-m" style="color:white" ng-click="searchDVT()">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-table" style="margin-top: 10px;">
                        <table class="table-hover result-point mt-2">
                            <thead class="point-table-head" style="width:100%">
                                <tr>
                                    <th style="width:2%;" class="text-center">
                                        <input type="checkbox" ng-model="selectAll" ng-click="checkAll()" />
                                    </th>
                                    <th style="width:2%;" class="text-center" ng-if="stt">STT</th>
                                    <th style="width:15%;" class="text-left" ng-if="dvt">Tên đơn vị tính</th>
                                    <th style="width:auto;" class="text-left" ng-if="Mota">Mô tả chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in DanhSach" ng-click="loadTemplate($index)">
                                    <td class="text-center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.select" value="10" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td class="text-left" ng-if="stt">{{(modelSearch.pageSize * (modelSearch.currentPage-1)) + $index + 1}}</td>
                                    <td class="text-left" ng-if="dvt">
                                        <span ng-if="!item.Edit">{{item.TEN_DVT}}</span>
                                        <input type="text" ng-if="item.Edit" ng-change="changeEdit($index)" class="form-control" ng-model="item.TEN_DVT">
                                    </td>
                                    <td class="text-left" ng-if="Mota">
                                        <span ng-if="!item.Edit">{{item.MO_TA}}</span>
                                        <input type="text" ng-if="item.Edit" ng-change="changeEdit($index)" class="form-control" ng-model="item.MO_TA">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr ng-repeat="row in rows">
                                    <td class="text-center">
                                        <input type="checkbox" id="check" ng-model="item.selected" />
                                    </td>
                                    <td class="text-left" ng-if="stt">{{modelSearch.pageSize * modelSearch.currentPage > modelSearch.totalItems ?  modelSearch.totalItems+1+$index : modelSearch.pageSize * modelSearch.currentPage +1+$index}}</td>
                                    <td class="text-left" ng-if="dvt">
                                        <input type="text" ng-model="row.TEN_DVT" placeholder="Nhập tên Đơn vị tính" />
                                    </td>
                                    <td class="text-left" ng-if="Mota">
                                        <input type="text" ng-model="row.MO_TA" placeholder="Nhập mô tả ngắn gọn" />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="pages-switch">
                            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelSearch.totalItems" show-length-per-page="true" items-per-page="modelSearch.pageSize" ng-model="modelSearch.currentPage" ng-change="pageChanged()" max-size="modelSearch.maxSize" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                        </div><!-- /.span -->
                    </div>
                </div>
            </div>
        </div>
    </main>


    <div class="modal fade" id="modal_CH">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Danh sách Đơn vị tính</h4>
                    <button type="button" class="close" data-dismiss="modal">
                        <img src="~/App_Assets/images/close.svg" alt="">
                    </button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <form class=" col-md-12" id="formSubmit">

                        <div class="col-5 none-padding-left">
                            <div class="main-action">
                                <div class="form-search w-100">
                                    <input type="text" placeholder="Tìm kiếm" ng-model="KeywordCH">
                                    <button ng-click="SearchKeywordCH()">
                                        <img src="~/App_Assets/images/search_icon.svg" alt="">
                                    </button>
                                </div>
                            </div>


                        </div>
                        <div class="row">
                            <div class="col-sm-5 none-padding">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"><label class="bold-label">Danh sách Đơn vị tính chưa sử dụng</label></legend>

                                    <div class="content-table" style="height:422px; overflow-y: scroll;">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AllChuaSD" ng-change="CheckAllChuaSD()" /> </th>
                                                    <th>STT</th>
                                                    <th>Tên ĐVT</th>
                                                    <th>Mô tả</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in ds_chua_sd">
                                                    <td class="center"><input type="checkbox" ng-change="CheckChuaSD($index)" class="form-control" ng-model="item.SELECT" /> </td>
                                                    <td>{{$index + 1}}</td>
                                                    <td>{{item.TEN_DVT}}</td>
                                                    <td>{{item.MO_TA}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="col-sm-1">

                                <div class="main-action d-flex pull-left p-3 bold-label">
                                    <button class="btn-action-m" ng-click="CoSD()">
                                        <i class="fa fa-angle-right" aria-hidden="true"></i>
                                        <span></span>
                                    </button>

                                </div>
                            </div>
                            <div class="col-sm-1">

                                <div class="main-action d-flex pull-right p-3 bold-label">

                                    <button class="btn-action-m" ng-click="KhongSD()">
                                        <i class="fa fa-angle-left" aria-hidden="true"></i>
                                        <span></span>
                                    </button>

                                </div>
                            </div>
                            <div class="col-sm-5 none-padding">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"><label class="bold-label">Danh sách Đơn vị tính đang sử dụng</label></legend>
                                    <div class="content-table" style="height:422px; overflow-y:scroll;">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AllDangSD" ng-change="CheckAllDangSD()" /> </th>
                                                    <th>STT</th>
                                                    <th>Tên ĐVT</th>
                                                    <th>Mô tả</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in ds_dang_ssd">
                                                    <td class="center"><input type="checkbox" ng-change="CheckDangSD()" class="form-control" ng-model="item.SELECT" /> </td>
                                                    <td>{{$index + 1}}</td>
                                                    <td>{{item.TEN_DVT}}</td>
                                                    <td>{{item.MO_TA}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </form>
                </div>
                <!-- Modal footer -->
                <div class="modal-footer d-flex justify-content-between">
                    <h5 class="day-make"></h5>
                    <div class="main-action d-flex flex-wrap">

                        <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                            <img src="~/App_Assets/images/d_close.svg" alt="" class="exsit">
                            <img src="~/App_Assets/images/ic_close_r_light.svg" alt="" class="hover_m">
                            <span>Đóng</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
@section scripts{
    <script src="~/app/Controller/DonViTinhController.js"></script>
}