<div>
    <div class="main-action d-flex align-items-center justify-content-between flex-wrap mt-2 mb-2">
        <div class="d-flex align-items-center flex-wrap ct-w">
            <button class="btn-action-m" data-toggle="modal" data-target="#modalAddPhuLuc"
                    ng-click="addPhuLucModal()" ng-disabled="isDisableHD" ng-show="luuPhuLuc">
                <img src="~/App_Assets/images/icon_add.svg" alt="">
                <span>Thêm mới</span>
            </button>
            <button class="btn-action-m" ng-click="removePhuLuc()" ng-disabled="isDisableHD" ng-show="xoaPhuLuc">
                <img src="~/App_Assets/images/icon_del.svg" alt="">
                <span>Xoá</span>
            </button>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="row">
            <div class="col-12 col-sm-5 none-padding-left content-table">
                <div class="row">
                    <div class="col-sm-12">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="isCheckAllPLView" ng-change="changeCheckAllPLView()" />
                                            <span class="lbl"></span>
                                        </label>
                                    </th>
                                    <th class="center">STT</th>
                                    <th class="center">Ngày PL</th>
                                    <th class="center">Số PL</th>
                                    <th class="center">G.trị PL</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in listHDPhuLuc" ng-class="{activerow:$index==selectedRowPL}">
                                    <td class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.checked" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td ng-click="viewDetailPL(item, $index, 'true')">{{$index + 1}}</td>
                                    <td ng-click="viewDetailPL(item, $index, 'true')">{{item.ngayPhuLuc}}</td>
                                    <td ng-click="viewDetailPL(item, $index, 'true')">{{item.soPhuLuc}}</td>
                                    <td ng-click="viewDetailPL(item, $index, 'true')">
                                        {{item.giaTriPL | number}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 pages-switch">
                        <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelPhuluc.totalItems" items-per-page="modelPhuluc.pageSize" ng-model="modelPhuluc.pageIndex" ng-change="getPhucLuc()" max-size="modelPhuluc.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-7 none-padding-right content-table" ng-show="modelPhuLucView.idPhuLuc">
                <form class="row form-group mr-0 ml-0" name="phulucviewform">
                    <div class="col-12 col-md-6">
                        <label for="">Số phụ lục:</label>
                        <input type="text" disabled to-uppercase ng-model="modelPhuLucView.soPhuLuc" name="soPhuLuc" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Ngày phụ lục:</label>
                        <input type="text" disabled ng-model="modelPhuLucView.ngayPhuLuc" name="ngayPhuLuc" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Ngày chốt SLTT:</label>
                        <input type="text" disabled ng-model="modelPhuLucView.ngayChotSLTT" name="ngayChotSLTT" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="">Giá trị PL:</label>
                        <input type="text" disabled currency-input ng-model="modelPhuLucView.giaTriPL" name="giaTriPL" class="form-control" value="">
                    </div>
                </form>
                <div class="row mr-0 ml-0">
                    <div class="col-sm-12">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="center">STT</th>
                                    <th class="center">Mã hàng</th>
                                    <th class="center">Tên hàng</th>
                                    <th class="center">ĐVT</th>
                                    <th class="center">SL phụ lục</th>
                                    <th class="center">Đơn giá KH</th>
                                    <th class="center">Thành tiền</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in listSanPhamPLView">

                                    <td>{{$index + 1}}</td>
                                    <td>{{item.MA_HANG}}</td>
                                    <td>
                                        {{item.TEN_HANG}}
                                    </td>
                                    <td>{{item.DVT}}</td>
                                    <td class="text-right">
                                        {{item.SO_LUONG | number}}
                                    </td>
                                    <td class="text-right">
                                        {{item.DON_GIA | number}}
                                    </td>
                                    <td class="text-right">{{item.THANH_TIEN | number}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
