<div class="col-sm-12 pr-0">
    <div class="main-action d-flex align-items-center justify-content-end flex-wrap mb-2 mt-2 mr-3">
        <div class="d-flex align-items-center flex-wrap">
            <div class="main-action pt-3">
                <div class="form-search" style="margin-right: 0px">
                    <input type="text" ng-model="khoTonKhoVTPage.timKiem" placeholder="Tìm kiếm">
                    <button ng-click="khoTonKhoVTGetList()">
                        <img src="~/App_Assets/images/search_icon.svg" alt="">
                    </button>
                </div>
            </div>
            
        </div>
    </div>

    <div class="col-sm-12">
        <div class="row">
            <div class="col-12 col-sm-12 content-table none-padding">
                <div class="row ml-0 mr-0">
                    <div class="col-sm-12 none-padding-right">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="center">STT</th>
                                    @*<th class="center">Mã H55</th>*@
                                    <th class="center">Tên hàng</th>
                                    <th class="center">DVT</th>
                                    <th class="center">SL hợp đồng</th>
                                    <th class="center">SL qua kho</th>
                                    <th class="center">SL giao thẳng</th>
                                    <th class="center">SL điều chuyển</th>
                                    <th class="center">SL tồn</th>
                                    <th class="center">SL có thể xuất</th>

                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in khoTonKhoVTList">
                                    <td>{{$index + 1}}</td>
                                    @*<td>{{item.MA_H55}}</td>*@
                                    <td>{{item.TEN_SP}}</td>
                                    <td>{{item.DVT}}</td>
                                    <td>{{item.SO_LUONG}}</td>
                                    <td>{{item.SO_LUONG_QK}}</td>
                                    <td>{{item.SO_LUONG_GT}}</td>
                                    <td>{{item.SO_LUONG_DC}}</td>
                                    <td>{{item.SO_LUONG_TON}}</td>
                                    <td>{{item.SO_LUONG_XUAT}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>