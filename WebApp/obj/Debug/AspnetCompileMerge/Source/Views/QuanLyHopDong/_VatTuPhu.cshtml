<div class="col-sm-12">
    <div class="col-sm-12">
        <div class="main-action d-flex align-items-center justify-content-between flex-wrap mt-1 mb-2">
            <div class="d-flex align-items-center flex-wrap ct-w">
                <button class="btn-action-m" data-toggle="modal" data-target="#modalAddNTVatTu" ng-click="addNTVatTuModal()" ng-disabled="isDisableHD" ng-show="luuNghiemThuVatTuPhu">
                    <img src="~/App_Assets/images/icon_add.svg" alt="">
                    <span>Thêm mới</span>
                </button>
                @*<button class="btn-action-m" ng-click="updateNTVatTuModal()">
                        <img src="~/App_Assets/images/icon_edit.svg" alt="">
                        <span>Sửa</span>
                    </button>*@
                <button class="btn-action-m" ng-click="removeNghiemThuVatTu()" ng-disabled="isDisableHD" ng-show="xoaNghiemThuVatTuPhu">
                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                    <span>Xoá</span>
                </button>
            </div>

            <div class="d-flex align-items-center flex-wrap">
                <div class="main-action pt-3">
                    <div class="form-search" style="margin-right: 0px">
                        <input type="text" ng-model="modelNTVatTu.timKiem" placeholder="Tìm kiếm">
                        <button ng-click="pageNTVatTuChanged()">
                            <img src="~/App_Assets/images/search_icon.svg" alt="">
                        </button>
                    </div>
                </div>
                
            </div>
        </div>

        <div class="col-sm-12">
            <div class="row">
                <div class="col-12 col-sm-6 none-padding-left content-table">
                    <div class="row">
                        <div class="col-sm-12">
                            <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                                <thead>
                                    <tr>
                                        <th class="center">
                                            <label class="pos-rel">
                                                <input type="checkbox" ng-model="isCheckAllNtVatTuView" class="ace" ng-change="changeCheckAllNTVattuView()" />
                                                <span class="lbl"></span>
                                            </label>
                                        </th>
                                        <th class="center">STT</th>
                                        <th class="center">Chi tiết</th>
                                        <th class="center">Số phiếu</th>
                                        <th class="center">Ngày NT</th>
                                        <th class="center">Người NT</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr ng-repeat="item in listHDNTVatTu" ng-click="viewDetailNTVatTu(item, $index,'true')" ng-class="{activerow:$index==selectedRowNTVatTu}">
                                        <td class="center">
                                            <label class="pos-rel">
                                                <input type="checkbox" class="ace" ng-model="item.CHECKED" />
                                                <span class="lbl"></span>
                                            </label>
                                        </td>
                                        <td>{{$index + 1}}</td>
                                        <td>
                                            <button ng-click="updateNTVatTuModal(item)" style="background-color:transparent">
                                                <img src="~/App_Assets/images/icon_edit_green.svg" alt="">
                                            </button>
                                        </td>
                                        <td>{{item.SO_PHIEU_NT}}</td>
                                        <td>{{item.NGAY_NT}}</td>
                                        <td>{{item.NGUOI_NT}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 pages-switch">
                            <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelNTVatTu.totalItems" items-per-page="modelNTVatTu.pageSize" ng-model="modelNTVatTu.pageIndex" ng-change="pagePhuLucChanged()" max-size="modelNTVatTu.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 none-padding-right content-table">

                    <div class="row ml-0 mr-0">
                        <div class="col-sm-12 pl-0 pr-0">
                            <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                                <thead>
                                    <tr>
                                        <th class="center">STT</th>
                                        <th class="center">Tên sản phẩm</th>
                                        <th class="center">Số lượng</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr ng-repeat="item in listSanPhamAddNTVatTuView">
                                        <td>{{$index + 1}}</td>
                                        <td>{{item.TEN_SP}}</td>
                                        <td class="text-right">{{item.SL}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>