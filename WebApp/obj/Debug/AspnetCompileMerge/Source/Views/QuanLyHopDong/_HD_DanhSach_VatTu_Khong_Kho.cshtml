<div class="modal fade" id="modalHDVatTuKhongKho">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Danh sách vật tư</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="d-flex justify-content-end">
                    <div class="main-action d-flex align-items-center justify-content-between flex-wrap pt-3 pb-2">
                        <div class="form-search mr-0">
                            <input type="text" placeholder="Tìm kiếm" ng-model="listSPOpts.timKiem">
                            <button>
                                <img src="~/App_Assets/images/search_icon.svg" alt="">
                            </button>
                        </div>
                    </div>
                </div>
                <div class="content-table">
                    <table class="table-responsive table-hover result-point">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center"></th>
                                <th class="text-center">STT</th>
                                <th class="text-center balance">Tên hàng</th>
                                <th class="text-center">ĐVT</th>
                                <th class="text-center">SL tồn</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in listSanPhamCuaHopDong"
                                ng-if="item.TEN_SP.toLowerCase().includes(listSPOpts.timKiem.toLowerCase())">
                                <td class="center">
                                    <label class="pos-rel">
                                        <input type="checkbox" class="ace" ng-model="item.CHECKED" />
                                        <span class="lbl"></span>
                                    </label>
                                </td>
                                <td>{{$index + 1}}</td>
                                <td>
                                    {{item.TEN_SP}}
                                </td>
                                <td>{{item.DVT}}</td>
                                <td>{{item.SO_LUONG_XUAT}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-end">

                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="saveCheckedVatTuKhongKho()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Chọn</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>