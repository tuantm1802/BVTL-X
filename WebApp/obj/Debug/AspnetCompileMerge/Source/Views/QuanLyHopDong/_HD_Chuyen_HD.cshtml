
<div class="content-system" style="margin:0px">
    <div class="nav-tabs-box">
        <ul class="nav nav-tabs" id="myTabsss" role="tablist">
            <li class="nav-item" ng-click="khoChuyenHDNKGetList()">
                <a class="nav-link active" id="home-tab" data-toggle="tab" href="#chuyenphieunhapkho" role="tab">Chuyển phiếu nhập kho</a>
            </li>

            <li class="nav-item" ng-click="khoChuyenHDGTGetList()">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#chuyenphieugiaothang" role="tab">Chuyển phiếu giao thẳng</a>
            </li>

            <li class="nav-item" ng-click="khoChuyenHDXTGetList()">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#chuyenphieuxuatthang" role="tab">Chuyển phiếu xuất thẳng</a>
            </li>
            <li class="nav-item" ng-click="changeTabVatTu(3)">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#dieuchuyenvattuchinh" role="tab">Điều chuyển vật tư chính</a>
            </li>
            <li class="nav-item" ng-click="changeTabVatTu(4)">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#nhaptravattuchinh" role="tab">Nhập trả vật tư chính</a>
            </li>
            <li class="nav-item" ng-click="kpKetDuGetList()">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#chuyenkinhphiketdu" role="tab">Chuyển kinh phí kết dư</a>
            </li>
        </ul>
    </div>
    <div class="tab-content hd-overflow-open">
        <div class="tab-pane row active" id="chuyenphieunhapkho">
            @Html.Partial("_HD_Chuyen_HD_Phieu_NK")
        </div>
        <div class="tab-pane row" id="chuyenphieugiaothang">
            @Html.Partial("_HD_Chuyen_HD_Phieu_GT")
        </div>
        <div class="tab-pane row" id="chuyenphieuxuatthang">
            @Html.Partial("_HD_Chuyen_HD_Phieu_XT")
        </div>
        <div class="tab-pane row" id="dieuchuyenvattuchinh">
            @Html.Partial("_DieuChuyenVatTu")
        </div>
        <div class="tab-pane row" id="nhaptravattuchinh">
            @Html.Partial("~/Views/QuanLyHopDong/_VatTuNhapTra.cshtml")
        </div>
        <div class="tab-pane row" id="chuyenkinhphiketdu">
            @Html.Partial("_HD_Chuyen_HD_KinhPhiKetDu")
        </div>
    </div>
</div>
