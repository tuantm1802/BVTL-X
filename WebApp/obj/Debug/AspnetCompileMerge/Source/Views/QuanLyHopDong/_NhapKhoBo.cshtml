
<div class="col-sm-12">
    <!-- tabs -->
    <div class="tabbable" style="margin-right:10px">
        <div class="content-system">
            <div class="tabs-left">
                <ul class="nav nav-tabs nav-tabs-box mr-0 no-top-border">
                    <li class="nav-item" ng-click="khoNhapKhoGetList()">
                        <a class="nav-link active" href="#khoNhapKho" data-toggle="tab">Nhập kho</a>
                    </li>
                    <li class="nav-item" ng-click="khoTraHDGetList()">
                        <a class="nav-link" href="#khoTraHD" data-toggle="tab">Nhập trả HĐ</a>
                    </li>
                </ul>
            </div>
            <div class="tab-content">
                <div class="tab-pane active" id="khoNhapKho">
                    @Html.Partial("_NhapKhoBo_NhapKho")
                </div>
                <div class="tab-pane" id="khoTraHD">
                    @Html.Partial("_NhapKhoBo_Tra_HD")
                </div>
            </div>
        </div>
    </div>
    <!-- /tabs -->

</div>


