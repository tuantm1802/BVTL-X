@{
    ViewBag.Title = "Quản lý hợp đồng";
}

<main class="main-ac-system p7_hd" ng-controller="QuanLyHopDongController" ng-cloak>
    <div class="container-fluid d-flex cons-ac-system">
        <div class="action-system pd-two ui-widget-content" id="resizable">
            <button id="btn-changes-s-nav">
                <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
            </button>
            <div class="fill-box">
                <h3 class="title-fill">
                    Hợp đồng
                </h3>
            </div>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item has-one-fl">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#ds_hop_dong" role="tab"
                       ng-click="hdDanhSachClicked('HD')">
                        D.S hợp đồng
                    </a>
                </li>

                <li class="nav-item has-one-fl">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#ds_hop_dong_ung" role="tab"
                       ng-click="hdDanhSachClicked('UNG')">
                        Ứng hợp đồng
                    </a>
                </li>
            </ul>

            <div class="container">
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="ds_hop_dong" role="tabpanel" aria-labelledby="home-tab">
                        @Html.Partial("_HD_DanhSach")
                    </div>

                    <div class="tab-pane fade" id="ds_hop_dong_ung" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_HD_DanhSach")
                    </div>
                </div>
            </div>
        </div>
        <div class="content-system">
            <div class="fill-box-bread-crumb">
                <h3 class="bread_crumb">
                    <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>  /  Hợp Đồng
                </h3>
            </div>

            <div style="margin: 10px">
                @Html.Partial("_ThongTinHopDong")
            </div>
            <div class="nav-tabs-box">
                <ul class="nav nav-tabs tab-main" id="myTab" role="tablist" ng-if="hdPaging.type == 'HD'">
                    <li class="nav-item">
                        <a class="nav-link active" id="home-tab" data-toggle="tab" href="#noi_dung" role="tab" ng-click="noidungHopDongGet()">Nội dung</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#phu_luc" role="tab" ng-click="getPhucLuc()">Phụ lục</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#vat_tu_sx" role="tab" ng-click="tabVatTuSelect()">Vật tư sản xuất</a>
                    </li>
                    <li class="nav-item" ng-click="khoHopDongClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#kho_hop_dong" role="tab">Kho hợp đồng</a>
                    </li>
                    <li class="nav-item" ng-click="quyetToanClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#quyet_toan" role="tab">Quyết toán</a>
                    </li>
                    <li class="nav-item" ng-click="chuyenHDClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#chuyen_hop_dong" role="tab">Chuyển sang hợp đồng sau</a>
                    </li>
                    <button id="pick_up_changes_2" class="res-img">
                        <img src="~/App_Assets/images/btn_ui.svg" alt="">
                    </button>
                </ul>
                <ul class="nav nav-tabs tab-main" id="myTab" role="tablist" ng-if="hdPaging.type == 'UNG'">
                    <li class="nav-item" ng-click="khoHopDongClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#kho_hop_dong" role="tab">Kho hợp đồng</a>
                    </li>
                    <li class="nav-item" ng-click="quyetToanClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#quyet_toan" role="tab">Quyết toán</a>
                    </li>
                    <li class="nav-item" ng-click="chuyenHDClicked()">
                        <a class="nav-link" id="profile-tab" data-toggle="tab" href="#chuyen_hop_dong" role="tab">Chuyển sang hợp đồng sau</a>
                    </li>
                </ul>
            </div>

            <div class="container-fluid">
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="noi_dung" role="tabpanel" aria-labelledby="home-tab">
                        @Html.Partial("_NoiDung")
                    </div>
                    <div class="tab-pane fade" id="phu_luc" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_PhuLuc")
                    </div>

                    <div class="tab-pane fade" id="vat_tu_sx" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_VatTuSanXuat")
                    </div>

                    <div class="tab-pane fade" id="kho_hop_dong" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_KhoHopDong")
                    </div>

                    <div class="tab-pane fade" id="quyet_toan" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_QuyetToan")
                    </div>

                    <div class="tab-pane fade" id="chuyen_hop_dong" role="tabpanel" aria-labelledby="profile-tab">
                        @Html.Partial("_HD_Chuyen_HD")
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("_AddHopDong")
    @Html.Partial("_AddPhuLuc")
    @Html.Partial("_AddVatTuNghiemThu")
    @Html.Partial("_AddDSSPVatTuNghiemThu")
    @Html.Partial("_AddVatTuChinhQuaKho")
    @Html.Partial("_AddGiaoThangVatTu")
    @Html.Partial("_AddDieuChuyenVatTu")
    @Html.Partial("_AddNhapTraVatTu")
    @Html.Partial("_AddGiayBaoNghiemThu")
    @Html.Partial("_NoiDungHopDongBanDau")
    @Html.Partial("_DinhMucVatTu")
    @Html.Partial("_VaySec")
    @Html.Partial("_AddVaySec")
    @Html.Partial("_HD_DanhSach_TimKiem")
    @Html.Partial("_ChotSLTTHD")
    @Html.Partial("_Kho_PhieuXuatThang_Add")

    @Html.Partial("_HD_SanPham")
    @Html.Partial("_HD_DanhSach_VatTu_Kho")
    @Html.Partial("_HD_DanhSach_VatTu_Khong_Kho")

    <div class="modal fade" id="modalSearch">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1" role="document" style="width: 500px">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Thông tin chi tiết</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body md-sc form-infor app-s">
                    <div class="row no-gutters">
                        <div class="col-12 col-md-12">
                            <label for="">Năm kinh phí: </label>
                            <select ng-model="modelSearch.namKinhPhi" name="namKinhPhi" select2 class="form-control" ng-options="item.key as item.value for item in listNamKinhPhi"></select>
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Số hợp đồng:</label>
                            <input type="text" to-uppercase ng-model="modelSearch.soHopDong" class="form-control" />
                        </div>
                        <div class="col-12 col-md-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Ngày ký hợp đồng</legend>
                                <div class="form-group">
                                    <div class="row">
                                        <label for="" class="col-sm-4 col-form-label">Ngày bắt đầu:</label>
                                        <div class="input-group date col-sm-8 w-datepicker" data-date-format="dd/mm/yyyy">
                                            <input type="text" ng-model="modelSearch.ngayBatDauHopDong" class="form-control">
                                            <span class="input-group-addon"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="row">
                                        <label for="" class="col-sm-4 col-form-label">Ngày kết thúc:</label>
                                        <div id="dateForm" class="input-group date col-sm-8 w-datepicker" data-date-format="dd/mm/yyyy">
                                            <input type="text" ng-model="modelSearch.ngayKetThucHopDong" class="form-control">
                                            <span class="input-group-addon"></span>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Loại hợp đồng:</label>
                            <select select2 ng-model="modelSearch.loaiHopDong" name="loaiHopDong" ng-options="item.id as item.name for item in listLoaiHD" class="form-control">
                            </select>
                            @*<select ng-model="modelSearch.loaiHopDong" class="form-control">
                                    <option value="">Tất cả</option>
                                    <option ng-repeat="item in listLoaiHD" value="{{item.id}}">{{item.name}}</option>
                                </select>*@
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Công ty:</label>
                            <select select2 ng-model="modelSearch.congTy" ng-options="item.ID as item.TEN_CONG_TY for item in listCongTy" name="congTy" class="form-control">
                            </select>
                            @*<select ng-model="modelSearch.congTy" class="form-control">
                                    <option value="">Tất cả</option>
                                    <option ng-repeat="item in listCongTy" value="{{item.ID}}">{{item.TEN_CONG_TY}}</option>
                                </select>*@
                        </div>
                        <div class="col-12 col-md-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Thời gian giao hàng</legend>
                                <div class="form-group">
                                    <div class="row">
                                        <label for="" class="col-sm-4 col-form-label">Ngày bắt đầu:</label>
                                        <div class="input-group date col-sm-8 w-datepicker" data-date-format="dd/mm/yyyy">
                                            <input type="text" ng-model="modelSearch.ngayBatDauGiaoHang" class="form-control">
                                            <span class="input-group-addon"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="row">
                                        <label for="" class="col-sm-4 col-form-label">Ngày kết thúc:</label>
                                        <div class="input-group date col-sm-8 w-datepicker" data-date-format="dd/mm/yyyy">
                                            <input type="text" ng-model="modelSearch.ngayKetThucGiaoHang" class="form-control">
                                            <span class="input-group-addon"></span>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Trạng thái:</label>
                            <select select2 ng-model="modelSearch.trangThai" ng-options="item.id as item.name for item in listTrangThaiHD" name="trangThai" class="form-control">
                            </select>
                            @*<select ng-model="modelSearch.trangThai" class="form-control">
                                    <option value="">Tất cả</option>
                                    <option ng-repeat="item in listTrangThaiHD" value="{{item.id}}">{{item.name}}</option>
                                </select>*@
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="main-action d-flex flex-wrap">
                        <button class="btn-action-m cl-3" ng-click="timkiemHD(false)">
                            <img src="~/App_Assets/images/icon_save.svg" alt="">
                            <span>Tìm kiếm</span>
                        </button>

                        <button class="btn-action-m cl-3" data-dismiss="modal">
                            <img src="~/App_Assets/images/ic_cancel_light.svg" alt="">
                            <span>Đóng</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</main>


@section scripts{
    <script src="~/app/Controller/QuanLyHopDongController.js"></script>
}
