<div class="modal fade" id="modalKhoPhieuGiaoThangDetail">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Phiếu giao thẳng chi tiết</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="form-infor has-border p-3">
                    <h4 class="form-title">
                        Thông tin phiếu
                    </h4>

                    <form class="row no-gutters" name="gtvtkhongquakhoform">
                        <div class="col-12 col-md-4">
                            <label for="">Số phiếu: <span>*</span></label>
                            <input type="text" disabled to-uppercase ng-model="khoPhieuGTModel.SO_PHIEU" name="soPhieu" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Ngày giao:<span>*</span></label>
                            <div class="input-group date w-datepicker" data-date-format="dd/mm/yyyy">
                                <input type="text" disabled class="form-control" ng-model="khoPhieuGTModel.NGAY_GIAO" name="ngayThang" horizontal="left" value="" style="width: 100%">
                                <span class="input-group-addon"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Số phiếu tài chính:<span>*</span></label>
                            <input type="text" disabled ng-model="khoPhieuGTModel.SO_PHIEU_H55" name="soPhieuH55" class="form-control" value="">
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Người giao:</label>
                            <input type="text" disabled ng-model="khoPhieuGTModel.NGUOI_NHAN" name="nguoiNhan" class="form-control" value="">
                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Nơi giao:</label>
                            <input type="text" disabled ng-model="khoPhieuGTModel.NOI_GIAO" name="nguoiNhan" class="form-control" value="">

                        </div>
                        <div class="col-12 col-md-4">
                            <label for="">Nơi nhận:</label>
                            <input type="text" disabled ng-model="khoPhieuGTModel.NOI_NHAN" name="noiNhan" class="form-control">
                        </div>
                        <div class="col-12 col-md-12">
                            <label for="">Mô tả:</label>
                            <input type="text" disabled ng-model="khoPhieuGTModel.MO_TA" name="moTa" class="form-control" value="">
                        </div>
                    </form>
                </div>

                <div class="content-table">
                    <table class="table table-bordered table-hover">
                        <thead class="point-table-head">
                            <tr>
                                <th class="text-center">STT</th>
                                <th class="text-center">Tên hàng</th>
                                <th class="text-center">ĐVT</th>
                                <th class="text-center">Số lượng</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            <tr ng-repeat="item in khoPhieuGTListSP">
                                <td>{{$index + 1}}</td>
                                <td>{{item.TEN_SP}}</td>
                                <td>{{item.DVT}}</td>
                                <td>{{item.SO_LUONG}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">

                <h5 class="day-make">Ngày tạo: <i>@DateTime.Now.ToString("dd/MM/yyyy")</i></h5>

                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
