
<div class="modal fade" id="modalAddGiayBaoNghiemThu">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Thêm mới giấy báo nghiệm thu</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="nav-tabs-box">
                    <ul class="nav nav-tabs" id="myTabsss" role="tablist">
                        <li class="nav-item"><a class="nav-link active" href="#giaybaont" data-toggle="tab">Cỡ số</a></li>
                        <li class="nav-item"><a class="nav-link" href="#kehoachsx" data-toggle="tab">May đo</a></li>
                    </ul>
                </div>
                <div class="tab-content hd-overflow-open">
                    <div class="tab-pane active" id="giaybaont">
                        <div class="form-infor has-border p-3">
                            <h4 class="form-title">
                                Thông tin giấy báo nghiệm thu
                            </h4>

                            <form class="row no-gutters" name="khoNTform" ng-validate="khoNTValidation">
                                <div class="col-12 col-md-4">
                                    <label for="">Số nghiệm thu: <span>*</span></label>
                                    <input type="text" to-uppercase ng-model="khoNTModel.SO_PHIEU_NT" name="SO_PHIEU_NT" class="form-control" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="">Ngày nghiệm thu:</label>
                                    <div class="input-group date w-datepicker" data-date-format="dd/mm/yyyy">
                                        <input type="text" class="form-control" ng-model="khoNTModel.NGAY_NT" name="NGAY_NT" horizontal="left" value="">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="">Người nghiệm thu:</label>
                                    <input type="text" ng-model="khoNTModel.NGUOI_NT" name="NGUOI_NT" class="form-control" value="">
                                </div>
                                <div class="col-12 col-md-12">
                                    <label for="">Mô tả:</label>
                                    <input type="text" ng-model="khoNTModel.MO_TA" name="MO_TA" class="form-control" value="">
                                </div>
                            </form>
                        </div>

                        <div class="main-action d-flex align-items-center justify-content-between flex-wrap pt-3 pb-2">
                            <div class="d-flex align-items-center flex-wrap ct-w">
                                <button class="btn-action-m" ng-click="removeSP()">
                                    <img src="~/App_Assets/images/icon_del.svg" alt="">
                                    <span>Xoá</span>
                                </button>

                                <button class="btn-action-m" ng-click="openDanhSachSP('HD')" data-toggle="modal" data-target="#modalDanhSachHD">
                                    <img src="~/App_Assets/images/icon_fl.svg" alt="">
                                    <span>Danh sách sản phẩm</span>
                                </button>
                            </div>

                        </div>

                        <div class="content-table">
                            <table class="table table-bordered table-hover">
                                <thead class="point-table-head">
                                    <tr>
                                        <th class="text-center">
                                            <input type="checkbox" ng-model="listSPAddOpts.checkedAll"
                                                   class="ace" ng-change="checkAllSPClicked()">
                                        </th>
                                        <th class="text-center">STT</th>
                                        <th class="text-center un-code">Mã hàng</th>
                                        <th class="text-center">Tên hàng</th>
                                        <th class="text-center un-dtv">ĐTV</th>
                                        <th class="text-center">Số lượng</th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <tr ng-repeat="item in listSPAdd">
                                        <td class="text-center">
                                            <input type="checkbox" class="ace" ng-model="item.CHECKED" />
                                        </td>
                                        <td>{{$index + 1}}</td>
                                        <td>{{item.MA_H55}}</td>
                                        <td>
                                            {{item.TEN_SP}}
                                        </td>
                                        <td>{{item.TEN_DVT}}</td>
                                        <td>
                                            <input type="text" currency-input ng-class="item.SL_ERROR? 'error': ''" ng-model="item.SL" class="form-control" value="">
                                            <div ng-show="item.SL_ERROR">
                                                <label class="error">Bạn chưa nhập số lượng hóa đơn</label>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="kehoachsx">
                        <div class="form-infor has-border p-3">
                            <h4 class="form-title">
                                Thông tin kế hoạch sản xuất
                            </h4>
                            <form class="row no-gutters" name="khoNTPhieuKHForm" ng-validate="khoNTValidation">
                                <div class="col-12 col-md-4">
                                    <label for="">Số nghiệm thu: <span>*</span></label>
                                    <input type="text" to-uppercase ng-model="khoNTModel.PHIEU_KH_SO_PHIEU_NT" name="SO_PHIEU_NT" class="form-control" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="">Ngày nghiệm thu:</label>
                                    <div class="input-group date w-datepicker" data-date-format="dd/mm/yyyy">
                                        <input type="text" class="form-control" ng-model="khoNTModel.PHIEU_KH_NGAY_NT" name="NGAY_NT" horizontal="left" value="">
                                        <span class="input-group-addon"></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="">Người nghiệm thu:</label>
                                    <input type="text" ng-model="khoNTModel.PHIEU_KH_NGUOI_NT" name="NGUOI_NT" class="form-control" value="">
                                </div>
                                <div class="col-12 col-md-12">
                                    <label for="">Mô tả:</label>
                                    <input type="text" ng-model="khoNTModel.PHIEU_KH_MO_TA" name="MO_TA" class="form-control" value="">
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="">Phiếu kế hoạch:</label>
                                    <select ng-model="khoNTModel.PHIEU_KH_ID" name="PHIEU_KH_ID" ng-options="item.ID as item.MA_LENH for item in listPhieuKeHoachSx" select2 class="form-control" style="width:100%" ng-change="onChangeKHSX(khoNTModel.PHIEU_KH_ID)">
                                    </select>
                                </div>
                            </form>
                        </div>
                        <div class="content-table pt-3">
                            <table class="table table-bordered table-hover">
                                <thead class="point-table-head">
                                    <tr>
                                        <th class="text-center">STT</th>
                                        <th class="text-center un-code">Mã hàng</th>
                                        <th class="text-center">Tên hàng</th>
                                        <th class="text-center un-dtv">ĐTV</th>
                                        <th class="text-center">Số lượng KH</th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <tr ng-repeat="item in listPhieuKHSXDetail">
                                        <td>{{$index + 1}}</td>
                                        <td>{{item.MA_H55}}</td>
                                        <td>
                                            {{item.TEN_SP}}
                                        </td>
                                        <td>{{item.TEN_DVT}}</td>
                                        <td>{{item.SL_KE_HOACH}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">

                <h5 class="day-make">Ngày tạo: <i>@DateTime.Now.ToString("dd/MM/yyyy")</i></h5>

                <div class="main-action d-flex flex-wrap">

                    <button class="btn-action-m cl-3" ng-click="khoNTAddNew()"  ng-show="luuGiaBaoNghiemThuKho">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Lưu</span>
                    </button>

                    <button class="btn-action-m cl-3" data-dismiss="modal">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Đóng</span>
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>
