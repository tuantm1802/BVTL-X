
<div class="col-sm-12">
    <div class="main-action d-flex align-items-center justify-content-between flex-wrap mt-2 mb-2">
        <div class="d-flex align-items-center flex-wrap ct-w">
            <button class="btn-action-m" data-toggle="modal" data-target="#modalAddDieuChuyenVatTu" ng-click="addDieuChuyenVTKhongQuaKhoModal()" ng-disabled="isDisableHD" ng-show="luuDieuChuyenVatTuChinhKhongQuaKho">
                <img src="~/App_Assets/images/icon_add.svg" alt="">
                <span>Thêm mới</span>
            </button>
            @*<button class="btn-action-m" ng-click="updateDieuChuyenVTKhongQuaKhoModal()">
                    <img src="~/App_Assets/images/icon_edit.svg" alt="">
                    <span>Sửa</span>
                </button>*@
            <button class="btn-action-m" ng-click="removeDieuChuyenVTKhongQuaKho()" ng-disabled="isDisableHD" ng-show="xoaDieuChuyenVatTuChinhKhongQuaKho">
                <img src="~/App_Assets/images/icon_del.svg" alt="">
                <span>Xoá</span>
            </button>
        </div>

        <div class="d-flex align-items-center flex-wrap">
            <div class="main-action pt-3">
                <div class="form-search" style="margin-right: 0px">
                    <input type="text" ng-model="modelDieuChuyenVatTuKhongQuaKho.timKiem" placeholder="Tìm kiếm">
                    <button ng-click="pageDieuChuyenVTKhongQuaKhoChanged()">
                        <img src="~/App_Assets/images/search_icon.svg" alt="">
                    </button>
                </div>
            </div>
            
        </div>
    </div>

    <div class="col-sm-12 none-padding-right">
        <div class="row">
            <div class="col-12 col-sm-12 content-table none-padding">
                <div class="row ml-0 mr-0">
                    <div class="col-sm-12 none-padding-right pl-0">
                        <table id="simple-table" class="table table-bordered table-hover" style="margin-bottom: 0px;">
                            <thead>
                                <tr>
                                    <th class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" ng-model="isCheckAllVatTuKhongQuaKhoView" class="ace" ng-change="changeCheckAllVatTuKhongQuaKhoView()" />
                                            <span class="lbl"></span>
                                        </label>
                                    </th>
                                    <th class="center">STT</th>
                                    <th class="center">Chi tiết</th>
                                    <th class="center">Số phiếu</th>
                                    <th class="center">Số phiếu tài chính</th>
                                    <th class="center">Nơi giao</th>
                                    <th class="center">Nơi nhận</th>
                                    <th class="center">Ngày thực nhập</th>
                                    <th class="center">Lý do từ chối duyệt</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr ng-repeat="item in listDieuChuyenVatTuKhongQuaKho" ng-click="viewDetailVatTu(item, 2, $index,'true')" ng-class="{activerow:$index==selectedRowVatTuKhongQuaKho}">
                                    <td class="center">
                                        <label class="pos-rel">
                                            <input type="checkbox" class="ace" ng-model="item.CHECKED" />
                                            <span class="lbl"></span>
                                        </label>
                                    </td>
                                    <td>{{$index + 1}}</td>
                                    <td>
                                        <button ng-click="updateDieuChuyenVTKhongQuaKhoModal(item)" style="background-color:transparent">
                                            <img src="~/App_Assets/images/icon_edit_green.svg" alt="">
                                        </button>
                                    </td>
                                    <td>{{item.SO_PHIEU}}</td>
                                    <td>{{item.SO_PHIEU_H55}}</td>
                                    <td>{{item.SO_HD_GUI}}</td>
                                    <td>{{item.SO_HD_DEN}}</td>
                                    <td>{{item.NGAY_GIAO}}</td>
                                    <td>{{item.LY_DO_TU_CHOI_DUYET}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row ml-0 mr-0">
                    <div class="col-sm-12 pl-0 pr-0 pages-switch">
                        <ul class="pagination pagination-sm m-0 float-right" uib-pagination total-items="modelDieuChuyenVatTuKhongQuaKho.totalItems" items-per-page="modelDieuChuyenVatTuKhongQuaKho.pageSize" ng-model="modelDieuChuyenVatTuKhongQuaKho.pageIndex" ng-change="pageDieuChuyenVTKhongQuaKhoChanged()" max-size="modelDieuChuyenVatTuKhongQuaKho.maxSize" class="pagination-sm" boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>