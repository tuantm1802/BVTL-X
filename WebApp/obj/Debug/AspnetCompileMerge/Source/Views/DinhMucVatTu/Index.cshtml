@{
    ViewBag.Title = "Định mức vật tư";
}

<style type="text/css">
    .tccbcsParentcolor {
        background-color: #ffe2e2 !important;
        color: #900 !important;
    }
</style>

<div ng-controller="DinhMucVatTuController" style="margin-top: 15px;">
    <main>
        <div class="container-fluid d-flex cons-ac-system">
            <div class="action-system pd-two ui-widget-content" id="resizable">
                <button id="btn-changes-s-nav">
                    <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
                </button>
                <div class="fill-box">
                    <h3 class="title-fill">
                        Định mức
                    </h3>
                </div>
                <div class="container">
                    <div class="main-action pt-3">
                        <div class="row">
                            <div class="col-6 col-sm-6 col-md-6 col-lg-6">
                                Năm
                            </div>
                            <div class="col-6 col-sm-6 col-md-6 col-lg-6">
                                <select ng-model="NamBanHanh" ng-change="ChangeNamBanHanh()" class="form-control">
                                    <option value="{{item.Value}}" ng-repeat="item in ListYear">{{item.Name}}</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 form-search w-100" ng-show="RoleBtnSearch">
                                <input type="text" placeholder="Tìm kiếm" ng-model="SearchTreeSanPhamText">
                                <button ng-click="ChangeSanPham()">
                                    <img src="~/App_Assets/images/search_icon.svg" alt="">
                                </button>
                            </div>
                        </div>

                    </div>
                    <div class="function-box">
                        <div class="accordion js-accordion">
                            <div class="ztreeRoleBackground left" style="width:100%;">
                                <ul id="treeRole" class="ztree"></ul>
                            </div>
                        </div>
                    </div>
                    <div class="main-action pt-3">
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                <div class="main-action d-flex align-items-center flex-wrap">
                                    <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnDinhMucByNam" ng-click="CoppyDinhMucTheoNamTruoc()" title="Định mức theo năm trước">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Định mức theo năm trước</span>
                                    </button>
                                    <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnCreateNDM" ng-click="ShowPopupThemNhomDM()" title="Thêm nhóm ĐM">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm nhóm ĐM</span>
                                    </button>
                                    <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnAddSP" ng-click="AddNewDinhMuc()" title="Thêm sản phẩm">
                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                        <span>Thêm sản phẩm</span>
                                    </button>
                                    <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnDelete" ng-click="deleteDinhMuc()" title="Xoá">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        <span>Xóa</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-system no-border pb-0" ng-show="ShowContent">
                <div class="fill-box-bread-crumb">
                    <h3 class="bread_crumb">
                        <a href="/"> <i class="fa fa-home" aria-hidden="true"></i>Trang chủ </a>  /  Tiêu chuẩn - định mức  /  Định mức vật tư
                    </h3>
                </div>
                <div class="nav-box less-pd" style="margin-top:0px; padding-bottom:0px;">
                    <div class="container-fluid">
                        <div class="form-infor pt-3 pb-3">
                            <div class="row">
                                <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                    <div class="row no-gutters">
                                        <div class="col-12 col-md-6 col-lg-6 align-self-end">
                                            <div class="main-action d-flex align-items-center flex-wrap" style="padding-top: 21px;">
                                                <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnCreate" ng-click="AddVatTu()" title="Thêm mới">
                                                    <i class="fa fa-plus" aria-hidden="true"></i>Thêm mới
                                                </button>
                                                <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnSave" ng-click="SaveVatTu()" ng-disabled="disabledSaveChange" title="Lưu">
                                                    <i class="fa fa-floppy-o" aria-hidden="true"></i>Lưu
                                                </button>
                                                <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnRollback" ng-click="RollbackVatTu()" ng-disabled="disabledRollbackData" title="Hủy thay đổi">
                                                    <i class="fa fa-reply" aria-hidden="true"></i>Hủy thay đổi
                                                </button>
                                                <button class="btn-action-m ct-fix-lap" ng-show="RoleBtnDeleteVT" ng-click="DeleteVatTu()" title="Xoá">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>Xoá
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-6">
                                            <div class="main-action pt-3">
                                                <div class="form-search w-100" ng-show="RoleBtnSearch">
                                                    <input type="text" placeholder="Tìm kiếm" ng-model="SearchVatTuText">
                                                    <button ng-click="SearchVatTu()">
                                                        <img src="~/App_Assets/images/search_icon.svg" alt="">
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                                    <legend class="scheduler-border" style="        width: 265px;"><label class="bold-label"><b>Danh sách vật tư chính</b></label></legend>
                                    <div class="content-table">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th style="width: 8%;" class="text-center"><input type="checkbox" class="form-control inputcheckBox" ng-model="VTChinh_CheckAll" ng-change="VTChinh_ChangeCheckAll()" /> </th>
                                                    <th style="        width: 8%;" class="text-center">STT</th>
                                                    <th class="text-center">Vật tư</th>
                                                    <th style="width: 15%;" class="text-center">Đơn vị tính</th>
                                                    <th style="width: 15%;" class="text-center">Số lượng</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in SanPham_VatTuChinhs" ng-class="{activerow:$index==selectedRow, tccbcsParentcolor:item.IS_KE_THUA=='Y'}">
                                                    <td class="center"><input type="checkbox" class="form-control inputcheckBox" ng-model="item.SELECT" ng-change="VTChinh_CheckVatTu()" /> </td>
                                                    <td class="text-center" ng-class="">{{$index +1}}</td>
                                                    <td class="text-left">{{item.TEN_VAT_TU}}</td>
                                                    <td class="text-left">{{item.TEN_DVT}} </td>
                                                    <td class="text-right"><span ng-show="item.IS_KE_THUA=='Y'">{{item.SO_LUONG}}</span><input min="0" ng-show="item.IS_KE_THUA=='N'" class="form-control" ng-change="ChangeSoLuong()" ng-model="item.SO_LUONG" type="number" step="0.01" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12">
                                <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;height:475px;">
                                    <legend class="scheduler-border" style="        width: 265px;"><label class="bold-label"><b>Danh sách vật tư phụ</b></label></legend>
                                    <div class="content-table">
                                        <table class="table-responsive table-hover result-point">
                                            <thead class="point-table-head">
                                                <tr>
                                                    <th style="        width: 8%;" class="text-center"><input type="checkbox" class="form-control inputcheckBox" ng-model="VTPhu_CheckAll" ng-change="VTPhu_ChangeCheckAll()" /> </th>
                                                    <th style="        width: 8%;" class="text-center">STT</th>
                                                    <th class="text-center">Vật tư</th>
                                                    <th style="width: 15%;" class="text-center">Đơn vị tính</th>
                                                    <th style="width: 15%;" class="text-center">Số lượng</th>
                                                </tr>
                                            </thead>
                                            <tbody class="">
                                                <tr ng-repeat="item in SanPham_VatTuPhus" ng-class="{activerow:$index==selectedRow, tccbcsParentcolor:item.IS_KE_THUA=='Y'}">
                                                    <td class="center"><input type="checkbox" class="form-control inputcheckBox" ng-model="item.SELECT" ng-change="VTPhu_CheckVatTu()" /> </td>
                                                    <td class="text-center">{{$index +1}}</td>
                                                    <td class="text-left">{{item.TEN_VAT_TU}}</td>
                                                    <td class="text-left">{{item.TEN_DVT}} </td>
                                                    <td class="text-right"><span ng-show="item.IS_KE_THUA=='Y'">{{item.SO_LUONG}}</span> <input min="0" ng-show="item.IS_KE_THUA=='N'" class="form-control" ng-change="ChangeSoLuong()" ng-model="item.SO_LUONG" type="number" step="0.01" /> </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    @Html.Partial("~/Views/DinhMucVatTu/_addSPDinhMuc.cshtml")
    @Html.Partial("~/Views/DinhMucVatTu/_addNhomDinhMuc.cshtml")
    @Html.Partial("~/Views/DinhMucVatTu/_add.cshtml")
    @Html.Partial("~/Views/DinhMucVatTu/_coppyDinhMucNamTruoc.cshtml")
</div>

@section Scripts{
    <script src="~/app/Controller/HopDong/DinhMucVatTuController.js"></script>
    <script src="~/Content/js/jquery.ztree.core.js"></script>
    <script src="~/Content/js/jquery.ztree.excheck.js"></script>
}
