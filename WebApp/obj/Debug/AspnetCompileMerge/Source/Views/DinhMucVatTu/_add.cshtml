<div class="modal fade" id="AddVatTu">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable b-width_1">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Danh sách vật tư</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <img src="~/App_Assets/images/close.svg" alt="">
                </button>
            </div>
            <!-- Modal body -->
            <div class="modal-body">
                <form class=" col-md-12" id="formSubmit">
                    <div class="row">
                        <div class="col-sm-6" style="padding:0px;padding-right:10px;">
                            <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                                <legend class="scheduler-border" style="width: 225px;"><label class="bold-label">Danh sách vật tư</label></legend>
                                <div class="form-infor has-border p-3">
                                    <div class="row no-gutters">
                                        <div class="col-12 col-md-6">
                                            <label for="">Loại vật tư: </label>
                                            <select class="form-control" style="width:100%;" ng-model="AddVatTu_LoaiVT" ng-change="AddVatTu_LoaiVatTu()">
                                                <option value="Y">Vật tư chính</option>
                                                <option value="N">Vật tư phụ</option>
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label style="color:white;" for="">Tìm kiếm: </label>
                                            <div class="main-action">
                                                <div class="form-search w-100">
                                                    <input type="text" placeholder="Tìm kiếm" ng-model="AddVatTu_Keyword">
                                                    <button>
                                                        <img src="~/App_Assets/images/search_icon.svg" ng-click="AddVatTu_SearchVatTu()" alt="">
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="content-table" style="height:400px; overflow-y:scroll;">
                                    <table class="table-responsive table-hover result-point">
                                        <thead class="point-table-head">
                                            <tr>
                                                <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AddVatTu_CheckAllTP" ng-change="AddVatTu_ChangeCheckAllTP()" /> </th>
                                                <th>Tên vật tư</th>
                                            </tr>
                                        </thead>
                                        <tbody class="">
                                            <tr ng-repeat="item in AddVatTu_VatTus">
                                                <td class="center"><input type="checkbox" ng-change="AddVatTu_CheckedVatTu($index)" class="form-control" ng-model="item.SELECT" /> </td>
                                                <td>{{item.TEN_SP}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-sm-6" style="padding:0px;">
                            <div class="row">
                                <div class="col-sm-12">
                                    <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                                        <legend class="scheduler-border" style="width: 200px;"><label class="bold-label">Vật tư chính đã chọn</label></legend>
                                        <div class="content-table" style="height:220px; overflow-y:scroll;">
                                            <table class="table-responsive table-hover result-point">
                                                <thead class="point-table-head">
                                                    <tr>
                                                        <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AddVatTu_CheckAllTPChinhChon" ng-change="AddVatTu_ChangeCheckAllTPChon(1)" /> </th>
                                                        <th>Tên vật tư</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="">
                                                    <tr ng-repeat="item in AddVatTu_VatTuChinhChons">
                                                        <td class="center"><input type="checkbox" ng-change="AddVatTu_CheckedVatTuChon($index,1)" class="form-control" ng-model="item.SELECT" /> </td>
                                                        <td>{{item.TEN_SP}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12">
                                    <fieldset class="scheduler-border" style="width:100%;padding-left: 5px !important; padding-right: 5px !important;">
                                        <legend class="scheduler-border" style="width: 200px;"><label class="bold-label">Vật tư phụ đã chọn</label></legend>
                                        <div class="content-table" style="height:220px; overflow-y:scroll;">
                                            <table class="table-responsive table-hover result-point">
                                                <thead class="point-table-head">
                                                    <tr>
                                                        <th class="center" style="width: 8%;"><input type="checkbox" class="form-control" ng-model="AddVatTu_CheckAllTPPhuChon" ng-change="AddVatTu_ChangeCheckAllTPChon(0)" /> </th>
                                                        <th>Tên vật tư</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="">
                                                    <tr ng-repeat="item in AddVatTu_VatTuPhuChons">
                                                        <td class="center"><input type="checkbox" ng-change="AddVatTu_CheckedVatTuChon($index,0)" class="form-control" ng-model="item.SELECT" /> </td>
                                                        <td>{{item.TEN_SP}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
            <!-- Modal footer -->
            <div class="modal-footer d-flex justify-content-between">
                <h5 class="day-make"></h5>
                <div class="main-action d-flex flex-wrap">
                    <button class="btn-action-m cl-3" ng-click="AddVatTu_ThemVT()">
                        <img src="~/App_Assets/images/icon_save.svg" alt="">
                        <span>Lưu</span>
                    </button>
                    <button class="btn-action-m cl-3" data-dismiss="modal" ng-click="cancel()">
                        <img src="~/App_Assets/images/ic_close_r_light.svg" alt="">
                        <span>Hủy</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

