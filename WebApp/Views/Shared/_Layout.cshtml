    <script>
        window.addEventListener('message', handleMessage, false);
        function handleMessage(event) {
            var _data = event.data;
            if (_data.totalMessages !== undefined) {
                var $mesbadge = $('.chat-box-icon-top .badge');
                if (_data.totalMessages > 0)
                    $mesbadge.show();
                else
                    $mesbadge.hide();
                $mesbadge.text(_data.totalMessages);
            }
            if (_data.objectNotification !== undefined) {
                //alert(_data.objectNotification);
                angular.element(document.getElementById('thongbao-container')).scope().LoadThongBaoHeader();
            }
        }
    </script>
