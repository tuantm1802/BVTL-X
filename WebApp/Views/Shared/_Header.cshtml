@using Common
@{
    var userSession = (Model.ModelExtend.Base.UserLogin)HttpContext.Current.Session["USER_SESSION"];
    string avatar = string.Empty;
    string userId = string.Empty;
    if (userSession != null && !string.IsNullOrEmpty(userSession.Avartar))
    {
        avatar = userSession.Avartar;
        userId = userSession.UserID == 0 ? "0" : userSession.UserID.ToString();
    }

    var notifications = Session["Notifications"] as List<Model.ModelExtend.User.NotificationModel>;
}

<!-- Topbar -->
<nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

    <!-- Sidebar Toggle (Topbar) -->
    <form class="form-inline">
        <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
            <i class="fa fa-bars"></i>
        </button>
    </form>

    <!-- Topbar Search -->
    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search">
        @*<div class="input-group">
                <input type="text" class="form-control bg-light border-0 small" placeholder="Search for..."
                       aria-label="Search" aria-describedby="basic-addon2">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="button">
                        <i class="fas fa-search fa-sm"></i>
                    </button>
                </div>
            </div>*@
    </form>

    <!-- Topbar Navbar -->
    <ul class="navbar-nav ml-auto">

        <!-- Nav Item - Search Dropdown (Visible Only XS) -->
        <li class="nav-item dropdown no-arrow d-sm-none">
            <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button"
               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fas fa-search fa-fw"></i>
            </a>
            <!-- Dropdown - Messages -->
            <div class="dropdown-menu dropdown-menu-right p-3 shadow animated--grow-in"
                 aria-labelledby="searchDropdown">
                <form class="form-inline mr-auto w-100 navbar-search">
                    <div class="input-group">
                        <input type="text" class="form-control bg-light border-0 small"
                               placeholder="Search for..." aria-label="Search"
                               aria-describedby="basic-addon2">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button">
                                <i class="fas fa-search fa-sm"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </li>

        <!-- Nav Item - Alerts -->
        <li class="nav-item dropdown no-arrow mx-1">
            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button"
               data-bs-toggle="dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fas fa-bell fa-fw"></i>
                <span class="badge bg-danger text-white badge-counter" style="position: absolute; transform: scale(.7); transform-origin: top right; right: .25rem; margin-top: -.25rem;">@(notifications != null ? notifications.Count : 0)</span>
            </a>
            <div class="dropdown-list dropdown-menu dropdown-menu-end dropdown-menu-right shadow animated--grow-in"
                 aria-labelledby="alertsDropdown">
                <h6 class="dropdown-header bg-primary text-white py-2">
                    <i class="fas fa-bell me-1"></i> Thông báo hệ thống
                </h6>
                @if (notifications != null && notifications.Any())
                {
                    foreach (var item in notifications)
                    {
                        <a class="dropdown-item d-flex align-items-center py-2" href="#">
                            <div class="mr-3 me-2">
                                <div class="icon-circle bg-warning text-white p-2 rounded-circle">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                            </div>
                            <div>
                                <span class="font-weight-bold small">@item.NoiDung</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="dropdown-item text-center small text-muted py-3">Không có thông báo mới</div>
                }

                <a class="dropdown-item text-center small text-gray-500 py-2 border-top" href="/Notification/Index">Xem tất cả thông báo</a>
            </div>
        </li>

        <div class="topbar-divider d-none d-sm-block mx-2" style="width: 0; border-right: 1px solid #e3e6f0; height: calc(4.375rem - 2rem); margin: auto 1rem;"></div>

        <!-- Nav Item - User Information -->
        @if (userSession != null)
        {
            <li class="nav-item dropdown no-arrow">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button"
                   data-bs-toggle="dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="cursor: pointer;">
                    <span class="mr-2 me-2 d-none d-lg-inline text-gray-600 font-weight-semibold small">@userSession.Name</span>
                    @if (string.IsNullOrEmpty(avatar))
                    {
                        <div class="avatar-circle bg-light text-primary font-weight-bold d-flex align-items-center justify-content-center rounded-circle shadow-sm" 
                             style="width: 36px; height: 36px; border: 1px solid #e3e6f0;">
                            <span>@(string.IsNullOrEmpty(userSession.UserName) ? "US" : (userSession.UserName.Length >= 2 ? userSession.UserName.Substring(0, 2).ToUpper() : userSession.UserName.ToUpper()))</span>
                        </div>
                    }
                    else
                    {
                        <img class="img-profile rounded-circle shadow-sm" src="@avatar" style="width: 36px; height: 36px; object-fit: cover; border: 1px solid #e3e6f0;">
                    }
                </a>
                <!-- Dropdown - User Information -->
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-right shadow border-0 animated--grow-in py-2"
                     aria-labelledby="userDropdown" style="min-width: 220px; z-index: 1050;">
                    <div class="px-3 py-2 border-bottom bg-light">
                        <div class="font-weight-bold text-gray-900">@userSession.Name</div>
                        <div class="small text-muted font-monospace">@userSession.UserName</div>
                    </div>
                    <a class="dropdown-item py-2" href="/User/GetProfile?Id=@userSession.UserID">
                        <i class="fas fa-user-circle fa-sm fa-fw mr-2 me-2 text-primary"></i>
                        <span>Thông tin tài khoản (Profile)</span>
                    </a>
                    <a class="dropdown-item py-2" href="/User/ChangePassword?Id=@userSession.UserID">
                        <i class="fas fa-key fa-sm fa-fw mr-2 me-2 text-warning"></i>
                        <span>Đổi mật khẩu</span>
                    </a>
                    <div class="dropdown-divider my-1"></div>
                    <a class="dropdown-item py-2 text-danger font-weight-bold" href="/Login/Logout">
                        <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 me-2 text-danger"></i>
                        <span>Đăng xuất</span>
                    </a>
                </div>
            </li>
        }

    </ul>

</nav>
<!-- End of Topbar -->

@section scripts{
} 