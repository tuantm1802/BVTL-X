@model System.Collections.Generic.List<Model.ModelExtend.KetQuaACEPageModel>
@{
    ViewBag.Title = "Báo cáo Thang đo ACE - Tổn thương Tuổi thơ";
    var totalRecords = Model != null ? Model.Count : 0;
    var nguyCoCao = Model != null ? Model.Count(x => x.tongdiem_ace >= 4) : 0;
    var nguyCoTB = Model != null ? Model.Count(x => x.tongdiem_ace >= 1 && x.tongdiem_ace < 4) : 0;
    var khongTonThuong = Model != null ? Model.Count(x => x.tongdiem_ace == 0) : 0;
}

<div class="container-fluid py-3" x-data="alpineKetQuaACE()">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-child text-primary mr-2"></i> Báo cáo Thang đo Sang chấn Tuổi thơ (ACE)
            </h1>
            <p class="text-muted small mb-0">Theo dõi tổng điểm ACE và phân loại mức độ tổn thương tâm lý thời thơ ấu của khách hàng theo nhóm TTDL.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <button type="button" class="btn btn-success shadow-sm px-3 py-2 font-weight-bold" x-on:click="exportExcel()" style="border-radius: 8px;">
                <i class="fas fa-file-excel mr-1"></i> Xuất dữ liệu Excel
            </button>
        </div>
    </div>

    <!-- Statistics Overview Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #4e73df !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng lượt đánh giá ACE</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@totalRecords</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(78, 115, 223, 0.1);">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #e74a3b !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Nguy cơ Cao (Điểm ≥ 4)</div>
                            <div class="h4 mb-0 font-weight-bold text-danger">@nguyCoCao</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(231, 74, 59, 0.1);">
                                <i class="fas fa-shield-virus fa-2x text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #f6c23e !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Có tổn thương (1 - 3 điểm)</div>
                            <div class="h4 mb-0 font-weight-bold text-warning">@nguyCoTB</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(246, 194, 62, 0.15);">
                                <i class="fas fa-exclamation-circle fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #1cc88a !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Không tổn thương (0 điểm)</div>
                            <div class="h4 mb-0 font-weight-bold text-success">@khongTonThuong</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(28, 200, 138, 0.1);">
                                <i class="fas fa-smile fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between flex-wrap">
            <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                <i class="fas fa-table mr-2"></i> Chi tiết Điểm & Kết quả Đánh giá Thang đo ACE
            </h6>
            <span class="badge badge-light border text-muted">Thang điểm 0 - 10</span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTableKetQuaACE" width="100%" cellspacing="0">
                    <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                        <tr>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Dự án</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tỉnh / Thành</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Record ID</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mã & Tên nhóm</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mã KH</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Ngày số liệu</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tổng điểm ACE</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Phân loại Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            TimeZoneInfo cstZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");

                            foreach (var item in Model)
                            {
                                DateTime dNgayTiepCan = TimeZoneInfo.ConvertTimeFromUtc(item.ngaysl, cstZone);

                                <tr>
                                    <td><span class="badge badge-light border font-weight-bold text-dark">@(item.maduan ?? "BVTL")</span></td>
                                    <td><i class="fas fa-map-marker-alt text-danger mr-1 small"></i>@item.CityName</td>
                                    <td><span class="badge badge-light font-weight-bold text-primary">#@item.record_id</span></td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.tennhom_tbh</div>
                                        <small class="text-muted">(@item.manhom_tbh)</small>
                                    </td>
                                    <td><span class="badge badge-light font-weight-bold text-secondary">@item.makh</span></td>
                                    <td class="text-center font-weight-bold text-gray-700">@String.Format("{0:dd/MM/yyyy}", dNgayTiepCan)</td>
                                    <td class="text-center font-weight-bold" style="font-size: 1rem;">
                                        @if (item.tongdiem_ace >= 4)
                                        {
                                            <span class="text-danger">@item.tongdiem_ace</span>
                                        }
                                        else if (item.tongdiem_ace >= 1)
                                        {
                                            <span class="text-warning">@item.tongdiem_ace</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.tongdiem_ace >= 4)
                                        {
                                            <span class="badge badge-danger px-3 py-2 font-weight-bold shadow-xs">
                                                <i class="fas fa-radiation mr-1"></i> Nguy cơ cao
                                            </span>
                                        }
                                        else if (item.tongdiem_ace >= 1)
                                        {
                                            <span class="badge badge-warning px-3 py-2 font-weight-bold shadow-xs text-dark">
                                                <i class="fas fa-exclamation-triangle mr-1"></i> Có tổn thương
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success px-3 py-2 font-weight-bold shadow-xs">
                                                <i class="fas fa-check-circle mr-1"></i> Bình thường
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineKetQuaACE.js?v=@DateTime.Now.Ticks"></script>
}
