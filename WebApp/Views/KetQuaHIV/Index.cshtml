@{
    ViewBag.Title = "Kết quả HIV";
}

<div class="container-fluid" ng-controller="KetQuaHIVController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Kết quả HIV</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <div class="row">
                    <div class="col-sm-1">
                        <label>Từ khóa</label>
                    </div>
                    <div class="col-sm-09">
                        <input type="text" class="form-control" ng-model="modelSearch.KeyWord" />
                    </div>
                    <div class="col-sm-2">
                        <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                        <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-primary" ng-click="ExportExcel()">
                            <i class="fas fa-pencil-alt"></i> Xuất Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableKetQuaHIV" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th  style="width: auto;">Tỉnh </th>
                            <th  style="width:9%;">Mã nhóm TBH</th>
                            <th  style="width:auto;">Tên nhóm TBH </th>
                            <th  style="width:9%;">Mã KH</th>
                            <th  style="width:auto;">Họ tên KH </th>
                            <th  style="width:9%;">Ngày xét nghiệm</th>
                            <th style="width:9%;">Kết quả</th>
                            <th style="width:9%;">Đang điều trị HIV</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/KetQuaHIVController.js"></script>
}
