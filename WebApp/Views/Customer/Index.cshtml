<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>

<div class="container-fluid" ng-controller="CustomerController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Khách hàng</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                @*<div class="row">
                        <div class="col-sm-1">
                            <label>Từ khóa</label>
                        </div>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" ng-model="modelSearch.KeyWord" />
                        </div>
                        <div class="col-sm-2">
                            <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                                <i class="fas fa-search"></i> Tìm kiếm
                            </button>
                            <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-primary" ng-click="ExportExcel()">
                                <i class="fas fa-pencil-alt"></i> Xuất Excel
                            </button>
                        </div>
                    </div>*@
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableCustomer" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;">STT </th>
                            <th style="width:9%;">Mã KH</th>
                            <th style="width:auto;">Họ tên KH </th>
                            <th style="width:9%;">Giới tính </th>
                            <th style="width:9%;">Năm sinh </th>
                            <th style="width:9%;">Đối tượng</th>
                            <th style="width:9%;">Ngày tiếp cận</th>
                            <th style="width:9%;">Số điện thoại</th>
                            <th style="width:9%;">Tỉnh</th>
                            <th style="width:9%;">Địa chỉ</th>
                        </tr>
                    </thead>
                    @foreach (var item in Model)
                    {
                        var stt = 1;
                <tr>
                    <td class="text-center">@stt</td>
                    <td class="text-left">@item.makh</td>
                    <td class="text-left">@item.hoten</td>
                    <td class="text-left">@item.GioiTinhText</td>
                    <td class="text-left">@item.namsinh</td>
                    <td class="text-left">@item.LoaiDoiTuong</td>
                    <td class="text-center">@(item.ngaytiepcan != null ? item.ngaytiepcan.Value.ToString("yyyy-MM-dd") : string.Empty )</td>
                    @*<td class="text-center">@item.ngaytiepcantext</td>*@
                    <td class="text-left">@item.sodienthoai</td>
                    <td class="text-left">@item.CityName</td>
                    <td class="text-left">@item.diachi</td>
                </tr>
                        stt++;
                    }
                    @*<tbody>
                            <tr ng-repeat="item in ListCustomer1">
                                <td class="text-left">{{$Index +1}}</td>
                                <td class="text-left">{{item.makh}}</td>
                                <td class="text-left">{{item.hoten}}</td>
                                <td class="text-left">{{item.GioiTinhText}}</td>
                                <td class="text-left">{{item.namsinh}}</td>
                                <td class="text-left">{{item.LoaiDoiTuong}}</td>
                                <td class="text-left">{{item.ngaytiepcantext}}</td>
                                <td class="text-left">{{item.sodienthoai}}</td>
                                <td class="text-left">{{item.CityName}}</td>
                                <td class="text-left">{{item.diachi}}</td>
                            </tr>
                        </tbody>*@
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/CustomerController.js"></script>
}
