@{
    ViewBag.Title = "Nhóm thu thập dữ liệu";
}

<div class="container-fluid" ng-controller="TestGroupController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Nhóm thu thập dữ liệu</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <button type="button" class="btn btn-primary" ng-show="RoleBtnCreate == true" ng-click="add()">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
                <button type="button" class="btn btn-primary" ng-show="RoleBtnSearch == true" ng-click="Refesh()">
                    <i class="fas fa-sync-alt"></i> Làm mới
                </button>
                <button type="button" class="btn btn-primary" ng-show="RoleBtnUpdate == true" ng-click="edit()">
                    <i class="fas fa-pencil-alt"></i> Cập nhật
                </button>
                <button type="button" class="btn btn-danger" ng-show="RoleBtnDelete == true" ng-click="delete()">
                    <i class="fas fa-times"></i> Xóa
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableNhomTTDL" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:10%;">STT </th>
                            <th style="width:auto;">Mã </th>
                            <th style="width: auto;">Tên nhóm </th>
                            <th style="width: auto;">Trạng thái </th>
                            @*<th style="width:8%;">Thao tác</th>*@
                        </tr>
                    </thead>
                    @*<tbody>
                                            <tr ng-repeat="item in ListData" ng-class="{activerow:$index==selectedRow}">
                                            <td class="text-center">{{$index + 1}}</td>
                                            <td>{{item.Code}}</td>
                                            <td>{{item.Name}}</td>
                                            <td><input type="checkbox" ng-model="item.IsActive" disabled /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-primary" ng-click="edit(item.Id)" ng-show="RoleBtnUpdate == true" title="Cập nhật">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" ng-click="delete(item.Id, item.Name)" ng-show="RoleBtnDelete == true" title="Xóa">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </td>
                                        </tr>
                        </tbody>*@
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/app/Controller/TestGroupController.js"></script>
}
