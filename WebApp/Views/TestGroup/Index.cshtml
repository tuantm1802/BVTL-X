@{
    ViewBag.Title = "Nhóm người dùng";
}

<div class="container-fluid py-3 ng-scope" x-data="alpineTestGroup()" ng-controller="TestGroupController">

    <!-- Header Title Bar & Quick Stats Cards -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-layer-group text-primary mr-2"></i> Nhóm người dùng
            </h1>
            <p class="text-muted small mb-0">Quản lý danh sách các nhóm người dùng / nhóm thu thập dữ liệu và địa bàn phụ trách trên toàn hệ thống.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <button type="button" class="btn btn-primary btn-lg shadow-sm px-4 font-weight-bold mr-2" x-on:click="add()" x-show="RoleBtnCreate" style="border-radius: 8px;">
                <i class="fas fa-plus mr-2"></i> Thêm nhóm mới
            </button>
            <button type="button" class="btn btn-white btn-lg shadow-sm px-3 font-weight-bold border" x-on:click="search()" style="border-radius: 8px; background: #fff;">
                <i class="fas fa-sync-alt text-primary"></i>
            </button>
        </div>
    </div>

    <!-- Stats Overview Widgets -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #4e73df !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số Nhóm TTDL</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800" x-text="stats.totalGroups">0</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 bg-light-primary rounded-circle" style="background: rgba(78, 115, 223, 0.1);">
                                <i class="fas fa-users-cog fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #36b9cc !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Tỉnh / Thành phố phụ trách</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800" x-text="stats.totalCities">0</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(54, 185, 204, 0.1);">
                                <i class="fas fa-map-marked-alt fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #1cc88a !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Trạng thái hệ thống</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800 d-flex align-items-center">
                                <span class="badge badge-success px-2 py-1 mr-2"><i class="fas fa-check-circle mr-1"></i> Hoạt động ổn định</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(28, 200, 138, 0.1);">
                                <i class="fas fa-shield-alt fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Data Table Container Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
        <div class="card-header bg-white py-3 border-0">
            <div class="row align-items-center">
                <!-- Search Box -->
                <div class="col-lg-5 col-md-6 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px;"><i class="fas fa-search text-gray-400"></i></span>
                        </div>
                        <input type="text" class="form-control bg-light border-left-0" placeholder="Tìm theo Mã nhóm, Tên nhóm, Tỉnh thành..." x-model="modelSearch.KeyWord" x-on:keyup.enter="search()" style="border-radius: 0 8px 8px 0;">
                    </div>
                </div>

                <!-- City Filter -->
                <div class="col-lg-4 col-md-4 mb-2 mb-md-0">
                    <select class="form-control bg-light" x-model="modelSearch.CityCode" x-on:change="search()" style="border-radius: 8px;">
                        <option value="">-- Tất cả Tỉnh thành --</option>
                        <template x-for="c in ListCity" :key="c.Code">
                            <option :value="c.Code" x-text="c.Name"></option>
                        </template>
                    </select>
                </div>

                <!-- Action Controls -->
                <div class="col-lg-3 col-md-2 text-right">
                    <button type="button" class="btn btn-light font-weight-bold text-secondary border px-3" x-on:click="resetSearch()" style="border-radius: 8px;">
                        <i class="fas fa-undo mr-1"></i> Đặt lại
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" width="100%">
                    <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                        <tr>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="width: 5%; font-size: 0.75rem;">#</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="width: 20%; font-size: 0.75rem;">Mã nhóm</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="width: 45%; font-size: 0.75rem;">Tên nhóm thu thập</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="width: 20%; font-size: 0.75rem;">Tỉnh thành</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="width: 10%; font-size: 0.75rem;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(item, index) in ListData" :key="item.manhom_tbh || index">
                            <tr style="cursor: pointer;" :class="{'table-active bg-light-primary': selectedGroupId === item.manhom_tbh}" x-on:click="selectRow(item.manhom_tbh)">
                                <td class="text-center font-weight-bold text-gray-600 align-middle" x-text="(modelSearch.currentPage - 1) * modelSearch.pageSize + index + 1"></td>
                                
                                <td class="align-middle">
                                    <span class="badge badge-primary px-3 py-2 font-weight-bold shadow-xs" style="border-radius: 6px; font-size: 0.85rem;" x-text="item.manhom_tbh"></span>
                                </td>

                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle mr-3 d-flex align-items-center justify-content-center text-white font-weight-bold bg-primary" style="width: 38px; height: 38px; border-radius: 50%; font-size: 0.85rem;">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div>
                                            <div class="font-weight-bold text-gray-800" x-text="item.tennhom_tbh"></div>
                                            <small class="text-muted">Nhóm thu thập dữ liệu</small>
                                        </div>
                                    </div>
                                </td>

                                <td class="align-middle">
                                    <span class="text-dark font-weight-bold d-flex align-items-center">
                                        <i class="fas fa-map-marker-alt text-danger mr-2"></i>
                                        <span x-text="item.CityName || 'Chưa phân công'"></span>
                                    </span>
                                </td>

                                <td class="text-center align-middle">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary mr-1" x-on:click.stop="edit(item.manhom_tbh)" title="Cập nhật" style="border-radius: 6px;">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" x-on:click.stop="deleteGroup(item.manhom_tbh, item.tennhom_tbh)" title="Xóa" style="border-radius: 6px;">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </template>

                        <template x-if="!ListData || ListData.length === 0">
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="fas fa-folder-open fa-3x text-gray-300 mb-3"></i>
                                        <p class="text-gray-500 font-weight-bold mb-0">Không tìm thấy nhóm thu thập dữ liệu nào phù hợp.</p>
                                        <small class="text-muted">Vui lòng thử tìm kiếm lại với từ khóa khác.</small>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer & Responsive Pagination Bar -->
        <div class="card-footer bg-white py-3 border-top" style="border-color: #e3e6f0 !important;">
            <div class="row align-items-center">
                <div class="col-md-5 mb-2 mb-md-0 text-center text-md-left">
                    <span class="text-muted small">
                        Hiển thị <b class="text-dark" x-text="ListData.length > 0 ? (modelSearch.currentPage - 1) * modelSearch.pageSize + 1 : 0"></b> đến 
                        <b class="text-dark" x-text="Math.min(modelSearch.currentPage * modelSearch.pageSize, modelSearch.totalItems)"></b> trong tổng số 
                        <b class="text-primary" x-text="modelSearch.totalItems"></b> nhóm TTDL
                    </span>
                    <span class="ml-3 text-muted small">
                        Hiển thị
                        <select class="custom-select custom-select-sm d-inline-block w-auto border bg-light ml-1" x-model="modelSearch.pageSize" x-on:change="changePageSize($event.target.value)">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        bản ghi
                    </span>
                </div>

                <div class="col-md-7">
                    <ul class="pagination pagination-sm justify-content-center justify-content-md-end mb-0">
                        <li class="page-item" :class="{'disabled': modelSearch.currentPage === 1}">
                            <button class="page-item link-btn page-link rounded-left" x-on:click="LoadPage(modelSearch.currentPage - 1)"><i class="fas fa-chevron-left"></i></button>
                        </li>

                        <template x-for="p in pages" :key="p">
                            <li class="page-item" :class="{'active': p === modelSearch.currentPage}">
                                <button class="page-item link-btn page-link" x-on:click="LoadPage(p)" x-text="p"></button>
                            </li>
                        </template>

                        <li class="page-item" :class="{'disabled': modelSearch.currentPage >= totalPages}">
                            <button class="page-item link-btn page-link rounded-right" x-on:click="LoadPage(modelSearch.currentPage + 1)"><i class="fas fa-chevron-right"></i></button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineTestGroupController.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/app/Controller/TestGroupController.js?v=@DateTime.Now.Ticks"></script>
}
