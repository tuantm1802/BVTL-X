<style>
    label.error, span.error, .invalid-feedback {
        display: block !important;
        width: 100% !important;
        margin-top: 0.35rem !important;
        font-size: 0.825rem !important;
        font-weight: 600 !important;
        color: #e74a3b !important;
        position: relative !important;
        float: none !important;
        clear: both !important;
        background: transparent !important;
        border: none !important;
    }
    .form-control:focus {
        border-color: #4e73df !important;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25) !important;
    }
</style>

<div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
    <div class="modal-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
        <h5 class="modal-title font-weight-bold d-flex align-items-center">
            <i class="fas fa-layer-group mr-2"></i> Thêm mới Nhóm thu thập dữ liệu
        </h5>
        <button type="button" class="close text-white opacity-8" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body p-4" style="background-color: #f8f9fc;">
        <form id="formSubmit">
            <div class="card border-0 shadow-sm" style="border-radius: 10px;">
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-dark small">Mã nhóm <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-barcode text-gray-500"></i></span>
                                </div>
                                <input type="text" class="form-control border-left-0 bg-light font-weight-bold text-uppercase" 
                                       ng-model="model.manhom_tbh" name="manhom_tbh" 
                                       maxlength="6" placeholder="Ví dụ: HN_01, HCM01..." 
                                       style="text-transform: uppercase;" required>
                            </div>
                            <small class="form-text text-muted mt-1">
                                <i class="fas fa-info-circle mr-1 text-primary"></i> Quy chuẩn: Tối đa 6 ký tự viết hoa không dấu (Ví dụ: <code>HN_01</code>, <code>HC_ALO</code>, <code>TTDL01</code>).
                            </small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-dark small">Tên nhóm thu thập <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-users-cog text-gray-500"></i></span>
                                </div>
                                <input type="text" class="form-control border-left-0 bg-light" 
                                       ng-model="model.tennhom_tbh" name="tennhom_tbh" 
                                       maxlength="100" placeholder="Nhập tên nhóm thu thập dữ liệu..." required>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label font-weight-bold text-dark small">Tỉnh / Thành phố quản lý <span class="text-danger">*</span></label>
                            <select class="form-control bg-light" ui-select2 ng-model="model.city_code" name="city_code" 
                                    data-placeholder="-- Chọn Tỉnh / Thành phố --" 
                                    ng-options="item.Code as item.Name for item in ListCity" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="modal-footer bg-white py-3 border-top-0">
        <button type="button" class="btn btn-secondary px-4 font-weight-bold" data-dismiss="modal" ng-click="cancel()">
            <i class="fas fa-times mr-1"></i> Hủy bỏ
        </button>
        <button type="button" class="btn btn-primary px-4 font-weight-bold shadow-sm" ng-click="submit()">
            <i class="fas fa-save mr-1"></i> Lưu thông tin
        </button>
    </div>
</div>
