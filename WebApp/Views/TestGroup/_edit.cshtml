<div class="modal-header">
    <h4 class="modal-title">Cập nhật Nhóm thu thập dữ liệu</h4>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <form class=" col-md-12" id="formSubmit">
        <div class="row">
            <div class="col-lg-12">
                <div class="row" style="margin-bottom:10px;">
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="requiredInput">Mã nhóm</label>
                            <input type="text" class="form-control" ng-model="model.manhom_tbh" name="manhom_tbh" required>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="requiredInput">Tên nhóm</label>
                            <input type="text" class="form-control" ng-model="model.tennhom_tbh" name="tennhom_tbh" required>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-primary" ng-click="submit()">Lưu</button>
    <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-click="cancel()">Hủy</button>
</div>

