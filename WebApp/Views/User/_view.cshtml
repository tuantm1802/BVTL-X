<style>
    .modal-user-view-header {
        background: linear-gradient(135deg, #36b9cc 0%, #1a8a99 100%);
        color: #fff;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }
    .view-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #858796;
        margin-bottom: 4px;
    }
    .view-value {
        font-size: 14px;
        font-weight: 600;
        color: #2e59d9;
    }
    .view-avatar-box {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        border: 3px solid #fff;
    }
</style>

<div class="modal-header modal-user-view-header py-3 px-4">
    <h5 class="modal-title font-weight-bold text-white mb-0">
        <i class="fas fa-id-card mr-2"></i>Thông tin Chi tiết Tài khoản Người dùng
    </h5>
    <button type="button" class="close text-white opacity-80" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <span aria-hidden="true" style="font-size: 1.8rem;">&times;</span>
    </button>
</div>

<div class="modal-body p-4 bg-light">
    <!-- Top Summary Banner -->
    <div class="card border-0 shadow-sm rounded-lg mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-auto">
                    <img class="view-avatar-box" id="pathPhoto" src="~/Assest/dist/img/avatar.png" alt="Avatar" />
                </div>
                <div class="col">
                    <h5 class="font-weight-bold text-dark mb-1" ng-bind="model.Name || 'Chưa cập nhật tên'"></h5>
                    <p class="text-muted small mb-2"><i class="fas fa-user-circle mr-1"></i>Username: <strong class="text-primary" ng-bind="model.UserName"></strong></p>
                    <div>
                        <span class="badge badge-pill badge-primary px-3 py-1 mr-2" ng-bind="model.RoleName || 'Quyền dùng'"></span>
                        <span class="badge badge-pill px-3 py-1" ng-class="model.Status == 1 ? 'badge-success' : 'badge-danger'" ng-bind="model.Status == 1 ? '🟢 Hoạt động' : '🔴 Ngừng hoạt động'"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Fields Grid -->
    <div class="card border-0 shadow-sm rounded-lg bg-white p-3">
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="view-label">Tên truy cập</div>
                <div class="view-value" ng-bind="model.UserName || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Họ và tên</div>
                <div class="view-value" ng-bind="model.Name || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Giới tính</div>
                <div class="view-value" ng-bind="model.Gender == 'M' ? 'Nam' : (model.Gender == 'F' ? 'Nữ' : '—')"></div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="view-label">Số điện thoại</div>
                <div class="view-value" ng-bind="model.Phone || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Email liên hệ</div>
                <div class="view-value text-lowercase" ng-bind="model.Email || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Số CMND / CCCD</div>
                <div class="view-value" ng-bind="model.IdNumber || '—'"></div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="view-label">Ngày sinh</div>
                <div class="view-value" ng-bind="model.DateOfBirth || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Dự án quản lý</div>
                <div class="view-value" ng-bind="model.MaDuAn || '—'"></div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="view-label">Trạng thái</div>
                <div class="view-value" ng-bind="model.Status == 1 ? 'Đang hoạt động' : 'Tạm khóa'"></div>
            </div>

            <div class="col-md-12">
                <div class="view-label">Địa chỉ thường trú</div>
                <div class="view-value text-dark" ng-bind="model.Address || '—'"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer bg-white py-3 px-4 border-top">
    <button type="button" class="btn btn-secondary px-4 font-weight-bold" data-dismiss="modal" ng-click="cancel()">Đóng</button>
</div>