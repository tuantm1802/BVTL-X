
@{
    ViewBag.Title = "Người dùng";
}

<div class="container-fluid" ng-controller="UserController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Người dùng</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <button type="button" class="btn btn-primary" ng-click="add()">
                    <i class="fas fa-plus"></i> Thêm mới
                </button>
                <button type="button" ng-click="LoadPage(0)" class="btn btn-primary">
                    <i class="fas fa-sync-alt"></i> Làm mới
                </button>
                <button type="button" class="btn btn-primary" ng-click="edit()">
                    <i class="fas fa-pencil-alt"></i> Cập nhật
                </button>
                <button type="button" class="btn btn-danger" ng-click="delete()">
                    <i class="fas fa-times"></i> In Active
                </button>
                <button type="button" class="btn btn-primary" ng-click="activeUser()">
                    <i class="fas fa-pencil-alt"></i> Active
                </button>
                <button type="button" class="btn btn-primary" ng-click="ViewDetail()">
                    <i class="fas fa-eye"></i> Xem
                </button>
                <button type="button" class="btn btn-primary" ng-click="resetPassword()">
                    <i class="fas fa-pencil-alt"></i> Đặt lại mật khẩu
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableUser" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;">STT </th>
                            <th style="width:20%;">Tên đăng nhập </th>
                            <th style="width:auto;">Họ và tên </th>
                            <th style="width:10%;">Số CMND </th>
                            <th style="width:15%;">Nhóm quyền</th>
                            <th style="width:15%;">Trạng thái</th>
                            @*<th style="width:8%;">Thao tác</th>*@
                        </tr>
                    </thead>
                    @*<tbody>
                            <tr ng-repeat="item in ListUser" ng-class="{activerow:$index==selectedRow}">
                                <td class="text-center">{{(10 * (modelSearch.currentPage-1)) + $index + 1}}</td>
                                <td>{{item.UserName}}</td>
                                <td>{{item.Name}}</td>
                                <td>{{item.IdNumber}}</td>
                                <td>{{item.Role}}</td>
                                <td class="text-center">{{item.Status == true ? 'Sử dụng' : 'Không sử dụng'}}</td>
                                <td class="text-center">
