                                        <i class="fas fa-times"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary" ng-click="ViewDetail(item.ID, $index)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>*@
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    
    <script src="~/app/Controller/UserController.js"></script>
}
