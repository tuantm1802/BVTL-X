<div class="modal-header bg-danger text-white py-3 px-4">
    <h5 class="modal-title font-weight-bold text-white mb-0">
        <i class="fas fa-user-slash mr-2"></i>Khóa / Ngừng hoạt động tài khoản
    </h5>
    <button type="button" class="close text-white opacity-80" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <span aria-hidden="true" style="font-size: 1.8rem;">&times;</span>
    </button>
</div>

<div class="modal-body p-4 bg-light">
    <form id="formSubmitLock">
        <div class="card border-0 shadow-sm rounded-lg bg-white p-3">
            <div class="alert alert-danger border-0 small mb-3">
                <i class="fas fa-exclamation-circle mr-1"></i>Hành động này sẽ tạm ngừng quyền đăng nhập của người dùng vào hệ thống.
            </div>
            
            <div class="form-group mb-0">
                <label class="font-weight-bold text-dark small requiredInput">Lý do / Ý kiến khóa tài khoản</label>
                <textarea class="form-control" rows="3" ng-model="Content" name="Content" placeholder="Ghi rõ lý do khóa hoặc lý do chuyển trạng thái..."></textarea>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer bg-white py-3 px-4 border-top">
    <button type="button" class="btn btn-danger font-weight-bold shadow-sm px-4" ng-click="submit()">
        <i class="fas fa-lock mr-1"></i>Xác nhận Khóa tài khoản
    </button>
    <button type="button" class="btn btn-secondary font-weight-bold px-4" data-dismiss="modal" ng-click="cancel()">Hủy</button>
</div>