<style>
    .modal-user-header {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: #fff;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }
    .user-section-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #4e73df;
        border-bottom: 2px solid #e3e6f0;
        padding-bottom: 6px;
        margin-bottom: 16px;
    }
    .avatar-preview-box {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        border: 3px solid #fff;
    }
</style>

<div class="modal-header modal-user-header py-3 px-4">
    <h5 class="modal-title font-weight-bold text-white mb-0">
        <i class="fas fa-user-plus mr-2"></i>Thêm mới tài khoản người dùng
    </h5>
    <button type="button" class="close text-white opacity-80" data-dismiss="modal" aria-label="Close" ng-click="cancel()">
        <span aria-hidden="true" style="font-size: 1.8rem;">&times;</span>
    </button>
</div>

<div class="modal-body p-4 bg-light">
    <form id="formSubmit">
        <div class="row">
            <!-- Left Panel: Main Info -->
            <div class="col-lg-9 col-md-8">
                
                <!-- Section 1: Thông tin tài khoản & Phân quyền -->
                <div class="card border-0 shadow-sm rounded-lg mb-4">
                    <div class="card-body p-3">
                        <div class="user-section-title">
                            <i class="fas fa-lock mr-2"></i>1. Thông tin đăng nhập & Phân quyền
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small requiredInput">Tên truy cập (Username)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white"><i class="fas fa-user text-muted"></i></span>
                                    </div>
                                    <input type="text" class="form-control" ng-model="model.UserName" name="UserName" placeholder="Nhập username" required>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small requiredInput">Mật khẩu ban đầu</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white"><i class="fas fa-key text-muted"></i></span>
                                    </div>
                                    <input type="password" class="form-control" ng-model="model.Password" name="Password" placeholder="Nhập mật khẩu" required />
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small requiredInput">Nhóm quyền</label>
                                <select class="form-control" ui-select2 ng-model="model.GroupID" name="GroupID" required ng-options="item.ID as item.Name for item in ListUserGroup">
                                    <option value="">-- Chọn quyền --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Thông tin cá nhân -->
                <div class="card border-0 shadow-sm rounded-lg mb-4">
                    <div class="card-body p-3">
                        <div class="user-section-title">
                            <i class="fas fa-id-card mr-2"></i>2. Thông tin cá nhân
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-dark small requiredInput">Họ và tên</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white"><i class="fas fa-signature text-muted"></i></span>
                                    </div>
                                    <input type="text" class="form-control" ng-model="model.Name" name="Name" placeholder="Nhập họ và tên đầy đủ" required>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="font-weight-bold text-dark small">Giới tính</label>
                                <select class="form-control" ui-select2 ng-model="model.Gender" name="Gender">
                                    <option value="M">Nam</option>
                                    <option value="F">Nữ</option>
                                </select>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="font-weight-bold text-dark small">Ngày sinh</label>
                                <div class="input-group date" id="reDateOfBirth" data-target-input="nearest">
                                    <input type="text" class="form-control datetimepicker-input" ng-model="model.DateOfBirth" data-target="#reDateOfBirth" placeholder="DD/MM/YYYY">
                                    <div class="input-group-append" data-target="#reDateOfBirth" data-toggle="datetimepicker">
                                        <div class="input-group-text bg-white"><i class="fa fa-calendar text-muted"></i></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small">Số CMND / CCCD</label>
                                <input type="text" class="form-control" ng-model="model.IdNumber" placeholder="Số CMND/CCCD">
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small">Số điện thoại</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white"><i class="fas fa-phone text-muted"></i></span>
                                    </div>
                                    <input type="text" ng-pattern="ph_numbr" maxlength="10" name="Phone" class="form-control" ng-model="model.Phone" placeholder="09xxxxxxxx">
                                </div>
                                <span class="text-danger small" ng-show="formDemo.Phone.$error.pattern">Số điện thoại chưa đúng định dạng!</span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark small">Email liên hệ</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white"><i class="fas fa-envelope text-muted"></i></span>
                                    </div>
                                    <input type="email" class="form-control" name="Email" ng-model="model.Email" placeholder="example@email.com">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="font-weight-bold text-dark small">Địa chỉ liên hệ</label>
                                <input type="text" class="form-control" ng-model="model.Address" placeholder="Nhập địa chỉ cư trú">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Quản lý dự án & Trạng thái -->
                <div class="card border-0 shadow-sm rounded-lg">
                    <div class="card-body p-3">
                        <div class="user-section-title">
                            <i class="fas fa-tasks mr-2"></i>3. Quản lý dự án & Trạng thái
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold text-dark small requiredInput" title="Dự án quản lý">Dự án quản lý</label>
                                <select class="form-control" ui-select2 multiple ng-model="ListMaDuAn" name="ListMaDuAn" ng-options="item.Code as item.Name for item in ListDuAn">
                                </select>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="font-weight-bold text-dark small">Nhóm TTDL</label>
                                <select class="form-control" ui-select2 multiple ng-model="ListTestGroupId" name="ListTestGroupId" ng-options="item.Id as item.Name for item in ListTestGroup">
                                </select>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label class="font-weight-bold text-dark small">Trạng thái tài khoản</label>
                                <select class="form-control" ui-select2 ng-model="model.Status" name="Status" ng-options="item.ID as item.Name for item in ListStatus">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Panel: Avatar Upload -->
            <div class="col-lg-3 col-md-4">
                <div class="card border-0 shadow-sm rounded-lg text-center p-3 sticky-top" style="top: 20px;">
                    <div class="user-section-title text-center">
                        <i class="fas fa-camera mr-1"></i>Ảnh đại diện
                    </div>
                    <div class="my-3">
                        <img class="avatar-preview-box mx-auto" id="pathPhoto" src="~/Assest/dist/img/avatar.png" alt="Avatar Preview" />
                    </div>
                    <div class="custom-file mb-2">
                        <input type="text" hidden class="form-control" ng-model="model.Avartar">
                        <input id="filePhoto" name="filePhoto" type="file" onchange="angular.element(this).scope().SelectFile(event)" class="custom-file-input">
                        <label for="filePhoto" id="lableFile" class="custom-file-label text-truncate text-left small">Chọn file ảnh...</label>
                    </div>
                    <small class="text-muted">Định dạng JPG, PNG (Dung lượng &lt; 5MB)</small>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer bg-white py-3 px-4 border-top">
    <button type="button" class="btn btn-primary px-4 font-weight-bold shadow-sm" ng-click="submit()">
        <i class="fas fa-save mr-1"></i>Lưu người dùng
    </button>
    <button type="button" class="btn btn-secondary px-4 font-weight-bold" data-dismiss="modal" ng-click="cancel()">Hủy</button>
</div>