@{
    ViewBag.Title = "Đổi mật khẩu";
    var userSession = (Model.ModelExtend.Base.UserLogin)HttpContext.Current.Session["USER_SESSION"];
}

<div class="container-fluid py-4" ng-controller="UserChangePasswordController">
    <!-- Header & Breadcrumb -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="font-weight-bold text-gray-900 mb-1">
                <i class="fas fa-key text-warning me-2"></i>Đổi Mật Khẩu
            </h4>
            <p class="text-muted small mb-0">Thay đổi mật khẩu đăng nhập định kỳ để bảo vệ an toàn cho tài khoản</p>
        </div>
        <div class="d-flex gap-2">
            @if (userSession != null)
            {
                <a href="/User/GetProfile?Id=@userSession.UserID" class="btn btn-sm btn-outline-primary shadow-sm">
                    <i class="fas fa-id-card me-1"></i> Xem hồ sơ cá nhân
                </a>
            }
            <a href="/Home/Index" class="btn btn-sm btn-light border shadow-sm">
                <i class="fas fa-home me-1"></i> Trang chủ
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="font-weight-bold text-primary mb-0">
                        <i class="fas fa-lock me-2"></i>Thiết Lập Mật Khẩu Mới
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form id="formChangePassword" name="formChangePassword">
                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">
                                Mật khẩu cũ / hiện tại <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-shield-alt text-muted"></i>
                                </span>
                                <input type="password" class="form-control border-start-0" 
                                       placeholder="Nhập mật khẩu đang sử dụng" 
                                       ng-model="PasswordOld" name="PasswordOld" required>
                            </div>
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">
                                Mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-key text-muted"></i>
                                </span>
                                <input type="password" class="form-control border-start-0" 
                                       placeholder="Nhập mật khẩu mới" 
                                       ng-model="PasswordNew" name="PasswordNew" required>
                            </div>
                        </div>

                        <!-- Nhập lại mật khẩu mới -->
                        <div class="mb-4">
                            <label class="form-label small font-weight-bold text-gray-800">
                                Xác nhận lại mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-check-double text-muted"></i>
                                </span>
                                <input type="password" class="form-control border-start-0" 
                                       placeholder="Nhập lại mật khẩu mới" 
                                       ng-model="PasswordReNew" name="PasswordReNew" required>
                            </div>
                        </div>

                        <!-- Security Tips -->
                        <div class="alert alert-light border small text-muted mb-4 py-2">
                            <div class="font-weight-bold text-gray-800 mb-1">
                                <i class="fas fa-info-circle text-primary me-1"></i> Lưu ý bảo mật:
                            </div>
                            <ul class="mb-0 ps-3">
                                <li>Mật khẩu mới không nên trùng với mật khẩu cũ.</li>
                                <li>Nên có độ dài từ 6 ký tự trở lên để đảm bảo an toàn.</li>
                                <li>Sau khi đổi mật khẩu thành công, hệ thống sẽ yêu cầu đăng nhập lại.</li>
                            </ul>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Home/Index" class="btn btn-secondary btn-sm px-3">Hủy bỏ</a>
                            <button class="btn btn-primary btn-sm px-4 font-weight-semibold" type="button" ng-click="ChangePassword()">
                                <i class="fas fa-save me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/UserChangePasswordController.js"></script>
}


