@{
    ViewBag.Title = "Báo cáo sàng lọc";
}
<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>
<div class="container-fluid" x-data="ketQuaSangLocComponent()">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">THÔNG TIN SÀNG LỌC KHÁCH HÀNG TUYỂN VÀO DỰ ÁN</h1>
    <p class="mb-4">
    </p>
    <div class="form-group row">

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Từ ngày</label>
            <input type="date" class="form-control" x-model="modelSearch.FromDate" />
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Đến ngày</label>
            <input type="date" class="form-control" x-model="modelSearch.ToDate" />
        </div>

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Nhóm</label>
            <select class="form-control" multiple style="height:24px;" id="MaNhomTBH" name="MaNhomTBH">
                <template x-for="item in ListNhomTBH" :key="item.manhom_tbh">
                    <option :value="item.manhom_tbh" :selected="modelSearch.MaNhomTBH && modelSearch.MaNhomTBH.includes(item.manhom_tbh)" x-text="item.tennhom_tbh + ' (' + item.manhom_tbh + ') - ' + item.CityName"></option>
                </template>
            </select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Tỉnh</label>
            <select class="form-control" id="CityCodes" name="CityCodes">
                <option></option>
                <template x-for="item in ListCity" :key="item.Code">
                    <option :value="item.Code" :selected="modelSearch.CityCodes == item.Code" x-text="item.Name"></option>
                </template>
            </select>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3 mb-3 mb-sm-0 d-flex align-items-end">
            <button type="button" x-on:click="LoadPage()" x-show="RoleBtnSearch == true" class="btn btn-primary mr-2">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <button type="button" x-show="RoleBtnExportExcel == true" class="btn btn-secondary" x-on:click="ExportDataSangLoc()">
                <i class="fas fa-pencil-alt"></i> Xuất Excel
            </button>
        </div>
    </div>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        
        <div class="card-body">

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả sàng lọc</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th style="width:5%;" class="text-center"># </th>
                                    <th colspan="3">Tiêu chí</th>
                                    <th style="width:10%;" class="text-center">Số lượng</th>
                                    <th style="width:10%;" class="text-center">Tỷ lệ (%)</th>
                                </tr>
                            </thead>
                            <template x-for="(item, index) in KetQuaTTCBHanhViNguyCos" :key="index">
                                <tr>
                                    <td class="text-center" x-show="item.IsShow == 'Y'" x-text="item.STT"></td>
                                    <td class="text-left" x-show="!(item.IsShow == 'N' || item.ThongTinBC == '' || item.ThongTinBC == null)" :colspan="item.Colpan" :rowspan="item.Rowpan">
                                        <span x-show="item.BoldText == 'N'" x-text="item.ThongTinBC"></span>
                                        <b x-show="item.BoldText == 'Y'" x-text="item.ThongTinBC"></b>
                                    </td>
                                    <td class="text-left" x-show="!(item.SubRowspan == 1 || item.IsShow == 'N')" :rowspan="item.SubRowspan" x-text="item.ThongTinBC_Them"></td>

                                    <td class="text-left" x-text="item.SubThongTinBC_Them"></td>

                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.SoLuong || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : item.TyLe.toFixed(2) + '%')"></td>
                                </tr>
                            </template>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////Báo cáo theo CÁC LOẠI CHẤT GÂY NGHIỆN\KẾT QUẢ ASSIST////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Các loại chất gây nghiện/kết quả ASSIST</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableCacLoaiChatGayNghiens"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th rowspan="2">Các loại chất </th>
                                    <th colspan="2" class="text-center">Nguy cơ thấp (0-3)</th>
                                    <th colspan="2" class="text-center">Nguy cơ trung bình (4-27)</th>
                                    <th colspan="2" class="text-center">Nguy cơ cao (27+)</th>

                                </tr>
                                <tr>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                </tr>
                            </thead>
                            <template x-for="(item, index) in CacLoaiChatGayNghienAssists" :key="index">
                                <tr>
                                    <td class="text-left" x-text="item.LoaiDiem"></td>
                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.NguyCo_Thap || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe_NguyCo_Thap == null ? '' : (item.TyLe_NguyCo_Thap === 0 ? '0%' : item.TyLe_NguyCo_Thap.toFixed(2) + '%')"></td>
                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.NguyCo_TrungBinh || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe_NguyCo_TrungBinh == null ? '' : (item.TyLe_NguyCo_TrungBinh === 0 ? '0%' : item.TyLe_NguyCo_TrungBinh.toFixed(2) + '%')"></td>
                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.NguyCo_Cao || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe_NguyCo_Cao == null ? '' : (item.TyLe_NguyCo_Cao === 0 ? '0%' : item.TyLe_NguyCo_Cao.toFixed(2) + '%')"></td>
                                </tr>
                            </template>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////KẾT QUẢ QST////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả QST</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Kết quả QST </th>
                                    <th class="text-center">Ghi chú</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Tỷ lệ (%)</th>
                                </tr>

                            </thead>
                            <template x-for="(item, index) in KetQuaQSTs" :key="index">
                                <tr>
                                    <td class="text-left" :rowspan="item.SubRowspan" x-show="item.IsShow != 'N'" x-text="item.KetQua"></td>
                                    <td class="text-left" x-text="item.GhiChu"></td>
                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.SoLuong || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : item.TyLe.toFixed(2) + '%')"></td>
                                </tr>
                            </template>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////KẾT QUẢ ACE////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả ACE</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Kết quả ACE </th>
                                    
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Tỷ lệ (%)</th>
                                </tr>

                            </thead>
                            <template x-for="(item, index) in KetQuaACEs" :key="index">
                                <tr>
                                    <td class="text-left" x-text="item.KetQua"></td>
                                    <td class="text-right" x-text="new Intl.NumberFormat('en-US').format(item.SoLuong || 0)"></td>
                                    <td class="text-right" x-text="item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : item.TyLe.toFixed(2) + '%')"></td>
                                </tr>
                            </template>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineBaoCaoSangLoc.js?v=@DateTime.Now.Ticks"></script>
}
