@{
    ViewBag.Title = "Báo cáo sàng lọc";
}
<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>
<div class="container-fluid" ng-controller="KetQuaSangLocCD43Controller">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">THÔNG TIN SÀNG LỌC KHÁCH HÀNG TUYỂN VÀO DỰ ÁN</h1>
    <p class="mb-4">
    </p>
    <div class="form-group row">

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Từ ngày</label>
            <input type="date" class="form-control" ng-model="modelSearch.FromDate" />
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Đến ngày</label>
            <input type="date" class="form-control" ng-model="modelSearch.ToDate" />
        </div>

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Nhóm</label>
            <select class="form-control" ui-select2 multiple ng-model="modelSearch.MaNhomTBH" style="height:24px;" name="MaNhomTBH" ng-options="item.manhom_tbh as (item.tennhom_tbh + ' ('+ item.manhom_tbh +') - ' + item.CityName) for item in ListNhomTBH"></select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Tỉnh</label>
            <select class="form-control" placeholder="Chọn tỉnh" ui-select2 ng-model="modelSearch.CityCodes" style="height:24px;" id="CityCodes" name="CityCodes" ng-options="item.Code as item.Name for item in ListCity">
                <option></option>
            </select>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3 mb-3 mb-sm-0 d-flex align-items-end">
            <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary mr-2">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-secondary" ng-click="ExportDataSangLoc()">
                <i class="fas fa-pencil-alt"></i> Xuất Excel
            </button>
        </div>
    </div>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        
        <div class="card-body">

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả sàng lọc</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th style="width:5%;" class="text-center"># </th>
                                    <th colspan="3">Tiêu chí</th>
                                    <th style="width:10%;" class="text-center">Số lượng</th>
                                    <th style="width:10%;" class="text-center">Tỷ lệ (%)</th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in KetQuaTTCBHanhViNguyCos">
                                <td class="text-center" ng-show="item.IsShow == 'Y'">{{item.STT}}</td>
                                <td class="text-left" ng-hide="item.IsShow == 'N' || item.ThongTinBC == '' || item.ThongTinBC == null" colspan="{{item.Colpan}}" rowspan="{{item.Rowpan}}">
                                    <span ng-show="item.BoldText == 'N'">{{item.ThongTinBC}}</span>
                                    <b ng-show="item.BoldText == 'Y'">{{item.ThongTinBC}}</b>
                                </td>
                                <td class="text-left" ng-hide="item.SubRowspan ==1 || item.IsShow  == 'N'" rowspan="{{item.SubRowspan}}">{{item.ThongTinBC_Them }}</td>

                                <td class="text-left">
                                    {{item.SubThongTinBC_Them}}
                                </td>

                                <td class="text-right">{{item.SoLuong | number}}</td>
                                <td class="text-right">{{item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : (item.TyLe | number:2) + '%')}}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////Báo cáo theo CÁC LOẠI CHẤT GÂY NGHIỆN\KẾT QUẢ ASSIST////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Các loại chất gây nghiện/kết quả ASSIST</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableCacLoaiChatGayNghiens"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th rowspan="2">Các loại chất </th>
                                    <th colspan="2" class="text-center">Nguy cơ thấp (0-3)</th>
                                    <th colspan="2" class="text-center">Nguy cơ trung bình (4-27)</th>
                                    <th colspan="2" class="text-center">Nguy cơ cao (27+)</th>

                                </tr>
                                <tr>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">Số lượng </th>
                                    <th class="text-center">%</th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in CacLoaiChatGayNghienAssists">
                                <td class="text-left">{{item.LoaiDiem}}</td>
                                <td class="text-right">{{item.NguyCo_Thap | number}}</td>
                                <td class="text-right">                                    
                                    {{item.TyLe_NguyCo_Thap == null ? '' : (item.TyLe_NguyCo_Thap === 0 ? '0%' : (item.TyLe_NguyCo_Thap | number:2) + '%')}}
                                </td>
                                <td class="text-right">{{item.NguyCo_TrungBinh | number}}</td>
                                <td class="text-right">
                                    {{item.TyLe_NguyCo_TrungBinh == null ? '' : (item.TyLe_NguyCo_TrungBinh === 0 ? '0%' : (item.TyLe_NguyCo_TrungBinh | number:2) + '%')}}
                                </td>
                                <td class="text-right">{{item.NguyCo_Cao | number}}</td>
                                <td class="text-right">
                                    {{item.TyLe_NguyCo_Cao == null ? '' : (item.TyLe_NguyCo_Cao === 0 ? '0%' : (item.TyLe_NguyCo_Cao | number:2) + '%')}}
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////KẾT QUẢ QST////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả QST</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Kết quả QST </th>
                                    <th class="text-center">Ghi chú</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Tỷ lệ (%)</th>
                                </tr>

                            </thead>
                            <tr ng-repeat="item in KetQuaQSTs">
                                <td class="text-left" rowspan="{{item.SubRowspan}}" ng-hide="item.IsShow == 'N'">{{item.KetQua}}</td>
                                <td class="text-left">{{item.GhiChu}}</td>
                                <td class="text-right">{{item.SoLuong | number}}</td>
                                <td class="text-right">{{item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : (item.TyLe | number:2) + '%')}}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////KẾT QUẢ ACE////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả ACE</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Kết quả ACE </th>
                                    
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Tỷ lệ (%)</th>
                                </tr>

                            </thead>
                            <tr ng-repeat="item in KetQuaACEs">
                                <td class="text-left" >{{item.KetQua}}</td>
                                <td class="text-right">{{item.SoLuong | number}}</td>
                                <td class="text-right">{{item.TyLe == null ? '' : (item.TyLe === 0 ? '0%' : (item.TyLe | number:2) + '%')}}</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/KetQuaSangLocCD43Controller.js"></script>
}
