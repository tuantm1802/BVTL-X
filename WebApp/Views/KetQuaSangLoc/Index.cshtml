                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableDuongSDMaTuyDas"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>1, Hút, hít (khói, mùi) bằng mũi/miệng </th>
