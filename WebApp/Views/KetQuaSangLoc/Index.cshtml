            </div>
            @*////////////////////Báo cáo theo Loại ma túy SD đầu tiên////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Loại ma túy SD đầu tiên</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableLoaiMaTuyDaSDDauTiens"*@ width="100%" cellspacing="0">
