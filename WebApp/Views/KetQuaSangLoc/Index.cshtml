        <div class="card-body">
            @*////////////////////Báo cáo theo đối tượng////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Đối tượng KH</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableDoiTuongKHs"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Đối tượng KH </th>
                                    <th>Số người</th>
                                    <th>% </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in DoiTuongKHs">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item.SoNguoi | number}}</td>
                                <td class="text-right">{{item.PhanTram | number}}%</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////Báo cáo theo giới tính////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Giới tính</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableGioiTinhs"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Giới tính </th>
                                    <th>Số người</th>
                                    <th>% </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in GioiTinhs">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item.SoNguoi | number}}</td>
                                <td class="text-right">{{item.PhanTram | number}}%</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            @*////////////////////Báo cáo theo tuổi ////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tuổi</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableTuois"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Tuổi </th>
                                    <th>Số người</th>
                                    <th>% </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in Tuois">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item.SoNguoi | number}}</td>
                                <td class="text-right">{{item.PhanTram | number}}%</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////Báo cáo theo kết quả HIV ////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Kết quả sàng lọc HIV</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableKetQuaHIVs"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Kết quả</th>
                                    <th>Số người</th>
                                    <th>% </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in KetQuaHIVs">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item.SoNguoi | number}}</td>
                                <td class="text-right">{{item.PhanTram | number}}%</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            @*////////////////////Báo cáo theo Chất gây nghiện sử dụng trong 3 tháng gần đây////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Chất gây nghiện sử dụng trong 3 tháng gần đây</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableChatGayNghien3Thangs"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Chất gây nghiện sử dụng trong 3 tháng gần đây  </th>
                                    <th>Số người</th>
                                    <th>Tỉ lệ % người dùng từng loại </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in ChatGayNghien3Thangs">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item.SoNguoi | number}}</td>
                                <td class="text-right">{{item.PhanTram | number}}%</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            @*////////////////////Báo cáo theo Số chất gây nghiện////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Số Chất gây nghiện sử dụng trong 3 tháng gần đây</h6>
