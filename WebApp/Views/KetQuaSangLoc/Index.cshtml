                                <td class="text-right">{{item.ItHon1Lan1Thang | number}}<span ng-show="$index == 1">%</span></td>
                                <td class="text-right">{{item.KBKTL | number}}<span ng-show="$index == 1">%</span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            @*////////////////////Báo cáo theo Lần đầu SD ma tuý ////*@
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Lần đầu SD ma tuý</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" @*id="dataTableLanDauSDMaTuyDas"*@ width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Tuổi </th>
                                    <th>13</th>
                                    <th>14 </th>
                                    <th>15</th>
                                    <th>16 </th>
                                    <th>17</th>
                                    <th>18 </th>
                                    <th>19</th>
                                    <th>20</th>
                                    <th>21</th>
                                    <th>22</th>
                                    <th>23 </th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in LanDauSDMaTuyDas">
                                <td class="text-left">{{item.NoiDung}}</td>
                                <td class="text-right">{{item._13 | number}}<span ng-show="$index == 1">%</span></td>
                                <td class="text-right">{{item._14 | number}}<span ng-show="$index == 1">%</span></td>
                                <td class="text-right">{{item._15 | number}}<span ng-show="$index == 1">%</span></td>
                                <td class="text-right">{{item._16 | number}}<span ng-show="$index == 1">%</span></td>
