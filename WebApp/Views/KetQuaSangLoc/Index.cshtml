            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Loại chất gây nghiện sử dụng thường xuyên nhất trong 3 tháng gần đây</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
