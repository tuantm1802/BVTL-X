@{
    ViewBag.Title = "Báo cáo 6 tháng CH07";
}

<div class="container-fluid" ng-controller="BaoCao6ThangCH07Controller">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Báo cáo 6 tháng</h1>
    <p class="mb-4">
    </p>
    <div class="form-group row">

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Kỳ báo cáo</label>
            <select class="form-control" ng-model="SauThang" name="SauThang" ng-options="item.Id as item.Name for item in List6Thang"></select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Năm</label>
            <select class="form-control" ui-select2 ng-model="modelSearch.Year" name="Year" ng-options="item.Id as item.Name for item in ListYear"></select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label class="form-label">Tỉnh</label>
            <select class="form-control" ui-select2 multiple ng-model="ListCityCode" name="ListCity" ng-change="Changecity()" ng-options="item.Code as item.Name for item in ListCity"></select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label>Nhóm</label>
            <select class="form-control" ui-select2 multiple ng-model="ListMaNhomTBH" name="ListMaNhomTBH" ng-options="item.manhom_tbh as (item.tennhom_tbh + ' ('+ item.manhom_tbh +') - ' + item.CityName) for item in ListNhomTBH"></select>
        </div>
        
    </div>
    <div class="form-group row">
        <div class="col-sm-2">
            <button type="button" ng-click="Refesh()" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <button type="button" class="btn btn-secondary" ng-click="ExportExcel()">
                <i class="fas fa-pencil-alt"></i> Xuất Excel
            </button>
        </div>
    </div>
        <!-- DataTales Example -->
        <div class="card shadow mb-4">            
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th style="width:5%;"># </th>
                                <th style="width: 39%;" colspan="2">Thông tin báo cáo </th>
                                <th style="width: 8%; ">Tổng</th>                                
                                <th style="width: 8%; ">Nam</th>
                                <th style="width: 8%; ">Nữ</th>
                                <th style="width: 8%; ">Chuyển giới</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in ListData">
                                <td class="text-center" ng-show="item.IsShow == 'Y'">{{item.STT}}</td>
                                <td class="text-left" ng-hide="item.IsShow == 'N' || item.ThongTinBC == '' || item.ThongTinBC == null" colspan="{{item.Colpan}}" rowspan="{{item.Rowpan}}">
                                    <span ng-show="item.BoldText == 'N'">{{item.ThongTinBC}}</span>
                                    <b ng-show="item.BoldText == 'Y'">{{item.ThongTinBC}}</b>
                                </td>
                                <td class="text-left" ng-hide="item.Colpan >1 || item.IsShow  == 'N'">{{item.ThongTinBC_Them }}</td>
                                <td class="text-right" ng-show="item.IsShow  == 'Y'">{{item.Tong | number:0}}</td>
                                <td class="text-right" ng-show="item.IsShow  == 'Y'">{{item.Nam | number:0}}</td>
                                <td class="text-right" ng-show="item.IsShow  == 'Y'">{{item.Nu | number:0}}</td>
                                <td class="text-right" ng-show="item.IsShow  == 'Y'">{{item.ChuyenGioi | number:0}}</td>

                            </tr>
                        </tbody>
                    </table>


                </div>
            </div>
        </div>
    </div>

    @section Scripts{
        <script src="~/app/Controller/BaoCao6ThangCH07Controller.js"></script>
    }
