@{
    ViewBag.Title = "Chất gây nghiện 3TH";
}

<div class="container-fluid" ng-controller="ChatGayNghien3THController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Chất gây nghiện 3TH</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <button type="button" ng-click="Refesh()" ng-show="RoleBtnSearch == true" class="btn btn-primary">
