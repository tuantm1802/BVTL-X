@{
    ViewBag.Title = "TỔNG HỢP BÁO CÁO THEO CHỈ TIÊU DỰ ÁN CD43";
}

<div class="container-fluid" x-data="alpineBaoCaoTongHopQuyCD43">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">TỔNG HỢP BÁO CÁO THEO CHỈ TIÊU DỰ ÁN CD43</h1>
    <p class="mb-4">
    </p>
    <div class="form-group row">

        <div class="col-sm-3 mb-3 mb-sm-0">
            <label>Từ quý</label>
            <select class="form-control" x-model="TuQuy" name="TuQuy">
                <option value="I">I</option>
                <option value="II">II</option>
                <option value="III">III</option>
                <option value="IV">IV</option>
            </select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label>Năm</label>
            <select class="form-control" name="TuNam"
                x-init="
                    $watch('ListYear', () => { 
                        $nextTick(() => { $($el).select2(); }); 
                    });
                    $($el).on('change', (e) => { modelSearch.TuNam = $(e.target).val(); });
                ">
                <template x-for="item in ListYear" :key="item.Id">
                    <option :value="item.Id" x-text="item.Name" :selected="modelSearch.TuNam == item.Id"></option>
                </template>
            </select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label>Đến quý</label>
            <select class="form-control" x-model="DenQuy" name="DenQuy">
                <option value="I">I</option>
                <option value="II">II</option>
                <option value="III">III</option>
                <option value="IV">IV</option>
            </select>
        </div>
        <div class="col-sm-3 mb-3 mb-sm-0">
            <label>Năm</label>
            <select class="form-control" name="DenNam"
                x-init="
                    $watch('ListYear', () => { 
                        $nextTick(() => { $($el).select2(); }); 
                    });
                    $($el).on('change', (e) => { modelSearch.DenNam = $(e.target).val(); });
                ">
                <template x-for="item in ListYear" :key="item.Id">
                    <option :value="item.Id" x-text="item.Name" :selected="modelSearch.DenNam == item.Id"></option>
                </template>
            </select>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-3 mb-3 mb-sm-0 d-flex align-items-end">
            <button type="button" x-on:click="Refesh()" x-show="RoleBtnSearch == true" class="btn btn-primary mr-2">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <button type="button" class="btn btn-secondary" x-on:click="ExportExcel()">
                <i class="fas fa-pencil-alt"></i> Xuất Excel
            </button>
        </div>
    </div>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">        
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;">STT </th>
                            <th style="width: 39%;">Hoạt động </th>
                            <th style="width: 8%; ">Chỉ tiêu</th>
                            <th style="width: 8%;">Đơn vị </th>
                            <template x-for="item in ListQuy">
                                <th x-text="item.Quy"></th>
                            </template>
                            <th>Số lượng từ đầu DA</th>
                            <th>Tỷ lệ (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="item in ListData">
                            <tr>
                                <td class="text-center" x-text="item.STT"></td>
                                <td class="text-left">
                                    <span x-show="item.BoldText == false" x-text="item.HoatDong"></span>
                                    <b x-show="item.BoldText == true" x-text="item.HoatDong"></b>
                                </td>
                                <td class="text-left">
                                    <span x-text="item.ChiTieu"></span>
                                </td>
                                <td class="text-left">
                                    <span x-text="item.DonVi"></span>
                                </td>
                                <template x-for="itemQ in item.ListQuy">
                                    <td class="text-right" x-text="formatNumber(itemQ.SoLuong)"></td>
                                </template>
                                <td class="text-right" x-text="formatNumber(item.SoLuongTuDauDA)"></td>
                                <td class="text-right" x-text="formatNumber(item.TyLe)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>


            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineBaoCaoTongHopQuyCD43.js"></script>
}
