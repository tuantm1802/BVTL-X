@{
    ViewBag.Title = "Dashboard - Báo cáo Tổng quan";
}

<div class="container-fluid py-3 ng-scope" x-data="alpineHome()" ng-controller="HomeController">

    <!-- Header Section & Quick Actions -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-tachometer-alt text-primary mr-2"></i> Dashboard Tổng quan Chemsex
            </h1>
            <p class="text-muted small mb-0">Hệ thống phân tích chuyên sâu về tần suất Chemsex, sử dụng đa chất và các chỉ số sức khỏe tâm thần (ASSIST, ACE, QST).</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <button type="button" class="btn btn-white shadow-sm px-3 py-2 font-weight-bold border mr-2" x-on:click="loadAllDashboardData()" style="border-radius: 8px; background: #fff;">
                <i class="fas fa-sync-alt text-primary mr-1" :class="{'fa-spin': isLoading}"></i> Làm mới dữ liệu
            </button>
        </div>
    </div>

    <!-- Sync Notice Banner -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-left: 4px solid #1976d2 !important;">
        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center text-primary font-weight-bold my-1">
                <i class="fas fa-info-circle fa-lg mr-2"></i>
                <span>Dữ liệu được đồng bộ lần cuối vào lúc: <b class="text-dark ml-1" x-text="lastSyncTime"></b></span>
            </div>
            <div class="my-1">
                <span class="badge badge-primary px-3 py-2 font-weight-bold shadow-xs">
                    <i class="fas fa-database mr-1"></i> Nguồn API: CD43 Khách hàng TTCB
                </span>
            </div>
        </div>
    </div>

    <!-- Metric Overview Cards -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #4e73df !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số lượt đánh giá / Khảo sát</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800" x-text="metrics.totalSurvey">0</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(78, 115, 223, 0.1);">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #f6c23e !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Ca Có sử dụng đa chất</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800" x-text="metrics.highRiskCount">0</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(246, 194, 62, 0.15);">
                                <i class="fas fa-pills fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #e74a3b !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Tỷ lệ sử dụng đa chất trong Chemsex</div>
                            <div class="h4 mb-0 font-weight-bold text-danger" x-text="metrics.multiSubstanceRate">0%</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(231, 74, 59, 0.1);">
                                <i class="fas fa-chart-pie fa-2x text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-lg-4 col-md-5 mb-2 mb-md-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="fas fa-map-marker-alt text-danger mr-1"></i> Tỉnh / Thành phố:</label>
                    <select class="form-control bg-light" x-model="selectedTinh" x-on:change="selectCity($event.target.value, $event.target.options[$event.target.selectedIndex].text)" style="border-radius: 8px;">
                        <option value="">-- Toàn bộ Tỉnh / Thành --</option>
                        <template x-for="t in ListCity" :key="t.Code_Map || t.Code">
                            <option :value="t.Code_Map || t.Code" x-text="t.Name"></option>
                        </template>
                    </select>
                </div>

                <div class="col-lg-5 col-md-5 mb-2 mb-md-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="fas fa-users-cog text-primary mr-1"></i> Nhóm thu thập dữ liệu:</label>
                    <select class="form-control bg-light" x-model="selectedNhom" x-on:change="selectNhom($event.target.value, $event.target.options[$event.target.selectedIndex].text)" style="border-radius: 8px;">
                        <option value="">-- Toàn bộ Nhóm TTDL --</option>
                        <template x-for="n in ListNhomTBH" :key="n.manhom_tbh">
                            <option :value="n.manhom_tbh" x-text="n.tennhom_tbh"></option>
                        </template>
                    </select>
                </div>

                <div class="col-lg-3 col-md-2 text-md-right mt-3 mt-md-0">
                    <button type="button" class="btn btn-light font-weight-bold text-secondary border px-3 mt-md-3" x-on:click="resetFilters()" style="border-radius: 8px;">
                        <i class="fas fa-undo mr-1"></i> Đặt lại bộ lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 1: Theo Độ tuổi -->
    <div class="row">
        <div class="col-xl-8 col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-calendar-alt mr-2"></i> Tần suất Chemsex trong 3 tháng qua theo độ tuổi
                    </h6>
                    <span class="badge badge-light border text-muted">Phân bố tần suất</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-4" style="font-size: 0.75rem;">Độ tuổi</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">1 - 2 lần</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tháng (3-9 lần)</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tuần (1-4 lần/tuần)</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="font-size: 0.75rem;">Mỗi ngày / gần mỗi ngày</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbTanSuatChemsex3ThangTheoDoTuoi" :key="d.MucDoTuoi">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-4" x-text="d.MucDoTuoi || '—'"></td>
                                        <td class="text-center font-weight-bold text-gray-700" x-text="d.TanSuat1_2Lan || 0"></td>
                                        <td class="text-center font-weight-bold text-info" x-text="d.TanSuatMoiThang || 0"></td>
                                        <td class="text-center font-weight-bold text-warning" x-text="d.TanSuatMoiTuan || 0"></td>
                                        <td class="text-center font-weight-bold text-danger pr-4" x-text="d.TanSuatMoiNgay || 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbTanSuatChemsex3ThangTheoDoTuoi || dbTanSuatChemsex3ThangTheoDoTuoi.length === 0">
                                    <tr><td colspan="5" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-layer-group mr-2"></i> Sử dụng đa chất theo độ tuổi
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Độ tuổi</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Có đa chất</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Không đa chất</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbSuDungDaChatTrongChemsexTheoDoTuoi" :key="d.MucDoTuoi">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-3" x-text="d.MucDoTuoi || '—'"></td>
                                        <td class="text-center font-weight-bold text-danger" x-text="d.CoSuDungDaChat || 0"></td>
                                        <td class="text-center font-weight-bold text-success pr-3" x-text="d.KhongSuDungDaChat || 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbSuDungDaChatTrongChemsexTheoDoTuoi || dbSuDungDaChatTrongChemsexTheoDoTuoi.length === 0">
                                    <tr><td colspan="3" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Theo Thang Điểm ASSIST Ma túy đá -->
    <div class="row">
        <div class="col-xl-8 col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-heartbeat mr-2"></i> Tần suất Chemsex trong 3 tháng qua theo điểm ASSIST Ma túy đá
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-4" style="font-size: 0.75rem;">Mức độ nguy cơ</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">1 - 2 lần</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tháng</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tuần</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="font-size: 0.75rem;">Mỗi ngày</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbTanSuatChemsex3ThangTheoDiemAssist" :key="d.MucDoNguyCo">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-4" x-text="d.MucDoNguyCo || '—'"></td>
                                        <td class="text-center font-weight-bold text-gray-700" x-text="d.TanSuat1_2Lan >= 0 ? d.TanSuat1_2Lan : 0"></td>
                                        <td class="text-center font-weight-bold text-info" x-text="d.TanSuatMoiThang >= 0 ? d.TanSuatMoiThang : 0"></td>
                                        <td class="text-center font-weight-bold text-warning" x-text="d.TanSuatMoiTuan >= 0 ? d.TanSuatMoiTuan : 0"></td>
                                        <td class="text-center font-weight-bold text-danger pr-4" x-text="d.TanSuatMoiNgay >= 0 ? d.TanSuatMoiNgay : 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbTanSuatChemsex3ThangTheoDiemAssist || dbTanSuatChemsex3ThangTheoDiemAssist.length === 0">
                                    <tr><td colspan="5" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-prescription-bottle mr-2"></i> Đa chất theo ASSIST Ma túy đá
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Điểm ASSIST</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Có đa chất</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Không đa chất</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbSuDungDaChatTrongChemsexTheoDiemAssistMaTuyDa" :key="d.NoiDung">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-3" x-text="d.NoiDung || '—'"></td>
                                        <td class="text-center font-weight-bold text-danger" x-text="d.CoSuDungDaChat || 0"></td>
                                        <td class="text-center font-weight-bold text-success pr-3" x-text="d.KhongSuDungDaChat || 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbSuDungDaChatTrongChemsexTheoDiemAssistMaTuyDa || dbSuDungDaChatTrongChemsexTheoDiemAssistMaTuyDa.length === 0">
                                    <tr><td colspan="3" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Theo Điểm ACE (Tổn thương tuổi thơ) -->
    <div class="row">
        <div class="col-xl-8 col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-child mr-2"></i> Tần suất Chemsex trong 3 tháng qua theo điểm ACE
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-4" style="font-size: 0.75rem;">Mức độ ACE</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">1 - 2 lần</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tháng</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mỗi tuần</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="font-size: 0.75rem;">Mỗi ngày</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbTanSuatChemsex3ThangTheoDiemACE" :key="d.MucDoNguyCo">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-4" x-text="d.MucDoNguyCo || '—'"></td>
                                        <td class="text-center font-weight-bold text-gray-700" x-text="d.TanSuat1_2Lan >= 0 ? d.TanSuat1_2Lan : 0"></td>
                                        <td class="text-center font-weight-bold text-info" x-text="d.TanSuatMoiThang >= 0 ? d.TanSuatMoiThang : 0"></td>
                                        <td class="text-center font-weight-bold text-warning" x-text="d.TanSuatMoiTuan >= 0 ? d.TanSuatMoiTuan : 0"></td>
                                        <td class="text-center font-weight-bold text-danger pr-4" x-text="d.TanSuatMoiNgay >= 0 ? d.TanSuatMoiNgay : 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbTanSuatChemsex3ThangTheoDiemACE || dbTanSuatChemsex3ThangTheoDiemACE.length === 0">
                                    <tr><td colspan="5" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-shield-virus mr-2"></i> Đa chất theo điểm ACE
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Điểm ACE</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Có đa chất</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Không đa chất</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="d in dbSuDungDaChatTrongChemsexTheoDiemACE" :key="d.NoiDung">
                                    <tr>
                                        <td class="font-weight-bold text-dark pl-3" x-text="d.NoiDung || '—'"></td>
                                        <td class="text-center font-weight-bold text-danger" x-text="d.CoSuDungDaChat || 0"></td>
                                        <td class="text-center font-weight-bold text-success pr-3" x-text="d.KhongSuDungDaChat || 0"></td>
                                    </tr>
                                </template>
                                <template x-if="!dbSuDungDaChatTrongChemsexTheoDiemACE || dbSuDungDaChatTrongChemsexTheoDiemACE.length === 0">
                                    <tr><td colspan="3" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Theo Hành Vi Quan Hệ Tình Dục & Bán Dâm -->
    <div class="row">
        <div class="col-xl-4 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                        <i class="fas fa-venus-mars mr-2"></i> Đối tượng quan hệ tình dục
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                <tr>
                                    <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Đối tượng</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Có đa chất</th>
                                    <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Không đa chất</th>
                                </tr>
                            </thead>
                            <tbody>
