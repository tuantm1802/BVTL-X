
@{
    ViewBag.Title = "Trang chủ";
}
<style type="text/css">
    body {
        overflow: auto;
    }
    @@media (min-width: 768px){
        .chart-bar {
            height: 18rem;
        }
        .chart-pie {
            height: 18rem !important;
        }
    }
</style>
<div class="container-fluid" ng-controller="HomeController">
    
    <div class="alert alert-info" role="alert">

        <div class="d-flex justify-content-center" ng-show="isLoading">
            <div class="spinner-border" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <div id="endTimeSyncDisplay"></div>
    </div>

    <div class="row mb-3">
        <div class="col-xl-12 col-lg-12 col-md-12">
            <div class="btn-group">
                <a class="btn btn-secondary btn-sm dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                    {{ selectedTinhName || 'Chọn tỉnh' }}
                </a>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" ng-repeat="tinh in ListCity" ng-click="selectTinh(tinh.Code_Map, tinh.Name)">{{ tinh.Name }}</a>
                </div>
            </div>

            <div class="btn-group">
                <a class="btn btn-secondary btn-sm dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
                    {{ selectedNhomName || 'Chọn nhóm' }}
                </a>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" ng-repeat="nhom in ListNhomTBH" ng-click="selectNhom(nhom.manhom_tbh, nhom.tennhom_tbh)">{{ nhom.tennhom_tbh }}</a>
                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-8 col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tần suất Chemsex trong 3 tháng qua theo độ tuổi</h6>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col" class="col-md-2">Độ tuổi</th>
                                <th scope="col" class="col-md-2">1 - 2 lần</th>
                                <th scope="col" class="col-md-2">Mỗi tháng (3 - 9 lần)</th>
                                <th scope="col" class="col-md-2">Mỗi tuần (1 - 4 lần/tuần)</th>
                                <th scope="col" class="col-md-4">Mỗi ngày hoặc gần như mỗi ngày (5 - 7 lần/tuần)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="dashboard in dbTanSuatChemsex3ThangTheoDoTuoi">
                                <td class="text-center">{{dashboard.MucDoTuoi || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.TanSuat1_2Lan || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.TanSuatMoiThang || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.TanSuatMoiTuan || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.TanSuatMoiNgay || 'N/A'}}</td>
                            </tr>

                            <tr ng-if="!dbTanSuatChemsex3ThangTheoDoTuoi || dbTanSuatChemsex3ThangTheoDoTuoi.length === 0">
                                <td colspan="4"><p class="font-italic">Không có dữ liệu</p></td>
                            </tr>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Sử dụng đa chất trong Chemsex theo độ tuổi</h6>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col" class="col-md-4">Độ tuổi</th>
                                <th scope="col" class="col-md-4">Có sử dụng đa chất</th>
                                <th scope="col" class="col-md-4">Không sử dụng đa chất</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="dashboard in dbSuDungDaChatTrongChemsexTheoDoTuoi">
                                <td class="text-center">{{dashboard.MucDoTuoi || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.CoSuDungDaChat || 'N/A'}}</td>
                                <td class="text-center">{{dashboard.KhongSuDungDaChat || 'N/A'}}</td>
                            </tr>

                            <tr ng-if="!dbSuDungDaChatTrongChemsexTheoDoTuoi || dbSuDungDaChatTrongChemsexTheoDoTuoi.length === 0">
                                <td colspan="4"><p class="font-italic">Không có dữ liệu</p></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-xl-8 col-lg-8 col-md-8">
            <div class="card shadow mb-4">
