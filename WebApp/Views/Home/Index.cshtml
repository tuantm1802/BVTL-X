@{
    ViewBag.Title = "Dashboard Tổng quan Dự án CD45 (DREAMH)";
}

<div class="container-fluid py-3 ng-scope" x-data="alpineHome()" ng-controller="HomeController">

    <!-- Header Section & Quick Actions -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-brain text-primary mr-2"></i> Dashboard Tổng quan Dự án CD45 (DREAMH)
            </h1>
            <p class="text-muted small mb-0">Hệ thống theo dõi &amp; phân tích toàn diện dịch vụ Sức khỏe Tâm thần (QST), Sang chấn PTSD (PCL-5), Khám chuyên khoa và Chuyển gửi cho các nhóm đích.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <!-- Tab Switcher -->
            <div class="btn-group mr-3 shadow-xs" role="group">
                <button type="button" class="btn btn-sm font-weight-bold" 
                        :class="activeTab === 'visual' ? 'btn-primary' : 'btn-outline-primary'" 
                        x-on:click="switchTab('visual')">
                    <i class="fas fa-chart-pie mr-1"></i> Biểu đồ trực quan
                </button>
                <button type="button" class="btn btn-sm font-weight-bold" 
                        :class="activeTab === 'tables' ? 'btn-primary' : 'btn-outline-primary'" 
                        x-on:click="switchTab('tables')">
                    <i class="fas fa-table mr-1"></i> Bảng số liệu chi tiết
                </button>
            </div>
            <button type="button" class="btn btn-white shadow-sm px-3 py-2 font-weight-bold border" x-on:click="loadDashboardData()" style="border-radius: 8px; background: #fff;">
                <i class="fas fa-sync-alt text-primary mr-1" :class="{'fa-spin': isLoading}"></i> Làm mới
            </button>
        </div>
    </div>

    <!-- Sync Notice Banner -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 10px; background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%); border-left: 4px solid #0284c7 !important;">
        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center text-primary font-weight-bold my-1">
                <i class="fas fa-shield-alt fa-lg mr-2" style="color: #0284c7;"></i>
                <span class="text-dark">Dữ liệu đồng bộ lần cuối lúc: <b class="text-primary ml-1" x-text="lastSyncTime"></b></span>
            </div>
            <div class="my-1">
                <span class="badge px-3 py-2 font-weight-bold shadow-xs" style="background-color: #0284c7; color: #fff;">
                    <i class="fas fa-database mr-1"></i> Nguồn dữ liệu: Dự án CD45 (DREAMH) - SCDI
                </span>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body py-3">
            <div class="row align-items-end">
                <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="fas fa-map-marker-alt text-danger mr-1"></i> Tỉnh / Thành phố:</label>
                    <select class="form-control bg-light" x-model="selectedTinh" x-on:change="selectCity($event.target.value)" style="border-radius: 8px;">
                        <option value="">-- Toàn bộ Tỉnh / Thành --</option>
                        <template x-for="t in ListCity" :key="t.CityCode">
                            <option :value="t.CityCode" x-text="t.CityName"></option>
                        </template>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="fas fa-users text-primary mr-1"></i> Nhóm Tiếp cận (CBO):</label>
                    <select class="form-control bg-light" x-model="selectedNhom" x-on:change="selectNhom($event.target.value)" style="border-radius: 8px;">
                        <option value="">-- Toàn bộ Nhóm CBO --</option>
                        <template x-for="n in ListNhom" :key="n.MaNhom">
                            <option :value="n.MaNhom" x-text="n.TenNhom + ' (' + (n.CityCode || '') + ')'"></option>
                        </template>
                    </select>
                </div>

                <div class="col-lg-2 col-md-4 mb-2 mb-lg-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="far fa-calendar-alt text-secondary mr-1"></i> Từ ngày:</label>
                    <input type="text" class="form-control bg-light datepicker" placeholder="dd/MM/yyyy" x-model="fromDate" x-on:change="loadDashboardData()" style="border-radius: 8px;" />
                </div>

                <div class="col-lg-2 col-md-4 mb-2 mb-lg-0">
                    <label class="small font-weight-bold text-dark mb-1"><i class="far fa-calendar-alt text-secondary mr-1"></i> Đến ngày:</label>
                    <input type="text" class="form-control bg-light datepicker" placeholder="dd/MM/yyyy" x-model="toDate" x-on:change="loadDashboardData()" style="border-radius: 8px;" />
                </div>

                <div class="col-lg-2 col-md-4 text-md-right mb-2 mb-lg-0">
                    <button type="button" class="btn btn-light btn-block font-weight-bold text-secondary border py-2" x-on:click="resetFilters()" style="border-radius: 8px;">
                        <i class="fas fa-undo mr-1"></i> Đặt lại
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Metric Overview Cards (4 Tầng KPI) -->
    <div class="row mb-4">
        <!-- Card 1: Tổng khách hàng -->
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #3b82f6 !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng KH được chăm sóc</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" x-text="overview.TongKhachHang">0</div>
                            <div class="small text-muted mt-1">Lũy kế khách hàng tham gia</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(59, 130, 246, 0.1);">
                                <i class="fas fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Sàng lọc QST & Nguy cơ cao -->
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #f59e0b !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Sàng lọc SKTT (QST)</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" x-text="overview.TongSangLocQST">0</div>
                            <div class="small font-weight-bold text-danger mt-1">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                <span x-text="overview.QSTNguyCoCao">0</span> ca nguy cơ cao (<span x-text="overview.TyLeQSTNguyCoCao">0</span>%)
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(245, 158, 11, 0.15);">
                                <i class="fas fa-brain fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Khám Chuyên khoa SKTT -->
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #10b981 !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Khám Chuyên khoa SKTT</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" x-text="overview.TongKhamSKTT">0</div>
                            <div class="small text-muted mt-1">
                                <span class="badge badge-success px-2 py-1" x-text="overview.TongLuotKhamSKTT + ' lượt khám'">0 lượt khám</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(16, 185, 129, 0.1);">
                                <i class="fas fa-user-md fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Tư vấn Tâm lý & PTSD -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #8b5cf6 !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-purple text-uppercase mb-1" style="color: #8b5cf6;">Tư vấn Tâm lý Chuyên sâu</div>
                            <div class="h3 mb-0 font-weight-bold text-gray-800" x-text="overview.TongTuVanL1">0</div>
                            <div class="small text-muted mt-1">Đánh giá PTSD, AUDIT-C, Kỳ thị</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(139, 92, 246, 0.1);">
                                <i class="fas fa-hands-helping fa-2x" style="color: #8b5cf6;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: BIỂU ĐỒ TRỰC QUAN (VISUAL CHARTS) -->
    <!-- ========================================================================= -->
    <div x-show="activeTab === 'visual'" x-transition:enter="animate__animated animate__fadeIn">

        <!-- Row 1: Cascade Funnel & Province Distribution -->
        <div class="row">
            <!-- Cascade Funnel -->
            <div class="col-xl-8 col-lg-8 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-filter mr-2"></i> Phễu Dịch vụ Chăm sóc SKTT Toàn diện (Care Cascade)
                        </h6>
                        <span class="badge badge-light border text-muted">Luồng can thiệp liên tục</span>
                    </div>
                    <div class="card-body">
                        <div style="height: 280px; position: relative;">
                            <canvas id="chartFunnel"></canvas>
                        </div>
                        <div class="row text-center mt-3 pt-2 border-top">
                            <div class="col-4 border-right">
                                <div class="text-xs text-muted">Tỷ lệ Sàng lọc QST</div>
                                <div class="h6 font-weight-bold text-info mb-0" 
                                     x-text="cascadeFunnel.Step1_TiepCanTruyenThong > 0 ? ((cascadeFunnel.Step2_SangLocQST / cascadeFunnel.Step1_TiepCanTruyenThong) * 100).toFixed(1) + '%' : '0%'"></div>
                            </div>
                            <div class="col-4 border-right">
                                <div class="text-xs text-muted">Tỷ lệ Nguy cơ cao / Sàng lọc</div>
                                <div class="h6 font-weight-bold text-warning mb-0" 
                                     x-text="cascadeFunnel.Step2_SangLocQST > 0 ? ((cascadeFunnel.Step3_NguyCoCaoQST / cascadeFunnel.Step2_SangLocQST) * 100).toFixed(1) + '%' : '0%'"></div>
                            </div>
                            <div class="col-4">
                                <div class="text-xs text-muted">Tỷ lệ Tái khám SKTT</div>
                                <div class="h6 font-weight-bold text-success mb-0" 
                                     x-text="cascadeFunnel.Step5_KhamChuyenKhoa > 0 ? ((cascadeFunnel.Step6_TaiKhamSKTT / cascadeFunnel.Step5_KhamChuyenKhoa) * 100).toFixed(1) + '%' : '0%'"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Province Donut -->
            <div class="col-xl-4 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-map-marked-alt mr-2"></i> Phân bố KH theo Tỉnh / Thành
                        </h6>
                    </div>
                    <div class="card-body">
                        <div style="height: 280px; position: relative;">
                            <canvas id="chartProvince"></canvas>
                        </div>
                        <div class="mt-2 text-center small text-muted">
                            Tổng 6 tỉnh thành trọng điểm tham gia dự án
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: QST by Target Group & Age Group -->
        <div class="row">
            <!-- QST by Target Group -->
            <div class="col-xl-7 col-lg-7 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-layer-group mr-2"></i> Mức độ Nguy cơ QST theo Nhóm Đối tượng Đích
                        </h6>
                        <span class="badge badge-light border text-muted">Mức 1 đến Mức 4</span>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px; position: relative;">
                            <canvas id="chartQstTargetGroup"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- QST by Age Group -->
            <div class="col-xl-5 col-lg-5 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-calendar-alt mr-2"></i> Phân bố Nguy cơ QST theo Nhóm tuổi
                        </h6>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px; position: relative;">
                            <canvas id="chartQstAgeGroup"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: PTSD PCL-5 & Social Support Highlights -->
        <div class="row">
            <!-- PTSD PCL-5 -->
            <div class="col-xl-6 col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-danger d-flex align-items-center">
                            <i class="fas fa-heartbeat mr-2"></i> Đánh giá Sang chấn PTSD (Thang PCL-5)
                        </h6>
                        <span class="badge badge-light border text-muted">Dương tính vs Âm tính</span>
                    </div>
                    <div class="card-body">
                        <div style="height: 280px; position: relative;">
                            <canvas id="chartPcl5"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Referral & Social Support Summary -->
            <div class="col-xl-6 col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-hands-helping mr-2"></i> Dịch vụ Chuyển gửi &amp; Hỗ trợ Xã hội
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <div class="p-3 border rounded shadow-xs" style="background: #f8fafc;">
                                    <div class="text-xs text-muted text-uppercase font-weight-bold">Thẻ Bảo hiểm y tế (BHYT)</div>
                                    <div class="h4 font-weight-bold text-primary mb-0 mt-1" x-text="socialSupport.HoTroBHYT || 0"></div>
                                    <div class="small text-muted">Khách hàng được hỗ trợ mua thẻ</div>
                                </div>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <div class="p-3 border rounded shadow-xs" style="background: #f8fafc;">
                                    <div class="text-xs text-muted text-uppercase font-weight-bold">Tư vấn &amp; XN nhanh HIV</div>
                                    <div class="h4 font-weight-bold text-danger mb-0 mt-1" x-text="socialSupport.XetNghiemHIV || 0"></div>
                                    <div class="small text-muted">Khách hàng được xét nghiệm HIV</div>
                                </div>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <div class="p-3 border rounded shadow-xs" style="background: #f8fafc;">
                                    <div class="text-xs text-muted text-uppercase font-weight-bold">Hỗ trợ Điều trị Methadone</div>
                                    <div class="h4 font-weight-bold text-success mb-0 mt-1" x-text="socialSupport.HoTroMethadone || 0"></div>
                                    <div class="small text-muted">Hỗ trợ chi phí điều trị Methadone</div>
                                </div>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <div class="p-3 border rounded shadow-xs" style="background: #f8fafc;">
                                    <div class="text-xs text-muted text-uppercase font-weight-bold">Tài liệu Truyền thông đã phát</div>
                                    <div class="h4 font-weight-bold text-purple mb-0 mt-1" style="color: #8b5cf6;" x-text="overview.TongTaiLieuPhat || 0"></div>
                                    <div class="small text-muted">Quyển cẩm nang SKTT đã phát</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 2: BẢNG SỐ LIỆU PHÂN TÍCH CHI TIẾT (DATA TABLES) -->
    <!-- ========================================================================= -->
    <div x-show="activeTab === 'tables'" x-transition:enter="animate__animated animate__fadeIn">

        <!-- Table 1: Sàng lọc QST theo Nhóm đích -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between flex-wrap" style="gap: 10px;">
                <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                    <i class="fas fa-table mr-2"></i> Bảng 1: Sàng lọc Sức khỏe Tâm thần (QST) theo Nhóm Đối tượng Đích
                </h6>
                <div class="d-flex align-items-center">
                    <label class="small text-muted font-weight-bold mb-0 mr-2" style="white-space: nowrap;">
                        <i class="fas fa-filter text-primary mr-1"></i> Lọc độ tuổi:
                    </label>
                    <select class="form-control form-control-sm shadow-none" 
                            style="width: 170px; font-weight: 600; border-color: #cbd5e1; border-radius: 6px;"
                            x-model="selectedAgeTable1"
                            x-on:change="loadDashboardData()">
                        <option value="">-- Tất cả độ tuổi --</option>
                        <option value="< 18">&lt; 18 tuổi</option>
                        <option value="18 - 25">18 - 25 tuổi</option>
                        <option value="26 - 35">26 - 35 tuổi</option>
                        <option value=">= 36">&gt;= 36 tuổi</option>
                        <option value="Chưa xác định">Chưa xác định</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                            <tr>
                                <th class="text-secondary text-uppercase font-weight-bold py-3 pl-4" style="font-size: 0.75rem;">Nhóm đối tượng</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tổng KH</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Đã sàng lọc QST</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem; color: #ef4444 !important;">Mức 1 (>=8)</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem; color: #f97316 !important;">Mức 2 (6-7)</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem; color: #3b82f6 !important;">Mức 3 (4-5)</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem; color: #10b981 !important;">Mức 4 (&lt;4)</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="font-size: 0.75rem;">Tỷ lệ Nguy cơ cao</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="g in byTargetGroup" :key="g.DoiTuongId">
                                <tr>
                                    <td class="font-weight-bold text-dark pl-4" x-text="g.TenDoiTuong || '—'"></td>
                                    <td class="text-center font-weight-bold text-gray-800" x-text="g.TongKH || 0"></td>
                                    <td class="text-center font-weight-bold text-info" x-text="g.SoKHSangLoc || 0"></td>
                                    <td class="text-center font-weight-bold text-danger" x-text="g.Muc1_RatCao || 0"></td>
                                    <td class="text-center font-weight-bold" style="color: #f97316;" x-text="g.Muc2_Cao || 0"></td>
                                    <td class="text-center font-weight-bold text-primary" x-text="g.Muc3_TrungBinh || 0"></td>
                                    <td class="text-center font-weight-bold text-success" x-text="g.Muc4_Thap || 0"></td>
                                    <td class="text-center font-weight-bold pr-4">
                                        <span class="badge" 
                                              :class="g.TyLeNguyCoCao > 40 ? 'badge-danger' : 'badge-warning'" 
                                              x-text="(g.TyLeNguyCoCao || 0) + '%'"></span>
                                    </td>
                                </tr>
                            </template>
                            <template x-if="!byTargetGroup || byTargetGroup.length === 0">
                                <tr><td colspan="8" class="text-center py-4 text-muted font-italic">Không có dữ liệu</td></tr>
                            </template>
                        </tbody>
                        <tfoot style="background-color: #f1f5f9; font-weight: bold; border-top: 2px solid #cbd5e1;">
                            <tr>
                                <td class="pl-4 text-primary font-weight-bold">TỔNG CỘNG</td>
                                <td class="text-center font-weight-bold text-dark" x-text="getTotalTable1('TongKH')"></td>
                                <td class="text-center font-weight-bold text-info" x-text="getTotalTable1('SoKHSangLoc')"></td>
                                <td class="text-center font-weight-bold text-danger" x-text="getTotalTable1('Muc1_RatCao')"></td>
                                <td class="text-center font-weight-bold" style="color: #f97316;" x-text="getTotalTable1('Muc2_Cao')"></td>
                                <td class="text-center font-weight-bold text-primary" x-text="getTotalTable1('Muc3_TrungBinh')"></td>
                                <td class="text-center font-weight-bold text-success" x-text="getTotalTable1('Muc4_Thap')"></td>
                                <td class="text-center font-weight-bold pr-4">
                                    <span class="badge badge-primary px-2 py-1" x-text="getTotalTable1NguyCoCaoPct()"></span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Table 2: Sàng lọc QST theo Nhóm tuổi & Table 3: Lâm sàng SKTT -->
        <div class="row">
            <!-- Table 2 -->
            <div class="col-xl-6 col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                            <i class="fas fa-user-clock mr-2"></i> Bảng 2: Phân bố QST theo Độ tuổi
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                    <tr>
                                        <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Nhóm tuổi</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tổng KH</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mức 1</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mức 2</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mức 3</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Mức 4</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template x-for="a in byAgeGroup" :key="a.NhomTuoi">
                                        <tr>
                                            <td class="font-weight-bold text-dark pl-3" x-text="a.NhomTuoi"></td>
                                            <td class="text-center font-weight-bold text-gray-800" x-text="a.TongKH || 0"></td>
                                            <td class="text-center font-weight-bold text-danger" x-text="a.Muc1 || 0"></td>
                                            <td class="text-center font-weight-bold" style="color: #f97316;" x-text="a.Muc2 || 0"></td>
                                            <td class="text-center font-weight-bold text-primary" x-text="a.Muc3 || 0"></td>
                                            <td class="text-center font-weight-bold text-success pr-3" x-text="a.Muc4 || 0"></td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table 3: Lâm sàng PTSD & Alcohol & Stigma -->
            <div class="col-xl-6 col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="m-0 font-weight-bold text-danger d-flex align-items-center">
                            <i class="fas fa-stethoscope mr-2"></i> Bảng 3: Chỉ số Lâm sàng PTSD, Rượu &amp; Kỳ thị
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                                    <tr>
                                        <th class="text-secondary text-uppercase font-weight-bold py-3 pl-3" style="font-size: 0.75rem;">Nhóm</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Ca tư vấn</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">PTSD Dương</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tỷ lệ PTSD</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Điểm Rượu</th>
                                        <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-3" style="font-size: 0.75rem;">Điểm Kỳ thị</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template x-for="m in mentalHealth" :key="m.DoiTuongId">
                                        <tr>
                                            <td class="font-weight-bold text-dark pl-3" x-text="m.TenDoiTuong"></td>
                                            <td class="text-center font-weight-bold text-gray-800" x-text="m.SoCaTuVan || 0"></td>
                                            <td class="text-center font-weight-bold text-danger" x-text="m.PCL5_DuongTinh || 0"></td>
                                            <td class="text-center font-weight-bold">
                                                <span class="badge badge-danger px-2 py-1" x-text="(m.TyLePCL5DuongTinh || 0) + '%'"></span>
                                            </td>
                                            <td class="text-center font-weight-bold text-warning" x-text="m.DiemAuditCTB || 0"></td>
                                            <td class="text-center font-weight-bold text-purple pr-3" style="color: #8b5cf6;" x-text="m.DiemKyThiTB || 0"></td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table 4: Phân bố theo Tỉnh thành -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                    <i class="fas fa-map-marker-alt mr-2"></i> Bảng 4: Phân bố Hoạt động theo Tỉnh / Thành phố
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                            <tr>
                                <th class="text-secondary text-uppercase font-weight-bold py-3 pl-4" style="font-size: 0.75rem;">Mã tỉnh</th>
                                <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tên Tỉnh / Thành phố</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tổng KH</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Sàng lọc QST</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Khám BS SKTT</th>
                                <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="font-size: 0.75rem;">Tư vấn Tâm lý</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="p in byProvince" :key="p.CityCode">
                                <tr>
                                    <td class="font-weight-bold text-secondary pl-4" x-text="p.CityCode"></td>
                                    <td class="font-weight-bold text-dark" x-text="p.CityName"></td>
                                    <td class="text-center font-weight-bold text-primary" x-text="p.TongKH || 0"></td>
                                    <td class="text-center font-weight-bold text-info" x-text="p.SangLocQST || 0"></td>
                                    <td class="text-center font-weight-bold text-success" x-text="p.KhamSKTT || 0"></td>
                                    <td class="text-center font-weight-bold text-purple pr-4" style="color: #8b5cf6;" x-text="p.TuVanL1 || 0"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts{
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/app/Controller/AlpineHomeController.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/app/Controller/HomeController.js?v=@DateTime.Now.Ticks"></script>
}