
@{
    ViewBag.Title = "Trang chủ";
}
<style type="text/css">
    body {
        overflow: auto;
    }
    @@media (min-width: 768px){
        .chart-bar {
            height: 18rem;
        }
        .chart-pie {
            height: 18rem !important;
        }
    }
</style>
<div class="container-fluid" ng-controller="HomeController">
    <div class="row">
        <div class="col-xl-8 col-lg-8 col-md-8">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tần suất Chemsex trong 3 tháng qua theo độ tuổi</h6>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col" class="col-md-2">Độ tuổi</th>
                                <th scope="col" class="col-md-2">1 - 2 lần</th>
                                <th scope="col" class="col-md-2">Mỗi tháng</th>
                                <th scope="col" class="col-md-2">Mỗi tuần</th>
                                <th scope="col" class="col-md-4">Mỗi ngày hoặc gần như mỗi ngày</th>                                
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="dichvu in dbTanSuatChemsex3ThangTheoDoTuoi">
                                <td>Lần {{$index + 1}}</td>
                                <td>{{parseDate(dichvu.NgayTuVan) | date:'dd/MM/yyyy'}}</td>
                                <td>{{dichvu.HanhViNguyCo || 'N/A'}}</td>
                                <td>{{dichvu.SucKhoeTheChat || 'N/A'}}</td>
                                <td>{{dichvu.SucKhoeTamThan || 'N/A'}}</td>                                
                            </tr>

                            <tr ng-if="!dbTanSuatChemsex3ThangTheoDoTuoi || dbTanSuatChemsex3ThangTheoDoTuoi.length === 0">
                                <td colspan="4"><p class="font-italic">Không có dữ liệu</p></td>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Sử dụng đa chất trong Chemsex theo độ tuổi</h6>
                </div>
                <div class="card-body">
                    
                </div>
            </div>
        </div>
    </div>
    <div class="row">
       
        <!-- Tình trạng HIV -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-0">
                        <canvas id="hivTinhTrangChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- HIV Giới tính -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Giới tính</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="hivGioiTinhChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Theo Đối tượng -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Đối tượng</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="hivDoiTuongChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- HIV Độ tuổi -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Độ tuổi</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie">
                        <canvas id="hivDoTuoiChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
        <div class="row" style="display:none">
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>                        
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                        
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                       
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>

    
</div>
@section Scripts{
    <script src="~/Scripts/chart.js"></script>
    <script src="~/Scripts/chartjs-plugin-datalabels.js"></script>    
    <script src="~/app/Controller/HomeController.js"></script>
}