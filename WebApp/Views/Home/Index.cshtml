                                <th scope="col" class="col-md-2">Mỗi tuần (1 - 4 lần/tuần)</th>
                                <th scope="col" class="col-md-4">Mỗi ngày hoặc gần như mỗi ngày (5 - 7 lần/tuần)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="dashboard in dbTanSuatChemsex3ThangTheoDiemAssist">
                                <td class="text-center">{{dashboard.MucDoNguyCo || 'N/A'}}</td>
                                <td class="text-center">
                                    {{dashboard.TanSuat1_2Lan !== null && dashboard.TanSuat1_2Lan >= 0 ? dashboard.TanSuat1_2Lan : 'N/A'}}
                                </td>
                                <td class="text-center">
                                    {{dashboard.TanSuatMoiThang !== null && dashboard.TanSuatMoiThang >= 0 ? dashboard.TanSuatMoiThang : 'N/A'}}
                                </td>
                                <td class="text-center">
                                    {{dashboard.TanSuatMoiTuan !== null && dashboard.TanSuatMoiTuan >= 0 ? dashboard.TanSuatMoiTuan : 'N/A'}}                                    
                                </td>
                                <td class="text-center">
