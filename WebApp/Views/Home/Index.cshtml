        <!-- Tình trạng HIV -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-0">
                        <canvas id="hivTinhTrangChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- HIV Giới tính -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Giới tính</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="hivGioiTinhChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Theo Đối tượng -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Đối tượng</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="hivDoiTuongChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- HIV Độ tuổi -->
        <div class="col-xl-3 col-lg-5">
            <div class="card shadow mb-2">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tình trạng HIV theo Độ tuổi</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie">
                        <canvas id="hivDoTuoiChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
        <div class="row" style="display:none">
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>                        
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                        
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                       
                    </div>
                </div>
            </div>
            <!-- Donut Chart -->
            <div class="col-xl-3 col-lg-5">
                <div class="card shadow mb-4">
                    <!-- Card Header - Dropdown -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Donut Chart</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="chart-pie pt-4">
                            <canvas id="myPieChart"></canvas>
                        </div>
                       
                    </div>
                </div>
            </div>
