@{
    ViewBag.Title = "Báo cáo Hoạt động & Chỉ số (CD45 - DREAMH)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" x-data="alpineBaoCaoCD45">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <i class="fas fa-chart-line text-primary mr-2"></i>BÁO CÁO HOẠT ĐỘNG & CHỈ SỐ - DỰ ÁN CD45 (DREAMH)
        </h1>
    </div>

    <!-- Filter Card -->
    <div class="card shadow mb-4">
        <div class="card-header py-2 bg-gradient-primary text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold"><i class="fas fa-filter mr-1"></i> Bộ lọc báo cáo</h6>
        </div>
        <div class="card-body py-3">
            <div class="row">
                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Kỳ báo cáo</label>
                    <select class="form-control form-control-sm" x-model="loaiKy" x-on:change="updateDateRange()">
                        <option value="Thang">Theo Tháng (26-25)</option>
                        <option value="Quy">Theo Quý</option>
                        <option value="6Thang">6 Tháng</option>
                        <option value="12Thang">12 Tháng / Năm</option>
                        <option value="TuyChon">Tùy chọn ngày</option>
                    </select>
                </div>

                <div class="col-md-2 mb-2" x-show="loaiKy === 'Thang'">
                    <label class="font-weight-bold small">Tháng</label>
                    <select class="form-control form-control-sm" x-model="thang" x-on:change="updateDateRange()">
                        <option value="1">Tháng 1</option>
                        <option value="2">Tháng 2</option>
                        <option value="3">Tháng 3</option>
                        <option value="4">Tháng 4</option>
                        <option value="5">Tháng 5</option>
                        <option value="6">Tháng 6</option>
                        <option value="7">Tháng 7</option>
                        <option value="8">Tháng 8</option>
                        <option value="9">Tháng 9</option>
                        <option value="10">Tháng 10</option>
                        <option value="11">Tháng 11</option>
                        <option value="12">Tháng 12</option>
                    </select>
                </div>

                <div class="col-md-2 mb-2" x-show="loaiKy === 'Quy'">
                    <label class="font-weight-bold small">Quý</label>
                    <select class="form-control form-control-sm" x-model="quy" x-on:change="updateDateRange()">
                        <option value="I">Quý I</option>
                        <option value="II">Quý II</option>
                        <option value="III">Quý III</option>
                        <option value="IV">Quý IV</option>
                    </select>
                </div>

                <div class="col-md-2 mb-2" x-show="loaiKy === '6Thang'">
                    <label class="font-weight-bold small">Kỳ 6 Tháng</label>
                    <select class="form-control form-control-sm" x-model="ky6Thang" x-on:change="updateDateRange()">
                        <option value="1">6 Tháng đầu năm</option>
                        <option value="2">6 Tháng cuối năm</option>
                    </select>
                </div>

                <div class="col-md-1 mb-2" x-show="loaiKy !== 'TuyChon'">
                    <label class="font-weight-bold small">Năm</label>
                    <input type="number" class="form-control form-control-sm" x-model="nam" x-on:change="updateDateRange()" />
                </div>

                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Từ ngày</label>
                    <input type="text" class="form-control form-control-sm datepicker" x-model="fromDate" placeholder="dd/mm/yyyy" />
                </div>

                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Đến ngày</label>
                    <input type="text" class="form-control form-control-sm datepicker" x-model="toDate" placeholder="dd/mm/yyyy" />
                </div>

                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Tỉnh / Thành phố</label>
                    <select class="form-control form-control-sm" x-model="selectedCity" x-on:change="onCityChange()">
                        <option value="">-- Toàn dự án --</option>
                        <template x-for="c in listCities" :key="c.CityCode">
                            <option :value="c.CityCode" x-text="c.CityName + ' (' + c.CityCode + ')'"></option>
                        </template>
                    </select>
                </div>

                <div class="col-md-2 mb-2">
                    <label class="font-weight-bold small">Nhóm (CBO)</label>
                    <select class="form-control form-control-sm" x-model="selectedNhom">
                        <option value="">-- Tất cả nhóm --</option>
                        <template x-for="n in filteredNhoms" :key="n.manhom_tbh">
                            <option :value="n.manhom_tbh" x-text="n.tennhom_tbh + ' (' + n.manhom_tbh + ')'"></option>
                        </template>
                    </select>
                </div>

                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <button class="btn btn-primary btn-sm mr-2 shadow-sm" x-on:click="loadData()">
                        <i class="fas fa-search fa-sm"></i> Tìm kiếm
                    </button>
                    <button class="btn btn-success btn-sm shadow-sm" x-on:click="exportExcel()">
                        <i class="fas fa-file-excel fa-sm"></i> Xuất Excel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow mb-4">
        <div class="card-header py-2 bg-light d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-table mr-1"></i> Bảng số liệu Báo cáo kết quả hoạt động</h6>
            <span class="badge badge-info" x-text="'Kỳ: ' + fromDate + ' - ' + toDate"></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" style="font-size: 13.5px;">
                    <thead class="bg-primary text-white text-center">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Thông tin báo cáo</th>
                            <th style="width: 85px;" class="bg-dark text-white">Tổng</th>
                            <th style="width: 75px;">PUD</th>
                            <th style="width: 75px;">PLHIV</th>
                            <th style="width: 75px;">TG</th>
                            <th style="width: 75px;">SW</th>
                            <th style="width: 75px;">MSM</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(item, index) in items" :key="index">
                            <tr :class="item.IsBold ? 'bg-warning font-weight-bold text-dark' : ''">
                                <td class="text-center font-weight-bold" x-text="item.STT"></td>
                                <td :class="item.IndentLevel === 1 ? 'pl-4 text-muted' : ''">
                                    <span x-text="item.ChiTieu"></span>
                                </td>
                                <td class="text-right font-weight-bold text-primary" 
                                    :style="item.Tong > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'Tong', 'Tổng')" 
                                    x-text="formatNumber(item.Tong)"></td>
                                <td class="text-right" 
                                    :style="item.PUD > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'PUD', 'PUD')" 
                                    x-text="formatNumber(item.PUD)"></td>
                                <td class="text-right" 
                                    :style="item.PLHIV > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'PLHIV', 'PLHIV')" 
                                    x-text="formatNumber(item.PLHIV)"></td>
                                <td class="text-right" 
                                    :style="item.TG > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'TG', 'TG')" 
                                    x-text="formatNumber(item.TG)"></td>
                                <td class="text-right" 
                                    :style="item.SW > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'SW', 'SW')" 
                                    x-text="formatNumber(item.SW)"></td>
                                <td class="text-right" 
                                    :style="item.MSM > 0 ? 'cursor:pointer; text-decoration:underline;' : ''" 
                                    x-on:click="openDrillDown(item, 'MSM', 'MSM')" 
                                    x-text="formatNumber(item.MSM)"></td>
                            </tr>
                        </template>
                        <tr x-show="items.length === 0 && !isLoading">
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                                Không có dữ liệu trong khoảng thời gian này
                            </td>
                        </tr>
                        <tr x-show="isLoading">
                            <td colspan="8" class="text-center py-4 text-primary">
                                <i class="fas fa-spinner fa-spin fa-2x d-block mb-2"></i>
                                Đang tổng hợp số liệu báo cáo...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Drill-down xem danh sách khách hàng -->
    <div class="modal fade" id="modalDrillDown" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header bg-gradient-primary text-white py-2">
                    <h6 class="modal-title font-weight-bold" style="font-size: 15px;">
                        <i class="fas fa-list-ul mr-2"></i><span x-text="drillModalTitle"></span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" x-on:click="closeDrillDown()" style="background:none; border:none; font-size:1.5rem; line-height:1; color:#fff; opacity:0.9;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="w-50">
                            <input type="text" class="form-control form-control-sm" placeholder="Tìm nhanh mã KH, tỉnh, nhóm, TCV..." x-model="drillSearchText" x-on:input="filterDrill()" />
                        </div>
                        <div>
                            <span class="badge badge-success" x-text="'Tổng số: ' + filteredDrillItems.length + ' bản ghi'"></span>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-bordered table-sm table-striped table-hover mb-0" style="font-size: 13px;">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th style="width: 40px;" class="text-center">#</th>
                                    <th style="width: 120px;">Mã Khách hàng</th>
                                    <th style="width: 70px;" class="text-center">Tỉnh</th>
                                    <th style="width: 90px;" class="text-center">Nhóm</th>
                                    <th style="width: 80px;" class="text-center">TCV</th>
                                    <th style="width: 90px;" class="text-center">Quần thể</th>
                                    <th style="width: 100px;" class="text-center">Ngày</th>
                                    <th>Thông tin chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="(d, idx) in filteredDrillItems" :key="idx">
                                    <tr>
                                        <td class="text-center text-muted" x-text="idx + 1"></td>
                                        <td class="font-weight-bold text-primary" x-text="d.RECORD_ID"></td>
                                        <td class="text-center" x-text="d.CITY_CODE"></td>
                                        <td class="text-center" x-text="d.MA_NHOM"></td>
                                        <td class="text-center" x-text="d.MA_TCV || '-'"></td>
                                        <td class="text-center">
                                            <span class="badge badge-info" x-text="d.DOI_TUONG_TEXT"></span>
                                        </td>
                                        <td class="text-center" x-text="d.NGAY_THUC_HIEN"></td>
                                        <td x-text="d.CHI_TIET"></td>
                                    </tr>
                                </template>
                                <tr x-show="filteredDrillItems.length === 0 && !isDrillLoading">
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        Không tìm thấy bản ghi nào phù hợp
                                    </td>
                                </tr>
                                <tr x-show="isDrillLoading">
                                    <td colspan="8" class="text-center py-4 text-primary">
                                        <i class="fas fa-spinner fa-spin fa-2x d-block mb-2"></i>
                                        Đang trích xuất danh sách khách hàng...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal" data-bs-dismiss="modal" x-on:click="closeDrillDown()">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/app/Controller/AlpineBaoCaoCD45Controller.js?v=@DateTime.Now.Ticks"></script>
    <script>
        $(document).ready(function () {
            $('.datepicker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true,
                todayHighlight: true
            }).on('changeDate', function (e) {
                var modelName = $(this).attr('x-model');
                var val = $(this).val();
                if (modelName === 'fromDate') {
                    document.querySelector('[x-data=alpineBaoCaoCD45]')._x_dataStack[0].fromDate = val;
                } else if (modelName === 'toDate') {
                    document.querySelector('[x-data=alpineBaoCaoCD45]')._x_dataStack[0].toDate = val;
                }
            });
        });
    </script>
}
