@model  System.Collections.Generic.List<Model.ModelExtend.KetQuaASSISTPageModel>
@{
    ViewBag.Title = "Kết quả ASSIST";
}
<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>
<div class="container-fluid" x-data="alpineKetQuaASSIST()">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Kết quả ASSIST</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                @*<div class="row">
                <div class="col-sm-1">
            <label>Từ khóa</label>
        </div>
        <div class="col-sm-4">
            <input type="text" class="form-control" ng-model="modelSearch.KeyWord" />
        </div>
        <div class="col-sm-1">
            <label>Dự án</label>s
        </div>
        <div class="col-sm-4">
            <select class="form-control" ui-select2 ng-model="modelSearch.MaDuAn" name="MaDuAn" ng-options="item.Code as item.Name for item in ListDuAn">
                </select>
        </div>
                <div class="col-sm-2">
                    <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-primary" ng-click="ExportExcel()">
                        <i class="fas fa-pencil-alt"></i> Xuất Excel
                    </button>
                </div>
            </div>*@
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableKetQuaASSIST" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th rowspan="2" style="width: auto;">Dự án </th>
                            <th rowspan="2" style="width: auto;">Tỉnh </th>
                            <th rowspan="2" style="width: auto;">Record ID</th>
                            <th rowspan="2" style="width:9%;">Mã nhóm</th>
                            <th rowspan="2" style="width:auto;">Tên nhóm </th>
                            <th rowspan="2" style="width:9%;">Mã KH</th>
                            @*<th rowspan="2" style="width:auto;">Họ tên KH </th>*@
                            <th rowspan="2" style="width:9%;">Ngày số liệu</th>
                            <th colspan="2" style="width:9%;">Thuốc lá</th>
                            <th colspan="2" style="width:9%;">Cồn rượu</th>
                            <th colspan="2" style="width:9%;">Cần sa</th>
                            <th colspan="2" style="width:9%;">Co ca in</th>
                            <th colspan="2" style="width:9%;">Ma túy đá</th>
                            <th colspan="2" style="width:9%;">khixonghit</th>
                            <th colspan="2" style="width:9%;">Thuốc an thần</th>
                            <th colspan="2" style="width:9%;">Chất gây ảo giác</th>
                            <th colspan="2" style="width:9%;">Thuốc phiện</th>
                            <th colspan="2" style="width:9%;">Chất khác</th>
                        </tr>
                        <tr>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                            <th>Điểm</th>
                            <th>Nguy cơ</th>
                        </tr>
                    </thead>
                    @{
                        TimeZoneInfo cstZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");

                        foreach (var item in Model)
                        {
                            DateTime dNgayTiepCan = TimeZoneInfo.ConvertTimeFromUtc(item.ngaysl, cstZone);

                            var stt = 1;
                                        <tr>
                                            <td class="text-left">@item.maduan</td>
                                            <td class="text-left">@item.CityName</td>
                                            <td class="text-left">@item.record_id</td>
                                            <td class="text-left">@item.manhom_tbh</td>
                                            <td class="text-left">@item.tennhom_tbh</td>
                                            <td class="text-left">@item.makh</td>
                                            @*<td class="text-left">@item.hoten</td>*@
                                            @*<td class="text-center">@(item.ngaysl != null ? item.ngaysl.ToString("yyyy-MM-dd") : string.Empty )</td>*@
                                            @*<td class="text-left">@item.ngaysltext</td>*@
                                            <td class="text-center">@String.Format("{0:dd/MM/yyyy}", dNgayTiepCan)</td>
                                            <td class="text-left">@item.thuocla_diem</td>
                                            <td class="text-left">@item.thuocla_nguyco</td>
                                            <td class="text-left">@item.conruou_diem</td>
                                            <td class="text-left">@item.conruou_nguyco</td>
                                            <td class="text-left">@item.cansa_diem</td>
                                            <td class="text-left">@item.cansa_nguyco</td>
                                            <td class="text-left">@item.cocaine_diem</td>
                                            <td class="text-left">@item.cocaine_nguyco</td>
                                            <td class="text-left">@item.matuyda_diem</td>
                                            <td class="text-left">@item.matuyda_nguyco</td>
                                            <td class="text-left">@item.khixonghit_diem</td>
                                            <td class="text-left">@item.khixonghit_nguyco</td>
                                            <td class="text-left">@item.thuocanthan_diem</td>
                                            <td class="text-left">@item.thuocanthan_nguyco</td>
                                            <td class="text-left">@item.chatgayaogiac_diem</td>
                                            <td class="text-left">@item.chatgayaogiac_nguyco</td>
                                            <td class="text-left">@item.thuocphien_diem</td>
                                            <td class="text-left">@item.thuocphien_nguyco</td>
                                            <td class="text-left">@item.chatkhac_diem</td>
                                            <td class="text-left">@item.chatkhac_nguyco</td>
                                        </tr>
                            stt++;
                        }
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineKetQuaASSIST.js?v=@DateTime.Now.Ticks"></script>
}
