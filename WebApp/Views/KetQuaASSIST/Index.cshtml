@model System.Collections.Generic.List<Model.ModelExtend.KetQuaASSISTPageModel>
@{
    ViewBag.Title = "Báo cáo Thang đo Sàng lọc ASSIST";
    var totalRecords = Model != null ? Model.Count : 0;
    var maTuyDaCao = Model != null ? Model.Count(x => x.matuyda_nguyco == "Nguy cơ cao" || x.matuyda_nguyco == "Nguy cơ trung bình") : 0;
    var ruouThuocLaCao = Model != null ? Model.Count(x => x.thuocla_nguyco == "Nguy cơ cao" || x.conruou_nguyco == "Nguy cơ cao") : 0;
    var canSaKhacCao = Model != null ? Model.Count(x => x.cansa_nguyco == "Nguy cơ cao" || x.chatkhac_nguyco == "Nguy cơ cao") : 0;
}

<div class="container-fluid py-3" x-data="alpineKetQuaASSIST()">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-pills text-warning mr-2"></i> Báo cáo Thang đo Sàng lọc Chất gây nghiện (ASSIST)
            </h1>
            <p class="text-muted small mb-0">Phân loại mức độ nguy cơ nghiện chất (Thuốc lá, Cồn rượu, Cần sa, Cocaine, Ma túy đá, Khí xông hít, Thuốc an thần, Ảo giác, Thuốc phiện).</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <button type="button" class="btn btn-success shadow-sm px-3 py-2 font-weight-bold" x-on:click="exportExcel()" style="border-radius: 8px;">
                <i class="fas fa-file-excel mr-1"></i> Xuất dữ liệu Excel
            </button>
        </div>
    </div>

    <!-- Statistics Overview Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #4e73df !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng lượt sàng lọc ASSIST</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@totalRecords</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(78, 115, 223, 0.1);">
                                <i class="fas fa-clipboard-list fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #e74a3b !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Ma túy đá (Nguy cơ Cao/TB)</div>
                            <div class="h4 mb-0 font-weight-bold text-danger">@maTuyDaCao</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(231, 74, 59, 0.1);">
                                <i class="fas fa-biohazard fa-2x text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #f6c23e !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Rượu / Thuốc lá (Nguy cơ Cao)</div>
                            <div class="h4 mb-0 font-weight-bold text-warning">@ruouThuocLaCao</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(246, 194, 62, 0.15);">
                                <i class="fas fa-wine-bottle fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #36b9cc !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Cần sa / Chất khác (Nguy cơ Cao)</div>
                            <div class="h4 mb-0 font-weight-bold text-info">@canSaKhacCao</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(54, 185, 204, 0.1);">
                                <i class="fas fa-cannabis fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between flex-wrap">
            <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                <i class="fas fa-table mr-2"></i> Chi tiết Điểm & Nguy cơ Từng Loại Chất
            </h6>
            <span class="badge badge-light border text-muted">Bảng đa tiêu chí</span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0" id="dataTableKetQuaASSIST" width="100%" cellspacing="0">
                    <thead style="background-color: #f8f9fc;">
                        <tr>
                            <th rowspan="2" class="align-middle text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Dự án</th>
                            <th rowspan="2" class="align-middle text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Tỉnh</th>
                            <th rowspan="2" class="align-middle text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Record ID</th>
                            <th rowspan="2" class="align-middle text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Mã & Tên nhóm</th>
                            <th rowspan="2" class="align-middle text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Mã KH</th>
                            <th rowspan="2" class="align-middle text-center text-secondary text-uppercase font-weight-bold" style="font-size: 0.75rem;">Ngày số liệu</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Thuốc lá</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Cồn rượu</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Cần sa</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Cocaine</th>
                            <th colspan="2" class="text-center bg-danger text-white font-weight-bold">Ma túy đá</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Khí hít</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">An thần</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Ảo giác</th>
                            <th colspan="2" class="text-center bg-light text-dark font-weight-bold">Thuốc phiện</th>
                        </tr>
                        <tr>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                            <th class="text-center small">Điểm</th><th class="text-center small">Nguy cơ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            TimeZoneInfo cstZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");

                            foreach (var item in Model)
                            {
                                DateTime dNgayTiepCan = TimeZoneInfo.ConvertTimeFromUtc(item.ngaysl, cstZone);

                                <tr>
                                    <td><span class="badge badge-light border font-weight-bold text-dark">@(item.maduan ?? "BVTL")</span></td>
                                    <td>@item.CityName</td>
                                    <td><span class="badge badge-light font-weight-bold text-primary">#@item.record_id</span></td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.tennhom_tbh</div>
                                        <small class="text-muted">(@item.manhom_tbh)</small>
                                    </td>
                                    <td><span class="badge badge-light font-weight-bold text-secondary">@item.makh</span></td>
                                    <td class="text-center font-weight-bold text-gray-700">@String.Format("{0:dd/MM/yyyy}", dNgayTiepCan)</td>
                                    
                                    <td class="text-center">@item.thuocla_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.thuocla_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.thuocla_nguyco</small></td>
                                    
                                    <td class="text-center">@item.conruou_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.conruou_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.conruou_nguyco</small></td>
                                    
                                    <td class="text-center">@item.cansa_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.cansa_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.cansa_nguyco</small></td>
                                    
                                    <td class="text-center">@item.cocaine_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.cocaine_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.cocaine_nguyco</small></td>
                                    
                                    <td class="text-center font-weight-bold text-danger">@item.matuyda_diem</td>
                                    <td class="text-center">
                                        @if (item.matuyda_nguyco == "Nguy cơ cao")
                                        {
                                            <span class="badge badge-danger">Cao</span>
                                        }
                                        else if (item.matuyda_nguyco == "Nguy cơ trung bình")
                                        {
                                            <span class="badge badge-warning text-dark">Trung bình</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light text-muted">Thấp</span>
                                        }
                                    </td>
                                    
                                    <td class="text-center">@item.khixonghit_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.khixonghit_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.khixonghit_nguyco</small></td>
                                    
                                    <td class="text-center">@item.thuocanthan_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.thuocanthan_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.thuocanthan_nguyco</small></td>
                                    
                                    <td class="text-center">@item.chatgayaogiac_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.chatgayaogiac_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.chatgayaogiac_nguyco</small></td>
                                    
                                    <td class="text-center">@item.thuocphien_diem</td>
                                    <td class="text-center"><small class="font-weight-bold @(item.thuocphien_nguyco == "Nguy cơ cao" ? "text-danger" : "text-muted")">@item.thuocphien_nguyco</small></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineKetQuaASSIST.js?v=@DateTime.Now.Ticks"></script>
}
