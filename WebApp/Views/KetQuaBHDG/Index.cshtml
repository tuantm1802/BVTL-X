@model  System.Collections.Generic.List<Model.ModelExtend.KetQuaBHDGPageModel>
@{
    ViewBag.Title = "Kết quả BHDG";
}
<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>
<div class="container-fluid" x-data="alpineKetQuaBHDG()">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Kết quả BHDG</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                @*<div class="row">
                <div class="col-sm-1">
            <label>Từ khóa</label>
        </div>
        <div class="col-sm-4">
            <input type="text" class="form-control" ng-model="modelSearch.KeyWord" />
        </div>
        <div class="col-sm-1">
            <label>Dự án</label>s
        </div>
        <div class="col-sm-4">
            <select class="form-control" ui-select2 ng-model="modelSearch.MaDuAn" name="MaDuAn" ng-options="item.Code as item.Name for item in ListDuAn">
                </select>
        </div>
                <div class="col-sm-2">
                    <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-primary" ng-click="ExportExcel()">
                        <i class="fas fa-pencil-alt"></i> Xuất Excel
                    </button>
                </div>
            </div>*@
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableKetQuaBHDG" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width: auto;">Dự án </th>
                            <th style="width: auto;">Tỉnh </th>
                            <th style="width: auto;">Record ID</th>
                            <th style="width:9%;">Mã nhóm</th>
                            <th style="width:auto;">Tên nhóm</th>
                            <th style="width:9%;">Mã KH</th>
                            @*<th style="width:auto;">Họ tên KH </th>*@
                            <th style="width:9%;">Ngày xét nghiệm</th>
                            <th>1. HIV là các nhiễm trùng lây truyền qua đường tình dục</th>
                            <th>2. HIV là vi rút gây suy giảm miễn dịch ở người</th>
                            <th>3. HIV có thể lây nhiễm qua việc dùng chung các dụng cụ tiêm chích, xăm mình hoặc quan hệ tình dục không sử dụng bao cao su</th>
                            <th>4. HIV có thể lây nhiễm qua giao tiếp thông thường như ôm, hôn, bắt tay	</th>
                            <th>5. Xét nghiệm máu có thể phát hiện một người có bị nhiễm HIV hay không</th>
                            <th>6. Khám bệnh thông thường hoặc nhìn bề ngoài (gầy gò, các bệnh về da) có thể phát hiện một người có bị nhiễm HIV hay không</th>
                            <th>7. Nên đi xét nghiệm HIV sau ít nhất 14 ngày kể từ khi có hành vi nguy cơ (quan hệ tình dục không an toàn, tiêm chích chung...)</th>
                            <th>8. Vi rút HIV tồn tại 5 - 10 năm trong cơ thể người nhiễm và không thể lây nhiễm cho người khác</th>
                            <th>9. Hiện nay, HIV có thể được điều trị bằng thuốc kháng vi rút và điều trị suốt đời</th>
                            <th>10. Người nhiễm HIV mà có tải lượng virut dưới ngưỡng phát hiện thì không còn khả năng lây cho người khác</th>
                            <th>11. Sử dụng ma túy đá một mình là an toàn nhất</th>
                            <th>12. Sử dụng ma túy đá trong một thời gian dài có thể dẫn đến trầm cảm</th>
                            <th>13. Người bị tăng thân nhiệt do sử dụng ma túy đá nên uống nhiều nước (có thể uống nước điện giải)</th>
                            <th>14. Ăn uống và nghỉ ngơi đầy đủ sau mỗi lần chơi là một trong những cách giảm hại cho người sử dụng ma túy đá</th>
                            <th>15. Sử dụng ma túy đá kèm với các loại ma túy khác luôn tạo độ phê và sự an toàn cho người chơi</th>
                            <th>16. Cơn hoảng loạn, ảo giác và nôn mửa là các triệu chứng của quá liều (sốc thuốc) khi sử dụng ma túy đá</th>
                            <th>17. Sử dụng ma túy đá làm tăng nguy cơ lây nhiễm HIV do quan hệ tình dục không an toàn</th>
                            <th>18. Sử dụng ma túy đá có khả năng ảnh hưởng tới việc tuân thủ điều trị và hiệu quả điều trị ở người nhiễm HIV</th>
                            <th>19. Sử dụng ma túy đá không có nguy cơ lây nhiễm HIV nếu chỉ hút mà không tiêm chích chung</th>
                            <th>20. Sức khỏe tâm thần là tình trạng khỏe mạnh về tinh thần và không có rối loạn tâm thần</th>
                            <th>21. Lo âu, mất ngủ, buồn chán, mất động lực trong một thời gian dài không phải là các dấu hiệu của vấn đề về sức khỏe tâm thần</th>
                            <th>22. Nghe thấy tiếng kêu/ tiếng nói mà người khác không nghe thấy là dấu hiệu của vấn đề về sức khỏe tâm thần</th>
                            <th>23. Sử dụng ma túy có thể gây ra hoặc làm nặng thêm các rối loạn tâm thần</th>
                            <th>24. Các vấn đề về sức khỏe tâm thần có thể dẫn tới việc sử dụng ma túy</th>
                            <th>25. Để cải thiện sức khỏe tâm thần cần thực hiện cả việc giảm hại và điều trị nghiện ma túy</th>
                            <th>26. Các vấn đề sức khỏe tâm thần là các bệnh tâm thần do di truyền, không điều trị, không chữa khỏi được</th>
                            <th>27. Dùng chung popper và ma túy đá khi quan hệ tình dục thì không có nguy cơ về sức khỏe</th>

                        </tr>
                    </thead>
                    @{
                        TimeZoneInfo cstZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");

                        foreach (var item in Model)
                        {
                            DateTime dNgayTiepCan = TimeZoneInfo.ConvertTimeFromUtc(item.ngaysl, cstZone);

                        <tr>
                            <td class="text-left">@item.maduan</td>
                            <td class="text-left">@item.CityName</td>
                            <td class="text-left">@item.record_id_api</td>
                            <td class="text-left">@item.manhom_tbh</td>
                            <td class="text-left">@item.tennhom_tbh</td>
                            <td class="text-left">@item.makh</td>
                            @*<td class="text-left">@item.hoten</td>*@
                            @*<td class="text-center">@(item.ngaysl != null ? item.ngaysl.ToString("yyyy-MM-dd") : string.Empty)</td>*@
                            <td class="text-center">@String.Format("{0:dd/MM/yyyy}", dNgayTiepCan)</td>

                            @*<td class="text-left">@item.ngayxntext</td>*@
                            <td>@item.cau1</td>
                            <td>@item.cau2</td>
                            <td>@item.cau3</td>
                            <td>@item.cau4</td>
                            <td>@item.cau5</td>
                            <td>@item.cau6</td>
                            <td>@item.cau7</td>
                            <td>@item.cau8</td>
                            <td>@item.cau9</td>
                            <td>@item.cau10</td>
                            <td>@item.cau11</td>
                            <td>@item.cau12</td>
                            <td>@item.cau13</td>
                            <td>@item.cau14</td>
                            <td>@item.cau15</td>
                            <td>@item.cau16</td>
                            <td>@item.cau17</td>
                            <td>@item.cau18</td>
                            <td>@item.cau19</td>
                            <td>@item.cau20</td>
                            <td>@item.cau21</td>
                            <td>@item.cau22</td>
                            <td>@item.cau23</td>
                            <td>@item.cau24</td>
                            <td>@item.cau25</td>
                            <td>@item.cau26</td>
                            <td>@item.cau27</td>

                        </tr>
                            }
                        }
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineKetQuaBHDG.js?v=@DateTime.Now.Ticks"></script>
}
