@model System.Collections.Generic.List<Model.ModelExtend.KetQuaBHDGPageModel>
@{
    ViewBag.Title = "Báo cáo Đánh giá Hành vi (BHDG)";
    var totalRecords = Model != null ? Model.Count : 0;
    var totalGroups = Model != null ? Model.Select(x => x.manhom_tbh).Distinct().Count() : 0;
    var totalCities = Model != null ? Model.Select(x => x.CityName).Distinct().Count() : 0;
}

<div class="container-fluid py-3" x-data="alpineKetQuaBHDG()">

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-tasks text-primary mr-2"></i> Báo cáo Đánh giá Hành vi (BHDG)
            </h1>
            <p class="text-muted small mb-0">Theo dõi 27 câu hỏi khảo sát nhận thức, thái độ và hành vi liên quan đến HIV, Chemsex và sức khỏe tâm thần.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <button type="button" class="btn btn-success shadow-sm px-3 py-2 font-weight-bold" x-on:click="exportExcel()" style="border-radius: 8px;">
                <i class="fas fa-file-excel mr-1"></i> Xuất dữ liệu Excel
            </button>
        </div>
    </div>

    <!-- Statistics Overview Cards -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #4e73df !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng số phiếu khảo sát BHDG</div>
                            <div class="h4 mb-0 font-weight-bold text-gray-800">@totalRecords</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(78, 115, 223, 0.1);">
                                <i class="fas fa-clipboard-check fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6 mb-3 mb-xl-0">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #1cc88a !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Số Nhóm TTDL tham gia</div>
                            <div class="h4 mb-0 font-weight-bold text-success">@totalGroups</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(28, 200, 138, 0.1);">
                                <i class="fas fa-users-cog fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm h-100 py-2" style="border-radius: 12px; border-left: 4px solid #36b9cc !important; background: #ffffff;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Số Tỉnh / Thành phố</div>
                            <div class="h4 mb-0 font-weight-bold text-info">@totalCities</div>
                        </div>
                        <div class="col-auto">
                            <div class="p-3 rounded-circle" style="background: rgba(54, 185, 204, 0.1);">
                                <i class="fas fa-map-marked-alt fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between flex-wrap">
            <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                <i class="fas fa-table mr-2"></i> Chi tiết Kết quả Khảo sát 27 Tiêu chí BHDG
            </h6>
            <span class="badge badge-light border text-muted">Bảng chi tiết</span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dataTableKetQuaBHDG" width="100%" cellspacing="0">
                    <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                        <tr>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Dự án</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tỉnh</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Record ID</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mã & Tên nhóm</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Mã KH</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Ngày xét nghiệm</th>
                            <th title="HIV là các nhiễm trùng lây truyền qua đường tình dục">C1</th>
                            <th title="HIV là vi rút gây suy giảm miễn dịch ở người">C2</th>
                            <th title="HIV có thể lây nhiễm qua dùng chung dụng cụ tiêm chích, quan hệ không BCS">C3</th>
                            <th title="HIV có thể lây nhiễm qua giao tiếp thông thường">C4</th>
                            <th title="Xét nghiệm máu có thể phát hiện HIV">C5</th>
                            <th title="Khám bệnh thông thường có thể phát hiện HIV">C6</th>
                            <th title="Nên đi xét nghiệm sau 14 ngày kể từ hành vi nguy cơ">C7</th>
                            <th title="Vi rút HIV tồn tại 5-10 năm và không lây nhiễm">C8</th>
                            <th title="Hiện nay HIV có thể điều trị bằng ARV suốt đời">C9</th>
                            <th title="Tải lượng virut dưới ngưỡng phát hiện thì không lây cho người khác">C10</th>
                            <th title="Sử dụng ma túy đá một mình là an toàn nhất">C11</th>
                            <th title="Sử dụng ma túy đá thời gian dài có thể dẫn đến trầm cảm">C12</th>
                            <th title="Người bị tăng thân nhiệt nên uống nhiều nước">C13</th>
                            <th title="Ăn uống nghỉ ngơi đầy đủ sau mỗi lần chơi">C14</th>
                            <th title="Sử dụng kèm ma túy khác tạo độ phê và an toàn">C15</th>
                            <th title="Hoảng loạn, ảo giác, nôn mửa là sốc thuốc">C16</th>
                            <th title="Ma túy đá làm tăng nguy cơ lây HIV do QHTD không an toàn">C17</th>
                            <th title="Ma túy đá ảnh hưởng tuân thủ điều trị ở người nhiễm">C18</th>
                            <th title="Hút ma túy đá không có nguy cơ lây HIV">C19</th>
                            <th title="Sức khỏe tâm thần là khỏe mạnh về tinh thần">C20</th>
                            <th title="Lo âu, mất ngủ, buồn chán không phải dấu hiệu SKTT">C21</th>
                            <th title="Nghe tiếng kêu lạ là dấu hiệu SKTT">C22</th>
                            <th title="Ma túy gây hoặc làm nặng thêm rối loạn tâm thần">C23</th>
                            <th title="Vấn đề SKTT dẫn đến sử dụng ma túy">C24</th>
                            <th title="Cần cả giảm hại và điều trị nghiện">C25</th>
                            <th title="Bệnh tâm thần là do di truyền không chữa được">C26</th>
                            <th title="Dùng chung popper và ma túy đá không có nguy cơ">C27</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            TimeZoneInfo cstZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");

                            foreach (var item in Model)
                            {
                                DateTime dNgayTiepCan = TimeZoneInfo.ConvertTimeFromUtc(item.ngaysl, cstZone);

                                <tr>
                                    <td><span class="badge badge-light border font-weight-bold text-dark">@(item.maduan ?? "BVTL")</span></td>
                                    <td>@item.CityName</td>
                                    <td><span class="badge badge-light font-weight-bold text-primary">#@item.record_id_api</span></td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.tennhom_tbh</div>
                                        <small class="text-muted">(@item.manhom_tbh)</small>
                                    </td>
                                    <td><span class="badge badge-light font-weight-bold text-secondary">@item.makh</span></td>
                                    <td class="text-center font-weight-bold text-gray-700">@String.Format("{0:dd/MM/yyyy}", dNgayTiepCan)</td>
                                    <td class="text-center small">@item.cau1</td>
                                    <td class="text-center small">@item.cau2</td>
                                    <td class="text-center small">@item.cau3</td>
                                    <td class="text-center small">@item.cau4</td>
                                    <td class="text-center small">@item.cau5</td>
                                    <td class="text-center small">@item.cau6</td>
                                    <td class="text-center small">@item.cau7</td>
                                    <td class="text-center small">@item.cau8</td>
                                    <td class="text-center small">@item.cau9</td>
                                    <td class="text-center small">@item.cau10</td>
                                    <td class="text-center small">@item.cau11</td>
                                    <td class="text-center small">@item.cau12</td>
                                    <td class="text-center small">@item.cau13</td>
                                    <td class="text-center small">@item.cau14</td>
                                    <td class="text-center small">@item.cau15</td>
                                    <td class="text-center small">@item.cau16</td>
                                    <td class="text-center small">@item.cau17</td>
                                    <td class="text-center small">@item.cau18</td>
                                    <td class="text-center small">@item.cau19</td>
                                    <td class="text-center small">@item.cau20</td>
                                    <td class="text-center small">@item.cau21</td>
                                    <td class="text-center small">@item.cau22</td>
                                    <td class="text-center small">@item.cau23</td>
                                    <td class="text-center small">@item.cau24</td>
                                    <td class="text-center small">@item.cau25</td>
                                    <td class="text-center small">@item.cau26</td>
                                    <td class="text-center small">@item.cau27</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineKetQuaBHDG.js?v=@DateTime.Now.Ticks"></script>
}
