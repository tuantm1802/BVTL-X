<div class="action-system ui-widget-content" id="resizable">
    <button id="btn-changes-s-nav">
        <img src="~/App_Assets/images/ic_back_xx.svg" alt="">
    </button>
    <div class="container">
        <div class="form-infor p-3">
            <h4 class="form-title">
                Tìm kiếm
            </h4>
            <form id="e-danhsachhoso">
                <div class="row no-gutters">
                    <div class="col-12 col-md-12">
                        <label>Kho</label>
                        <select class="form-control" ng-model="hangDoi.Kho" ng-options="option.ID as option.TEN_DON_VI for option in listKho">
                            <option value="">- - - Chọn kho - - -</option>
                        </select>
                    </div>
                    <div ng-if="chkNVPK" class="col-12 col-md-12">
                        <label>Nhóm dữ liệu</label>
                        <select class="form-control" ng-model="hangDoi.NhomDuLieu" ng-change="pageChanged()" ng-options="option.CODE as option.NAME for option in listNhomDL">
                            <option value="">- - - Chọn nhóm dữ liệu - - -</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-12">
                        <label>Mã hàng</label>
                        <input type="text" class="form-control" placeholder="Nhập mã hàng" ng-model="hangDoi.MaHangHoa"/>
                    </div>
                    <div class="col-12 col-md-12">
                        <label>Tên hàng</label>
                        <input type="text" class="form-control" placeholder="Nhập tên hàng" ng-model="hangDoi.TenHangHoa"/>
                    </div>
                    <div class="col-12 col-md-6">
                        <label>Từ ngày</label>
                        <div class="input-group date" data-date-format="dd/mm/yyyy">
                            <input type="text" customzdatetime class="form-control" ng-model="hangDoi.TuNgay">
                            <span class="input-group-addon"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label>Đến ngày</label>
                        <div class="input-group date" data-date-format="dd/mm/yyyy">
                            <input type="text" customzdatetime class="form-control" ng-model="hangDoi.DenNgay">
                            <span class="input-group-addon"></span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="d-flex align-item-center">
            <div class="main-action" style="margin: 0 auto;">
                <button class="btn-action-m bg-green" ng-click="TimKiem()">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </div>
        <div class="content-table mt-2">
            <table class="table-responsive table-hover result-point">
                <thead class="point-table-head">
                    <tr>
                        <th class="e-cursor-pointer">
                            <div style="width: 70%;" class="e-th-table-boder">Hàng hóa</div>
                        </th>
                        <th class="e-cursor-pointer">
                            <div style="width: 30%;" class="e-th-table-boder">ĐVT</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-click="ShowThongTin(item,$index)" ng-repeat="item in dsKetQua" class="e-cursor-pointer" ng-class="{'selected':$index == selectedRow}">
                        <td>{{item.CODE}} - {{ item.NAME}}</td>
                        <td>{{item.DVT}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-sm-12">
            <div style="float:left;padding-top:16px" ng-show="CoKetQua">{{SoLuongHienThi}}/{{SoLuongKetQua}} kết quả</div>
            <div class="row content-table pull-right">
                <div class="pages-switch">
                    <ul class="pagination pagination-sm m-0 float-right no-margin" uib-pagination total-items="SoLuongKetQua" items-per-page=10 ng-model="currentPage" ng-change="TimKiem(currentPage)" max-size=3 boundary-links="true" rotate="false" previous-text="&lsaquo;" next-text="&rsaquo;" first-text="&laquo;" last-text="&raquo;"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

