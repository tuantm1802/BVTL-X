@{
    ViewBag.Title = "Tham số";
}

<div class="container-fluid" ng-controller="SysParameterController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Tham số</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <button type="button" ng-click="Refesh()" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                    <i class="fas fa-sync-alt"></i> Làm mới
                </button>
                <button type="button" class="btn btn-primary" ng-click="edit()" ng-show="RoleBtnUpdate == true">
                    <i class="fas fa-pencil-alt"></i> Cập nhật
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableParam" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;">STT </th>
                            <th style="width:10%;">Mã </th>
                            <th style="width:10%;">Giá trị </th>
                            <th style="width:10%;">Kiểu dữ liệu </th>
                            <th style="width:auto;">Mô tả </th>
                            <th style="width:9%;">Trạng thái</th>
                            @*<th style="width:8%;">Thao tác</th>*@
                        </tr>
                    </thead>
                    @*<tbody>
                           <tr ng-repeat="item in ListSysParameter" ng-click="ViewDetail(item.ID, $index)" ng-class="{activerow:$index==selectedRow}">
                            <td class="text-center">{{$index + 1}}</td>
                            <td class="text-left">{{item.ParamCode}}</td>
                            <td class="text-left">{{item.ParamValue}}</td>
                            <td class="text-left">{{item.ParamValueType == 'STRING' ? 'Kiểu chữ' : 'Kiểu số'}}</td>
                            <td class="text-left">{{item.Desctiption}}</td>
                            <td class="text-center">{{item.IsActive == true ? 'Sử dụng' : 'Không sử dụng'}}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-primary" ng-click="edit(item.ID)" ng-show="RoleBtnUpdate == true" title="Cập nhật">
                                    <i class="fas fa-pencil-alt"></i>
                                </button>
                            </td>
                        </tr>
                        </tbody>*@
                </table>
            </div>
        </div>
    </div>
</div>

