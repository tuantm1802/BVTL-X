@{
    ViewBag.Title = "Báo cáo quý dự án CD43";
}

<div class="container-fluid" x-data="alpineBaoCaoQuyCD43">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Báo cáo quý dự án CD43</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
                <div class="card-tools">
                    <div class="form-group row">
                        <label class="col-sm-1 col-form-label">Quý</label>
                        <div class="col-sm-1">
                            <select class="form-control" x-model="Quy" name="Quy">
                                <option value="I">I</option>
                                <option value="II">II</option>
                                <option value="III">III</option>
                                <option value="IV">IV</option>
                            </select>
                        </div>

                        <label class="col-sm-1 col-form-label">Năm</label>
                        <div class="col-sm-1">
                            <select class="form-control" name="Year"
                                x-init="
                                    $watch('ListYear', () => { 
                                        $nextTick(() => { $($el).select2(); }); 
                                    });
                                    $($el).on('change', (e) => { modelSearch.Year = $(e.target).val(); });
                                ">
                                <template x-for="item in ListYear" :key="item.Id">
                                    <option :value="item.Id" x-text="item.Name" :selected="modelSearch.Year == item.Id"></option>
                                </template>
                            </select>
                        </div>
                        
                        <div class="col-sm-3 mb-3 mb-sm-0">
                            <label>Nhóm</label>
                            <select class="form-control" multiple name="ListMaNhomTBH"
                                x-init="
                                    $nextTick(() => { $($el).select2({ placeholder: 'Chọn nhóm', allowClear: true }); });
                                    $watch('ListNhomTBH', () => { 
                                        $nextTick(() => { $($el).select2({ placeholder: 'Chọn nhóm', allowClear: true }); }); 
                                    });
                                    $($el).on('change', (e) => { 
                                        ListMaNhomTBH = $(e.target).val() || []; 
                                    });
                                ">
                                <template x-for="item in ListNhomTBH" :key="item.manhom_tbh">
                                    <option :value="item.manhom_tbh" x-text="item.tennhom_tbh + ' (' + item.manhom_tbh + ') - ' + item.CityName" :selected="ListMaNhomTBH.includes(item.manhom_tbh)"></option>
                                </template>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-sm-2">
                            <button type="button" x-on:click="Refesh()" x-show="RoleBtnSearch == true" class="btn btn-primary">
                                <i class="fas fa-search"></i> Tìm kiếm
                            </button>
                            <button type="button" class="btn btn-primary" x-on:click="ExportExcel()">
                                <i class="fas fa-pencil-alt"></i> Xuất Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered"  width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:10%;"># </th>
                            <th style="width: 40%;" colspan="2">Thông tin báo cáo </th>
                            <th style="width: 10%; ">Nam</th>
                            <th style="width: 10%; ">Nữ</th>
                            <th style="width: 10%; ">Chuyển giới</th>
                            <th style="width: 10%; ">Tổng</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="item in ListData">
                            <tr>
                                <td class="text-center" x-show="item.IsShow == 'Y'" x-text="item.STT"></td>
                                <td class="text-left" x-show="item.IsShow != 'N' && item.ThongTinBC != '' && item.ThongTinBC != null" :colspan="item.Colpan" :rowspan="item.Rowpan">
                                    <span x-show="item.BoldText == 'N'" x-text="item.ThongTinBC"></span>
                                    <b x-show="item.BoldText == 'Y'" x-text="item.ThongTinBC"></b>
                                </td>
                                <td class="text-left" x-show="!(item.Colpan > 1 || item.IsShow == 'N')" x-text="item.ThongTinBC_Them"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nam)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nu)"></td>                            
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.ChuyenGioi)"></td>                            
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Tong)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>

                
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineBaoCaoQuyCD43.js"></script>
}
