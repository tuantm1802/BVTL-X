@{
    ViewBag.Title = "Danh sách Khách hàng";
}

<div class="container-fluid py-3" ng-controller="KhachHangController">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold text-gray-800 mb-1">
                <i class="fas fa-user-injured text-primary mr-2"></i>Danh sách Khách hàng
            </h1>
            <p class="text-muted small mb-0">Quản lý và tra cứu thông tin chi tiết các đối tượng khách hàng</p>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0 rounded-lg mb-4">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="customerTable" class="table table-hover align-middle mb-0" style="width:100%">
                    <thead class="bg-light">
                        <tr>
                            <th>Record ID</th>
                            <th>Mã Nhóm</th>
                            <th>Ngày Sinh</th>
                            <th>Giới Tính</th>
                            <th>Học Vấn</th>
                            <th>Nghề Nghiệp</th>                    
                            <th>Ngày Hỏi</th>                    
                            <th class="text-center" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineCustomerDetailModal.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/app/Controller/KhachHangController.js?v=@DateTime.Now.Ticks"></script>
}
