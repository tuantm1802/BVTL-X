@model  System.Collections.Generic.List<Model.ModelExtend.TTKHMaDaVIIVPageModel>
@{
    ViewBag.Title = "Thông tin KH mất dấu";
}
<style type="text/css">
    div.dataTables_length select {
        width: 70px !important;
    }
</style>
<div class="container-fluid" ng-controller="TTKHMaDaVIIVController">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Viiv-Thông tin KH mất dấu</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                @*<div class="row">
                <div class="col-sm-1">
            <label>Từ khóa</label>
        </div>
        <div class="col-sm-4">
            <input type="text" class="form-control" ng-model="modelSearch.KeyWord" />
        </div>
        <div class="col-sm-1">
            <label>Dự án</label>s
        </div>
        <div class="col-sm-4">
            <select class="form-control" ui-select2 ng-model="modelSearch.MaDuAn" name="MaDuAn" ng-options="item.Code as item.Name for item in ListDuAn">
                </select>
        </div>
                <div class="col-sm-2">
                    <button type="button" ng-click="LoadPage(2)" ng-show="RoleBtnSearch == true" class="btn btn-primary">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                    <button type="button" ng-show="RoleBtnExportExcel == true" class="btn btn-primary" ng-click="ExportExcel()">
                        <i class="fas fa-pencil-alt"></i> Xuất Excel
                    </button>
                </div>
            </div>*@
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTableTTKHMaDaVIIV" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width: auto;">Dự án </th>
                            <th style="width: auto;">Tỉnh </th>
                            <th style="width:9%;">Mã nhóm TBH</th>
                            <th style="width:auto;">Tên nhóm TBH </th>
                            <th style="width:9%;">Mã KH</th>
                            <th style="width:auto;">Họ tên KH </th>
                            <th style="width:9%;">Ngày mất dấu</th>
                            
                        </tr>
                    </thead>
                    @foreach (var item in Model)
                    {
                <tr>
                    <td class="text-left">@item.maduan</td>
                    <td class="text-left">@item.CityName</td>
                    <td class="text-left">@item.manhom_tbh</td>
                    <td class="text-left">@item.tennhom_tbh</td>
                    <td class="text-left">@item.makh</td>
                    <td class="text-left">@item.hoten</td>
                    <td class="text-center">@(item.ngay_md != null ? item.ngay_md.ToString("yyyy-MM-dd") : string.Empty )</td>
                    
                </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/TTKHMaDaVIIVController.js"></script>
}
