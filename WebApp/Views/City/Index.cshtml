@{
    ViewBag.Title = "Danh mục Tỉnh / Thành phố";
}

<div class="container-fluid py-3" x-data="alpineCity()" x-cloak>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 font-weight-bold d-flex align-items-center">
                <i class="fas fa-city text-primary mr-2"></i> Danh mục Tỉnh / Thành phố
            </h1>
            <p class="text-muted small mb-0">Quản trị và tra cứu danh sách các địa bàn Tỉnh / Thành phố triển khai các hoạt động dự án.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center">
            <span class="badge badge-light border px-3 py-2 text-dark font-weight-bold mr-2 shadow-sm">
                <i class="fas fa-map-marked-alt text-primary mr-1"></i> Tổng số: <span class="text-primary ml-1" x-text="totalItems">0</span> Tỉnh/Thành
            </span>
            <span class="badge badge-light border px-3 py-2 text-dark font-weight-bold shadow-sm">
                <i class="fas fa-star text-warning mr-1"></i> Tỉnh trọng điểm CD45: <span class="text-success ml-1">6</span>
            </span>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-md-7 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" class="form-control bg-light border-0" placeholder="Nhập Mã hoặc Tên Tỉnh/Thành phố cần tìm..." x-model="keyword" x-on:keyup.enter="search()" style="border-radius: 0 8px 8px 0;">
                    </div>
                </div>
                <div class="col-md-2 mb-2 mb-md-0">
                    <div class="d-flex align-items-center">
                        <span class="text-muted small mr-2 text-nowrap">Hiển thị:</span>
                        <select class="custom-select custom-select-sm border-light bg-light font-weight-bold" x-model="pageSize" x-on:change="changePageSize($event.target.value)" style="border-radius: 8px;">
                            <template x-for="opt in pageSizeOptions" :key="opt">
                                <option :value="opt" x-text="opt === 63 ? 'Tất cả (63)' : opt + ' dòng'"></option>
                            </template>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 text-md-right">
                    <button type="button" class="btn btn-primary px-3 font-weight-bold mr-1" x-on:click="search()" style="border-radius: 8px;">
                        <i class="fas fa-search mr-1"></i> Tìm
                    </button>
                    <button type="button" class="btn btn-light border px-3 font-weight-bold text-secondary" x-on:click="resetSearch()" style="border-radius: 8px;">
                        <i class="fas fa-undo mr-1"></i> Đặt lại
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" width="100%" cellspacing="0">
                    <thead style="background-color: #f8f9fc; border-top: 1px solid #e3e6f0; border-bottom: 2px solid #e3e6f0;">
                        <tr>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pl-4" style="width: 80px; font-size: 0.75rem;">STT</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="width: 140px; font-size: 0.75rem;">Mã Tỉnh (3 ký tự)</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="width: 170px; font-size: 0.75rem;">Mã Viết Tắt (CD45 / BVTL)</th>
                            <th class="text-secondary text-uppercase font-weight-bold py-3" style="font-size: 0.75rem;">Tên Tỉnh / Thành phố</th>
                            <th class="text-center text-secondary text-uppercase font-weight-bold py-3 pr-4" style="width: 160px; font-size: 0.75rem;">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(item, index) in items" :key="item.Code || index">
                            <tr>
                                <td class="text-center font-weight-bold text-muted pl-4" x-text="fromRecord + index"></td>
                                <td>
                                    <span class="badge badge-light border font-weight-bold text-primary font-monospace px-2 py-1" x-text="item.Code || '—'"></span>
                                </td>
                                <td>
                                    <template x-if="item.Code_Map">
                                        <span class="badge badge-primary font-weight-bold font-monospace px-2 py-1" title="Mã ánh xạ 2 ký tự trong mã khách hàng CD45" x-text="item.Code_Map"></span>
                                    </template>
                                    <template x-if="!item.Code_Map">
                                        <span class="text-muted font-italic small">—</span>
                                    </template>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark d-flex align-items-center">
                                        <i class="fas fa-map-marker-alt text-danger mr-2"></i>
                                        <span x-text="item.Name || item.CityName || '—'"></span>
                                    </div>
                                </td>
                                <td class="text-center pr-4">
                                    <template x-if="item.IsActive !== false">
                                        <span class="badge badge-success px-3 py-1 font-weight-bold">
                                            <i class="fas fa-check mr-1"></i> Hoạt động
                                        </span>
                                    </template>
                                    <template x-if="item.IsActive === false">
                                        <span class="badge badge-secondary px-3 py-1 font-weight-bold">
                                            <i class="fas fa-ban mr-1"></i> Ngừng
                                        </span>
                                    </template>
                                </td>
                            </tr>
                        </template>
                        <template x-if="isLoading">
                            <tr>
                                <td colspan="5" class="text-center py-5 text-primary">
                                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                                    <p class="mt-2 mb-0 font-weight-bold">Đang tải dữ liệu Tỉnh / Thành phố...</p>
                                </td>
                            </tr>
                        </template>
                        <template x-if="!isLoading && (!items || items.length === 0)">
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    <span>Không tìm thấy Tỉnh / Thành phố nào phù hợp</span>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Phân trang & Dòng thông tin hiển thị bản ghi -->
        <div class="card-footer bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-center border-top" x-show="totalItems > 0">
            <div class="text-muted small mb-2 mb-md-0">
                Hiển thị từ <span class="font-weight-bold text-dark" x-text="fromRecord"></span> đến <span class="font-weight-bold text-dark" x-text="toRecord"></span> trong tổng số <span class="font-weight-bold text-primary" x-text="totalItems"></span> Tỉnh/Thành phố (Trang <span class="font-weight-bold text-dark" x-text="currentPage"></span> / <span x-text="totalPages"></span>)
            </div>
            <nav x-show="totalPages > 1">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item" :class="{ 'disabled': currentPage <= 1 }">
                        <a class="page-link" href="javascript:void(0)" x-on:click="changePage(1)" title="Trang đầu"><i class="fas fa-angle-double-left"></i></a>
                    </li>
                    <li class="page-item" :class="{ 'disabled': currentPage <= 1 }">
                        <a class="page-link" href="javascript:void(0)" x-on:click="changePage(currentPage - 1)" title="Trang trước"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    <template x-for="p in visiblePages" :key="p">
                        <li class="page-item" :class="{ 'active': p === currentPage }">
                            <a class="page-link font-weight-bold" href="javascript:void(0)" x-on:click="changePage(p)" x-text="p"></a>
                        </li>
                    </template>
                    <li class="page-item" :class="{ 'disabled': currentPage >= totalPages }">
                        <a class="page-link" href="javascript:void(0)" x-on:click="changePage(currentPage + 1)" title="Trang sau"><i class="fas fa-chevron-right"></i></a>
                    </li>
                    <li class="page-item" :class="{ 'disabled': currentPage >= totalPages }">
                        <a class="page-link" href="javascript:void(0)" x-on:click="changePage(totalPages)" title="Trang cuối"><i class="fas fa-angle-double-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineCityController.js?v=@DateTime.Now.Ticks"></script>
}
