@{
    ViewBag.Title = "Báo cáo Chỉ số 6 Tháng";
}

<div class="container-fluid" x-data="alpineBaoCaoChiSo6Thang()">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Báo cáo Chỉ số 6 Tháng</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <div class="form-group row">
                    <div class="col-sm-2 mb-3 mb-sm-0">
                        <label class="form-label">Kỳ báo cáo</label>
                        <select class="form-control" name="SauThang"
                            x-init="
                                $nextTick(() => { $($el).select2(); });
                                $($el).on('change', (e) => { SauThang = $(e.target).val(); });
                            ">
                            <template x-for="item in List6Thang" :key="item.Id">
                                <option :value="item.Id" x-text="item.Name" :selected="SauThang == item.Id"></option>
                            </template>
                        </select>
                    </div>

                    <div class="col-sm-2 mb-3 mb-sm-0">
                        <label class="form-label">Năm</label>
                        <select class="form-control" name="Year"
                            x-init="
                                $nextTick(() => { $($el).select2(); });
                                $watch('ListYear', () => { 
                                    $nextTick(() => { $($el).select2(); }); 
                                });
                                $($el).on('change', (e) => { modelSearch.Year = $(e.target).val(); });
                            ">
                            <template x-for="item in ListYear" :key="item.Id">
                                <option :value="item.Id" x-text="item.Name" :selected="modelSearch.Year == item.Id"></option>
                            </template>
                        </select>
                    </div>

                    <div class="col-sm-3 mb-3 mb-sm-0">
                        <label class="form-label">Tỉnh</label>
                        <select class="form-control" multiple name="ListCity"
                            x-init="
                                $watch('ListCity', () => { 
                                    $nextTick(() => { $($el).select2({ placeholder: 'Chọn tỉnh...' }); }); 
                                });
                                $($el).on('change', (e) => { 
                                    ListCityCode = $(e.target).val() || []; 
                                    Changecity(); 
                                });
                            ">
                            <template x-for="item in ListCity" :key="item.Code">
                                <option :value="item.Code" x-text="item.Name" :selected="ListCityCode.includes(item.Code)"></option>
                            </template>
                        </select>
                    </div>

                    <div class="col-sm-3 mb-3 mb-sm-0">
                        <label class="form-label">Nhóm</label>
                        <select class="form-control" multiple name="ListMaNhomTBH"
                            x-init="
                                $nextTick(() => { $($el).select2({ placeholder: 'Chọn nhóm...' }); });
                                $watch('ListNhomTBH', () => { 
                                    $nextTick(() => { $($el).select2({ placeholder: 'Chọn nhóm...' }); }); 
                                });
                                $($el).on('change', (e) => { 
                                    ListMaNhomTBH = $(e.target).val() || []; 
                                });
                            ">
                            <template x-for="item in ListNhomTBH" :key="item.manhom_tbh">
                                <option :value="item.manhom_tbh" x-text="item.tennhom_tbh + ' ('+ item.manhom_tbh +') - ' + (item.CityName || '')" :selected="ListMaNhomTBH.includes(item.manhom_tbh)"></option>
                            </template>
                        </select>
                    </div>

                    <div class="col-sm-2 mb-3 mb-sm-0 d-flex align-items-end">
                        <button type="button" x-on:click="Refesh()" x-show="RoleBtnSearch == true" class="btn btn-primary mr-2">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-secondary" x-on:click="ExportExcel()">
                            <i class="fas fa-pencil-alt"></i> Xuất Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;"># </th>
                            <th style="width: 39%;" colspan="2">People / organizations that directly benefited from the project</th>
                            <th style="width: 8%; ">Number (cumulative)</th>
                            <th style="width: 8%; ">Disaggregated data 1 (Women)</th>
                            <th style="width: 8%; ">Disaggregated data 2 (men)</th>
                            <th style="width: 8%; ">Disaggregated data 3 (TG: Transgender)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(item, index) in ListData" :key="index">
                            <tr>
                                <td class="text-center" x-show="item.IsShow == 'Y'" x-text="item.STT"></td>
                                <td class="text-left" x-show="!(item.IsShow == 'N' || item.ThongTinBC == '' || item.ThongTinBC == null)" :colspan="item.Colpan" :rowspan="item.Rowpan">
                                    <span x-show="item.BoldText == 'N'" x-text="item.ThongTinBC"></span>
                                    <b x-show="item.BoldText == 'Y'" x-text="item.ThongTinBC"></b>
                                </td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Tong)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nam)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nu)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.ChuyenGioi)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineBaoCaoChiSo6Thang.js?v=@DateTime.Now.Ticks"></script>
}
