                                                    <th>Tiếp cận viên</th>
                                                    <th>Địa điểm</th>
                                                    <th class="text-center">AUDIT-C</th>
                                                    <th class="text-center">PCL-5</th>
                                                    <th class="text-center">Kỳ thị (Stigma)</th>
                                                    <th>Đánh giá / Can thiệp áp dụng</th>
                                                    <th>Hẹn tiếp</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <template x-for="tv in selectedCustomer?.ListTuVan" :key="tv.LanTuVan + '_' + tv.REPEAT_INSTANCE + '_' + tv.NGAY_TU_VAN">
                                                    <tr>
                                                        <td>
                                                            <span class="badge" :class="tv.LanTuVan === 1 ? 'bg-primary-subtle text-primary border border-primary' : 'bg-success-subtle text-success border border-success'"
                                                                  x-text="tv.LanTuVan === 1 ? 'Lần 1' : ('Lần ' + tv.REPEAT_INSTANCE)"></span>
                                                        </td>
                                                        <td class="fw-semibold text-secondary" x-text="formatDate(tv.NGAY_TU_VAN)"></td>
                                                        <td class="fw-semibold" x-text="tv.TenTCV"></td>
                                                        <td class="text-muted" x-text="tv.DIA_DIEM || '-'"></td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark border px-2" x-text="tv.AUDIT_C_SCORE !== null ? tv.AUDIT_C_SCORE : '-'"></span>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark border px-2" x-text="tv.PCL5_SCORE !== null ? tv.PCL5_SCORE : '-'"></span>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark border px-2" x-text="tv.STIGMA_SCORE !== null ? tv.STIGMA_SCORE : '-'"></span>
                                                        </td>
                                                        <td class="text-dark small" x-text="tv.DANH_GIA_HIEN_TAI || tv.TINH_TRANG_SKTT || tv.CAN_THIEP_AP_DUNG || '-'"></td>
                                                        <td>
                                                            <span class="badge bg-light text-dark border" x-text="formatDate(tv.NGAY_HEN_TIEP)"></span>
                                                        </td>
                                                    </tr>
                                                </template>
                                                <tr x-show="!selectedCustomer?.ListTuVan?.length">
                                                    <td colspan="9" class="text-center py-4 text-muted">
                                                        Chưa có lượt tư vấn cá nhân nào.
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- 2. Tuân thủ điều trị -->
                                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                                    <div class="card-header bg-white py-2 border-bottom">
                                        <h6 class="fw-bold text-success mb-0">
                                            <i class="fas fa-pills me-2"></i>2. Quản lý Tuân thủ Điều trị (ARV / PrEP / MMT)
                                        </h6>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-modern table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="text-center" style="width: 50px;">Lần</th>
                                                    <th style="width: 110px;">Ngày hỗ trợ</th>
                                                    <th>Tiếp cận viên</th>
                                                    <th>Hình thức điều trị</th>
                                                    <th class="text-center">Kê đơn thuốc</th>
                                                    <th>Đánh giá tuân thủ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <template x-for="tt in selectedCustomer?.ListTuanThu" :key="tt.REPEAT_INSTANCE + '_' + tt.NGAY_HO_TRO">
                                                    <tr>
                                                        <td class="text-center fw-bold text-success" x-text="tt.REPEAT_INSTANCE"></td>
                                                        <td class="fw-semibold text-secondary" x-text="formatDate(tt.NGAY_HO_TRO)"></td>
                                                        <td class="fw-semibold" x-text="tt.TenTCV"></td>
                                                        <td class="fw-semibold text-primary" x-text="tt.HINH_THUC_DIEU_TRI || '-'"></td>
                                                        <td class="text-center">
                                                            <span x-show="tt.CO_KE_DON_THUOC === true" class="badge bg-success-subtle text-success border border-success">
                                                                <i class="fas fa-check-circle me-1"></i>Có đơn thuốc
                                                            </span>
                                                            <span x-show="tt.CO_KE_DON_THUOC === false" class="badge bg-secondary-subtle text-secondary border">
                                                                Không
                                                            </span>
                                                            <span x-show="tt.CO_KE_DON_THUOC === null" class="text-muted">-</span>
                                                        </td>
                                                        <td class="fw-semibold" x-text="tt.TUAN_THU || '-'"></td>
                                                    </tr>
                                                </template>
                                                <tr x-show="!selectedCustomer?.ListTuanThu?.length">
                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                        Chưa có dữ liệu tuân thủ điều trị.
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL FOOTER -->
                    <div class="modal-footer bg-white py-2 px-3 justify-content-between border-top">
                        <div class="text-muted small">
                            <i class="fas fa-shield-alt text-primary me-1"></i>Hồ sơ Khách hàng 360° - Dự án CD45 (DREAMH)
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" 
                                    x-on:click="copyRecordId(selectedCustomer?.ThongTinChung?.RECORD_ID)">
                                <i class="fas fa-copy me-1"></i>Sao chép Record ID
                            </button>
                            <button type="button" class="btn btn-primary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">
                                <i class="fas fa-check me-1"></i>Đóng
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/app/Controller/AlpineKhachHangCD45Controller.js?v=@DateTime.Now.Ticks"></script>
}
