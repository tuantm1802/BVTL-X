@{
    ViewBag.Title = "Báo cáo định kỳ & Kho lưu trữ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3" x-data="alpineScheduledReport">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="font-weight-bold text-gray-900 mb-1">
                <i class="fas fa-calendar-check text-primary me-2"></i>Báo Cáo Định Kỳ & Kho Lưu Trữ
            </h4>
            <p class="text-muted small mb-0">Tự động kết xuất số liệu hàng tháng (Báo cáo TCV CD45, Hoạt động CD45), lưu trữ snapshot lịch sử và thông báo qua Telegram</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary shadow-sm" @@click="loadLogs(1); loadSettings();">
                <i class="fas fa-sync-alt me-1"></i> Làm mới dữ liệu
            </button>
            <a href="/Home/Index" class="btn btn-sm btn-light border shadow-sm">
                <i class="fas fa-home me-1"></i> Trang chủ
            </a>
        </div>
    </div>

    <!-- 4 KPI Overview Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Tổng số file đã lưu kho -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs text-uppercase text-muted font-weight-bold mb-1">File Đã Lưu Kho</div>
                            <div class="h5 font-weight-bold text-gray-900 mb-0" x-text="settings.totalExportedFiles || 0">0</div>
                            <div class="text-xs text-muted mt-1">Snapshot lịch sử an toàn</div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="fas fa-archive fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Lần chạy gần nhất -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs text-uppercase text-muted font-weight-bold mb-1">Lần Xuất Gần Nhất</div>
                            <div class="h6 font-weight-bold text-success mb-0" x-text="formatDateTime(settings.lastRunTime)">—</div>
                            <div class="text-xs text-muted mt-1">Trạng thái: Hoàn tất</div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="fas fa-history fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Lịch chạy kế tiếp -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs text-uppercase text-muted font-weight-bold mb-1">Lịch Chạy Kế Tiếp</div>
                            <div class="h6 font-weight-bold text-gray-900 mb-0" x-text="formatDateTime(settings.nextRunTime)">—</div>
                            <div class="text-xs text-muted mt-1" x-text="'Mùng ' + settings.runDay + ' lúc ' + settings.runHour + ':00 sáng'">Mùng 5 hàng tháng</div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                            <i class="fas fa-clock fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Kênh thông báo -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-xs text-uppercase text-muted font-weight-bold mb-1">Kênh Thông Báo</div>
                            <div class="h6 font-weight-bold text-info mb-0">Telegram Bot SCDI</div>
                            <div class="text-xs text-success mt-1"><i class="fas fa-check-circle me-1"></i>Đang kết nối</div>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                            <i class="fab fa-telegram-plane fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="row g-4">
        <!-- Cột Trái: Bảng Điều Khiển Xuất Nhanh & Cấu Hình (col-lg-4) -->
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                
                <!-- CARD 1: XUẤT BÁO CÁO NGAY BÂY GIỜ (RUN NOW) -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <h6 class="font-weight-bold text-primary mb-0">
                            <i class="fas fa-bolt text-warning me-2"></i>Xuất Báo Cáo Ngay (Run Now)
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <p class="small text-muted mb-3">Chủ động kết xuất số liệu ngay lập tức mà không cần đợi đến lịch tự động ngày mùng 5.</p>
                        
                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">Loại Báo Cáo</label>
                            <select class="form-select form-select-sm" x-model="manualExport.reportType">
                                <option value="ALL">⭐ Xuất tất cả (TCV CD45 + Hoạt động CD45)</option>
                                <option value="TCV_CD45">📦 Báo cáo TCV CD45 (.ZIP theo Tỉnh/Nhóm)</option>
                                <option value="HOATDONG_CD45">📊 Báo cáo Hoạt động CD45 (.xlsx)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">Kỳ Báo Cáo</label>
                            <select class="form-select form-select-sm" x-model="manualExport.periodType">
                                <option value="Month">Theo Tháng (26 tháng trước - 25 tháng này)</option>
                                <option value="Quarter">Theo Quý (Chu kỳ 3 tháng 26-25)</option>
                                <option value="Year">Cả Năm (26/12 - 25/12)</option>
                            </select>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6" x-show="manualExport.periodType === 'Month'">
                                <label class="form-label small font-weight-bold text-gray-800">Tháng Số Liệu</label>
                                <select class="form-select form-select-sm" x-model.number="manualExport.month">
                                    <template x-for="m in 12" :key="m">
                                        <option :value="m" x-text="'Tháng ' + m"></option>
                                    </template>
                                </select>
                            </div>
                            <div class="col-6" x-show="manualExport.periodType === 'Quarter'">
                                <label class="form-label small font-weight-bold text-gray-800">Quý Số Liệu</label>
                                <select class="form-select form-select-sm" x-model.number="manualExport.quarter">
                                    <option :value="1">Quý I</option>
                                    <option :value="2">Quý II</option>
                                    <option :value="3">Quý III</option>
                                    <option :value="4">Quý IV</option>
                                </select>
                            </div>
                            <div :class="manualExport.periodType === 'Year' ? 'col-12' : 'col-6'">
                                <label class="form-label small font-weight-bold text-gray-800">Năm</label>
                                <input type="number" class="form-control form-control-sm" x-model.number="manualExport.year" min="2020" max="2030" />
                            </div>
                        </div>

                        <div class="alert alert-secondary py-1 px-2 small mb-3 border text-center">
                            <i class="fas fa-calendar-alt text-primary me-1"></i> Phạm vi: <strong class="text-primary" x-text="getComputedDateRangeText()"></strong>
                        </div>

                        <!-- Progress Bar / Spinner if exporting -->
                        <div x-show="isExporting" class="alert alert-info py-2 small mb-3">
                            <div class="d-flex align-items-center">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span x-text="exportProgressMsg">Đang xử lý...</span>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary btn-sm font-weight-semibold shadow-sm" 
                                    @@click="triggerExportNow()" 
                                    :disabled="isExporting">
                                <i class="fas fa-play me-1"></i> Bắt Đầu Xuất File Ngay
                            </button>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: CẤU HÌNH LỊCH CHẠY TỰ ĐỘNG -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <h6 class="font-weight-bold text-primary mb-0">
                            <i class="fas fa-cog text-secondary me-2"></i>Cấu Hình Lịch Chạy Tự Động
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="switchActive" x-model="settings.isActive">
                            <label class="form-check-label small font-weight-bold text-gray-900" for="switchActive">
                                Bật chế độ tự động xuất báo cáo
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">
                                Ngày chạy trong tháng (Sau khi các tỉnh nhập xong)
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">Mùng</span>
                                <input type="number" class="form-control" x-model.number="settings.runDay" min="1" max="28">
                                <span class="input-group-text bg-light">hàng tháng</span>
                            </div>
                            <small class="text-muted">Khuyến nghị: Ngày mùng 5 hàng tháng</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small font-weight-bold text-gray-800">Khung giờ chạy (24h)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" class="form-control" x-model.number="settings.runHour" min="0" max="23">
                                <span class="input-group-text bg-light">:00 sáng</span>
                            </div>
                        </div>

                        <div class="alert alert-light border small text-muted mb-3 py-2">
                            <i class="fas fa-shield-alt text-success me-1"></i> <strong>Cơ chế tiền kiểm tra:</strong> Hệ thống sẽ tự động kiểm tra số liệu trước. Nếu chưa có dữ liệu sẽ tạm hoãn và bắn cảnh báo Telegram thay vì sinh file rỗng.
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-outline-success btn-sm font-weight-semibold shadow-sm" 
                                    @@click="saveSettings()" 
                                    :disabled="settingsSaving">
                                <i class="fas fa-save me-1"></i> Lưu Cấu Hình Lịch Chạy
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Cột Phải: Kho Lưu Trữ File Báo Cáo (col-lg-8) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h6 class="font-weight-bold text-primary mb-0">
                        <i class="fas fa-folder-open text-warning me-2"></i>Kho Lưu Trữ File Báo Cáo (Snapshot Archive)
                    </h6>
                    <span class="badge bg-light text-dark border font-weight-normal px-2 py-1" x-text="'Tổng cộng: ' + totalRows + ' file'"></span>
                </div>

                <div class="card-body p-3">
                    <!-- Filters Row -->
                    <div class="row g-2 mb-3 bg-light p-2 rounded border">
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" x-model="filter.reportType" @@change="loadLogs(1)">
                                <option value="">-- Tất cả loại báo cáo --</option>
                                <option value="TCV_CD45">Báo cáo TCV CD45</option>
                                <option value="HOATDONG_CD45">Báo cáo Hoạt động CD45</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" x-model="filter.periodType" @@change="loadLogs(1)">
                                <option value="">-- Tất cả kỳ --</option>
                                <option value="Month">Theo Tháng</option>
                                <option value="Quarter">Theo Quý</option>
                                <option value="Year">Cả Năm</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" x-model.number="filter.year" @@change="loadLogs(1)">
                                <option value="2026">Năm 2026</option>
                                <option value="2025">Năm 2025</option>
                                <option value="2024">Năm 2024</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" x-model="filter.month" @@change="loadLogs(1)" :disabled="filter.periodType === 'Quarter' || filter.periodType === 'Year'">
                                <option value="">-- Tất cả tháng --</option>
                                <template x-for="m in 12" :key="m">
                                    <option :value="m" x-text="'Tháng ' + m"></option>
                                </template>
                            </select>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-sm btn-secondary" @@click="filter.reportType=''; filter.periodType=''; filter.month=''; loadLogs(1)">
                                <i class="fas fa-redo me-1"></i> Đặt lại
                            </button>
                        </div>
                    </div>

                    <!-- Table Data -->
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle text-sm mb-0">
                            <thead class="table-light">
                                <tr class="text-center small font-weight-bold text-muted">
                                    <th style="width: 50px;">STT</th>
                                    <th>Loại Báo Cáo</th>
                                    <th>Kỳ Số Liệu</th>
                                    <th>Tên File & Dung Lượng</th>
                                    <th>Thời Gian Xuất</th>
                                    <th>Hình Thức</th>
                                    <th>Trạng Thái</th>
                                    <th style="width: 130px;">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-if="logsLoading">
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                                            Đang tải danh sách báo cáo...
                                        </td>
                                    </tr>
                                </template>

                                <template x-if="!logsLoading && logs.length === 0">
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="fas fa-folder-open fa-3x text-gray-300 mb-2 d-block"></i>
                                            Chưa có file báo cáo nào trong kho lưu trữ cho bộ lọc này.
                                        </td>
                                    </tr>
                                </template>

                                <template x-if="!logsLoading && logs.length > 0">
                                    <template x-for="(item, idx) in logs" :key="item.Id">
                                        <tr>
                                            <td class="text-center font-monospace small" x-text="(pageIndex - 1) * pageSize + idx + 1"></td>
                                            <td>
                                                <span :class="getReportBadgeClass(item.ReportType)" x-text="getReportTypeName(item.ReportType)"></span>
                                            </td>
                                            <td class="font-weight-semibold text-gray-900" x-text="item.PeriodValue"></td>
                                            <td>
                                                <div class="font-weight-bold text-primary" x-text="item.FileName"></div>
                                                <div class="text-xs text-muted" x-text="'Dung lượng: ' + formatFileSize(item.FileSizeKb) + (item.TotalRecords ? ' | ' + item.TotalRecords + ' bản ghi' : '')"></div>
                                            </td>
                                            <td class="small text-muted font-monospace" x-text="formatDateTime(item.CreatedDate)"></td>
                                            <td class="text-center small">
                                                <span x-show="item.TriggerType === 'AutoSchedule'" class="badge bg-light text-primary border">Tự động</span>
                                                <span x-show="item.TriggerType === 'Manual'" class="badge bg-light text-secondary border">Thủ công</span>
                                                <span x-show="item.TriggerType !== 'AutoSchedule' && item.TriggerType !== 'Manual'" class="badge bg-light text-muted border" x-text="item.TriggerType"></span>
                                            </td>
                                            <td class="text-center">
                                                <span x-show="item.Status === 'Success'" class="badge bg-success text-white">Thành công</span>
                                                <span x-show="item.Status === 'Pending_NoData'" class="badge bg-warning text-dark">Chờ số liệu</span>
                                                <span x-show="item.Status === 'Failed'" class="badge bg-danger text-white">Lỗi</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-1">
                                                    <template x-if="item.Status === 'Success' && item.FileName !== 'NONE'">
                                                        <button class="btn btn-sm btn-outline-primary py-1 px-2 shadow-xs" 
                                                                @@click="downloadFile(item.Id)" 
                                                                title="Tải file về máy">
                                                            <i class="fas fa-download"></i>
                                                        </button>
                                                    </template>
                                                    <button class="btn btn-sm btn-outline-danger py-1 px-2 shadow-xs"
                                                            @@click="confirmDelete(item)"
                                                            title="Xóa báo cáo này (Xóa cả file vật lý trên máy chủ)">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </template>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2" x-show="totalPages > 1">
                        <div class="text-xs text-muted">
                            Hiển thị trang <span class="font-weight-bold" x-text="pageIndex"></span> / <span x-text="totalPages"></span>
                        </div>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item" :class="{ 'disabled': pageIndex <= 1 }">
                                <button class="page-link" @@click="loadLogs(pageIndex - 1)">&laquo;</button>
                            </li>
                            <template x-for="p in totalPages" :key="p">
                                <li class="page-item" :class="{ 'active': pageIndex === p }" x-show="Math.abs(p - pageIndex) <= 2 || p === 1 || p === totalPages">
                                    <button class="page-link" @@click="loadLogs(p)" x-text="p"></button>
                                </li>
                            </template>
                            <li class="page-item" :class="{ 'disabled': pageIndex >= totalPages }">
                                <button class="page-link" @@click="loadLogs(pageIndex + 1)">&raquo;</button>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
</div>

    <!-- Modal Xác Nhận Xóa Báo Cáo (Cảnh báo xóa file vật lý) -->
    <div class="modal fade" id="modalConfirmDelete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title font-weight-bold mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Cảnh Báo Xóa Báo Cáo & File Vật Lý
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="alert alert-warning mb-3 small">
                        <i class="fas fa-exclamation-circle me-1"></i>
                        <strong>LƯU Ý NGUY HIỂM:</strong> Hành động này sẽ <span class="text-danger font-weight-bold">xóa vĩnh viễn</span> bản ghi trong hệ thống và <span class="text-danger font-weight-bold">tệp báo cáo vật lý (.xlsx / .zip) trên máy chủ</span>. Không thể khôi phục sau khi xóa!
                    </div>
                    <template x-if="deleteItem">
                        <div class="bg-light p-2 rounded border small mb-3">
                            <div class="mb-1"><strong>Kỳ báo cáo:</strong> <span class="badge bg-secondary" x-text="deleteItem.PeriodValue"></span></div>
                            <div class="mb-1"><strong>Loại báo cáo:</strong> <span x-text="getReportTypeName(deleteItem.ReportType)"></span></div>
                            <div class="mb-1"><strong>Tên tệp:</strong> <span class="text-danger font-monospace font-weight-bold" x-text="deleteItem.FileName"></span></div>
                            <div><strong>Thời gian xuất:</strong> <span x-text="formatDateTime(deleteItem.CreatedDate)"></span></div>
                        </div>
                    </template>
                    <p class="small text-muted mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn tệp báo cáo này khỏi kho lưu trữ không?</p>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="button" class="btn btn-sm btn-danger font-weight-semibold" :disabled="isDeleting" @@click="executeDelete()">
                        <span x-show="!isDeleting"><i class="fas fa-trash-alt me-1"></i> Xác Nhận Xóa Vĩnh Viễn</span>
                        <span x-show="isDeleting"><i class="fas fa-spinner fa-spin me-1"></i> Đang xóa...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/app/Controller/AlpineScheduledReportController.js"></script>
}
