@{
    ViewBag.Title = "Báo cáo tháng";
}

<div class="container-fluid" x-data="alpineBaoCaoThang()">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Báo cáo tháng</h1>
    <p class="mb-4">
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <div class="card-tools">
                <div class="form-group row">
                    <label class="col-sm-1 col-form-label">Tháng</label>
                    <div class="col-sm-1">
                        <select class="form-control" x-model="Thangs" name="ListThang" multiple>
                            <template x-for="item in ListThang" :key="item.Id">
                                <option :value="item.Id" x-text="item.Name"></option>
                            </template>
                        </select>
                    </div>  
                    
                    <label class="col-sm-1 col-form-label">Năm</label>
                    <div class="col-sm-1">
                        <select class="form-control" x-model="modelSearch.Year" name="Year">
                            <template x-for="item in ListYear" :key="item.Id">
                                <option :value="item.Id" x-text="item.Name"></option>
                            </template>
                        </select>
                    </div>                    

                    <label class="col-sm-1 col-form-label">Tỉnh</label>
                    <div class="col-sm-2">
                        <select class="form-control" x-model="ListCityCode" name="ListCity" @change="Changecity()" multiple>
                            <template x-for="item in ListCity" :key="item.Code">
                                <option :value="item.Code" x-text="item.Name"></option>
                            </template>
                        </select>
                    </div>                    
                    <label class="col-sm-1 col-form-label">Nhóm</label>
                    <div class="col-sm-2">
                        <select class="form-control" x-model="ListMaNhomTBH" name="ListMaNhomTBH" multiple>
                            <template x-for="item in ListNhomTBH" :key="item.manhom_tbh">
                                <option :value="item.manhom_tbh" x-text="item.tennhom_tbh"></option>
                            </template>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" @click="Refesh()" x-show="RoleBtnSearch == true" class="btn btn-primary">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-primary" @click="ExportExcel()">
                            <i class="fas fa-pencil-alt"></i> Xuất Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="report-tabs">
                <div class="report-tab-item" :class="{'active': activeTab == 'table'}" @click="setTab('table')">Bảng số liệu</div>
                <div class="report-tab-item" :class="{'active': activeTab == 'chart'}" @click="setTab('chart')">Biểu đồ trực quan</div>
            </div>

            <!-- Table View -->
            <div x-show="activeTab == 'table'" class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th style="width:5%;"># </th>
                            <th style="width: 39%;" colspan="2">Thông tin báo cáo </th>
                            <th style="width: 8%; ">Tổng</th>
                            <th style="width: 8%;">MSM </th>
                            <th style="width: 8%; ">PUD </th>
                            <th style="width: 8%; ">SW </th>
                            <th style="width: 8%; ">Nam</th>
                            <th style="width: 8%; ">Nữ</th>
                            <th style="width: 8%; ">Chuyển giới</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="(item, index) in ListData" :key="index">
                            <tr>
                                <td class="text-center" x-show="item.IsShow == 'Y'" x-text="item.STT"></td>
                                <td class="text-left" x-show="!(item.IsShow == 'N' || item.ThongTinBC == '' || item.ThongTinBC == null)" :colspan="item.Colpan" :rowspan="item.Rowpan">
                                    <span x-show="item.BoldText == 'N'" x-text="item.ThongTinBC"></span>
                                    <b x-show="item.BoldText == 'Y'" x-text="item.ThongTinBC"></b>
                                </td>
                                <td class="text-left" x-show="!(item.Colpan > 1 || item.IsShow == 'N')" x-text="item.ThongTinBC_Them"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Tong)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.MSM)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.PUD)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.SW)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nam)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.Nu)"></td>
                                <td class="text-right" x-show="item.IsShow == 'Y'" x-text="formatNumber(item.ChuyenGioi)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <!-- Chart View -->
            <div x-show="activeTab == 'chart'" class="py-4">
                <div class="chart-container">
                    <canvas id="monthlyReportChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Scripts/chart.js"></script>
    <script src="~/app/Controller/AlpineBaoCaoThang.js?v=@DateTime.Now.Ticks"></script>
}
