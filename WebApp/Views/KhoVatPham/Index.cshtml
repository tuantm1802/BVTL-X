
@{
    ViewBag.Title = "Kho vật phẩm";

}
<div ng-controller="KhoVatPhamController">

    <div class="container-fluid mt-5">
        <h2>Danh sách Xuất Nhập Vật phẩm</h2>
        <div class="row">
            <div class="col-sm-8 mb-2">
                <div class="alert alert-warning" role="alert">
                    Để đảm bảo có dữ liệu mới nhất Phiếu xuất từ PTV và Sinh hoạt nhóm. Hãy click "Cập nhật P.Xuất"!
                </div>

            </div>
            <div class="col-sm-4 mb-2">
                <button type="button" ng-click="CapNhatPhieuXuatNhap(2)" class="btn btn-primary">
                    Cập nhật P.Xuất
                </button>
            </div>
        </div>
        <table id="ChiTietPhieuXuatNhapTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Mã vật phẩm</th>
                    <th>Tên vật phẩm</th>
                    <th>Mã Phiếu</th>
                    <th>Ngày lập</th>
                    <th>Số lượng</th>
                    <th>Loại</th>
                    <th>Ghi chú</th>                                                            
                    @*<th>Thao tác</th>*@
                </tr>
            </thead>
        </table>
    </div>

</div>
@section Scripts{
    <script src="~/app/Controller/KhoVatPhamController.js"></script>
}

